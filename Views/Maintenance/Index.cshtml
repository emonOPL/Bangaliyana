@{
    Layout = null;
    var siteName = ViewBag.SiteName ?? "Bangaliyana";
    var message = ViewBag.MaintenanceMessage ?? "We are currently under maintenance. Please check back soon.";
    var contactEmail = ViewBag.ContactEmail;
    var logoUrl = ViewBag.LogoUrl;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Maintenance - @siteName</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <style>
        :root {
            --primary-color: #198754;
            --primary-dark: #146c43;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }

        .maintenance-container {
            text-align: center;
            max-width: 600px;
            padding: 50px 40px;
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
        }

        .logo-container {
            margin-bottom: 30px;
        }

        .logo-container img {
            max-height: 60px;
            width: auto;
        }

        .maintenance-icon {
            width: 120px;
            height: 120px;
            background: linear-gradient(135deg, #fff3cd 0%, #ffeeba 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 30px;
            animation: pulse 2s ease-in-out infinite;
        }

        .maintenance-icon i {
            font-size: 50px;
            color: #856404;
        }

        @@keyframes pulse {
            0%, 100% {
                transform: scale(1);
                box-shadow: 0 0 0 0 rgba(255, 193, 7, 0.4);
            }
            50% {
                transform: scale(1.05);
                box-shadow: 0 0 0 20px rgba(255, 193, 7, 0);
            }
        }

        h1 {
            font-size: 2rem;
            font-weight: 700;
            color: #333;
            margin-bottom: 15px;
        }

        .maintenance-message {
            font-size: 1.1rem;
            color: #666;
            line-height: 1.7;
            margin-bottom: 30px;
        }

        .progress-section {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 30px;
        }

        .progress-section p {
            margin-bottom: 10px;
            color: #666;
            font-size: 0.9rem;
        }

        .progress {
            height: 8px;
            border-radius: 4px;
            overflow: hidden;
        }

        .progress-bar {
            background: linear-gradient(90deg, var(--primary-color), var(--primary-dark));
            animation: progress-animation 2s ease-in-out infinite;
        }

        @@keyframes progress-animation {
            0% { width: 20%; }
            50% { width: 80%; }
            100% { width: 20%; }
        }

        .contact-section {
            padding-top: 20px;
            border-top: 1px solid #eee;
        }

        .contact-section p {
            color: #888;
            font-size: 0.9rem;
            margin-bottom: 10px;
        }

        .contact-section a {
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 500;
        }

        .contact-section a:hover {
            text-decoration: underline;
        }

        .social-links {
            margin-top: 20px;
        }

        .social-links a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #f8f9fa;
            color: #666;
            margin: 0 5px;
            transition: all 0.3s ease;
        }

        .social-links a:hover {
            background: var(--primary-color);
            color: white;
            transform: translateY(-3px);
        }

        .admin-link {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #eee;
        }

        .admin-link a {
            color: #888;
            font-size: 0.85rem;
            text-decoration: none;
        }

        .admin-link a:hover {
            color: var(--primary-color);
        }

        /* Dark mode support */
        @@media (prefers-color-scheme: dark) {
            body {
                background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            }

            .maintenance-container {
                background: #2a2a3e;
                box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            }

            h1 {
                color: #fff;
            }

            .maintenance-message {
                color: #aaa;
            }

            .progress-section {
                background: #3a3a4e;
            }

            .progress-section p {
                color: #aaa;
            }

            .contact-section {
                border-top-color: #3a3a4e;
            }

            .contact-section p {
                color: #888;
            }

            .social-links a {
                background: #3a3a4e;
                color: #aaa;
            }

            .admin-link {
                border-top-color: #3a3a4e;
            }
        }
    </style>
</head>
<body>
    <div class="maintenance-container">
        @if (!string.IsNullOrEmpty(logoUrl))
        {
            <div class="logo-container">
                <img src="~/@logoUrl" alt="@siteName" />
            </div>
        }

        <div class="maintenance-icon">
            <i class="fas fa-tools"></i>
        </div>

        <h1>Under Maintenance</h1>

        <p class="maintenance-message">@message</p>

        <div class="progress-section">
            <p><i class="fas fa-cog fa-spin me-2"></i>We're working hard to improve your experience</p>
            <div class="progress">
                <div class="progress-bar" role="progressbar"></div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(contactEmail))
        {
            <div class="contact-section">
                <p>Need urgent help? Contact us:</p>
                <a href="mailto:@contactEmail">
                    <i class="fas fa-envelope me-2"></i>@contactEmail
                </a>
            </div>
        }

        <div class="admin-link">
            <a href="/Identity/Account/Login">
                <i class="fas fa-lock me-1"></i> Admin Login
            </a>
        </div>
    </div>
</body>
</html>
