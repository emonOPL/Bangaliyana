                            {
                                <img src="~/@siteSettings.LogoUrl" alt="@siteSettings.SiteName" class="logo-light" />
                            }
                            @if (!string.IsNullOrEmpty(siteSettings.DarkModeLogoUrl))
                            {
                                <img src="~/@siteSettings.DarkModeLogoUrl" alt="@siteSettings.SiteName" class="logo-dark" />
                            }
                            else if (!string.IsNullOrEmpty(siteSettings.LogoUrl))
                            {
                                <img src="~/@siteSettings.LogoUrl" alt="@siteSettings.SiteName" class="logo-dark" />
                            }
                        }
                        else
                        {
                            <i class="fas fa-store me-2 text-primary"></i>
                            <span class="fw-bold">@siteSettings.SiteName</span>
                        }
