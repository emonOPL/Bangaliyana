                                    <!-- Content Management -->
                                    <li class="dropdown-header small text-uppercase menu-section-header section-content"><i class="fas fa-newspaper me-2"></i>@Localizer["Content"]</li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Blog" asp-action="Index">
                                            <i class="fas fa-blog me-2 text-info"></i>@Localizer["BlogPosts"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Blog" asp-action="Categories">
                                            <i class="fas fa-folder me-2 text-warning"></i>@Localizer["BlogCategories"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="StylingGuides" asp-action="Index">
                                            <i class="fas fa-palette me-2 text-success"></i>@Localizer["StylingGuides"]
                                        </a>
                                    </li>
