                                    <!-- Marketing -->
                                    <li class="dropdown-header small text-uppercase menu-section-header section-communication"><i class="fas fa-bullhorn me-2"></i>@Localizer["Marketing"]</li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="PromotionalCampaigns" asp-action="Index">
                                            <i class="fas fa-envelope-open-text me-2 text-primary"></i>@Localizer["PromotionalCampaigns"]
