    <!-- Performance and Error Monitoring -->
    <script>
        // Performance monitoring
        window.addEventListener('load', function() {
            setTimeout(function() {
                if ('performance' in window && performance.timing) {
                    const loadTime = performance.timing.loadEventEnd - performance.timing.navigationStart;
                    if (loadTime > 3000) {
                        console.warn('Page load time is slow:', loadTime + 'ms');
                    }
                }
            }, 100);
        });

        // document.getElementById("themeToggle").addEventListener("click", function () {
        //     const moonIcon = document.getElementById("moon");
        //     const sunIcon = document.getElementById("sun");
        //     const theme = document.documentElement.getAttribute('data-theme');

        //     if (theme === "dark") {
        //         moonIcon.classList.remove("d-none");
        //         sunIcon.classList.add("d-none");
        //     } else {
        //         sunIcon.classList.remove("d-none");
        //         moonIcon.classList.add("d-none");
        //     }
        // });
            (function () {
            const moonIcon = document.getElementById('moon');
            const sunIcon = document.getElementById('sun');
            const theme = document.documentElement.getAttribute('data-theme');

            if (theme === 'dark') {
                moonIcon.classList.remove('d-none');
                sunIcon.classList.add('d-none');
            } else {
                sunIcon.classList.remove('d-none');
                moonIcon.classList.add('d-none');
            }

            // Update all mobile theme toggle icons
            document.querySelectorAll('.mobile-theme-toggle').forEach(function(btn) {
                const moonEl = btn.querySelector('.moon-icon');
                const sunEl = btn.querySelector('.sun-icon');
                if (theme === 'dark') {
                    moonEl && moonEl.classList.remove('d-none');
                    sunEl && sunEl.classList.add('d-none');
                } else {
                    sunEl && sunEl.classList.remove('d-none');
                    moonEl && moonEl.classList.add('d-none');
                }
            });
        })();

        // Mobile Theme Toggle Handler
        document.querySelectorAll('.mobile-theme-toggle').forEach(function(btn) {
            btn.addEventListener('click', function() {
                const moonIcon = document.getElementById('moon');
                const sunIcon = document.getElementById('sun');
                let theme = document.documentElement.getAttribute('data-theme');

                if (theme === 'dark') {
                    document.documentElement.setAttribute('data-theme', 'light');
                    localStorage.setItem('bangaliyana-theme', 'light');
                    sunIcon && sunIcon.classList.remove('d-none');
                    moonIcon && moonIcon.classList.add('d-none');
                } else {
                    document.documentElement.setAttribute('data-theme', 'dark');
                    localStorage.setItem('bangaliyana-theme', 'dark');
                    moonIcon && moonIcon.classList.remove('d-none');
                    sunIcon && sunIcon.classList.add('d-none');
                }

                // Update mobile toggle icons
                document.querySelectorAll('.mobile-theme-toggle').forEach(function(b) {
                    const moonEl = b.querySelector('.moon-icon');
                    const sunEl = b.querySelector('.sun-icon');
                    const newTheme = document.documentElement.getAttribute('data-theme');
                    if (newTheme === 'dark') {
                        moonEl && moonEl.classList.remove('d-none');
                        sunEl && sunEl.classList.add('d-none');
                    } else {
                        sunEl && sunEl.classList.remove('d-none');
                        moonEl && moonEl.classList.add('d-none');
                    }
                });
            });
        });

        // Scroll to Top Button with enhanced smooth scroll support
        (function() {
            var scrollBtn = document.getElementById('scrollToTopBtn');
            if (scrollBtn) {
                // Throttle function for performance
                function throttle(func, limit) {
                    var inThrottle;
                    return function() {
                        var args = arguments;
                        var context = this;
                        if (!inThrottle) {
                            func.apply(context, args);
                            inThrottle = true;
                            setTimeout(function() { inThrottle = false; }, limit);
                        }
                    };
                }

                // Show/hide button based on scroll position (throttled for performance)
                window.addEventListener('scroll', throttle(function() {
                    if (window.pageYOffset > 300) {
                        scrollBtn.classList.add('show');
                    } else {
                        scrollBtn.classList.remove('show');
                    }
                }, 100));

                // Enhanced smooth scroll function - uses custom animation for consistent behavior
                function smoothScrollToTop() {
                    // Always use manual animation for consistent, visually smooth scrolling
                    // Native scroll-behavior can be too fast and inconsistent across browsers
                    manualSmoothScroll();
                }

                // Manual smooth scroll animation fallback
                function manualSmoothScroll() {
                    var currentPosition = window.pageYOffset || document.documentElement.scrollTop;
                    if (currentPosition <= 0) return;

                    var startTime = performance.now();
                    var duration = 600; // Animation duration in ms

                    // Temporarily disable CSS smooth scroll to prevent conflicts
                    var htmlElement = document.documentElement;
                    var originalScrollBehavior = htmlElement.style.scrollBehavior;
                    htmlElement.style.scrollBehavior = 'auto';

                    function animateScroll(currentTime) {
                        var elapsed = currentTime - startTime;
                        var progress = Math.min(elapsed / duration, 1);

                        // Easing function (easeOutQuart for smoother feel)
                        var easeOut = 1 - Math.pow(1 - progress, 4);

                        var newPosition = currentPosition * (1 - easeOut);
                        window.scrollTo(0, newPosition);

                        if (progress < 1) {
                            requestAnimationFrame(animateScroll);
                        } else {
                            // Ensure we end at exactly 0
                            window.scrollTo(0, 0);
                            // Restore original scroll behavior
                            htmlElement.style.scrollBehavior = originalScrollBehavior || '';
                        }
                    }

                    requestAnimationFrame(animateScroll);
                }

                // Click handler
                scrollBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    smoothScrollToTop();
                });

                // Also support touch events for mobile
                scrollBtn.addEventListener('touchend', function(e) {
                    e.preventDefault();
                    smoothScrollToTop();
                }, { passive: false });
            }
        })();

        // Quick View Functionality
        (function() {
            document.addEventListener('click', function(e) {
                var btn = e.target.closest('.quick-view-btn');
                if (btn) {
                    e.preventDefault();
                    var productId = btn.getAttribute('data-product-id');
                    if (productId) {
                        var modal = new bootstrap.Modal(document.getElementById('quickViewModal'));
                        var contentDiv = document.getElementById('quickViewContent');

                        // Show loading spinner
                        contentDiv.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-success" role="status"><span class="visually-hidden">Loading...</span></div></div>';
                        modal.show();

                        // Fetch product details
                        fetch('/Customer/Home/QuickView/' + productId)
                            .then(function(response) {
                                if (!response.ok) throw new Error('Product not found');
                                return response.text();
                            })
                            .then(function(html) {
                                contentDiv.innerHTML = html;
                            })
                            .catch(function(error) {
                                contentDiv.innerHTML = '<div class="text-center py-5 text-danger"><i class="fas fa-exclamation-circle fa-3x mb-3"></i><p>Failed to load product details</p></div>';
                            });
                    }
                }
            });
        })();

        // Wishlist Functionality
        (function() {
            console.log('Wishlist handler registered');
            document.addEventListener('click', function(e) {
                var btn = e.target.closest('.wishlist-btn');
                if (btn) {
                    console.log('Wishlist button clicked, data-product-id:', btn.getAttribute('data-product-id'));
                    var productId = btn.getAttribute('data-product-id');
                    // Only handle if button has data-product-id (skip Details page which uses onclick)
                    if (productId) {
                        e.preventDefault();
                        e.stopPropagation();
                        var icon = btn.querySelector('i') || btn.querySelector('svg') || btn.querySelector('.fa-heart');
                        if (!icon) {
                            console.error('Wishlist icon not found in button:', btn.innerHTML);
                            return;
                        }
                        var originalClass = icon.className;

                        // Show loading state
                        icon.className = 'fas fa-spinner fa-spin';
                        btn.disabled = true;

                        fetch('/Customer/Wishlist/Toggle', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                            },
                            body: 'productId=' + productId
                        })
                        .then(function(response) {
                            return response.json();
                        })
                        .then(function(data) {
                            btn.disabled = false;
                            if (data.success) {
                                if (data.isInWishlist) {
                                    icon.classList.remove('far', 'fa-spinner', 'fa-spin');
                                    icon.classList.add('fas', 'fa-heart', 'text-danger');
                                    btn.classList.add('active');
                                } else {
                                    icon.classList.remove('fas', 'text-danger', 'fa-spinner', 'fa-spin');
                                    icon.classList.add('far', 'fa-heart');
                                    btn.classList.remove('active');
                                }
                                // Show toast notification
                                showToast(data.message, 'success');
                            } else if (data.requireLogin) {
                                icon.className = originalClass;
                                showToast('Please login to add items to wishlist', 'warning');
                                setTimeout(function() {
                                    window.location.href = '/Identity/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                                }, 1500);
                            } else {
                                icon.className = originalClass;
                                showToast(data.message || 'Error occurred', 'error');
                            }
                        })
                        .catch(function(error) {
                            btn.disabled = false;
                            icon.className = originalClass;
                            showToast('Error adding to wishlist', 'error');
                        });
                    }
                }
            });
        })();

        // Mobile Menu Body Scroll Lock (cross-browser support with iOS fix)
        (function() {
            var navbarCollapse = document.querySelector('.navbar-collapse');
            var scrollPosition = 0;

            if (navbarCollapse) {
                // Lock body scroll when menu opens
                navbarCollapse.addEventListener('show.bs.collapse', function() {
                    scrollPosition = window.pageYOffset;
                    document.body.style.overflow = 'hidden';
                    document.body.style.position = 'fixed';
                    document.body.style.top = '-' + scrollPosition + 'px';
                    document.body.style.width = '100%';
                    document.body.classList.add('menu-open');

                    // Reset menu scroll to top when opening
                    navbarCollapse.scrollTop = 0;
                });

                // Unlock body scroll when menu closes
                navbarCollapse.addEventListener('hide.bs.collapse', function() {
                    document.body.style.overflow = '';
                    document.body.style.position = '';
                    document.body.style.top = '';
                    document.body.style.width = '';
                    document.body.classList.remove('menu-open');
                    window.scrollTo(0, scrollPosition);
                });

                // iOS Safari touch scroll fix
                var startY = 0;

                navbarCollapse.addEventListener('touchstart', function(e) {
                    startY = e.touches[0].clientY;
                }, { passive: true });

                navbarCollapse.addEventListener('touchmove', function(e) {
                    var scrollTop = navbarCollapse.scrollTop;
                    var scrollHeight = navbarCollapse.scrollHeight;
                    var clientHeight = navbarCollapse.clientHeight;
                    var currentY = e.touches[0].clientY;
                    var isScrollingUp = currentY > startY;
                    var isScrollingDown = currentY < startY;

                    // Prevent overscroll at boundaries on iOS
                    if ((scrollTop <= 0 && isScrollingUp) ||
                        (scrollTop + clientHeight >= scrollHeight && isScrollingDown)) {
                        // At boundaries - overscroll-behavior CSS handles bounce prevention
                    }
                }, { passive: true });

                // Prevent body touchmove when menu is open (iOS fix)
                document.body.addEventListener('touchmove', function(e) {
                    if (document.body.classList.contains('menu-open')) {
                        // Allow scrolling only inside the navbar collapse
                        if (navbarCollapse.contains(e.target)) {
                            return; // Allow scroll inside menu
                        }
                        e.preventDefault();
                    }
                }, { passive: false });
            }
        })();

        // Dropdown Arrow Toggle for Seller and Admin menus
        (function() {
            // Helper function to toggle dropdown arrow icons
            function setupDropdownArrowToggle(dropdownSelector) {
                var dropdown = document.querySelector(dropdownSelector);
                if (dropdown) {
                    dropdown.addEventListener('shown.bs.dropdown', function() {
                        var iconRight = dropdown.querySelector('.dropdown-toggle .icon-right');
                        var iconDown = dropdown.querySelector('.dropdown-toggle .icon-down');
                        if (iconRight) iconRight.style.display = 'none';
                        if (iconDown) iconDown.style.display = 'inline';
                    });

                    dropdown.addEventListener('hidden.bs.dropdown', function() {
                        var iconRight = dropdown.querySelector('.dropdown-toggle .icon-right');
                        var iconDown = dropdown.querySelector('.dropdown-toggle .icon-down');
                        if (iconRight) iconRight.style.display = 'inline';
                        if (iconDown) iconDown.style.display = 'none';
                    });
                }
            }

            // Setup for Seller, Admin, and Moderator dropdowns
            setupDropdownArrowToggle('.seller-dropdown');
            setupDropdownArrowToggle('.admin-dropdown');
            setupDropdownArrowToggle('.moderator-dropdown');
        })();
    </script>
</body>
