                                    <!-- Reports & Analytics -->
                                    <li class="dropdown-header small text-uppercase menu-section-header section-reports"><i class="fas fa-chart-bar me-2"></i>@Localizer["ReportsAndAnalytics"]</li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Reports" asp-action="SalesReport">
