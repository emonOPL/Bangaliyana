                                   href="#" id="moderatorDropdown"
                                   role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user-tie me-1"></i>
                                    <span>@Localizer["Moderator"]</span>
                                    <i class="fas fa-chevron-right ms-1 dropdown-arrow icon-right"></i>
                                    <i class="fas fa-chevron-down ms-1 dropdown-arrow icon-down" style="display: none;"></i>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-scrollable shadow-lg border-0 rounded-3" aria-labelledby="moderatorDropdown" style="min-width: 260px;">
                                    <!-- Dashboard -->
                                    <li>
                                        <a class="dropdown-item" asp-area="Moderator" asp-controller="Dashboard" asp-action="Index">
                                            <i class="fas fa-tachometer-alt me-2 text-primary"></i>@Localizer["ModeratorDashboard"]
                                        </a>
                                    </li>

                                    <!-- Seller Management -->
                                    <li class="dropdown-header small text-uppercase menu-section-header section-seller"><i class="fas fa-store me-2"></i>@Localizer["SellerManagement"]</li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Moderator" asp-controller="Seller" asp-action="Index">
                                            <i class="fas fa-users me-2 text-info"></i>@Localizer["AllSellers"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Moderator" asp-controller="Seller" asp-action="Index" asp-route-status="Pending">
                                            <i class="fas fa-user-clock me-2 text-warning"></i>@Localizer["PendingApplications"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Moderator" asp-controller="Seller" asp-action="BankRequests">
                                            <i class="fas fa-university me-2 text-secondary"></i>@Localizer["BankRequests"]
                                        </a>
                                    </li>

                                    <!-- Orders & Payments -->
                                    <li class="dropdown-header small text-uppercase menu-section-header section-orders"><i class="fas fa-shopping-cart me-2"></i>@Localizer["OrdersAndPayments"]</li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Moderator" asp-controller="Order" asp-action="Index">
                                            <i class="fas fa-shopping-bag me-2 text-success"></i>@Localizer["AllOrders"]
