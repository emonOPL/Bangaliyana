                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="CategoryPromotions" asp-action="Index">
                                            <i class="fas fa-tags me-2 text-danger"></i>@Localizer["CategoryPromotions"]
                                        </a>
