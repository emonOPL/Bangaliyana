                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="AdminRoles" asp-action="Index">
                                            <i class="fas fa-key me-2 text-warning"></i>@Localizer["AdminRolesPermissions"]
                                        </a>
