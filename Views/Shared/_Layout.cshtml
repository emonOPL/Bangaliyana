                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="BusinessType" asp-action="Index">
                                            <i class="fas fa-briefcase me-2 text-info"></i>@Localizer["BusinessTypes"]
                                        </a>
