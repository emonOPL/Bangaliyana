                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="SeasonalCollections" asp-action="Index">
                                            <i class="fas fa-snowflake me-2 text-primary"></i>@Localizer["SeasonalCollections"]
