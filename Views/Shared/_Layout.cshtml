                                            <i class="fas fa-folder-tree me-2 text-warning"></i>@Localizer["Categories"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Inventory" asp-action="Index">
                                            <i class="fas fa-warehouse me-2 text-success"></i>@Localizer["Inventory"]
                                        </a>
                                    </li>

                                    <!-- Administration -->
                                    <li class="dropdown-header small text-uppercase menu-section-header section-admin"><i class="fas fa-cogs me-2"></i>@Localizer["Administration"]</li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="UserManagement" asp-action="Index">
                                            <i class="fas fa-users-cog me-2 text-primary"></i>@Localizer["UserManagement"]
