@using Bangaliyana.Services
@using Bangaliyana.Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@inject ISiteSettingsService SiteSettingsService
@inject SignInManager<ApplicationUser> SignInManager
@inject IStringLocalizer<Bangaliyana.SharedResources> Localizer
@{
    // Fallback default (in case JS/localStorage not available)
    var theme = "light";
    var isDark = theme == "dark";

    // Get dynamic site settings
    var siteSettings = await SiteSettingsService.GetSiteSettingsAsync();
    var socialLinks = await SiteSettingsService.GetActiveSocialLinksAsync();
    var footerPages = await SiteSettingsService.GetFooterPagesAsync();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="@(siteSettings.SiteDescription ?? "Modern e-commerce platform")" />
    <meta name="keywords" content="@(siteSettings.SiteKeywords ?? "e-commerce, Bangladesh, online shopping")" />
    <title>@ViewData["Title"] - @siteSettings.SiteName</title>
    @if (!string.IsNullOrEmpty(siteSettings.FaviconUrl))
    {
        <link rel="icon" href="~/@siteSettings.FaviconUrl" type="image/x-icon" />
    }

    <!-- PWA Support -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="@(siteSettings.PrimaryColor ?? "#198754")" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="@siteSettings.SiteName" />
    <link rel="apple-touch-icon" href="/icons/icon-152x152.png" />
    <meta name="msapplication-TileImage" content="/icons/icon-144x144.png" />
    <meta name="msapplication-TileColor" content="@(siteSettings.PrimaryColor ?? "#198754")" />

    <!-- Stylesheets -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ai-search.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Bangaliyana.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="//cdn.jsdelivr.net/npm/alertifyjs@1.14.0/build/css/alertify.min.css" />
    
    <!-- Theme detection script (inline for no flash) -->
    <script>
        (function () {
            const savedTheme = localStorage.getItem('bangaliyana-theme');
            const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            const theme = savedTheme || (prefersDark ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>

    <!-- Dynamic Theme Colors from SiteSettings -->
    <style>
        :root {
            --site-primary-color: @siteSettings.PrimaryColor;
            --site-secondary-color: @siteSettings.SecondaryColor;
            --site-accent-color: @siteSettings.AccentColor;
        }

        /* Enable smooth scrolling for the entire page */
        html {
            scroll-behavior: smooth;
        }

        @if (!siteSettings.EnableDarkMode)
        {
            <text>
        /* Hide dark mode toggle when disabled in settings */
        .theme-toggle, .mobile-theme-toggle {
            display: none !important;
        }
            </text>
        }

        /* Logo visibility based on theme */
        .logo-light { display: inline-block; }
        .logo-dark { display: none; }
        [data-theme="dark"] .logo-light { display: none; }
        [data-theme="dark"] .logo-dark { display: inline-block; }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100" style="overflow-x: hidden;">
    <!-- Main Navigation -->
    <header>
        <nav class="navbar navbar-expand-lg fixed-top">
            <div class="container">

                <!-- Brand -->
                <a class="navbar-brand" asp-area="Customer" asp-controller="Home" asp-action="Index"
                   title="@siteSettings.SiteName - @siteSettings.SiteTagline">
                    @if (!string.IsNullOrEmpty(siteSettings.LogoUrl) || !string.IsNullOrEmpty(siteSettings.DarkModeLogoUrl))
                    {
                        @if (!string.IsNullOrEmpty(siteSettings.LogoUrl))
                        {
                            <img src="~/@siteSettings.LogoUrl" alt="@siteSettings.SiteName" style="height: 40px;" class="logo-light" />
                        }
                        @if (!string.IsNullOrEmpty(siteSettings.DarkModeLogoUrl))
                        {
                            <img src="~/@siteSettings.DarkModeLogoUrl" alt="@siteSettings.SiteName" style="height: 40px;" class="logo-dark" />
                        }
                        else if (!string.IsNullOrEmpty(siteSettings.LogoUrl))
                        {
                            <!-- Fallback: use light logo for dark mode if no dark logo -->
                            <img src="~/@siteSettings.LogoUrl" alt="@siteSettings.SiteName" style="height: 40px;" class="logo-dark" />
                        }
                    }
                    else
                    {
                        <i class="fas fa-store me-2 text-primary"></i>
                        <span class="fw-bold">@siteSettings.SiteName</span>
                    }
                </a>

                <!-- Mobile Right Actions (visible on tablet, hidden on small mobile <450px) -->
                <div class="mobile-header-actions d-flex d-lg-none align-items-center gap-2 ms-auto me-2">
                    <!-- Search Icon Button (Mobile) -->
                    <button type="button"
                            class="search-toggle-btn btn btn-outline-secondary btn-sm border-0"
                            title="Search products"
                            aria-label="Open search"
                            data-bs-toggle="modal"
                            data-bs-target="#searchModal">
                        <i class="fas fa-search"></i>
                    </button>

                    <!-- Theme Toggle Button (Mobile) -->
                    <button type="button"
                            class="theme-toggle btn btn-outline-secondary btn-sm border-0 mobile-theme-toggle"
                            title="Toggle theme"
                            aria-label="Toggle dark/light theme">
                        <span class="moon-icon @(isDark ? "" : "d-none")"><i class="fas fa-moon"></i></span>
                        <span class="sun-icon @(isDark ? "d-none" : "")"><i class="fas fa-sun"></i></span>
                    </button>

                    <!-- Cart/User (Mobile) -->
                    <partial name="_LoginPartial" />
                </div>

                <!-- Mobile Toggle (Hamburger) -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="hamburger-icon">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>
                </button>

                <!-- Navigation Items (Collapsible) -->
                <div class="collapse navbar-collapse" id="navbarNav">
                    <!-- Mobile Menu Brand (visible only on mobile at top-left) -->
                    <a class="mobile-menu-brand d-lg-none" asp-area="Customer" asp-controller="Home" asp-action="Index"
