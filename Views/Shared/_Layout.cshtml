                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Reports" asp-action="SellerPerformance">
                                            <i class="fas fa-store me-2 text-purple"></i>@Localizer["SellerPerformance"]
                                        </a>
                                    </li>

                                    <!-- Support -->
                                    <li class="dropdown-header small text-uppercase menu-section-header section-support"><i class="fas fa-headset me-2"></i>@Localizer["Support"]</li>
