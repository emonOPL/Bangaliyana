                                            <i class="fas fa-undo-alt me-2 text-danger"></i>@Localizer["ReturnsAndRefunds"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="SellerPayment" asp-action="Index">
                                            <i class="fas fa-money-bill-wave me-2 text-success"></i>@Localizer["SellerPayments"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Moderator" asp-controller="MonthlyReport" asp-action="Index">
                                            <i class="fas fa-file-invoice-dollar me-2 text-primary"></i>@Localizer["MonthlyReports"]
