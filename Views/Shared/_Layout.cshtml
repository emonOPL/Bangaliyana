                                    <!-- Settings -->
                                    <li class="dropdown-header small text-uppercase menu-section-header section-settings"><i class="fas fa-sliders-h me-2"></i>@Localizer["Settings"]</li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="SiteSettings" asp-action="Index">
                                            <i class="fas fa-globe me-2 text-primary"></i>@Localizer["SiteSettings"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="MenuManagement" asp-action="Index">
                                            <i class="fas fa-bars me-2 text-secondary"></i>@Localizer["MenuManagement"]
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <!-- Mobile Menu Actions (visible inside hamburger on <450px) -->
                    <div class="mobile-menu-actions d-lg-none">
                        <div class="mobile-menu-divider"></div>
                        <div class="mobile-menu-section">
                            <div class="mobile-menu-title">@Localizer["QuickActions"]</div>
                            <div class="d-flex flex-wrap gap-3 justify-content-center p-3">
                                <!-- Search -->
                                <button type="button"
                                        class="mobile-action-btn btn btn-outline-primary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#searchModal">
                                    <i class="fas fa-search"></i>
                                    <span>@Localizer["Search"]</span>
                                </button>

                                <!-- Theme Toggle -->
                                <button type="button"
                                        class="mobile-action-btn btn btn-outline-secondary mobile-theme-toggle">
                                    <span class="moon-icon @(isDark ? "" : "d-none")"><i class="fas fa-moon"></i></span>
                                    <span class="sun-icon @(isDark ? "d-none" : "")"><i class="fas fa-sun"></i></span>
                                    <span>@Localizer["Theme"]</span>
                                </button>

                                <!-- Language Toggle (Mobile) -->
                                @{
                                    var mobileCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
                                    var mobileIsEnglish = mobileCulture.StartsWith("en");
                                }
                                <div class="dropdown">
                                    <button class="mobile-action-btn btn btn-outline-info dropdown-toggle" type="button"
                                            data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fas fa-globe"></i>
                                        <span>@(mobileIsEnglish ? "EN" : "বাংলা")</span>
                                    </button>
                                    <ul class="dropdown-menu shadow-sm">
                                        <li>
                                            <form asp-area="Customer" asp-controller="Home" asp-action="SetLanguage" method="post">
                                                <input type="hidden" name="culture" value="en" />
                                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                <button type="submit" class="dropdown-item @(mobileIsEnglish ? "active" : "")">
                                                    🇺🇸 English
                                                </button>
                                            </form>
                                        </li>
                                        <li>
                                            <form asp-area="Customer" asp-controller="Home" asp-action="SetLanguage" method="post">
                                                <input type="hidden" name="culture" value="bn" />
                                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                <button type="submit" class="dropdown-item @(!mobileIsEnglish ? "active" : "")">
                                                    🇧🇩 বাংলা
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>

                                <!-- Cart -->
                                <a class="mobile-action-btn btn btn-outline-success"
                                   asp-area="Customer" asp-controller="Home" asp-action="Cart">
                                    <i class="fas fa-shopping-cart"></i>
                                    <span>@Localizer["Cart"]</span>
                                </a>

                                @if (SignInManager.IsSignedIn(User))
                                {
                                    <!-- Notifications -->
                                    <a class="mobile-action-btn btn btn-outline-warning"
                                       asp-area="Identity" asp-page="/Account/Manage/Notifications">
                                        <i class="fas fa-bell"></i>
                                        <span>@Localizer["Notifications"]</span>
                                    </a>
                                    <!-- Messages -->
                                    <a class="mobile-action-btn btn btn-outline-info"
                                       asp-area="Customer" asp-controller="Messages" asp-action="Index">
                                        <i class="fas fa-comment-dots"></i>
                                        <span>@Localizer["Messages"]</span>
                                    </a>
                                }
                            </div>
                        </div>

                        <!-- User Authentication Links -->
                        <div class="mobile-auth-section">
                            @if (SignInManager.IsSignedIn(User))
                            {
                                <div class="d-flex flex-wrap gap-2 justify-content-center p-3">
                                    <!-- Wishlist -->
                                    <a class="mobile-action-btn btn btn-outline-danger"
                                       asp-area="Customer" asp-controller="Wishlist" asp-action="Index">
                                        <i class="fas fa-heart"></i>
                                        <span>@Localizer["Wishlist"]</span>
                                    </a>
                                    <!-- Followed Shops -->
                                    <a class="mobile-action-btn btn btn-outline-primary"
                                       asp-area="Customer" asp-controller="Home" asp-action="FollowedShops">
                                        <i class="fas fa-store"></i>
                                        <span>@Localizer["FollowedShops"]</span>
                                    </a>
                                    <!-- Profile -->
                                    <a class="mobile-action-btn btn btn-outline-secondary"
                                       asp-area="Identity" asp-page="/Account/Manage/Index">
                                        <i class="fas fa-user"></i>
                                        <span>@Localizer["Profile"]</span>
                                    </a>
                                    <!-- Orders -->
                                    <a class="mobile-action-btn btn btn-outline-success"
                                       asp-area="Customer" asp-controller="Home" asp-action="Orders">
                                        <i class="fas fa-receipt"></i>
                                        <span>@Localizer["Orders"]</span>
                                    </a>
                                    <!-- Logout -->
                                    <form asp-area="Identity" asp-page="/Account/Logout"
                                          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "Customer" })"
                                          class="d-inline">
                                        <button type="submit" class="mobile-action-btn btn btn-danger">
                                            <i class="fas fa-sign-out-alt"></i>
                                            <span>@Localizer["Logout"]</span>
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex gap-2 justify-content-center p-3">
                                    <a class="mobile-action-btn btn btn-primary flex-grow-1"
                                       asp-area="Identity" asp-page="/Account/Login">
                                        <i class="fas fa-sign-in-alt"></i>
                                        <span>@Localizer["Login"]</span>
                                    </a>
                                    <a class="mobile-action-btn btn btn-success flex-grow-1"
                                       asp-area="Identity" asp-page="/Account/Register">
                                        <i class="fas fa-user-plus"></i>
                                        <span>@Localizer["SignUp"]</span>
                                    </a>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Right side: Search + Theme Toggle + Login Partial (Desktop only) -->
                    <div class="d-none d-lg-flex align-items-center gap-2">
                        <!-- Search Icon Button -->
                        <button type="button"
                                id="searchToggleBtn"
                                class="search-toggle-btn btn btn-outline-secondary btn-sm border-0"
                                title="Search products (Ctrl+K)"
                                aria-label="Open search"
                                data-bs-toggle="modal"
                                data-bs-target="#searchModal">
                            <i class="fas fa-search"></i>
                        </button>

                        <!-- Theme Toggle Button -->
                        <button type="button"
                                id="themeToggle"
                                class="theme-toggle btn btn-outline-secondary btn-sm border-0"
                                title="Toggle theme"
                                aria-label="Toggle dark/light theme"
                                onclick="
                                const moonIcon = document.getElementById('moon');
                                const sunIcon = document.getElementById('sun');
                                let theme = document.documentElement.getAttribute('data-theme');

                                if (theme === 'dark') {
                                    // Switch to light
                                    document.documentElement.setAttribute('data-theme', 'light');
                                    localStorage.setItem('bangaliyana-theme', 'light');
                                    sunIcon.classList.remove('d-none');
                                    moonIcon.classList.add('d-none');
                                } else {
                                    // Switch to dark
                                    document.documentElement.setAttribute('data-theme', 'dark');
                                    localStorage.setItem('bangaliyana-theme', 'dark');
                                    moonIcon.classList.remove('d-none');
                                    sunIcon.classList.add('d-none');
                                }
                            ">
                            <span id="moon" class="@(isDark ? "" : "d-none")"><i class="fas fa-moon"></i></span>
                            <span id="sun" class="@(isDark ? "d-none" : "")"><i class="fas fa-sun"></i></span>
                        </button>

                        <!-- Language Switcher Dropdown -->
                        @{
                            var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
                            var isEnglish = currentCulture.StartsWith("en");
                            var isBengali = currentCulture.StartsWith("bn");
                        }
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary btn-sm border-0 dropdown-toggle" type="button"
                                    id="languageDropdown" data-bs-toggle="dropdown" aria-expanded="false"
                                    title="Change Language">
                                <i class="fas fa-globe"></i>
                                <span class="ms-1 d-none d-xl-inline">@(isBengali ? "বাংলা" : "EN")</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="languageDropdown" style="min-width: 120px;">
                                <li>
                                    <form asp-area="Customer" asp-controller="Home" asp-action="SetLanguage" method="post">
                                        <input type="hidden" name="culture" value="en" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="dropdown-item @(isEnglish ? "active" : "")">
                                            <span class="me-2">🇺🇸</span> English
                                        </button>
                                    </form>
                                </li>
                                <li>
                                    <form asp-area="Customer" asp-controller="Home" asp-action="SetLanguage" method="post">
                                        <input type="hidden" name="culture" value="bn" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="dropdown-item @(isBengali ? "active" : "")">
                                            <span class="me-2">🇧🇩</span> বাংলা
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>

                        <!-- Login/User Menu -->
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Page Content -->
    <main class="main-content">
        <div>
            <!-- Toast Messages from TempData (will be shown via alertify) -->
            @if (TempData["success"] != null)
            {
                var successMsg = TempData["success"]?.ToString()?.Replace("'", "\\'") ?? "";
                <script>
                    document.addEventListener('DOMContentLoaded', function() {
                        alertify.success('@Html.Raw(successMsg)');
                    });
                </script>
            }
            @if (TempData["error"] != null)
            {
                var errorMsg = TempData["error"]?.ToString()?.Replace("'", "\\'") ?? "";
                <script>
                    document.addEventListener('DOMContentLoaded', function() {
                        alertify.error('@Html.Raw(errorMsg)');
                    });
                </script>
            }
            @if (TempData["warning"] != null)
            {
                var warningMsg = TempData["warning"]?.ToString()?.Replace("'", "\\'") ?? "";
                <script>
                    document.addEventListener('DOMContentLoaded', function() {
                        alertify.warning('@Html.Raw(warningMsg)');
                    });
                </script>
            }
            @if (TempData["info"] != null)
            {
                var infoMsg = TempData["info"]?.ToString()?.Replace("'", "\\'") ?? "";
                <script>
                    document.addEventListener('DOMContentLoaded', function() {
                        alertify.message('@Html.Raw(infoMsg)');
                    });
                </script>
            }

            <!-- Main Content Area -->
            <div class="content-wrapper">
                @RenderBody()
            </div>
        </div>
    </main>

    <!-- Scroll to Top Button -->
    <button id="scrollToTopBtn" class="scroll-to-top-btn" title="Go to top" aria-label="Scroll to top">
        <i class="fas fa-arrow-up"></i>
    </button>

    <!-- Quick View Modal -->
    <div class="modal fade" id="quickViewModal" tabindex="-1" aria-labelledby="quickViewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title" id="quickViewModalLabel">@Localizer["QuickView"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="quickViewContent">
                    <div class="text-center py-5">
                        <div class="spinner-border text-success" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- AI Search Modal -->
    <div class="modal fade" id="searchModal" tabindex="-1" aria-labelledby="searchModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg search-modal-dialog">
            <div class="modal-content search-modal-content">
                <!-- Modal Header with Search Input -->
                <div class="search-modal-header">
                    <div class="search-input-wrapper">
                        <i class="fas fa-search search-input-icon"></i>
                        <input type="text"
                               id="modalSearchInput"
                               class="search-modal-input"
                               placeholder="@Localizer["SearchPlaceholder"]"
                               autocomplete="off"
                               spellcheck="false" />
                        <div class="search-shortcuts">
                            <kbd>ESC</kbd>
                        </div>
                        <button type="button" id="modalClearSearchBtn" class="search-modal-clear" aria-label="Clear search">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    <button type="button" class="search-modal-close" data-bs-dismiss="modal" aria-label="Close">
                        <i class="fas fa-times"></i>
                    </button>
                </div>

                <!-- Modal Body with Search Results -->
                <div class="search-modal-body" id="searchModalBody">
                    <!-- Default content will be loaded here -->
                    <div class="search-modal-loading">
                        <div class="search-welcome">
                            <div class="search-welcome-icon">
                                <i class="fas fa-search"></i>
                            </div>
                            <h5>@Localizer["WhatAreYouLookingFor"]</h5>
                            <p class="text-muted">@Localizer["SearchForProductsDescription"]</p>
                        </div>
                    </div>
                </div>

                <!-- Modal Footer with Quick Actions -->
                <div class="search-modal-footer">
                    <div class="search-tips">
                        <span class="search-tip">
                            <kbd><i class="fas fa-arrow-up"></i></kbd>
                            <kbd><i class="fas fa-arrow-down"></i></kbd>
                            @Localizer["ToNavigate"]
                        </span>
                        <span class="search-tip">
                            <kbd>Enter</kbd>
                            @Localizer["ToSelect"]
                        </span>
                        <span class="search-tip">
                            <kbd>ESC</kbd>
                            @Localizer["ToClose"]
                        </span>
                    </div>
                    <div class="search-powered">
                        <i class="fas fa-magic text-primary me-1"></i>
                        @Localizer["AIPoweredSearch"]
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer mt-auto">
        <div class="container">
            <div class="row gy-4">
                <!-- About Us Section -->
                <div class="col-12 col-lg-6 col-xl-3">
                    <h6 class="fw-bold mb-3">@Localizer["AboutUs"]</h6>
                    <div class="d-flex align-items-center mb-3">
                        @{
                            var hasFooterLogo = !string.IsNullOrEmpty(siteSettings.FooterLogoUrl) || !string.IsNullOrEmpty(siteSettings.DarkModeFooterLogoUrl);
                            var hasMainLogo = !string.IsNullOrEmpty(siteSettings.LogoUrl) || !string.IsNullOrEmpty(siteSettings.DarkModeLogoUrl);
                        }
                        @if (hasFooterLogo || hasMainLogo)
                        {
                            <!-- Light Mode Footer Logo -->
                            @if (!string.IsNullOrEmpty(siteSettings.FooterLogoUrl))
                            {
                                <img src="~/@siteSettings.FooterLogoUrl" alt="@siteSettings.SiteName" style="height: 40px;" class="me-2 logo-light" />
                            }
                            else if (!string.IsNullOrEmpty(siteSettings.LogoUrl))
                            {
                                <img src="~/@siteSettings.LogoUrl" alt="@siteSettings.SiteName" style="height: 40px;" class="me-2 logo-light" />
                            }
                            <!-- Dark Mode Footer Logo -->
                            @if (!string.IsNullOrEmpty(siteSettings.DarkModeFooterLogoUrl))
                            {
                                <img src="~/@siteSettings.DarkModeFooterLogoUrl" alt="@siteSettings.SiteName" style="height: 40px;" class="me-2 logo-dark" />
                            }
                            else if (!string.IsNullOrEmpty(siteSettings.DarkModeLogoUrl))
                            {
                                <img src="~/@siteSettings.DarkModeLogoUrl" alt="@siteSettings.SiteName" style="height: 40px;" class="me-2 logo-dark" />
                            }
                            else if (!string.IsNullOrEmpty(siteSettings.FooterLogoUrl))
                            {
                                <img src="~/@siteSettings.FooterLogoUrl" alt="@siteSettings.SiteName" style="height: 40px;" class="me-2 logo-dark" />
                            }
                            else if (!string.IsNullOrEmpty(siteSettings.LogoUrl))
                            {
                                <img src="~/@siteSettings.LogoUrl" alt="@siteSettings.SiteName" style="height: 40px;" class="me-2 logo-dark" />
                            }
                        }
                        else
                        {
                            <i class="fas fa-store me-2 text-success fs-4"></i>
                        }
                        <h5 class="mb-0 fw-bold">@siteSettings.SiteName</h5>
                    </div>
                    <p class="footer-tagline text-muted small mb-3">
                        @(siteSettings.FooterAboutText ?? siteSettings.SiteTagline)
                    </p>
                    @if (!string.IsNullOrEmpty(siteSettings.ContactEmail) || !string.IsNullOrEmpty(siteSettings.ContactPhone) || !string.IsNullOrEmpty(siteSettings.ContactAddress))
                    {
                        <div class="text-muted small">
                            @if (!string.IsNullOrEmpty(siteSettings.ContactAddress))
                            {
