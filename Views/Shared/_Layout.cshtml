                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="RoleManagement" asp-action="Index">
                                            <i class="fas fa-user-shield me-2 text-success"></i>@Localizer["RoleManagement"]
                                        </a>
