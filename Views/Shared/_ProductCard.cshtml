@model Bangaliyana.Models.Products
@using Microsoft.Extensions.Localization
@inject Bangaliyana.Services.ICompareService CompareService
@inject IStringLocalizer<Bangaliyana.SharedResources> Localizer
@{
    var isFlashSale = ViewData["IsFlashSale"] as bool? ?? false;
    var showQuickView = ViewData["ShowQuickView"] as bool? ?? true;
    var avgRating = Model.Reviews?.Any() == true ? Model.Reviews.Average(r => r.Rating) : 0;
    var reviewCount = Model.Reviews?.Count ?? 0;
    var currencySymbol = ViewData["CurrencySymbol"] as string ?? "৳";
    var wishlistProductIds = ViewData["WishlistProductIds"] as HashSet<int> ?? new HashSet<int>();
    var isInWishlist = wishlistProductIds.Contains(Model.Id);
    var isInCompare = CompareService.IsInCompare(Model.Id);
}

<div class="card h-100 border-0 shadow-sm product-card">
    <div class="position-relative overflow-hidden">
        <a href="@Url.Action("Details", "Home", new { area = "Customer", id = Model.Id })">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="~/@Model.ImageUrl?width=300&quality=80"
                     alt="@Model.Name"
                     class="card-img-top product-img"
                     loading="lazy"
                     decoding="async" />
            }
            else
            {
                <img src="~/images/noimage.jpg"
                     alt="@Model.Name"
                     class="card-img-top product-img"
                     loading="lazy"
                     decoding="async" />
            }
        </a>

        @if (Model.HasDiscount)
        {
            <span class="badge bg-danger position-absolute top-0 start-0 m-2 px-2 py-1">-@Model.DiscountPercentage%</span>
        }

        @if (!Model.IsAvailable || Model.Stock <= 0)
        {
            <div class="position-absolute top-50 start-50 translate-middle">
                <span class="badge bg-dark px-3 py-2">@Localizer["OutOfStock"]</span>
            </div>
        }
        else if (Model.Stock <= 5)
        {
            <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-2 px-2 py-1 small">@Localizer["OnlyXLeft", Model.Stock]</span>
        }

        @if (isFlashSale)
        {
            <span class="badge bg-gradient position-absolute bottom-0 start-0 m-2 px-2 py-1 flash-badge">
                <i class="fas fa-bolt me-1"></i>@Localizer["FlashSale"]
            </span>
        }

        <div class="product-actions position-absolute top-50 end-0 translate-middle-y me-2 d-flex flex-column gap-2">
            @if (showQuickView)
            {
                <button class="btn btn-light btn-sm rounded-circle shadow-sm quick-view-btn" title="@Localizer["QuickView"]" data-product-id="@Model.Id" data-bs-toggle="tooltip">
                    <i class="fas fa-eye"></i>
                </button>
            }
            <button class="btn btn-light btn-sm rounded-circle shadow-sm wishlist-btn @(isInWishlist ? "active" : "")" title="@(isInWishlist ? Localizer["RemoveFromWishlist"].Value : Localizer["AddToWishlist"].Value)" data-product-id="@Model.Id" data-bs-toggle="tooltip">
                <i class="@(isInWishlist ? "fas fa-heart text-danger" : "far fa-heart")"></i>
            </button>
            <button class="btn btn-light btn-sm rounded-circle shadow-sm compare-btn @(isInCompare ? "active" : "")" title="@(isInCompare ? Localizer["RemoveFromCompare"].Value : Localizer["AddToCompare"].Value)" data-product-id="@Model.Id" data-bs-toggle="tooltip">
                <i class="fas fa-balance-scale @(isInCompare ? "text-primary" : "")"></i>
            </button>
            @if (Model.IsAvailable && Model.Stock > 0)
            {
                <button type="button" class="btn btn-light btn-sm rounded-circle shadow-sm add-to-cart-btn"
                        title="@Localizer["AddToCart"]" data-bs-toggle="tooltip" data-product-id="@Model.Id">
                    <i class="fas fa-shopping-cart"></i>
                </button>
            }
        </div>
    </div>

    <div class="card-body d-flex flex-column p-3">
        @if (Model.Category != null)
        {
            <small class="text-success text-uppercase fw-semibold letter-spacing-1 mb-1">@Model.Category.Name</small>
        }

        <h6 class="card-title mb-2 fw-semibold product-title">
            <a href="@Url.Action("Details", "Home", new { area = "Customer", id = Model.Id })" class="text-decoration-none product-title-link">
                @Model.Name
            </a>
        </h6>

        @if (!string.IsNullOrEmpty(Model.ShortDescription))
        {
            <p class="card-text text-muted small mb-2">
                @(Model.ShortDescription.Length > 60 ? Model.ShortDescription.Substring(0, 60) + "..." : Model.ShortDescription)
            </p>
        }

        <div class="mb-2">
            <span class="text-warning small">
                @for (int i = 1; i <= 5; i++)
                {
                    if (i <= avgRating)
                    {
                        <i class="fas fa-star"></i>
                    }
                    else if (i - 0.5 <= avgRating)
                    {
                        <i class="fas fa-star-half-alt"></i>
                    }
                    else
                    {
                        <i class="far fa-star"></i>
                    }
                }
            </span>
            <small class="text-muted ms-1">(@reviewCount)</small>
        </div>

        <div class="mt-auto">
            <div class="mb-1">
                @if (Model.HasDiscount)
                {
                    <span class="text-muted text-decoration-line-through small me-2">@currencySymbol@Model.Price.ToString("N0")</span>
                    <span class="text-danger fw-bold fs-6">@currencySymbol@Model.DiscountPrice?.ToString("N0")</span>
                }
                else
                {
                    <span class="text-danger fw-bold fs-6">@currencySymbol@Model.Price.ToString("N0")</span>
                }
            </div>

            @if (Model.SoldCount > 0)
            {
                <small class="text-muted">@Model.SoldCount @Localizer["Sold"]</small>
            }
        </div>
    </div>
</div>

<style>
    .product-card {
        border-radius: 0.75rem !important;
    }
    .product-img {
        aspect-ratio: 1;
        object-fit: cover;
    }
    .product-actions {
        opacity: 1;
    }
    .product-actions .btn {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .product-title-link {
        color: var(--text-color, #212529);
    }
    [data-theme="dark"] .product-title-link {
        color: #f1f5f9 !important;
    }
    .flash-badge {
        background: linear-gradient(135deg, #ff6b6b, #ee5a24) !important;
    }
    .letter-spacing-1 {
        letter-spacing: 0.5px;
    }
    @@media (max-width: 576px) {
        .product-actions .btn {
            width: 32px;
            height: 32px;
        }
    }
</style>
