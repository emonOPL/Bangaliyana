@model Tuple<int, string>
@{
    var id = Model.Item1;
    var controller = Model.Item2;
}

<div class="modal fade mt-5" id="deleteModal@(id)" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body">
                <h5 class="text-center">Are you sure you want to delete this item?</h5>
                <div class="d-flex gap-5 justify-content-center align-items-center mt-5">
                    <form asp-action="Delete" asp-controller="@controller" asp-route-id="@id" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">Yes</button>
                    </form>
                    @* <button id="deleteConfirmation" type="button" class="btn btn-danger">Yes</button> *@
                    <button type="button" class="btn btn-success" data-bs-dismiss="modal">No</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div>
    <a asp-action="Edit" asp-controller="@controller" class="btn btn-primary my-1 my-lg-0" asp-route-id="@id"><i class="fa-solid fa-pen-to-square"></i></a>
    <a asp-action="Details" asp-controller="@controller" class="btn btn-success my-1 my-lg-0" asp-route-id="@id"><i class="fa-solid fa-file-lines"></i></a>
    <button class="btn btn-danger my-1 my-lg-0" data-bs-toggle="modal" data-bs-target="#deleteModal@(id)">
        <i class="fa-solid fa-trash"></i>
    </button>

    @* <form id="deleteForm" asp-action="Delete" asp-controller="@controller" asp-route-id="@id" method="post" style="display:inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal" onclick="return confirm('Are you sure you want to delete this item?');">
            <i class="fa-solid fa-trash"></i>
        </button> 
    </form> *@
</div>


