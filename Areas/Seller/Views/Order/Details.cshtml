@model Bangaliyana.Models.Order
@using Bangaliyana.Extensions
@{
    ViewData["Title"] = Localizer["OrderDetailsTitle", Model.OrderNumber].Value;
    var sellerTotal = (decimal)ViewBag.SellerTotal;
    var canConfirm = (bool)(ViewBag.CanConfirm ?? false);
    var canProcess = (bool)(ViewBag.CanProcess ?? false);
    var canShip = (bool)(ViewBag.CanShip ?? false);
    var canDeliver = (bool)(ViewBag.CanDeliver ?? false);
    var canCancel = Model.Status <= OrderStatus.Confirmed;

    var statusClass = Model.Status switch
    {
        OrderStatus.Pending => "bg-warning text-dark",
        OrderStatus.Confirmed => "bg-secondary",
        OrderStatus.Processing => "bg-info",
        OrderStatus.Shipped => "bg-primary",
        OrderStatus.Delivered => "bg-success",
        OrderStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };

    var paymentIcon = Model.PaymentMethod == PaymentMethod.CashOnDelivery ? "fa-money-bill-wave" : "fa-credit-card";
    var paymentClass = Model.PaymentMethod == PaymentMethod.CashOnDelivery ? "text-warning" : "text-success";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="fas fa-receipt text-primary me-2"></i>@Localizer["OrderDetailsTitle", Model.OrderNumber]</h1>
            <p class="text-muted mb-0">@Localizer["PlacedOn"] @Model.OrderDate.ToBangladeshString()</p>
        </div>
        <div>
            @{
                // Check if shipping slip can be printed
                bool canPrintSlip = false;
                if (Model.PaymentMethod == PaymentMethod.CashOnDelivery)
                {
                    canPrintSlip = Model.Status == OrderStatus.Confirmed ||
                                   Model.Status == OrderStatus.Paid ||
                                   Model.Status == OrderStatus.Shipped ||
                                   Model.Status == OrderStatus.Delivered;
                }
                else
                {
                    canPrintSlip = (Model.Status == OrderStatus.Paid ||
                                    Model.Status == OrderStatus.Shipped ||
                                    Model.Status == OrderStatus.Delivered) ||
                                   (Model.Status == OrderStatus.Confirmed && Model.PaymentStatus == PaymentStatus.Completed);
                }
            }
            @if (canPrintSlip)
            {
                <a asp-action="PrintShippingSlip" asp-route-id="@Model.Id" class="btn btn-success me-2" target="_blank">
                    <i class="fas fa-print me-1"></i>@Localizer["PrintShippingSlip"]
                </a>
            }
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>@Localizer["BackToOrders"]
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            <!-- Order Status & Actions -->
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>@Localizer["OrderStatus"]</h5>
                    <span class="badge @statusClass fs-6">@Model.Status.GetDisplayName()</span>
                </div>
                <div class="card-body">
                    <!-- Progress Bar -->
                    <div class="order-progress mb-4">
                        @{
                            var steps = new[] { OrderStatus.Pending, OrderStatus.Confirmed, OrderStatus.Processing, OrderStatus.Shipped, OrderStatus.Delivered };
                            var currentStep = Array.IndexOf(steps, Model.Status);
                            if (currentStep < 0) currentStep = 0;
                            var progressPercent = (currentStep + 1) * 20;
                        }
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-success" style="width: @progressPercent%"></div>
                        </div>
                        <div class="d-flex justify-content-between mt-2">
                            @foreach (var step in steps)
                            {
                                var isActive = Array.IndexOf(steps, Model.Status) >= Array.IndexOf(steps, step);
                                <small class="@(isActive ? "text-success fw-semibold" : "text-muted")" style="font-size: 0.7rem;">@step</small>
                            }
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    @if (Model.Status != OrderStatus.Delivered && Model.Status != OrderStatus.Cancelled)
                    {
                        <div class="d-flex gap-2 flex-wrap">
                            @if (canConfirm)
                            {
                                <form asp-action="Confirm" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <button type="submit" class="btn btn-success">
                                        <i class="fas fa-check me-1"></i>@Localizer["ConfirmOrder"]
                                    </button>
                                </form>
                            }
                            @if (canProcess)
                            {
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <input type="hidden" name="status" value="@OrderStatus.Processing" />
                                    <button type="submit" class="btn btn-info">
                                        <i class="fas fa-cog me-1"></i>@Localizer["StartProcessing"]
                                    </button>
                                </form>
                            }
                            @if (canShip)
                            {
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <input type="hidden" name="status" value="@OrderStatus.Shipped" />
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-shipping-fast me-1"></i>@Localizer["MarkAsShipped"]
                                    </button>
                                </form>
                            }
                            @if (canDeliver)
                            {
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <input type="hidden" name="status" value="@OrderStatus.Delivered" />
                                    <button type="submit" class="btn btn-success">
                                        <i class="fas fa-check-double me-1"></i>@Localizer["MarkAsDelivered"]
                                    </button>
                                </form>
                            }
                            @if (canCancel)
                            {
                                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelModal">
                                    <i class="fas fa-times me-1"></i>@Localizer["CancelOrder"]
                                </button>
                            }
                        </div>
                    }

                    @if (Model.Status == OrderStatus.Pending && Model.PaymentMethod != PaymentMethod.CashOnDelivery)
                    {
                        <div class="alert alert-info mt-3 mb-0">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>@Localizer["WaitingForAdminConfirmation"]:</strong> @Localizer["OnlinePaymentNeedsAdminConfirmation"]
                        </div>
                    }
                </div>
            </div>

            <!-- Order Items -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-box me-2"></i>@Localizer["OrderItems"]</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 80px;">@Localizer["Image"]</th>
                                    <th>@Localizer["Product"]</th>
                                    <th class="text-center">@Localizer["Qty"]</th>
                                    <th class="text-end">@Localizer["UnitPrice"]</th>
                                    <th class="text-end">@Localizer["Total"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderItems)
                                {
                                    <tr>
                                        <td>
                                            <img src="~/@(item.Product?.ImageUrl ?? "images/products/noimage.jpg")"
                                                 alt="@item.Product?.Name"
                                                 class="rounded" style="width: 60px; height: 60px; object-fit: cover;" />
                                        </td>
                                        <td>
                                            <strong>@item.Product?.Name</strong>
                                            @if (!string.IsNullOrEmpty(item.VariantInfo))
                                            {
                                                <br /><small class="text-info"><i class="fas fa-tag me-1"></i>@item.VariantInfo</small>
                                            }
                                            @if (!string.IsNullOrEmpty(item.Product?.SKU))
                                            {
                                                <br /><small class="text-muted">@Localizer["SKU"]: @item.Product.SKU</small>
                                            }
                                        </td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end">৳@((int)Math.Round(item.UnitPrice))</td>
                                        <td class="text-end fw-semibold">৳@((int)Math.Round(item.TotalPrice))</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="4" class="text-end fw-semibold">@Localizer["Subtotal"]:</td>
                                    <td class="text-end fw-bold text-success fs-5">৳@((int)Math.Round(sellerTotal))</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Payment Info -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-credit-card me-2"></i>@Localizer["Payment"]</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="me-3">
                            <span class="@paymentClass fs-3">
                                <i class="fas @paymentIcon"></i>
                            </span>
                        </div>
                        <div>
                            <strong>@(Model.PaymentMethod == PaymentMethod.CashOnDelivery ? Localizer["CashOnDelivery"].Value : Localizer["OnlinePayment"].Value)</strong>
                            <br />
                            <small class="text-muted">
                                @if (Model.PaymentMethod == PaymentMethod.CashOnDelivery)
                                {
                                    @Localizer["CollectOnDelivery", (int)Math.Round(Model.TotalAmount)]
                                }
                                else
                                {
                                    @Localizer["PaymentReceived"]
                                }
                            </small>
                        </div>
                    </div>
                    <hr />
                    <div class="small">
                        <div class="d-flex justify-content-between mb-1">
                            <span>@Localizer["Subtotal"]:</span>
                            <span>৳@((int)Math.Round(Model.SubTotal))</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>@Localizer["Delivery"]:</span>
                            <span>৳@((int)Math.Round(Model.DeliveryCharge))</span>
                        </div>
                        @if (Model.DiscountAmount > 0)
                        {
                            <div class="d-flex justify-content-between mb-1 text-success">
                                <span>@Localizer["CouponDiscount"]:</span>
                                <span>-৳@((int)Math.Round(Model.DiscountAmount))</span>
                            </div>
                        }
                        @if (Model.RewardDiscountAmount > 0)
                        {
                            <div class="d-flex justify-content-between mb-1 text-success">
                                <span>@Localizer["RewardDiscount"]:</span>
                                <span>-৳@((int)Math.Round(Model.RewardDiscountAmount))</span>
                            </div>
                        }
                        @if (Model.PremiumDiscountAmount > 0)
                        {
                            <div class="d-flex justify-content-between mb-1 text-success">
                                <span>@Localizer["PremiumDiscount"]:</span>
                                <span>-৳@((int)Math.Round(Model.PremiumDiscountAmount))</span>
                            </div>
                        }
                        <hr />
                        <div class="d-flex justify-content-between fw-bold">
                            <span>@Localizer["Total"]:</span>
                            <span>৳@((int)Math.Round(Model.TotalAmount))</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Customer Info -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-user me-2"></i>@Localizer["Customer"]</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        @if (!string.IsNullOrEmpty(Model.User?.AvatarUrl))
                        {
                            <img src="@Model.User.AvatarUrl" alt="@Model.User.FullName"
                                 class="rounded-circle me-3" style="width: 50px; height: 50px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center me-3"
                                 style="width: 50px; height: 50px;">
                                <i class="fas fa-user text-white"></i>
                            </div>
                        }
                        <div>
                            <strong>@Model.User?.FullName</strong>
                            <br /><small class="text-muted">@Model.User?.Email</small>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.User?.PhoneNumber))
                    {
                        <div class="mb-2">
                            <i class="fas fa-phone text-muted me-2"></i>@Model.User.PhoneNumber
                        </div>
                    }
                </div>
            </div>

            <!-- Shipping Address -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-map-marker-alt me-2"></i>@Localizer["ShippingAddress"]</h5>
                </div>
                <div class="card-body">
                    <address class="mb-0">
                        <strong>@Model.CustomerName</strong><br />
                        @Model.Address<br />
                        @if (!string.IsNullOrEmpty(Model.City))
                        {
                            @Model.City@(string.IsNullOrEmpty(Model.PostalCode) ? "" : ", " + Model.PostalCode)<br />
                        }
                        @if (Model.District != null)
                        {
                            @Model.District.Name@(Model.Division != null ? ", " + Model.Division.Name : "")<br />
                        }
                        <i class="fas fa-phone text-muted me-1"></i>@Model.Phone
                    </address>
                </div>
            </div>

            <!-- Order Timeline -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-history me-2"></i>@Localizer["Timeline"]</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-3">
                            <div class="d-flex">
                                <div class="me-3">
                                    <span class="badge bg-success rounded-circle" style="width: 24px; height: 24px; line-height: 16px;">
                                        <i class="fas fa-check" style="font-size: 10px;"></i>
                                    </span>
                                </div>
                                <div>
                                    <strong>@Localizer["OrderPlaced"]</strong>
                                    <br /><small class="text-muted">@Model.OrderDate.ToString("MMM dd, yyyy 'at' hh:mm tt")</small>
                                </div>
                            </div>
                        </li>
                        @if (Model.Status >= OrderStatus.Confirmed)
                        {
                            <li class="mb-3">
                                <div class="d-flex">
                                    <div class="me-3">
                                        <span class="badge bg-secondary rounded-circle" style="width: 24px; height: 24px; line-height: 16px;">
                                            <i class="fas fa-check" style="font-size: 10px;"></i>
                                        </span>
                                    </div>
                                    <div>
                                        <strong>@Localizer["Confirmed"]</strong>
                                        <br /><small class="text-muted">@Localizer["OrderConfirmed"]</small>
                                    </div>
                                </div>
                            </li>
                        }
                        @if (Model.Status >= OrderStatus.Processing)
                        {
                            <li class="mb-3">
                                <div class="d-flex">
                                    <div class="me-3">
                                        <span class="badge bg-info rounded-circle" style="width: 24px; height: 24px; line-height: 16px;">
                                            <i class="fas fa-cog" style="font-size: 10px;"></i>
                                        </span>
                                    </div>
                                    <div>
                                        <strong>@Localizer["Processing"]</strong>
                                        <br /><small class="text-muted">@Localizer["OrderBeingPrepared"]</small>
                                    </div>
                                </div>
                            </li>
                        }
                        @if (Model.Status >= OrderStatus.Shipped && Model.ShippedAt.HasValue)
                        {
                            <li class="mb-3">
                                <div class="d-flex">
                                    <div class="me-3">
                                        <span class="badge bg-primary rounded-circle" style="width: 24px; height: 24px; line-height: 16px;">
                                            <i class="fas fa-shipping-fast" style="font-size: 10px;"></i>
                                        </span>
                                    </div>
                                    <div>
                                        <strong>@Localizer["Shipped"]</strong>
                                        <br /><small class="text-muted">@Model.ShippedAt?.ToString("MMM dd, yyyy 'at' hh:mm tt")</small>
                                    </div>
                                </div>
                            </li>
                        }
                        @if (Model.Status == OrderStatus.Delivered && Model.DeliveredAt.HasValue)
                        {
                            <li>
                                <div class="d-flex">
                                    <div class="me-3">
                                        <span class="badge bg-success rounded-circle" style="width: 24px; height: 24px; line-height: 16px;">
                                            <i class="fas fa-check-double" style="font-size: 10px;"></i>
                                        </span>
                                    </div>
                                    <div>
                                        <strong>@Localizer["Delivered"]</strong>
                                        <br /><small class="text-muted">@Model.DeliveredAt?.ToString("MMM dd, yyyy 'at' hh:mm tt")</small>
                                    </div>
                                </div>
                            </li>
                        }
                        @if (Model.Status == OrderStatus.Cancelled)
                        {
                            <li>
                                <div class="d-flex">
                                    <div class="me-3">
                                        <span class="badge bg-danger rounded-circle" style="width: 24px; height: 24px; line-height: 16px;">
                                            <i class="fas fa-times" style="font-size: 10px;"></i>
                                        </span>
                                    </div>
                                    <div>
                                        <strong>@Localizer["Cancelled"]</strong>
                                        <br /><small class="text-muted">@Model.CancelledAt?.ToString("MMM dd, yyyy 'at' hh:mm tt")</small>
                                        @if (!string.IsNullOrEmpty(Model.CancellationReason))
                                        {
                                            <br /><small class="text-danger">@Localizer["Reason"]: @Model.CancellationReason.FormatAsDisplayName()</small>
                                        }
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Cancel Order Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Cancel" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-times-circle text-danger me-2"></i>@Localizer["CancelOrder"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>@Localizer["ConfirmCancelOrder"]</p>
                    <div class="mb-3">
                        <label class="form-label">@Localizer["ReasonForCancellation"]:</label>
                        <textarea name="reason" class="form-control" rows="3" placeholder="@Localizer["EnterReasonOptional"]"></textarea>
                    </div>
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        @Localizer["CancelWarning"]
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Close"]</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-times me-1"></i>@Localizer["CancelOrder"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    [data-theme="dark"] .card {
        background-color: #1f2937;
        border-color: #374151;
    }

    [data-theme="dark"] .card-header {
        background-color: #111827;
        border-color: #374151;
        color: #f3f4f6;
    }

    [data-theme="dark"] .table {
        color: #e5e7eb;
    }

    [data-theme="dark"] .table-light {
        background-color: #374151;
        color: #f3f4f6;
    }

    [data-theme="dark"] .progress {
        background-color: #374151;
    }

    [data-theme="dark"] .modal-content {
        background-color: #1f2937;
        color: #f3f4f6;
    }

    [data-theme="dark"] .modal-header {
        border-color: #374151;
    }

    [data-theme="dark"] .modal-footer {
        border-color: #374151;
    }

    [data-theme="dark"] .form-control {
        background-color: #374151;
        border-color: #4b5563;
        color: #f3f4f6;
    }

    /* Dark mode badge visibility fixes */
    [data-theme="dark"] .badge.bg-warning {
        color: #1f2937 !important;
    }

    [data-theme="dark"] .badge.bg-info {
        background-color: #0891b2 !important;
        color: #ffffff !important;
    }

    [data-theme="dark"] .badge.bg-primary {
        background-color: #4f46e5 !important;
        color: #ffffff !important;
    }

    [data-theme="dark"] .badge.bg-success {
        background-color: #059669 !important;
        color: #ffffff !important;
    }

    [data-theme="dark"] .badge.bg-danger {
        background-color: #dc2626 !important;
        color: #ffffff !important;
    }

    [data-theme="dark"] .badge.bg-secondary {
        background-color: #4b5563 !important;
        color: #f3f4f6 !important;
    }
</style>
