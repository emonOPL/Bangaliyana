@model Bangaliyana.Models.Order
@using Bangaliyana.Extensions
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer
@{
    Layout = null;
    var siteSettings = ViewBag.SiteSettings as Bangaliyana.Models.SiteSettings;
    var siteName = siteSettings?.SiteName ?? "Bangaliyana";
    var sitePhone = siteSettings?.ContactPhone ?? "";
    var siteEmail = siteSettings?.ContactEmail ?? "";
    var currencySymbol = siteSettings?.CurrencySymbol ?? "৳";
    var seller = ViewBag.Seller as Bangaliyana.Models.Seller;
    var sellerOrderItems = ViewBag.SellerOrderItems as List<Bangaliyana.Models.OrderItem> ?? Model.OrderItems.ToList();
    var sellerSubtotal = sellerOrderItems.Sum(i => i.TotalPrice);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Localizer["ShippingSlipTitle", Model.Id]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
    <style>
        * {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 12pt;
            line-height: 1.4;
            color: #333;
            background: #fff;
        }

        .shipping-slip {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }

        .slip-header {
            border-bottom: 3px solid #0d6efd;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }

        .company-name {
            font-size: 24pt;
            font-weight: bold;
            color: #0d6efd;
        }

        .slip-title {
            font-size: 18pt;
            font-weight: bold;
            text-align: center;
            background: #0d6efd;
            color: white;
            padding: 10px;
            margin: 20px 0;
            border-radius: 5px;
        }

        .info-section {
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 15px;
            background: #f8f9fa;
        }

        .info-section h5 {
            color: #0d6efd;
            border-bottom: 2px solid #0d6efd;
            padding-bottom: 8px;
            margin-bottom: 12px;
            font-size: 14pt;
        }

        .info-row {
            display: flex;
            margin-bottom: 5px;
        }

        .info-label {
            font-weight: 600;
            width: 140px;
            color: #555;
        }

        .info-value {
            flex: 1;
        }

        .address-box {
            background: #fff;
            border: 2px solid #0d6efd;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 15px;
        }

        .address-box h5 {
            color: #0d6efd;
            margin-bottom: 10px;
            font-size: 14pt;
        }

        .address-box .name {
            font-size: 14pt;
            font-weight: bold;
            color: #333;
        }

        .address-box .phone {
            font-size: 14pt;
            font-weight: bold;
            color: #0d6efd;
        }

        .items-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
        }

        .items-table th {
            background: #0d6efd;
            color: white;
            padding: 10px;
            text-align: left;
            font-size: 11pt;
        }

        .items-table td {
            padding: 10px;
            border-bottom: 1px solid #ddd;
            font-size: 11pt;
        }

        .items-table tbody tr:last-child td {
            border-bottom: none;
        }

        .items-table tr:nth-child(even) {
            background: #f8f9fa;
        }

        .variant-info {
            font-size: 10pt;
            color: #666;
        }

        .totals-section {
            background: #f8f9fa;
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 15px;
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            padding: 5px 0;
            border-bottom: 1px solid #eee;
        }

        .total-row:last-child {
            border-bottom: none;
        }

        .total-row.grand-total {
            font-size: 14pt;
            font-weight: bold;
            color: #0d6efd;
            border-top: 2px solid #0d6efd;
            margin-top: 10px;
            padding-top: 10px;
        }

        .cod-badge {
            background: #dc3545;
            color: white;
            padding: 8px 15px;
            border-radius: 5px;
            font-weight: bold;
            font-size: 12pt;
            display: inline-block;
        }

        .paid-badge {
            background: #198754;
            color: white;
            padding: 8px 15px;
            border-radius: 5px;
            font-weight: bold;
            font-size: 12pt;
            display: inline-block;
        }

        .barcode-section {
            text-align: center;
            margin: 20px 0;
            padding: 15px 20px;
            background: #fff;
            border: 1px solid #ddd;
            border-radius: 8px;
        }

        .barcode-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .barcode-wrapper {
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .barcode-wrapper svg {
            height: 100px;
        }

        .qr-wrapper {
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .qr-wrapper img {
            width: 100px;
            height: 100px;
        }

        .order-id-display {
            margin-top: 15px;
            padding: 10px 25px;
            background: #0d6efd;
            color: white;
            font-size: 16pt;
            font-weight: bold;
            letter-spacing: 4px;
            border-radius: 25px;
            display: inline-block;
            box-shadow: 0 3px 10px rgba(13, 110, 253, 0.3);
        }

        .tracking-info {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 12px;
            font-size: 10pt;
            color: #666;
        }

        .tracking-info span {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .order-id-large {
            font-size: 24pt;
            font-weight: bold;
            letter-spacing: 3px;
            color: #333;
        }

        .print-btn {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1000;
        }

        .footer-note {
            text-align: center;
            font-size: 10pt;
            color: #666;
            margin-top: 20px;
            padding-top: 15px;
            border-top: 1px solid #ddd;
        }

        .seller-badge {
            background: #0d6efd;
            color: white;
            padding: 3px 10px;
            border-radius: 3px;
            font-size: 10pt;
        }

        @@media print {
            .print-btn {
                display: none !important;
            }

            body {
                padding: 0;
                margin: 0;
            }

            .shipping-slip {
                padding: 10px;
                max-width: 100%;
            }

            .info-section,
            .address-box,
            .totals-section,
            .barcode-section {
                break-inside: avoid;
            }
        }
    </style>
</head>
<body>
    <button class="btn btn-primary print-btn" onclick="window.print()">
        <i class="fas fa-print me-2"></i>@Localizer["PrintShippingSlip"]
    </button>

    <div class="shipping-slip">
        <!-- Header -->
        <div class="slip-header">
            <div class="row align-items-center">
                <div class="col-8">
                    @if (seller != null)
                    {
                        <div class="company-name">@seller.ShopName</div>
                        @if (seller.User != null && !string.IsNullOrEmpty(seller.User.PhoneNumber))
                        {
                            <div><i class="fas fa-phone me-2"></i>@seller.User.PhoneNumber</div>
                        }
                        @if (!string.IsNullOrEmpty(seller.BusinessAddress))
                        {
                            <div><i class="fas fa-map-marker-alt me-2"></i>@seller.BusinessAddress</div>
                        }
                    }
                    else
                    {
                        <div class="company-name">@siteName</div>
                        @if (!string.IsNullOrEmpty(sitePhone))
                        {
                            <div><i class="fas fa-phone me-2"></i>@sitePhone</div>
                        }
                    }
                    <div class="mt-2"><span class="seller-badge"><i class="fas fa-store me-1"></i>@Localizer["SellerCopy"]</span></div>
                </div>
                <div class="col-4 text-end">
                    <div class="order-id-large">#@Model.Id</div>
                    <div class="text-muted">@Model.OrderDate.ToBangladeshShortDateString()</div>
                    @if (Model.PaymentMethod == Bangaliyana.Models.PaymentMethod.CashOnDelivery)
                    {
                        <div class="cod-badge mt-2">
                            <i class="fas fa-money-bill-wave me-1"></i>@Localizer["COD"]
                        </div>
                    }
                    else
                    {
                        <div class="paid-badge mt-2">
                            <i class="fas fa-check-circle me-1"></i>@Localizer["PAID"]
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="slip-title">
            <i class="fas fa-truck me-2"></i>@Localizer["ShippingSlipDeliveryDetails"]
        </div>

        <div class="row">
            <!-- Customer/Buyer Info -->
            <div class="col-6">
                <div class="address-box">
                    <h5><i class="fas fa-user me-2"></i>@Localizer["ShipToCustomer"]</h5>
                    <div class="name">@Model.CustomerName</div>
                    <div class="phone"><i class="fas fa-phone me-1"></i>@Model.Phone</div>
                    @if (!string.IsNullOrEmpty(Model.Email))
                    {
                        <div><i class="fas fa-envelope me-1"></i>@Model.Email</div>
                    }
                    <hr />
                    <div><strong>@Localizer["Address"]:</strong></div>
                    <div>@Model.Address</div>
                    @if (Model.Upazila != null)
                    {
                        <div>@Model.Upazila.Name, @Model.District?.Name</div>
                    }
                    @if (Model.Division != null)
                    {
                        <div>@Model.Division.Name</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.PostalCode))
                    {
                        <div>@Localizer["PostalCode"]: @Model.PostalCode</div>
                    }
                </div>
            </div>

            <!-- Seller Info -->
            <div class="col-6">
                <div class="address-box">
                    <h5><i class="fas fa-store me-2"></i>@Localizer["ShipFromSeller"]</h5>
                    @if (seller != null)
                    {
                        <div class="name">@seller.ShopName</div>
                        @if (seller.User != null)
                        {
                            <div><i class="fas fa-user me-1"></i>@seller.User.FullName</div>
                            <div><i class="fas fa-phone me-1"></i>@seller.User.PhoneNumber</div>
                        }
                        @if (!string.IsNullOrEmpty(seller.BusinessAddress))
                        {
                            <div><i class="fas fa-map-marker-alt me-1"></i>@seller.BusinessAddress</div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Order Items (Seller's products only) -->
        <div class="info-section">
            <h5><i class="fas fa-box me-2"></i>@Localizer["YourItemsCount", sellerOrderItems.Count]</h5>
            <table class="items-table">
                <thead>
                    <tr>
                        <th style="width: 50%;">@Localizer["Product"]</th>
                        <th class="text-center">@Localizer["Qty"]</th>
                        <th class="text-end">@Localizer["UnitPrice"]</th>
                        <th class="text-end">@Localizer["Total"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in sellerOrderItems)
                    {
                        <tr>
                            <td>
                                <strong>@item.ProductName</strong>
                                @if (!string.IsNullOrEmpty(item.VariantInfo))
                                {
                                    <div class="variant-info"><i class="fas fa-tag me-1"></i>@item.VariantInfo</div>
                                }
                                @if (!string.IsNullOrEmpty(item.SKU))
                                {
                                    <div class="variant-info">@Localizer["SKU"]: @item.SKU</div>
                                }
                            </td>
                            <td class="text-center"><strong>@item.Quantity</strong></td>
                            <td class="text-end">@currencySymbol@item.UnitPrice.ToString("N0")</td>
                            <td class="text-end"><strong>@currencySymbol@item.TotalPrice.ToString("N0")</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="row">
            <!-- Order Info -->
            <div class="col-6">
                <div class="info-section">
                    <h5><i class="fas fa-info-circle me-2"></i>@Localizer["OrderInfo"]</h5>
                    <div class="info-row">
                        <span class="info-label">@Localizer["OrderID"]:</span>
                        <span class="info-value"><strong>#@Model.Id</strong></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">@Localizer["OrderDate"]:</span>
                        <span class="info-value">@Model.OrderDate.ToBangladeshString("dd MMM, yyyy hh:mm tt")</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">@Localizer["Status"]:</span>
                        <span class="info-value"><span class="badge bg-success">@Model.Status.GetDisplayName()</span></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">@Localizer["Payment"]:</span>
                        <span class="info-value">@Model.PaymentMethod.GetDisplayName()</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="info-row">
                            <span class="info-label">@Localizer["Instructions"]:</span>
                            <span class="info-value">@Model.Notes</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Seller Items Summary -->
            <div class="col-6">
                <div class="totals-section">
                    <h5 style="color: #0d6efd; margin-bottom: 10px;"><i class="fas fa-receipt me-2"></i>@Localizer["YourItemsTotal"]</h5>
                    <div class="total-row">
                        <span>@Localizer["ItemsCount"]:</span>
                        <span>@sellerOrderItems.Count</span>
                    </div>
                    <div class="total-row">
                        <span>@Localizer["TotalQuantity"]:</span>
                        <span>@sellerOrderItems.Sum(i => i.Quantity)</span>
                    </div>
                    <div class="total-row grand-total">
                        <span>@Localizer["Subtotal"]:</span>
                        <span>@currencySymbol@sellerSubtotal.ToString("N0")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Barcode/Order ID Section -->
        <div class="barcode-section">
            <div class="barcode-container">
                <!-- Barcode -->
                <div class="barcode-wrapper">
                    <svg id="barcode"></svg>
                </div>
                <!-- QR Code -->
                <div class="qr-wrapper">
                    @{
                        // Create detailed order info for QR code
                        var orderDetails = new System.Text.StringBuilder();
                        orderDetails.AppendLine($"ORDER #{Model.Id}");
                        orderDetails.AppendLine($"Date: {Model.OrderDate:dd MMM yyyy}");
                        orderDetails.AppendLine($"Customer: {Model.CustomerName}");
                        orderDetails.AppendLine($"Phone: {Model.Phone}");
                        orderDetails.AppendLine($"Address: {Model.Address}");
                        if (Model.Upazila != null)
                        {
                            orderDetails.AppendLine($"Area: {Model.Upazila.Name}, {Model.District?.Name}");
                        }
                        if (Model.Division != null)
                        {
                            orderDetails.AppendLine($"Division: {Model.Division.Name}");
                        }
                        orderDetails.AppendLine($"Items: {sellerOrderItems.Count}");
                        orderDetails.AppendLine($"Total: {currencySymbol}{Model.TotalAmount:N0}");
                        orderDetails.AppendLine($"Payment: {Model.PaymentMethod.GetDisplayName()}");
                        if (Model.PaymentMethod == Bangaliyana.Models.PaymentMethod.CashOnDelivery)
                        {
                            orderDetails.AppendLine($"COD Amount: {currencySymbol}{Model.TotalAmount:N0}");
                        }
                        orderDetails.AppendLine($"Status: {Model.Status.GetDisplayName()}");
                        var qrData = orderDetails.ToString();
                        var qrUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=100x100&data={Uri.EscapeDataString(qrData)}";
                    }
                    <img src="@qrUrl" alt="QR Code" />
                </div>
            </div>
            <div class="order-id-display">
                <i class="fas fa-box me-2"></i>@Localizer["OrderNumber"] #@Model.Id
            </div>
            <div class="tracking-info">
                <span><i class="fas fa-calendar-alt"></i> @Model.OrderDate.ToBangladeshShortDateString()</span>
                <span><i class="fas fa-truck"></i> @Model.Status.GetDisplayName()</span>
                <span><i class="fas fa-credit-card"></i> @Model.PaymentMethod.GetDisplayName()</span>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer-note">
            @if (seller != null)
            {
                <p><strong>@seller.ShopName</strong> - @Localizer["ThankYouForYourBusiness"]</p>
            }
            <p>@Localizer["PrintedOn"]: @DateTimeExtensions.GetBangladeshNowString()</p>
        </div>
    </div>

    <script>
        // Generate Barcode
        document.addEventListener('DOMContentLoaded', function() {
            var orderId = '@Model.Id.ToString().PadLeft(8, '0')';
            JsBarcode("#barcode", orderId, {
                format: "CODE128",
                width: 2,
                height: 70,
                displayValue: true,
                fontSize: 12,
                fontOptions: "bold",
                textMargin: 3,
                margin: 5,
                background: "#ffffff"
            });
        });
    </script>
</body>
</html>
