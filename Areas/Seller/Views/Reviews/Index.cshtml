@using Bangaliyana.Models
@model IEnumerable<ProductReview>
@{
    ViewData["Title"] = "My Reviews";
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var totalReviews = ViewBag.TotalReviews as int? ?? 0;
    var search = ViewBag.Search as string;
    var rating = ViewBag.Rating as int?;
    var avgRating = ViewBag.AverageRating as double? ?? 0;
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="h3 mb-1"><i class="fas fa-star text-warning me-2"></i>My Product Reviews</h1>
            <p class="text-muted mb-0">View and respond to customer reviews</p>
        </div>
        <div class="d-flex gap-3 align-items-center">
            <div class="text-center">
                <div class="d-flex align-items-center gap-1">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Math.Round(avgRating))
                        {
                            <i class="fas fa-star text-warning"></i>
                        }
                        else if (i - 0.5 <= avgRating)
                        {
                            <i class="fas fa-star-half-alt text-warning"></i>
                        }
                        else
                        {
                            <i class="far fa-star text-muted"></i>
                        }
                    }
                    <span class="fw-semibold ms-1">@avgRating.ToString("F1")</span>
                </div>
                <small class="text-muted">Average Rating</small>
            </div>
            <span class="badge bg-primary fs-6 d-flex align-items-center" style="height: 38px;">
                <i class="fas fa-star me-1"></i>@totalReviews Reviews
            </span>
        </div>
    </div>

    @if (TempData["onSave"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["onSave"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["onEdit"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show">
            <i class="fas fa-info-circle me-2"></i>@TempData["onEdit"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["onDelete"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["onDelete"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filters Card -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label small text-muted mb-1">Search</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" name="search" value="@search" class="form-control" placeholder="Product, customer, or comment..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Rating</label>
                    <select name="rating" class="form-select">
                        <option value="">All Ratings</option>
                        @for (int i = 5; i >= 1; i--)
                        {
                            <option value="@i" selected="@(rating == i)">@i Star@(i > 1 ? "s" : "")</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1">
                            <i class="fas fa-filter me-1"></i>Filter
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-times"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Reviews Table Card -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 60px;">Product</th>
                                <th>Review</th>
                                <th>Customer</th>
                                <th class="text-center">Rating</th>
                                <th class="text-center">Reply</th>
                                <th>Date</th>
                                <th style="width: 80px;" class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var review in Model)
                            {
                                var productImage = review.Product?.ImageUrl ?? "images/products/noimage.jpg";
                                <tr>
                                    <td>
                                        <img src="~/@productImage" alt="Product"
                                             class="rounded shadow-sm" style="width: 50px; height: 50px; object-fit: cover;" />
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@review.Id" class="fw-semibold text-decoration-none review-link">
                                            @if (!string.IsNullOrEmpty(review.Title))
                                            {
                                                @(review.Title.Length > 30 ? review.Title.Substring(0, 30) + "..." : review.Title)
                                            }
                                            else if (!string.IsNullOrEmpty(review.Comment))
                                            {
                                                @(review.Comment.Length > 30 ? review.Comment.Substring(0, 30) + "..." : review.Comment)
                                            }
                                            else
                                            {
                                                <span class="text-muted">No comment</span>
                                            }
                                        </a>
                                        <br />
                                        <small class="text-muted">
                                            <i class="fas fa-box me-1"></i>@(review.Product?.Name?.Length > 25 ? review.Product.Name.Substring(0, 25) + "..." : review.Product?.Name ?? "Unknown")
                                        </small>
                                    </td>
                                    <td>
                                        <span class="fw-medium">@(review.User?.FullName ?? "Unknown")</span>
                                        @if (review.IsVerifiedPurchase)
                                        {
                                            <br /><span class="badge bg-info text-white"><i class="fas fa-check-circle me-1"></i>Verified</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-1">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= review.Rating)
                                                {
                                                    <i class="fas fa-star text-warning"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star text-muted"></i>
                                                }
                                            }
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        @if (review.Reply != null)
                                        {
                                            <span class="badge bg-success"><i class="fas fa-check me-1"></i>Replied</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>Pending</span>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            @review.CreatedAt.ToString("MMM dd, yyyy")
                                            <br />@review.CreatedAt.ToString("hh:mm tt")
                                        </small>
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@review.Id" class="btn btn-outline-primary btn-sm" title="View & Reply">
                                            <i class="fas fa-reply"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <nav class="p-3 border-top">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)"
                                   asp-route-search="@search" asp-route-rating="@rating">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                            @{
                                var startPage = Math.Max(1, currentPage - 2);
                                var endPage = Math.Min(totalPages, startPage + 4);
                                if (endPage - startPage < 4)
                                {
                                    startPage = Math.Max(1, endPage - 4);
                                }
                            }
                            @if (startPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" asp-route-page="1"
                                       asp-route-search="@search" asp-route-rating="@rating">1</a>
                                </li>
                                @if (startPage > 2)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                            }
                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i"
                                       asp-route-search="@search" asp-route-rating="@rating">@i</a>
                                </li>
                            }
                            @if (endPage < totalPages)
                            {
                                @if (endPage < totalPages - 1)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" asp-route-page="@totalPages"
                                       asp-route-search="@search" asp-route-rating="@rating">@totalPages</a>
                                </li>
                            }
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)"
                                   asp-route-search="@search" asp-route-rating="@rating">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                        <div class="text-center text-muted small mt-2">
                            Showing @((currentPage - 1) * 15 + 1) - @(Math.Min(currentPage * 15, totalReviews)) of @totalReviews reviews
                        </div>
                    </nav>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-star fa-4x text-muted mb-3"></i>
                    <h5 class="text-muted">No reviews found</h5>
                    <p class="text-muted">
                        @if (!string.IsNullOrEmpty(search) || rating.HasValue)
                        {
                            <text>Try adjusting your filters or search criteria</text>
                        }
                        else
                        {
                            <text>You haven't received any product reviews yet. Once customers review your products, they will appear here.</text>
                        }
                    </p>
                    @if (!string.IsNullOrEmpty(search) || rating.HasValue)
                    {
                        <a asp-action="Index" class="btn btn-outline-primary">
                            <i class="fas fa-times me-1"></i>Clear Filters
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Styles {
    <style>
        .review-link {
            color: var(--bs-body-color);
            transition: color 0.2s;
        }
        .review-link:hover {
            color: var(--bs-primary);
        }

        .table > tbody > tr:hover {
            background-color: rgba(var(--bs-primary-rgb), 0.05);
        }

        /* Dark mode styles */
        [data-theme="dark"] .card {
            background-color: var(--bs-dark);
            border-color: var(--bs-gray-700);
        }

        [data-theme="dark"] .table {
            color: var(--bs-light);
        }

        [data-theme="dark"] .table-light {
            background-color: #374151 !important;
            color: #f3f4f6 !important;
        }

        [data-theme="dark"] .table-light th {
            background-color: #374151 !important;
            color: #f3f4f6 !important;
        }

        [data-theme="dark"] .form-control,
        [data-theme="dark"] .form-select {
            background-color: var(--bs-gray-800);
            border-color: var(--bs-gray-600);
            color: var(--bs-light);
        }

        [data-theme="dark"] .input-group-text {
            background-color: var(--bs-gray-700);
            border-color: var(--bs-gray-600);
            color: var(--bs-light);
        }

        [data-theme="dark"] .page-link {
            background-color: var(--bs-gray-800);
            border-color: var(--bs-gray-600);
            color: var(--bs-light);
        }

        [data-theme="dark"] .page-item.active .page-link {
            background-color: var(--bs-primary);
            border-color: var(--bs-primary);
        }

        [data-theme="dark"] .page-item.disabled .page-link {
            background-color: var(--bs-gray-900);
            color: var(--bs-gray-500);
        }

        [data-theme="dark"] .border-top {
            border-color: var(--bs-gray-700) !important;
        }
    </style>
}
