@using Bangaliyana.Models
@model ProductReview
@{
    ViewData["Title"] = "Review Details";
    var productImage = Model.Product?.ImageUrl ?? "images/products/noimage.jpg";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var canEditReply = Model.Reply != null && Model.Reply.UserId == currentUserId;
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a asp-action="Index">Reviews</a></li>
                    <li class="breadcrumb-item active">Review Details</li>
                </ol>
            </nav>
            <h1 class="h3 mb-1"><i class="fas fa-star text-warning me-2"></i>Review Details</h1>
            <p class="text-muted mb-0">Review #@Model.Id - @Model.CreatedAt.ToString("MMM dd, yyyy")</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to Reviews
        </a>
    </div>

    @if (TempData["onSave"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["onSave"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["onEdit"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show">
            <i class="fas fa-info-circle me-2"></i>@TempData["onEdit"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["onDelete"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["onDelete"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Left Column: Review Info -->
        <div class="col-lg-8 mb-4">
            <!-- Product Info Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-box me-2"></i>Product Information</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-start gap-3">
                        <img src="~/@productImage" alt="Product" class="rounded shadow-sm" style="width: 100px; height: 100px; object-fit: cover;" />
                        <div class="flex-grow-1">
                            <h5 class="mb-1">@(Model.Product?.Name ?? "Unknown Product")</h5>
                            @if (Model.Product != null)
                            {
                                <p class="text-muted mb-2">
                                    @if (Model.Product.DiscountPrice.HasValue && Model.Product.DiscountPrice < Model.Product.Price)
                                    {
                                        <span class="fw-semibold text-success">৳@Model.Product.DiscountPrice.Value.ToString("N0")</span>
                                        <span class="text-muted text-decoration-line-through ms-2">৳@Model.Product.Price.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span class="fw-semibold">৳@Model.Product.Price.ToString("N0")</span>
                                    }
                                </p>
                                @if (!string.IsNullOrEmpty(Model.Product.SKU))
                                {
                                    <p class="mb-0 text-muted small"><i class="fas fa-barcode me-1"></i>SKU: @Model.Product.SKU</p>
                                }
                            }
                        </div>
                        @if (Model.Product != null)
                        {
                            <a asp-area="Seller" asp-controller="Product" asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-external-link-alt me-1"></i>View Product
                            </a>
                        }
                    </div>
                </div>
            </div>

            <!-- Review Content Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-comment me-2"></i>Customer Review</h5>
                </div>
                <div class="card-body">
                    <!-- Rating -->
                    <div class="mb-4">
                        <label class="form-label text-muted small mb-1">Rating</label>
                        <div class="d-flex align-items-center gap-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Model.Rating)
                                {
                                    <i class="fas fa-star text-warning fs-4"></i>
                                }
                                else
                                {
                                    <i class="far fa-star text-muted fs-4"></i>
                                }
                            }
                            <span class="ms-2 fw-semibold fs-5">@Model.Rating / 5</span>
                            @if (Model.IsVerifiedPurchase)
                            {
                                <span class="badge bg-info ms-2"><i class="fas fa-check-circle me-1"></i>Verified Purchase</span>
                            }
                        </div>
                    </div>

                    <!-- Title -->
                    @if (!string.IsNullOrEmpty(Model.Title))
                    {
                        <div class="mb-3">
                            <label class="form-label text-muted small mb-1">Title</label>
                            <p class="fw-semibold mb-0">@Model.Title</p>
                        </div>
                    }

                    <!-- Comment -->
                    @if (!string.IsNullOrEmpty(Model.Comment))
                    {
                        <div class="mb-3">
                            <label class="form-label text-muted small mb-1">Comment</label>
                            <p class="mb-0">@Model.Comment</p>
                        </div>
                    }

                    <!-- Pros -->
                    @if (!string.IsNullOrEmpty(Model.Pros))
                    {
                        <div class="mb-3">
                            <label class="form-label text-muted small mb-1"><i class="fas fa-thumbs-up text-success me-1"></i>What they liked</label>
                            <p class="mb-0 text-success">@Model.Pros</p>
                        </div>
                    }

                    <!-- Cons -->
                    @if (!string.IsNullOrEmpty(Model.Cons))
                    {
                        <div class="mb-3">
                            <label class="form-label text-muted small mb-1"><i class="fas fa-thumbs-down text-danger me-1"></i>What could be improved</label>
                            <p class="mb-0 text-danger">@Model.Cons</p>
                        </div>
                    }

                    <!-- Review Images -->
                    @if (Model.Images != null && Model.Images.Any())
                    {
                        <div class="mb-3">
                            <label class="form-label text-muted small mb-2">Customer Photos</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var image in Model.Images)
                                {
                                    <a href="~/@image.ImageUrl" target="_blank">
                                        <img src="~/@image.ImageUrl" alt="Review Image" class="rounded shadow-sm"
                                             style="width: 100px; height: 100px; object-fit: cover; cursor: pointer;" />
                                    </a>
                                }
                            </div>
                        </div>
                    }

                    <!-- Metadata -->
                    <div class="row mt-4 pt-3 border-top">
                        <div class="col-md-6">
                            <small class="text-muted">
                                <i class="fas fa-thumbs-up me-1"></i>Helpful Count: <span class="fw-semibold">@Model.HelpfulCount</span>
                            </small>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <small class="text-muted">
                                <i class="fas fa-clock me-1"></i>Submitted: @Model.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Reply Section -->
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-reply me-2"></i>Your Reply</h5>
                    @if (Model.Reply != null && canEditReply)
                    {
                        <form asp-action="DeleteReply" asp-route-id="@Model.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Are you sure you want to delete your reply?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="fas fa-trash me-1"></i>Delete Reply
                            </button>
                        </form>
                    }
                </div>
                <div class="card-body">
                    @if (Model.Reply != null)
                    {
                        <div class="bg-light rounded p-3 mb-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="fw-semibold">@(Model.Reply.User?.FullName ?? "Seller")</span>
                                    <span class="badge bg-primary ms-2">Your Reply</span>
                                </div>
                                <small class="text-muted">
                                    @Model.Reply.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")
                                    @if (Model.Reply.UpdatedAt.HasValue)
                                    {
                                        <br /><span class="fst-italic">(edited @Model.Reply.UpdatedAt.Value.ToString("MMM dd, yyyy"))</span>
                                    }
                                </small>
                            </div>
                            <p class="mb-0">@Model.Reply.Reply</p>
                        </div>

                        @if (canEditReply)
                        {
                            <h6 class="mb-2">Edit Your Reply</h6>
                            <form asp-action="Reply" asp-route-id="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <div class="mb-3">
                                    <textarea name="reply" class="form-control" rows="4"
                                              placeholder="Update your reply...">@Model.Reply.Reply</textarea>
                                </div>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save me-1"></i>Update Reply
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="alert alert-info small mb-0">
                                <i class="fas fa-info-circle me-1"></i>This review was replied to by another team member.
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-warning mb-3">
                            <i class="fas fa-lightbulb me-2"></i>
                            <strong>Tip:</strong> Responding to reviews shows customers you value their feedback. A thoughtful reply can improve customer satisfaction and encourage future purchases.
                        </div>

                        <form asp-action="Reply" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label">Write your reply</label>
                                <textarea name="reply" class="form-control" rows="4"
                                          placeholder="Thank the customer for their feedback and address any concerns they mentioned..."></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-paper-plane me-1"></i>Send Reply
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column: Customer Info & Order -->
        <div class="col-lg-4 mb-4">
            <!-- Customer Info Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-user me-2"></i>Customer</h5>
                </div>
                <div class="card-body">
                    @if (Model.User != null)
                    {
                        <div class="mb-0">
                            <p class="fw-semibold mb-1">@Model.User.FullName</p>
                            <small class="text-muted">
                                <i class="fas fa-calendar me-1"></i>Member since @Model.User.CreatedAt.ToString("MMM yyyy")
                            </small>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Customer information not available</p>
                    }
                </div>
            </div>

            <!-- Order Info Card -->
            @if (Model.Order != null)
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fas fa-shopping-bag me-2"></i>Related Order</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label text-muted small mb-1">Order Number</label>
                            <p class="fw-semibold mb-0">
                                <a asp-area="Seller" asp-controller="Order" asp-action="Details" asp-route-id="@Model.OrderId" class="text-decoration-none">
                                    #@Model.Order.OrderNumber
                                </a>
                            </p>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted small mb-1">Order Date</label>
                            <p class="mb-0">@Model.Order.CreatedAt.ToString("MMM dd, yyyy")</p>
                        </div>
                        <div class="mb-0">
                            <label class="form-label text-muted small mb-1">Status</label>
                            <p class="mb-0">
                                <span class="badge bg-info">@Model.Order.Status</span>
                            </p>
                        </div>
                    </div>
                </div>
            }

            <!-- Quick Stats Card -->
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Review Status</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label text-muted small mb-1">Visibility</label>
                        <p class="mb-0">
                            @if (Model.IsApproved)
                            {
                                <span class="badge bg-success"><i class="fas fa-eye me-1"></i>Visible to customers</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark"><i class="fas fa-eye-slash me-1"></i>Hidden</span>
                            }
                        </p>
                    </div>
                    <div class="mb-0">
                        <label class="form-label text-muted small mb-1">Reply Status</label>
                        <p class="mb-0">
                            @if (Model.Reply != null)
                            {
                                <span class="badge bg-success"><i class="fas fa-check me-1"></i>Replied</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>Pending reply</span>
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Dark mode styles */
        [data-theme="dark"] .card {
            background-color: var(--bs-dark);
            border-color: var(--bs-gray-700);
        }

        [data-theme="dark"] .card-header {
            background-color: var(--bs-gray-800);
            border-color: var(--bs-gray-700);
        }

        [data-theme="dark"] .bg-light {
            background-color: var(--bs-gray-800) !important;
        }

        [data-theme="dark"] .form-control {
            background-color: var(--bs-gray-800);
            border-color: var(--bs-gray-600);
            color: var(--bs-light);
        }

        [data-theme="dark"] .border-top {
            border-color: var(--bs-gray-700) !important;
        }

        [data-theme="dark"] .alert-warning {
            background-color: rgba(255, 193, 7, 0.15);
            border-color: rgba(255, 193, 7, 0.3);
            color: #ffc107;
        }

        [data-theme="dark"] .alert-info {
            background-color: rgba(13, 202, 240, 0.15);
            border-color: rgba(13, 202, 240, 0.3);
            color: #0dcaf0;
        }

        [data-theme="dark"] .breadcrumb-item a {
            color: var(--bs-primary);
        }

        [data-theme="dark"] .breadcrumb-item.active {
            color: var(--bs-gray-400);
        }

        [data-theme="dark"] .breadcrumb-item + .breadcrumb-item::before {
            color: var(--bs-gray-500);
        }
    </style>
}
