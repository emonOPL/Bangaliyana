@model List<SellerTransaction>
@using Bangaliyana.Extensions
@{
    ViewData["Title"] = "Transaction History";
    var seller = ViewBag.Seller as Seller;
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
    var totalTransactions = (int)ViewBag.TotalTransactions;
    var selectedType = ViewBag.Type as string;
    var fromDate = ViewBag.FromDate as DateTime?;
    var toDate = ViewBag.ToDate as DateTime?;
    var totalCommissions = (decimal)ViewBag.TotalCommissions;
    var totalPayouts = (decimal)ViewBag.TotalPayouts;
    var totalRefunds = (decimal)ViewBag.TotalRefunds;
    var totalWithdrawals = (decimal)ViewBag.TotalWithdrawals;
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="fas fa-history text-primary me-2"></i>Transaction History</h2>
            <p class="text-muted mb-0">View your account balance history and transactions</p>
        </div>
        <div>
            <a asp-page="/Account/Manage/PaymentStatement" asp-area="Identity" class="btn btn-primary me-2">
                <i class="fas fa-file-invoice-dollar me-1"></i>Payment Statement
            </a>
            <a asp-action="Index" asp-controller="Dashboard" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-xl col-lg-4 col-md-6 mb-3">
            <div class="card summary-card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="summary-icon bg-primary bg-opacity-10 text-primary">
                            <i class="fas fa-wallet"></i>
                        </div>
                        <div class="ms-3">
                            <div class="summary-label text-muted">Current Balance</div>
                            <div class="summary-value @(seller?.AccountBalance >= 0 ? "text-success" : "text-danger")">
                                ৳@(seller != null ? (int)Math.Round(seller.AccountBalance) : 0)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl col-lg-4 col-md-6 mb-3">
            <div class="card summary-card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="summary-icon bg-success bg-opacity-10 text-success">
                            <i class="fas fa-plus-circle"></i>
                        </div>
                        <div class="ms-3">
                            <div class="summary-label text-muted">Total Payouts</div>
                            <div class="summary-value text-success">৳@((int)Math.Round(totalPayouts))</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl col-lg-4 col-md-6 mb-3">
            <div class="card summary-card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="summary-icon bg-warning bg-opacity-10 text-warning">
                            <i class="fas fa-percentage"></i>
                        </div>
                        <div class="ms-3">
                            <div class="summary-label text-muted">Total Commission</div>
                            <div class="summary-value text-warning">৳@((int)Math.Round(totalCommissions))</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl col-lg-6 col-md-6 mb-3">
            <div class="card summary-card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="summary-icon bg-danger bg-opacity-10 text-danger">
                            <i class="fas fa-undo"></i>
                        </div>
                        <div class="ms-3">
                            <div class="summary-label text-muted">Total Refunds</div>
                            <div class="summary-value text-danger">৳@((int)Math.Round(totalRefunds))</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl col-lg-6 col-md-6 mb-3">
            <div class="card summary-card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="summary-icon bg-info bg-opacity-10 text-info">
                            <i class="fas fa-money-bill-wave"></i>
                        </div>
                        <div class="ms-3">
                            <div class="summary-label text-muted">Total Withdrawals</div>
                            <div class="summary-value text-info">৳@((int)Math.Round(totalWithdrawals))</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Transaction Type</label>
                    <select name="type" class="form-select">
                        <option value="">All Types</option>
                        <option value="Commission" selected="@(selectedType == "Commission")">Commission Deduction</option>
                        <option value="OrderPayout" selected="@(selectedType == "OrderPayout")">Order Payout</option>
                        <option value="RefundDeduction" selected="@(selectedType == "RefundDeduction")">Refund Deduction</option>
                        <option value="Withdrawal" selected="@(selectedType == "Withdrawal")">Withdrawal</option>
                        <option value="Adjustment" selected="@(selectedType == "Adjustment")">Adjustment</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">From Date</label>
                    <input type="date" name="fromDate" class="form-control" value="@fromDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">To Date</label>
                    <input type="date" name="toDate" class="form-control" value="@toDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="fas fa-filter me-1"></i>Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-1"></i>Clear
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Transactions Table -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-list text-primary me-2"></i>Transactions (@totalTransactions)</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Description</th>
                                <th>Order</th>
                                <th class="text-end">Amount</th>
                                <th class="text-end">Balance After</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var transaction in Model)
                            {
                                var typeClass = transaction.Type switch
                                {
                                    SellerTransactionType.Commission => "bg-warning text-dark",
                                    SellerTransactionType.OrderPayout => "bg-success",
                                    SellerTransactionType.RefundDeduction => "bg-danger",
                                    SellerTransactionType.Withdrawal => "bg-info",
                                    SellerTransactionType.Adjustment => "bg-secondary",
                                    _ => "bg-secondary"
                                };

                                var typeIcon = transaction.Type switch
                                {
                                    SellerTransactionType.Commission => "fa-percentage",
                                    SellerTransactionType.OrderPayout => "fa-plus-circle",
                                    SellerTransactionType.RefundDeduction => "fa-undo",
                                    SellerTransactionType.Withdrawal => "fa-money-bill-wave",
                                    SellerTransactionType.Adjustment => "fa-sliders-h",
                                    _ => "fa-circle"
                                };

                                var typeLabel = transaction.Type switch
                                {
                                    SellerTransactionType.Commission => "Commission",
                                    SellerTransactionType.OrderPayout => "Payout",
                                    SellerTransactionType.RefundDeduction => "Refund",
                                    SellerTransactionType.Withdrawal => "Withdrawal",
                                    SellerTransactionType.Adjustment => "Adjustment",
                                    _ => transaction.Type.ToString()
                                };

                                <tr>
                                    <td>
                                        <div>@transaction.CreatedAt.ToBangladeshShortDateString()</div>
                                        <small class="text-muted">@transaction.CreatedAt.ToBangladeshString("hh:mm tt")</small>
                                    </td>
                                    <td>
                                        <span class="badge @typeClass">
                                            <i class="fas @typeIcon me-1"></i>@typeLabel
                                        </span>
                                    </td>
                                    <td>@transaction.Description</td>
                                    <td>
                                        @if (transaction.OrderId.HasValue && transaction.Order != null)
                                        {
                                            <a asp-action="Details" asp-controller="Order" asp-route-id="@transaction.OrderId" class="text-decoration-none">
                                                #@transaction.Order.OrderNumber
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <span class="@(transaction.Amount >= 0 ? "text-success" : "text-danger") fw-semibold">
                                            @(transaction.Amount >= 0 ? "+" : "")৳@((int)Math.Round(transaction.Amount))
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <span class="@(transaction.BalanceAfter >= 0 ? "text-dark" : "text-danger")">
                                            ৳@((int)Math.Round(transaction.BalanceAfter))
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-inbox fa-3x mb-3"></i>
                    <p class="mb-0">No transactions found</p>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="card-footer">
                <nav>
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)"
                               asp-route-type="@selectedType" asp-route-fromDate="@fromDate?.ToString("yyyy-MM-dd")"
                               asp-route-toDate="@toDate?.ToString("yyyy-MM-dd")">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>
                        @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i"
                                   asp-route-type="@selectedType" asp-route-fromDate="@fromDate?.ToString("yyyy-MM-dd")"
                                   asp-route-toDate="@toDate?.ToString("yyyy-MM-dd")">@i</a>
                            </li>
                        }
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)"
                               asp-route-type="@selectedType" asp-route-fromDate="@fromDate?.ToString("yyyy-MM-dd")"
                               asp-route-toDate="@toDate?.ToString("yyyy-MM-dd")">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<style>
    .summary-card {
        border-radius: 12px;
        transition: transform 0.2s;
    }

    .summary-card:hover {
        transform: translateY(-2px);
    }

    .summary-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .summary-label {
        font-size: 0.85rem;
    }

    .summary-value {
        font-size: 1.25rem;
        font-weight: 600;
    }

    /* Dark mode */
    [data-theme="dark"] .card {
        background-color: #1f2937;
        border-color: #374151;
    }

    [data-theme="dark"] .card-header {
        background-color: #111827;
        border-color: #374151;
        color: #f3f4f6;
    }

    [data-theme="dark"] .card-footer {
        background-color: #111827;
        border-color: #374151;
    }

    [data-theme="dark"] .table {
        color: #e5e7eb;
    }

    [data-theme="dark"] .table-light {
        background-color: #374151;
        color: #f3f4f6;
    }

    [data-theme="dark"] .summary-card {
        background-color: #1f2937 !important;
    }

    [data-theme="dark"] .form-control,
    [data-theme="dark"] .form-select {
        background-color: #374151;
        border-color: #4b5563;
        color: #f3f4f6;
    }

    [data-theme="dark"] .text-dark {
        color: #f3f4f6 !important;
    }
</style>
