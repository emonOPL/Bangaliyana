@model Bangaliyana.Models.Seller
@{
    ViewData["Title"] = Localizer["MyShop"].Value;
    var productCount = (int)ViewBag.ProductCount;
    var orderCount = (int)ViewBag.OrderCount;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="fas fa-store text-primary me-2"></i>@Localizer["MyShop"]</h1>
            <p class="text-muted mb-0">@Localizer["ManageShopProfileSettings"]</p>
        </div>
        <a asp-action="Index" asp-controller="Dashboard" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>@Localizer["BackToDashboard"]
        </a>
    </div>

    @if (TempData["StatusMessage"] != null)
    {
        <div class="alert @(TempData["StatusMessage"]?.ToString()?.StartsWith("Error") == true ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @TempData["StatusMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Shop Status Card -->
    <div class="card mb-4 shop-status-card">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="d-flex align-items-center">
                        @if (!string.IsNullOrEmpty(Model.ShopLogoUrl))
                        {
                            <img src="@Model.ShopLogoUrl" alt="Shop Logo" class="shop-logo-preview me-3" />
                        }
                        else
                        {
                            <div class="shop-logo-placeholder me-3">
                                <i class="fas fa-store"></i>
                            </div>
                        }
                        <div>
                            <h4 class="mb-1">@Model.ShopName</h4>
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                @if (Model.Status == SellerStatus.Approved)
                                {
                                    <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>@Localizer["Approved"]</span>
                                }
                                else if (Model.Status == SellerStatus.Pending)
                                {
                                    <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>@Localizer["PendingApproval"]</span>
                                }
                                else if (Model.Status == SellerStatus.Suspended)
                                {
                                    <span class="badge bg-danger"><i class="fas fa-ban me-1"></i>@Localizer["Suspended"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="fas fa-times-circle me-1"></i>@Localizer["Rejected"]</span>
                                }

                                @if (Model.IsVerified)
                                {
                                    <span class="badge bg-info"><i class="fas fa-shield-alt me-1"></i>@Localizer["Verified"]</span>
                                }

                                <span class="badge bg-light text-dark">
                                    <i class="fas fa-tag me-1"></i>@Model.BusinessCategory.GetDisplayName()
                                </span>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.ShopSlug))
                            {
                                <small class="text-muted d-block mt-1">
                                    <i class="fas fa-link me-1"></i>
                                    <a href="/shop/@Model.ShopSlug" target="_blank">/shop/@Model.ShopSlug</a>
                                </small>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="row text-center">
                        <div class="col-4">
                            <div class="stat-item">
                                <div class="stat-value">@productCount</div>
                                <div class="stat-label">@Localizer["Products"]</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="stat-item">
                                <div class="stat-value">@orderCount</div>
                                <div class="stat-label">@Localizer["Orders"]</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="stat-item">
                                <div class="stat-value">@Model.Rating.ToString("F1")</div>
                                <div class="stat-label">@Localizer["Rating"]</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Form with Images -->
    <form asp-action="Update" method="post" id="shopForm" enctype="multipart/form-data" novalidate>
        @Html.AntiForgeryToken()

        <!-- Shop Images -->
        <div class="row mb-4">
            <!-- Shop Logo -->
            <div class="col-md-4 mb-3">
                <div class="card h-100">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="fas fa-image me-2"></i>@Localizer["ShopLogo"]</h6>
                    </div>
                    <div class="card-body text-center">
                        <div id="logoPreviewContainer">
                            @if (!string.IsNullOrEmpty(Model.ShopLogoUrl))
                            {
                                <img src="@Model.ShopLogoUrl" alt="Shop Logo" id="logoPreview" class="img-fluid rounded-circle mb-3" style="width: 120px; height: 120px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="shop-logo-empty mb-3" id="logoPlaceholder">
                                    <i class="fas fa-camera"></i>
                                    <span>@Localizer["NoLogo"]</span>
                                </div>
                            }
                        </div>
                        <input type="file" id="logoInput" name="Logo" accept="image/*" class="d-none" />
                        <div class="d-flex justify-content-center gap-2 mb-2">
                            <button type="button" class="btn btn-outline-primary btn-sm" onclick="document.getElementById('logoInput').click()">
                                <i class="fas fa-camera me-1"></i>@Localizer["ChooseLogo"]
                            </button>
                            @if (!string.IsNullOrEmpty(Model.ShopLogoUrl))
                            {
                                <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#removeLogoModal">
                                    <i class="fas fa-trash me-1"></i>@Localizer["Remove"]
                                </button>
                            }
                        </div>
                        <div id="logoFileName" class="selected-file"></div>
                        <div class="mt-2">
                            <small class="text-muted">@Localizer["RecommendedLogoSize"]</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Shop Banner -->
            <div class="col-md-8 mb-3">
                <div class="card h-100">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="fas fa-panorama me-2"></i>@Localizer["ShopBanner"]</h6>
                    </div>
                    <div class="card-body">
                        <div id="bannerPreviewContainer">
                            @if (!string.IsNullOrEmpty(Model.ShopBannerUrl))
                            {
                                <img src="@Model.ShopBannerUrl" alt="Shop Banner" id="bannerPreview" class="img-fluid rounded mb-3" style="width: 100%; max-height: 150px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="shop-banner-empty mb-3" id="bannerPlaceholder">
                                    <i class="fas fa-image"></i>
                                    <span>@Localizer["NoBannerUploaded"]</span>
                                </div>
                            }
                        </div>
                        <input type="file" id="bannerInput" name="Banner" accept="image/*" class="d-none" />
                        <div class="d-flex gap-2 mb-2">
                            <button type="button" class="btn btn-outline-primary flex-grow-1" onclick="document.getElementById('bannerInput').click()">
                                <i class="fas fa-image me-1"></i>@Localizer["ChooseBanner"]
                            </button>
                            @if (!string.IsNullOrEmpty(Model.ShopBannerUrl))
                            {
                                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#removeBannerModal">
                                    <i class="fas fa-trash me-1"></i>@Localizer["Remove"]
                                </button>
                            }
                        </div>
                        <div id="bannerFileName" class="selected-file"></div>
                        <div class="mt-2">
                            <small class="text-muted">@Localizer["RecommendedBannerSize"]</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Left Column -->
            <div class="col-lg-8">
                <!-- Basic Info -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="fas fa-store me-2"></i>@Localizer["ShopInformation"]</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label class="form-label">@Localizer["ShopName"] <span class="text-danger">*</span></label>
                                <input name="ShopName" id="ShopName" value="@Model.ShopName" class="form-control" placeholder="@Localizer["EnterShopName"]" data-required="true" data-error-msg="@Localizer["ShopNameRequired"]" />
                                <div class="invalid-feedback" id="ShopName-error"></div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">@Localizer["ShopURL"]</label>
                                <input name="ShopSlug" value="@Model.ShopSlug" class="form-control" placeholder="shop-url" />
                                <small class="text-muted">@Localizer["LeaveEmptyToAutoGenerate"]</small>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Localizer["BusinessCategory"] <span class="text-danger">*</span></label>
                            <select name="BusinessCategory" id="BusinessCategory" class="form-select" data-required="true" data-error-msg="Please select a business category">
                                @foreach (var category in Enum.GetValues<BusinessCategory>())
                                {
                                    <option value="@category" selected="@(Model.BusinessCategory == category)">@category.GetDisplayName()</option>
                                }
                            </select>
                            <div class="invalid-feedback" id="BusinessCategory-error"></div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Localizer["ShopDescription"]</label>
                            <textarea name="ShopDescription" class="form-control" rows="4" placeholder="@Localizer["TellCustomersAboutShop"]">@Model.ShopDescription</textarea>
                        </div>
                    </div>
                </div>

                <!-- Contact Info -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="fas fa-phone-alt me-2"></i>@Localizer["ContactInformation"]</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">@Localizer["BusinessPhone"] <span class="text-danger">*</span></label>
                                <input name="BusinessPhone" id="BusinessPhone" value="@Model.BusinessPhone" class="form-control" placeholder="01XXXXXXXXX" data-required="true" data-error-msg="@Localizer["BusinessPhoneRequired"]" />
                                <div class="invalid-feedback" id="BusinessPhone-error"></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">@Localizer["BusinessEmail"] <span class="text-danger">*</span></label>
                                <input name="BusinessEmail" id="BusinessEmail" value="@Model.BusinessEmail" type="email" class="form-control" placeholder="shop@example.com" data-required="true" data-type="email" data-error-msg="@Localizer["BusinessEmailRequired"]" data-email-error="@Localizer["ValidEmailRequired"]" />
                                <div class="invalid-feedback" id="BusinessEmail-error"></div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Localizer["BusinessAddress"]</label>
                            <textarea name="BusinessAddress" class="form-control" rows="2" placeholder="@Localizer["EnterBusinessAddress"]">@Model.BusinessAddress</textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Localizer["OperatingHours"]</label>
                            <input name="OperatingHours" value="@Model.OperatingHours" class="form-control" placeholder="@Localizer["OperatingHoursExample"]" />
                        </div>
                    </div>
                </div>

                <!-- Policies -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="fas fa-file-contract me-2"></i>@Localizer["ShopPolicies"]</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">@Localizer["ShopPolicies"]</label>
                            <textarea name="ShopPolicies" class="form-control" rows="3" placeholder="@Localizer["GeneralShopPolicies"]">@Model.ShopPolicies</textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Localizer["ReturnPolicy"]</label>
                            <textarea name="ReturnPolicy" class="form-control" rows="3" placeholder="@Localizer["ReturnRefundPolicy"]">@Model.ReturnPolicy</textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Localizer["ShippingInformation"]</label>
                            <textarea name="ShippingInfo" class="form-control" rows="3" placeholder="@Localizer["ShippingInfoPlaceholder"]">@Model.ShippingInfo</textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column -->
            <div class="col-lg-4">
                <!-- Social Links -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="fas fa-share-alt me-2"></i>@Localizer["SocialLinks"]</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Facebook</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fab fa-facebook text-primary"></i></span>
                                <input name="FacebookUrl" value="@Model.FacebookUrl" class="form-control" placeholder="https://facebook.com/yourpage" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Instagram</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fab fa-instagram text-danger"></i></span>
                                <input name="InstagramUrl" value="@Model.InstagramUrl" class="form-control" placeholder="https://instagram.com/yourpage" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">WhatsApp</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fab fa-whatsapp text-success"></i></span>
                                <input name="WhatsAppNumber" value="@Model.WhatsAppNumber" class="form-control" placeholder="01XXXXXXXXX" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Business Documents -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="fas fa-file-alt me-2"></i>@Localizer["BusinessDocuments"]</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">@Localizer["TradeLicenseNumber"]</label>
                            <input name="TradeLicenseNumber" value="@Model.TradeLicenseNumber" class="form-control" placeholder="@Localizer["EnterTradeLicenseNumber"]" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Localizer["NIDNumber"] <span class="text-danger">*</span></label>
                            <input name="NIDNumber" id="NIDNumber" value="@Model.NIDNumber" class="form-control" placeholder="@Localizer["EnterNIDNumber"]" data-required="true" data-error-msg="@Localizer["NIDNumberRequired"]" />
                            <div class="invalid-feedback" id="NIDNumber-error"></div>
                        </div>

                        @if (!Model.IsVerified)
                        {
                            <div class="alert alert-info small mb-0">
                                <i class="fas fa-info-circle me-1"></i>
                                @Localizer["CompleteDocumentsForVerified"]
                            </div>
                        }
                    </div>
                </div>

                <!-- Commission Info -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="fas fa-percentage me-2"></i>@Localizer["Commission"]</h6>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <span>@Localizer["YourCommissionRate"]:</span>
                            <span class="badge bg-primary fs-6">@Model.CommissionRate%</span>
                        </div>
                        <small class="text-muted">@Localizer["CommissionRateSetByAdmin"]</small>
                    </div>
                </div>

                <!-- Save Button -->
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fas fa-save me-2"></i>@Localizer["SaveChanges"]
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<style>
    .shop-status-card {
        background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
        border: 1px solid #86efac;
    }

    .shop-logo-preview {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #10b981;
    }

    .shop-logo-placeholder {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2rem;
    }

    .shop-logo-empty, .shop-banner-empty {
        background: #f3f4f6;
        border: 2px dashed #d1d5db;
        border-radius: 8px;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #9ca3af;
    }

    .shop-logo-empty {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        margin: 0 auto;
    }

    .shop-logo-empty i, .shop-banner-empty i {
        font-size: 2rem;
        margin-bottom: 0.5rem;
    }

    .stat-item {
        padding: 0.5rem;
    }

    .stat-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: #10b981;
    }

    .stat-label {
        font-size: 0.75rem;
        color: #6b7280;
        text-transform: uppercase;
    }

    /* Dark mode */
    [data-theme="dark"] .shop-status-card {
        background: linear-gradient(135deg, #064e3b 0%, #065f46 100%);
        border-color: #059669;
    }

    [data-theme="dark"] .shop-status-card h4,
    [data-theme="dark"] .shop-status-card .stat-value,
    [data-theme="dark"] .shop-status-card .stat-label {
        color: #fff;
    }

    [data-theme="dark"] .shop-status-card .badge.bg-light {
        background-color: #374151 !important;
        color: #f3f4f6 !important;
    }

    [data-theme="dark"] .shop-logo-empty,
    [data-theme="dark"] .shop-banner-empty {
        background: #374151;
        border-color: #4b5563;
        color: #9ca3af;
    }

    [data-theme="dark"] .card {
        background-color: #1f2937;
        border-color: #374151;
    }

    [data-theme="dark"] .card-header {
        background-color: #111827;
        border-color: #374151;
        color: #f3f4f6;
    }

    [data-theme="dark"] .form-control,
    [data-theme="dark"] .form-select {
        background-color: #374151;
        border-color: #4b5563;
        color: #f3f4f6;
    }

    [data-theme="dark"] .form-floating > label {
        color: #9ca3af;
    }

    [data-theme="dark"] .input-group-text {
        background-color: #374151;
        border-color: #4b5563;
        color: #f3f4f6;
    }

    [data-theme="dark"] .form-label {
        color: #e5e7eb;
    }

    [data-theme="dark"] .text-muted {
        color: #9ca3af !important;
    }

    .selected-file {
        font-size: 0.85rem;
        min-height: 20px;
        color: #059669;
        text-align: center;
    }

    .selected-file i {
        color: #10b981;
    }

    .invalid-feedback {
        display: none;
        font-size: 0.875rem;
        color: #dc3545;
    }

    .is-invalid + .invalid-feedback,
    .form-control.is-invalid ~ .invalid-feedback,
    .form-select.is-invalid ~ .invalid-feedback {
        display: block;
    }

    [data-theme="dark"] .selected-file {
        color: #4ade80;
    }
</style>

<!-- Remove Logo Confirmation Modal -->
<div class="modal fade" id="removeLogoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content confirm-modal-content border-0 shadow-lg">
            <button type="button" class="btn-close confirm-modal-close" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="modal-body text-center p-4">
                <div class="confirm-icon-wrapper mb-3">
                    <div class="confirm-icon-circle confirm-icon-danger">
                        <i class="fas fa-image" style="font-size: 2.5rem;"></i>
                    </div>
                </div>
                <h4 class="modal-title fw-bold mb-2">Remove Logo?</h4>
                <p class="text-muted mb-1">Are you sure you want to remove the shop logo?</p>
                <p class="text-muted small mb-0">You can upload a new one anytime.</p>
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2 pt-0 pb-4">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Cancel
                </button>
                <form asp-action="RemoveLogo" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="fas fa-check me-1"></i> Yes, Remove
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Remove Banner Confirmation Modal -->
<div class="modal fade" id="removeBannerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content confirm-modal-content border-0 shadow-lg">
            <button type="button" class="btn-close confirm-modal-close" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="modal-body text-center p-4">
                <div class="confirm-icon-wrapper mb-3">
                    <div class="confirm-icon-circle confirm-icon-danger">
                        <i class="fas fa-panorama" style="font-size: 2.5rem;"></i>
                    </div>
                </div>
                <h4 class="modal-title fw-bold mb-2">Remove Banner?</h4>
                <p class="text-muted mb-1">Are you sure you want to remove the shop banner?</p>
                <p class="text-muted small mb-0">You can upload a new one anytime.</p>
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2 pt-0 pb-4">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Cancel
                </button>
                <form asp-action="RemoveBanner" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="fas fa-check me-1"></i> Yes, Remove
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('shopForm');

        // Logo preview on select
        const logoInput = document.getElementById('logoInput');
        const logoFileName = document.getElementById('logoFileName');

        logoInput.addEventListener('change', function() {
            if (this.files && this.files[0]) {
                const file = this.files[0];

                // Validate file type
                const allowedTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
                if (!allowedTypes.includes(file.type)) {
                    logoFileName.innerHTML = '<span class="text-danger"><i class="fas fa-exclamation-circle me-1"></i>Only JPG, PNG, GIF, WebP allowed</span>';
                    this.value = '';
                    return;
                }

                // Validate file size (2MB)
                if (file.size > 2 * 1024 * 1024) {
                    logoFileName.innerHTML = '<span class="text-danger"><i class="fas fa-exclamation-circle me-1"></i>File size must be less than 2MB</span>';
                    this.value = '';
                    return;
                }

                logoFileName.innerHTML = '<i class="fas fa-check-circle me-1"></i>' + file.name;

                // Show preview
                const reader = new FileReader();
                reader.onload = function(e) {
                    const container = document.getElementById('logoPreviewContainer');
                    container.innerHTML = '<img src="' + e.target.result + '" alt="Shop Logo Preview" class="img-fluid rounded-circle mb-3" style="width: 120px; height: 120px; object-fit: cover;" />';
                };
                reader.readAsDataURL(file);
            }
        });

        // Banner preview on select
        const bannerInput = document.getElementById('bannerInput');
        const bannerFileName = document.getElementById('bannerFileName');

        bannerInput.addEventListener('change', function() {
            if (this.files && this.files[0]) {
                const file = this.files[0];

                // Validate file type
                const allowedTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
                if (!allowedTypes.includes(file.type)) {
                    bannerFileName.innerHTML = '<span class="text-danger"><i class="fas fa-exclamation-circle me-1"></i>Only JPG, PNG, GIF, WebP allowed</span>';
                    this.value = '';
                    return;
                }

                // Validate file size (5MB)
                if (file.size > 5 * 1024 * 1024) {
                    bannerFileName.innerHTML = '<span class="text-danger"><i class="fas fa-exclamation-circle me-1"></i>File size must be less than 5MB</span>';
                    this.value = '';
                    return;
                }

                bannerFileName.innerHTML = '<i class="fas fa-check-circle me-1"></i>' + file.name;

                // Show preview
                const reader = new FileReader();
                reader.onload = function(e) {
                    const container = document.getElementById('bannerPreviewContainer');
                    container.innerHTML = '<img src="' + e.target.result + '" alt="Shop Banner Preview" class="img-fluid rounded mb-3" style="width: 100%; max-height: 150px; object-fit: cover;" />';
                };
                reader.readAsDataURL(file);
            }
        });

        // Custom form validation
        form.addEventListener('submit', function(e) {
            let isValid = true;

            // Clear previous errors
            document.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
            document.querySelectorAll('.invalid-feedback').forEach(el => el.textContent = '');

            // Validate required fields
            const requiredFields = form.querySelectorAll('[data-required="true"]');
            requiredFields.forEach(field => {
                const value = field.value.trim();
                const errorDiv = document.getElementById(field.id + '-error');

                if (!value) {
                    field.classList.add('is-invalid');
                    if (errorDiv) {
                        errorDiv.textContent = field.dataset.errorMsg || 'This field is required';
                    }
                    isValid = false;
                }

                // Email validation
                if (value && field.dataset.type === 'email') {
                    const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                    if (!emailRegex.test(value)) {
                        field.classList.add('is-invalid');
                        if (errorDiv) {
                            errorDiv.textContent = field.dataset.emailError || 'Please enter a valid email';
                        }
                        isValid = false;
                    }
                }
            });

            if (!isValid) {
                e.preventDefault();

                // Scroll to first error
                const firstError = document.querySelector('.is-invalid');
                if (firstError) {
                    firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    firstError.focus();
                }
            }
        });

        // Clear error on input
        document.querySelectorAll('[data-required="true"]').forEach(field => {
            field.addEventListener('input', function() {
                this.classList.remove('is-invalid');
                const errorDiv = document.getElementById(this.id + '-error');
                if (errorDiv) {
                    errorDiv.textContent = '';
                }
            });
        });
    });
</script>
}
