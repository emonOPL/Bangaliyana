@model List<Bangaliyana.Models.SellerConversation>
@using Bangaliyana.Extensions
@{
    ViewData["Title"] = Localizer["Messages"].Value;
    var isArchived = ViewContext.RouteData.Values["action"]?.ToString() == "Archived";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="fas fa-comments text-primary me-2"></i>@(isArchived ? Localizer["ArchivedMessages"].Value : Localizer["Messages"].Value)</h1>
            <p class="text-muted mb-0">@Localizer["ConversationsCount", Model.Count]</p>
        </div>
        <div>
            @if (isArchived)
            {
                <a asp-action="Index" class="btn btn-outline-primary">
                    <i class="fas fa-inbox me-1"></i>@Localizer["Inbox"]
                </a>
            }
            else
            {
                <a asp-action="Archived" class="btn btn-outline-secondary">
                    <i class="fas fa-archive me-1"></i>@Localizer["Archived"]
                </a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var conversation in Model)
                    {
                        var hasUnread = conversation.UnreadCountSeller > 0;
                        <a asp-action="Conversation" asp-route-id="@conversation.Id"
                           class="list-group-item list-group-item-action @(hasUnread ? "bg-light" : "")">
                            <div class="d-flex align-items-start">
                                <!-- Buyer Avatar -->
                                <div class="flex-shrink-0 me-3">
                                    @if (!string.IsNullOrEmpty(conversation.Buyer?.AvatarUrl))
                                    {
                                        <img src="@conversation.Buyer.AvatarUrl" alt="@conversation.Buyer.FullName"
                                             class="rounded-circle" style="width: 50px; height: 50px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                                             style="width: 50px; height: 50px; font-size: 1.2rem;">
                                            @(conversation.Buyer?.FullName?.Substring(0, 1).ToUpper() ?? "?")
                                        </div>
                                    }
                                </div>

                                <!-- Content -->
                                <div class="flex-grow-1 min-width-0">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <h6 class="mb-1 @(hasUnread ? "fw-bold" : "")">
                                            @(conversation.Buyer?.FullName ?? Localizer["Unknown"].Value)
                                        </h6>
                                        <small class="text-muted">
                                            @conversation.LastMessageAt.ToBangladeshString("dd MMM, hh:mm tt")
                                        </small>
                                    </div>

                                    @if (conversation.Product != null)
                                    {
                                        <div class="d-flex align-items-center mb-1">
                                            <img src="~/@(conversation.Product.ImageUrl ?? "images/products/noimage.jpg")"
                                                 class="rounded me-2" style="width: 24px; height: 24px; object-fit: cover;" />
                                            <small class="text-muted">@Localizer["Re"]: @conversation.Product.Name.Truncate(40)</small>
                                        </div>
                                    }

                                    <p class="mb-0 text-muted small text-truncate">
                                        @if (conversation.Messages.Any())
                                        {
                                            var lastMessage = conversation.Messages.OrderByDescending(m => m.CreatedAt).FirstOrDefault();
                                            if (lastMessage != null)
                                            {
                                                @(lastMessage.IsSentBySeller ? Localizer["You"].Value + ": " : "")@lastMessage.Message.Truncate(60)
                                            }
                                        }
                                        else
                                        {
                                            @Localizer["NoMessagesYet"]
                                        }
                                    </p>
                                </div>

                                <!-- Unread Badge -->
                                @if (hasUnread)
                                {
                                    <span class="badge bg-primary rounded-pill ms-2">@conversation.UnreadCountSeller</span>
                                }
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-comments fa-4x text-muted mb-3"></i>
                    <h5>@Localizer["NoMessages"]</h5>
                    <p class="text-muted">
                        @if (isArchived)
                        {
                            @Localizer["NoArchivedConversations"]
                        }
                        else
                        {
                            @Localizer["ConversationsWillAppearHere"]
                        }
                    </p>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .min-width-0 {
        min-width: 0;
    }

    [data-theme="dark"] .card {
        background-color: #1f2937;
        border-color: #374151;
    }

    [data-theme="dark"] .list-group-item {
        background-color: #1f2937;
        border-color: #374151;
        color: #e5e7eb;
    }

    [data-theme="dark"] .list-group-item:hover {
        background-color: #374151;
    }

    [data-theme="dark"] .list-group-item.bg-light {
        background-color: #283548 !important;
    }
</style>
