@model List<Bangaliyana.Models.Products>
@using Bangaliyana.Extensions
@{
    ViewData["Title"] = Localizer["MyProducts"].Value;
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
    var totalProducts = (int)ViewBag.TotalProducts;
    var search = ViewBag.Search as string;
    var categoryId = ViewBag.CategoryId as int?;
    var status = ViewBag.Status as string;
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="fas fa-box text-primary me-2"></i>@Localizer["MyProducts"]</h1>
            <p class="text-muted mb-0">@Localizer["ProductsInYourShop", totalProducts]</p>
        </div>
        <div class="btn-group">
            <a asp-action="BulkUpload" class="btn btn-outline-success">
                <i class="fas fa-file-excel me-1"></i>@Localizer["BulkUpload"]
            </a>
            <a asp-action="Create" class="btn btn-success">
                <i class="fas fa-plus me-1"></i>@Localizer["AddProduct"]
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" name="search" value="@search" class="form-control" placeholder="@Localizer["SearchProducts"]" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="categoryId" class="form-select">
                        <option value="">@Localizer["AllCategories"]</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id" selected="@(categoryId == cat.Id)">@cat.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="status" class="form-select">
                        <option value="">@Localizer["AllStatus"]</option>
                        @foreach (var s in Enum.GetValues<ProductStatus>())
                        {
                            <option value="@s" selected="@(status == s.ToString())">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-filter me-1"></i>@Localizer["Filter"]
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Products Table -->
    <div class="card">
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 60px;">@Localizer["Image"]</th>
                                <th>@Localizer["Product"]</th>
                                <th>@Localizer["Category"]</th>
                                <th>@Localizer["Price"]</th>
                                <th>@Localizer["Stock"]</th>
                                <th>@Localizer["Views"]</th>
                                <th>@Localizer["Sold"]</th>
                                <th>@Localizer["Status"]</th>
                                <th style="width: 150px;">@Localizer["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model)
                            {
                                var stockClass = product.Stock <= 0 ? "bg-danger" : (product.Stock <= 5 ? "bg-warning text-dark" : "bg-success");
                                var statusClass = product.Status switch
                                {
                                    ProductStatus.Active => "bg-success",
                                    ProductStatus.Draft => "bg-secondary",
                                    ProductStatus.Inactive => "bg-warning text-dark",
                                    _ => "bg-danger"
                                };
                                <tr>
                                    <td>
                                        <img src="~/@(product.ImageUrl ?? "images/products/noimage.jpg")" alt="@product.Name"
                                             class="rounded" style="width: 50px; height: 50px; object-fit: cover;" />
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@product.Id" class="fw-semibold text-decoration-none">
                                            @product.Name.Truncate(40)
                                        </a>
                                        @if (!string.IsNullOrEmpty(product.SKU))
                                        {
                                            <br /><small class="text-muted">@product.SKU</small>
                                        }
                                    </td>
                                    <td>@product.Category?.Name</td>
                                    <td>
                                        @if (product.DiscountPrice.HasValue && product.DiscountPrice < product.Price)
                                        {
                                            <span class="fw-semibold text-success">৳@((int)Math.Round(product.DiscountPrice.Value))</span>
                                            <br /><small class="text-muted text-decoration-line-through">৳@((int)Math.Round(product.Price))</small>
                                        }
                                        else
                                        {
                                            <span class="fw-semibold">৳@((int)Math.Round(product.Price))</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @stockClass">@product.Stock</span>
                                    </td>
                                    <td>
                                        <span class="text-primary"><i class="fas fa-eye me-1"></i>@product.ViewCount</span>
                                    </td>
                                    <td>
                                        <span class="text-success"><i class="fas fa-shopping-cart me-1"></i>@product.SoldCount</span>
                                    </td>
                                    <td>
                                        <span class="badge @statusClass">@product.Status.GetDisplayName()</span>
                                        @if (!product.IsAvailable)
                                        {
                                            <span class="badge bg-secondary">@Localizer["Hidden"]</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-outline-primary" title="@Localizer["Edit"]">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-info" title="@Localizer["View"]">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-danger" title="@Localizer["Delete"]"
                                                    data-bs-toggle="modal" data-bs-target="#deleteProductModal"
                                                    data-product-id="@product.Id" data-product-name="@product.Name">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <nav class="p-3">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)"
                                   asp-route-search="@search" asp-route-categoryId="@categoryId" asp-route-status="@status">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i"
                                       asp-route-search="@search" asp-route-categoryId="@categoryId" asp-route-status="@status">@i</a>
                                </li>
                            }
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)"
                                   asp-route-search="@search" asp-route-categoryId="@categoryId" asp-route-status="@status">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
                    <h5>@Localizer["NoProductsFound"]</h5>
                    <p class="text-muted">
                        @if (!string.IsNullOrEmpty(search) || categoryId.HasValue || !string.IsNullOrEmpty(status))
                        {
                            <text>@Localizer["TryAdjustingFilters"]</text>
                        }
                        else
                        {
                            <text>@Localizer["StartByAddingFirstProduct"]</text>
                        }
                    </p>
                    <a asp-action="Create" class="btn btn-success">
                        <i class="fas fa-plus me-1"></i>@Localizer["AddProduct"]
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    [data-theme="dark"] .card {
        background-color: #1f2937;
        border-color: #374151;
    }

    [data-theme="dark"] .table {
        color: #e5e7eb;
    }

    [data-theme="dark"] .table-light {
        background-color: #374151;
        color: #f3f4f6;
    }

    [data-theme="dark"] .form-control,
    [data-theme="dark"] .form-select {
        background-color: #374151;
        border-color: #4b5563;
        color: #f3f4f6;
    }

    [data-theme="dark"] .input-group-text {
        background-color: #374151;
        border-color: #4b5563;
        color: #9ca3af;
    }

    /* Dark mode badge visibility fixes */
    [data-theme="dark"] .badge.bg-warning {
        color: #1f2937 !important;
    }

    [data-theme="dark"] .badge.bg-success {
        background-color: #059669 !important;
        color: #ffffff !important;
    }

    [data-theme="dark"] .badge.bg-danger {
        background-color: #dc2626 !important;
        color: #ffffff !important;
    }

    [data-theme="dark"] .badge.bg-secondary {
        background-color: #4b5563 !important;
        color: #f3f4f6 !important;
    }
</style>

<!-- Delete Product Confirmation Modal -->
<div class="modal fade" id="deleteProductModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content confirm-modal-content border-0 shadow-lg">
            <button type="button" class="btn-close confirm-modal-close" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="modal-body text-center p-4">
                <div class="confirm-icon-wrapper mb-3">
                    <div class="confirm-icon-circle confirm-icon-danger">
                        <i class="fas fa-trash-alt" style="font-size: 2.5rem;"></i>
                    </div>
                </div>
                <h4 class="modal-title fw-bold mb-2">@Localizer["DeleteProductQuestion"]</h4>
                <p class="text-muted mb-1">@Localizer["ConfirmDeleteProduct"] "<span id="deleteProductName"></span>"?</p>
                <p class="text-muted small mb-0">@Localizer["ActionCannotBeUndone"]</p>
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2 pt-0 pb-4">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> @Localizer["Cancel"]
                </button>
                <form id="deleteProductForm" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="fas fa-check me-1"></i> @Localizer["YesDelete"]
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('deleteProductModal').addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var productId = button.getAttribute('data-product-id');
            var productName = button.getAttribute('data-product-name');

            document.getElementById('deleteProductName').textContent = productName;
            document.getElementById('deleteProductForm').action = '@Url.Action("Delete")/' + productId;
        });
    </script>
}
