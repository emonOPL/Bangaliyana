            function resetCreateVariantForm() {
                editingVariantIndex = -1;
                $('#createVariantSize').val('');
                $('#createCustomSize').hide().val('');
                $('#createVariantColor').val('');
                $('#createVariantColorCode').val('');
                $('#createVariantColorPicker').val('#6f42c1');
                $('#createVariantSKU').val('');
                $('#createVariantStock').val('0');
                $('#createVariantAdditionalPrice').val('0');
                $('#createVariantIsAvailable').prop('checked', true);
                $('#createVariantModalTitle').text('Add New Variant');
            }

            // Add Variant button
            $('#addVariantBtn').on('click', function() {
                resetCreateVariantForm();
                var modal = new bootstrap.Modal(document.getElementById('createVariantModal'));
                modal.show();
            });

            // Edit variant button
            $(document).on('click', '.edit-temp-variant-btn', function() {
                var index = $(this).data('index');
                var v = tempVariants[index];
                editingVariantIndex = index;

                var sizeOptions = ['XS', 'S', 'M', 'L', 'XL', 'XXL', 'XXXL', 'Free Size'];
                if (v.Size && sizeOptions.indexOf(v.Size) === -1) {
                    $('#createVariantSize').val('Custom');
                    $('#createCustomSize').show().val(v.Size);
                } else {
                    $('#createVariantSize').val(v.Size || '');
                    $('#createCustomSize').hide().val('');
                }

                $('#createVariantColor').val(v.Color || '');
                $('#createVariantColorCode').val(v.ColorCode || '');
                if (v.ColorCode && /^#[0-9A-Fa-f]{6}$/.test(v.ColorCode)) {
                    $('#createVariantColorPicker').val(v.ColorCode);
                }
                $('#createVariantSKU').val(v.SKU || '');
                $('#createVariantStock').val(v.Stock || 0);
                $('#createVariantAdditionalPrice').val(v.AdditionalPrice || 0);
                $('#createVariantIsAvailable').prop('checked', v.IsAvailable !== false);
                $('#createVariantModalTitle').text('Edit Variant');

                var modal = new bootstrap.Modal(document.getElementById('createVariantModal'));
                modal.show();
            });

            // Save variant
            $('#saveCreateVariantBtn').on('click', function() {
                var size = $('#createVariantSize').val() === 'Custom' ? $('#createCustomSize').val() : $('#createVariantSize').val();
                var color = $('#createVariantColor').val();

                if (!size && !color) {
                    if (typeof alertify !== 'undefined') {
                        alertify.error('Please enter at least a size or color');
                    } else {
                        alert('Please enter at least a size or color');
                    }
                    return;
                }

                var variant = {
                    Size: size,
                    Color: color,
                    ColorCode: $('#createVariantColorCode').val(),
                    SKU: $('#createVariantSKU').val(),
                    Stock: parseInt($('#createVariantStock').val()) || 0,
                    AdditionalPrice: parseFloat($('#createVariantAdditionalPrice').val()) || 0,
                    IsAvailable: $('#createVariantIsAvailable').is(':checked')
                };

                if (editingVariantIndex >= 0) {
                    tempVariants[editingVariantIndex] = variant;
                    if (typeof alertify !== 'undefined') alertify.success('Variant updated');
                } else {
                    tempVariants.push(variant);
                    if (typeof alertify !== 'undefined') alertify.success('Variant added');
                }

                updateVariantsUI();
                bootstrap.Modal.getInstance(document.getElementById('createVariantModal')).hide();
            });

            // Delete variant - show modal
            var deleteCreateVariantModal = new bootstrap.Modal(document.getElementById('deleteCreateVariantModal'));

            $(document).on('click', '.delete-temp-variant-btn', function() {
                $('#deleteCreateVariantIndex').val($(this).data('index'));
                deleteCreateVariantModal.show();
            });

            // Confirm delete variant
            $('#confirmDeleteCreateVariantBtn').on('click', function() {
                var index = parseInt($('#deleteCreateVariantIndex').val());
                tempVariants.splice(index, 1);
                updateVariantsUI();
                deleteCreateVariantModal.hide();
                if (typeof alertify !== 'undefined') alertify.success('Variant removed');
            });
        });
    </script>
}
