            $('#isReturnableCheck').change(function () {
                $('#returnDaysInput').prop('disabled', !$(this).is(':checked'));
            });

            // Bengali text validation
            $('.bengali-only').on('input', function () {
                var text = $(this).val();
                var bengaliPattern = /^[\u0980-\u09FF\s\.,!?;:\-\(\)\[\]'"0-9]*$/;
                var errorSpan = $(this).siblings('.bengali-error');

                if (text && !bengaliPattern.test(text)) {
                    errorSpan.show();
                    $(this).addClass('is-invalid');
                } else {
                    errorSpan.hide();
                    $(this).removeClass('is-invalid');
                }
            });

            // English text validation
            $('.english-only').on('input', function () {
                var text = $(this).val();
                var englishPattern = /^[a-zA-Z0-9\s\.,!?;:\-\(\)\[\]'"]*$/;
                var errorSpan = $(this).siblings('.english-error');

                if (text && !englishPattern.test(text)) {
                    errorSpan.show();
                    $(this).addClass('is-invalid');
                } else {
                    errorSpan.hide();
                    $(this).removeClass('is-invalid');
                }
            });

            // Image Upload Management
            var uploadedImages = [];
            var primaryIndex = 0;

            $('#imageUploadInput').change(function () {
                var files = Array.from(this.files);

                files.forEach(function (file, index) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        uploadedImages.push({
                            file: file,
                            dataUrl: e.target.result,
                            name: file.name
                        });
                        if (uploadedImages.length === 1) {
                            primaryIndex = 0;
                        }
                        renderImageGrid();
                    };
                    reader.readAsDataURL(file);
                });

                $(this).val('');
            });

            function renderImageGrid() {
                var grid = $('#imagePreviewGrid');
                grid.empty();

                if (uploadedImages.length === 0) {
                    grid.html('<div class="col-12 text-center text-muted py-4" id="noImagesPlaceholder">' +
                        '<i class="fas fa-cloud-upload-alt fa-3x mb-2"></i>' +
                        '<p class="mb-0">No images uploaded yet. Select images above.</p></div>');
                    return;
                }

                uploadedImages.forEach(function (img, index) {
                    var isPrimary = index === primaryIndex;
                    var cardHtml = '<div class="col-6 col-md-4 col-lg-3">' +
                        '<div class="image-upload-card' + (isPrimary ? ' primary' : '') + '" data-index="' + index + '">' +
                        (isPrimary ? '<span class="primary-badge"><i class="fas fa-star me-1"></i>Primary</span>' : '') +
                        '<button type="button" class="edit-btn" onclick="editImage(' + index + '); event.stopPropagation();" title="Edit image">' +
                        '<i class="fas fa-edit"></i></button>' +
                        '<button type="button" class="remove-btn" onclick="removeImage(' + index + '); event.stopPropagation();" title="Remove image">' +
                        '<i class="fas fa-times"></i></button>' +
                        '<div class="image-wrapper">' +
                        '<img src="' + img.dataUrl + '" alt="' + img.name + '" />' +
                        '</div>' +
                        '<div class="image-actions">' +
                        (isPrimary ? '<span class="badge bg-success"><i class="fas fa-check me-1"></i>Primary Image</span>' :
                            '<button type="button" class="btn btn-sm btn-outline-success set-primary-btn" onclick="setPrimary(' + index + '); event.stopPropagation();">' +
                            '<i class="fas fa-star me-1"></i>Set as Primary</button>') +
                        '</div></div></div>';
                    grid.append(cardHtml);
                });

                updateHiddenInputs();
            }

            window.removeImage = function(index) {
                if (uploadedImages.length <= 1) {
                    if (typeof alertify !== 'undefined') {
                        alertify.warning('Cannot remove the last image. Every product must have at least one image.');
                    } else {
                        alert('Cannot remove the last image. Every product must have at least one image.');
                    }
                    return;
                }

                uploadedImages.splice(index, 1);

                if (primaryIndex >= uploadedImages.length) {
                    primaryIndex = uploadedImages.length - 1;
                } else if (primaryIndex > index) {
                    primaryIndex--;
                } else if (primaryIndex === index) {
                    primaryIndex = 0;
                }

                renderImageGrid();
            };

            window.setPrimary = function(index) {
                primaryIndex = index;
                renderImageGrid();
            };

            var editingImageIndex = -1;

            window.editImage = function(index) {
                editingImageIndex = index;
                var img = uploadedImages[index];
                if (img && img.dataUrl) {
                    openImageEditor(img.dataUrl);
                }
            };

            function updateHiddenInputs() {
                var primaryDT = new DataTransfer();
                var additionalDT = new DataTransfer();

                uploadedImages.forEach(function (img, index) {
                    if (index === primaryIndex) {
                        primaryDT.items.add(img.file);
                    } else {
                        additionalDT.items.add(img.file);
                    }
                });

                document.getElementById('primaryImageFile').files = primaryDT.files;
                document.getElementById('additionalImagesFile').files = additionalDT.files;
            }

            // Form validation before submit
            $('#productForm').on('submit', function (e) {
                var bengaliField = $('.bengali-only');
                var englishField = $('.english-only');

                var categoryId = $('#finalCategoryId').val();
                if (!categoryId || categoryId === '') {
                    e.preventDefault();
                    $('#categoryValidation').show();
                    $('#cascadingCategories .category-select:first').addClass('is-invalid');
                    if (typeof alertify !== 'undefined') {
                        alertify.error('Please select a category for the product');
                    }
                    $('html, body').animate({
                        scrollTop: $('#cascadingCategories').offset().top - 100
                    }, 300);
                    return false;
                }

                if (uploadedImages.length === 0) {
                    e.preventDefault();
                    if (typeof alertify !== 'undefined') {
                        alertify.error('Please upload at least one product image');
                    } else {
                        alert('Please upload at least one product image');
                    }
                    $('#imageUploadInput').focus();
                    return false;
                }

                if (bengaliField.hasClass('is-invalid')) {
                    e.preventDefault();
                    if (typeof alertify !== 'undefined') {
                        alertify.error('Please fix Bengali description field - only Bengali text allowed');
                    }
