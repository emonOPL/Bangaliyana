                        alertify.error('Please fix English description field - only English text allowed');
                    }
                    englishField.focus();
                    return false;
                }
            });

            // Validation Icons Management
            function initValidationIcons() {
                var formControls = $('#productForm').find('input.form-control, textarea.form-control, select.form-select');

                formControls.each(function () {
                    var $input = $(this);

                    if ($input.attr('type') === 'hidden' || $input.attr('type') === 'file' || $input.css('display') === 'none') {
                        return;
                    }

                    if ($input.closest('.input-group').length > 0) {
                        return;
                    }

                    if (!$input.parent().hasClass('validation-input-wrapper')) {
                        var isTextarea = $input.is('textarea');
                        $input.wrap('<div class="validation-input-wrapper' + (isTextarea ? ' textarea-wrapper' : '') + '"></div>');

                        var $wrapper = $input.parent();
                        $wrapper.append('<i class="fas fa-check-circle validation-icon valid-icon"></i>');
                        $wrapper.append('<i class="fas fa-exclamation-circle validation-icon invalid-icon"></i>');
                    }

                    $input.off('input.validation blur.validation change.validation').on('input.validation blur.validation change.validation', function () {
                        updateValidationState($(this));
                    });
                });
            }

            function updateValidationState($input) {
                var $wrapper = $input.parent('.validation-input-wrapper');
                if (!$wrapper.length) return;

                var value = $input.val();
                var hasCustomError = $input.hasClass('is-invalid');
                var $validationSpan = $input.siblings('span[data-valmsg-for]').add($input.parent().siblings('span[data-valmsg-for]'));
                var hasServerError = $validationSpan.length && $validationSpan.text().trim().length > 0 && $validationSpan.hasClass('field-validation-error');

                $wrapper.removeClass('is-valid is-invalid');
                $input.removeClass('is-valid');

                if (hasCustomError || hasServerError) {
                    $wrapper.addClass('is-invalid');
                } else if (value && value.toString().trim().length > 0) {
                    $wrapper.addClass('is-valid');
                }
            }

            setTimeout(function () {
                initValidationIcons();
            }, 100);

            // Camera Capture Functionality
            var cameraStream = null;
            var cameraCaptureModal = new bootstrap.Modal(document.getElementById('cameraCaptureModal'));
            var imageEditorModal = new bootstrap.Modal(document.getElementById('imageEditorModal'));

            var cropper = null;
            var originalImageDataUrl = null;
            var scaleX = 1;
            var scaleY = 1;

            function isMediaDevicesAvailable() {
                return !!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia);
            }

            function isSecureContext() {
                return window.isSecureContext ||
                       location.protocol === 'https:' ||
                       location.hostname === 'localhost' ||
                       location.hostname === '127.0.0.1';
            }

            $('#openCameraBtn').click(function() {
                if (isSecureContext() && isMediaDevicesAvailable()) {
                    openCameraDirectly();
                } else {
                    $('#nativeCameraInput').click();
                }
            });

            $('#nativeCameraInput').change(function() {
                var file = this.files[0];
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function(e) {
                        openImageEditor(e.target.result);
                    };
                    reader.readAsDataURL(file);
                }
                $(this).val('');
            });

            function openCameraDirectly() {
                $('#cameraError').addClass('d-none');
                $('#cameraVideo').show();

                var constraints = {
                    video: { facingMode: 'environment' },
                    audio: false
                };

                navigator.mediaDevices.getUserMedia(constraints)
                    .then(function(stream) {
                        cameraStream = stream;
                        var video = document.getElementById('cameraVideo');
                        video.srcObject = stream;
                        video.play();
                        cameraCaptureModal.show();

                        navigator.mediaDevices.enumerateDevices()
                            .then(function(devices) {
                                var videoDevices = devices.filter(function(d) { return d.kind === 'videoinput'; });
                                var cameraSelect = $('#cameraSelect');
                                cameraSelect.empty().append('<option value="">Select Camera</option>');

                                videoDevices.forEach(function(device, index) {
                                    cameraSelect.append(
                                        $('<option></option>')
                                            .val(device.deviceId)
                                            .text(device.label || 'Camera ' + (index + 1))
                                    );
                                });

                                var currentTrack = stream.getVideoTracks()[0];
                                if (currentTrack) {
                                    var settings = currentTrack.getSettings();
                                    if (settings.deviceId) {
                                        cameraSelect.val(settings.deviceId);
                                    }
                                }
                            });
                    })
                    .catch(function(err) {
                        console.log('Camera API failed, using native capture:', err.message);
                        $('#nativeCameraInput').click();
                    });
            }

            function startCamera(deviceId) {
                stopCamera();
                var constraints = {
                    video: deviceId ? { deviceId: { exact: deviceId } } : { facingMode: 'environment' },
                    audio: false
                };

                navigator.mediaDevices.getUserMedia(constraints)
                    .then(function(stream) {
                        cameraStream = stream;
                        var video = document.getElementById('cameraVideo');
                        video.srcObject = stream;
                        video.play();
                        $('#cameraError').addClass('d-none');
                    })
                    .catch(function(err) {
                        showCameraError('Camera access denied: ' + err.message);
                    });
            }

            function stopCamera() {
                if (cameraStream) {
                    cameraStream.getTracks().forEach(function(track) { track.stop(); });
                    cameraStream = null;
                }
            }

            function showCameraError(message) {
                $('#cameraErrorText').text(message);
                $('#cameraError').removeClass('d-none');
                $('#cameraVideo').hide();
            }

            $('#cameraSelect').change(function() {
                var deviceId = $(this).val();
                if (deviceId) startCamera(deviceId);
            });

            $('#capturePhotoBtn').click(function() {
                var video = document.getElementById('cameraVideo');
                var canvas = document.getElementById('hiddenCanvas');
                var ctx = canvas.getContext('2d');

                canvas.width = video.videoWidth;
                canvas.height = video.videoHeight;
                ctx.drawImage(video, 0, 0);

                var imageDataUrl = canvas.toDataURL('image/jpeg', 0.9);
                stopCamera();
                cameraCaptureModal.hide();
                openImageEditor(imageDataUrl);
            });

            $('#cameraCaptureModal').on('hidden.bs.modal', function() {
                stopCamera();
            });

            // Cropper.js Image Editor
            function openImageEditor(imageDataUrl) {
                originalImageDataUrl = imageDataUrl;
                scaleX = 1;
                scaleY = 1;

                $('.btn-ratio').removeClass('active');
                $('.btn-ratio[data-ratio="NaN"]').addClass('active');
                $('#zoomSlider').val(100);
                $('#zoomValue').text('100');

                var cropperImage = document.getElementById('cropperImage');
                cropperImage.src = imageDataUrl;

                imageEditorModal.show();

                setTimeout(function() {
                    if (cropper) {
                        cropper.destroy();
                    }
                    cropper = new Cropper(cropperImage, {
                        viewMode: 1,
                        aspectRatio: NaN,
                        autoCropArea: 1,
                        responsive: true,
                        restore: false,
                        guides: true,
                        center: true,
                        highlight: true,
                        cropBoxMovable: true,
                        cropBoxResizable: true,
                        toggleDragModeOnDblclick: false,
                        ready: function() {
                            $('#zoomSlider').val(100);
                            $('#zoomValue').text('100');
                        }
                    });
                }, 300);
            }

            $('#rotateLeftBtn').click(function() {
                if (cropper) cropper.rotate(-90);
            });

            $('#rotateRightBtn').click(function() {
                if (cropper) cropper.rotate(90);
            });

            $('#flipHorizontalBtn').click(function() {
                if (cropper) {
                    scaleX = scaleX * -1;
                    cropper.scaleX(scaleX);
                }
            });

            $('#flipVerticalBtn').click(function() {
                if (cropper) {
                    scaleY = scaleY * -1;
                    cropper.scaleY(scaleY);
                }
            });

            $('.btn-ratio').click(function() {
                $('.btn-ratio').removeClass('active');
                $(this).addClass('active');
                var ratio = parseFloat($(this).data('ratio'));
                if (cropper) {
                    cropper.setAspectRatio(ratio);
                }
            });

            $('#zoomSlider').on('input', function() {
                var val = parseInt($(this).val());
                $('#zoomValue').text(val);
                if (cropper) {
                    cropper.zoomTo(val / 100);
                }
            });

            $('#zoomInBtn').click(function() {
                var currentVal = parseInt($('#zoomSlider').val());
                var newVal = Math.min(200, currentVal + 10);
                $('#zoomSlider').val(newVal).trigger('input');
            });

            $('#zoomOutBtn').click(function() {
                var currentVal = parseInt($('#zoomSlider').val());
                var newVal = Math.max(50, currentVal - 10);
                $('#zoomSlider').val(newVal).trigger('input');
            });

            $('#resetAllBtn').click(function() {
                if (cropper && originalImageDataUrl) {
                    scaleX = 1;
                    scaleY = 1;
                    cropper.reset();
                    $('.btn-ratio').removeClass('active');
                    $('.btn-ratio[data-ratio="NaN"]').addClass('active');
                    $('#zoomSlider').val(100);
                    $('#zoomValue').text('100');
                }
            });

            $('#retakePhotoBtn').click(function() {
                if (cropper) {
                    cropper.destroy();
                    cropper = null;
                }
                imageEditorModal.hide();
                if (isSecureContext() && isMediaDevicesAvailable()) {
                    openCameraDirectly();
                } else {
                    $('#nativeCameraInput').click();
                }
            });

            $('#confirmImageBtn').click(function() {
                if (cropper) {
                    var canvas = cropper.getCroppedCanvas({
                        maxWidth: 1200,
                        maxHeight: 1200,
                        fillColor: '#fff'
                    });

                    canvas.toBlob(function(blob) {
                        var fileName = 'product_image_' + Date.now() + '.jpg';
                        var file = new File([blob], fileName, { type: 'image/jpeg' });

                        if (editingImageIndex >= 0) {
                            uploadedImages[editingImageIndex] = {
                                file: file,
                                dataUrl: canvas.toDataURL('image/jpeg', 0.9),
                                name: fileName
                            };
                            editingImageIndex = -1;
                        } else {
                            uploadedImages.push({
                                file: file,
                                dataUrl: canvas.toDataURL('image/jpeg', 0.9),
                                name: fileName
                            });
                            if (uploadedImages.length === 1) {
                                primaryIndex = 0;
                            }
                        }

                        renderImageGrid();
                        cropper.destroy();
                        cropper = null;
                        imageEditorModal.hide();
                    }, 'image/jpeg', 0.9);
                }
            });

            $('#imageEditorModal').on('hidden.bs.modal', function() {
                if (cropper) {
                    cropper.destroy();
                    cropper = null;
                }
                editingImageIndex = -1;
            });

            // =============================================
            // PRODUCT VARIANTS MANAGEMENT (Create Page)
            // =============================================

            var tempVariants = [];
            var editingVariantIndex = -1;

            function updateVariantsUI() {
                if (tempVariants.length === 0) {
                    $('#noVariantsMessage').show();
                    $('#variantsTableContainer').hide();
                } else {
                    $('#noVariantsMessage').hide();
                    $('#variantsTableContainer').show();

                    var tbody = $('#variantsTableBody');
                    tbody.empty();

                    tempVariants.forEach(function(v, index) {
                        var colorSwatch = v.ColorCode ? '<span style="background-color: ' + v.ColorCode + '; width: 18px; height: 18px; border-radius: 50%; border: 1px solid #ddd; display: inline-block; margin-right: 5px;"></span>' : '';
                        var row = '<tr data-index="' + index + '">' +
                            '<td>' + (v.Size ? '<span class="badge bg-secondary">' + v.Size + '</span>' : '<span class="text-muted">-</span>') + '</td>' +
                            '<td>' + (v.Color ? '<div class="d-flex align-items-center">' + colorSwatch + '<span>' + v.Color + '</span></div>' : '<span class="text-muted">-</span>') + '</td>' +
                            '<td><code class="small">' + (v.SKU || '-') + '</code></td>' +
                            '<td class="text-center"><span class="badge ' + (v.Stock > 0 ? 'bg-success' : 'bg-danger') + '">' + v.Stock + '</span></td>' +
                            '<td class="text-end">' + (v.AdditionalPrice > 0 ? '<span class="text-success">+৳' + v.AdditionalPrice + '</span>' : '<span class="text-muted">-</span>') + '</td>' +
                            '<td class="text-center">' + (v.IsAvailable ? '<span class="badge bg-success"><i class="fas fa-check"></i></span>' : '<span class="badge bg-secondary"><i class="fas fa-times"></i></span>') + '</td>' +
                            '<td class="text-end">' +
                                '<div class="btn-group btn-group-sm">' +
                                    '<button type="button" class="btn btn-outline-primary edit-temp-variant-btn" data-index="' + index + '" title="Edit"><i class="fas fa-edit"></i></button>' +
                                    '<button type="button" class="btn btn-outline-danger delete-temp-variant-btn" data-index="' + index + '" title="Delete"><i class="fas fa-trash"></i></button>' +
                                '</div>' +
                            '</td>' +
                        '</tr>';
                        tbody.append(row);
                    });
                }

                // Update hidden input
                $('#variantsJsonInput').val(JSON.stringify(tempVariants));
