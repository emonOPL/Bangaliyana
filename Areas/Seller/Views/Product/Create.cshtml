            // Sync color picker with text input
            $('#createVariantColorPicker').on('input', function() {
                $('#createVariantColorCode').val($(this).val());
            });
            $('#createVariantColorCode').on('input', function() {
                var val = $(this).val();
                if (/^#[0-9A-Fa-f]{6}$/.test(val)) {
                    $('#createVariantColorPicker').val(val);
