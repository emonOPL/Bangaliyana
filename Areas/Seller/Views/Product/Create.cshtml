@model Bangaliyana.Models.Products
@using Bangaliyana.Models

@{
    ViewData["Title"] = Localizer["AddNewProduct"].Value;
}

<div class="container py-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-success text-white py-3">
            <h4 class="mb-0"><i class="fas fa-plus-circle me-2"></i>@Localizer["AddNewProduct"]</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post" enctype="multipart/form-data" id="productForm">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <!-- Basic Information Section -->
                <div class="card mb-4 border-success">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="fas fa-info-circle text-success me-2"></i>@Localizer["BasicInformation"]</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="Name" class="form-label fw-semibold">@Localizer["ProductName"] <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" placeholder="@Localizer["EnterProductName"]" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="Description" class="form-label fw-semibold">@Localizer["MainDescription"] <span class="text-danger">*</span></label>
                                <textarea asp-for="Description" class="form-control" rows="4" placeholder="@Localizer["EnterMainProductDescription"]"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DescriptionBengali" class="form-label fw-semibold">@Localizer["DescriptionBengali"]</label>
                                <textarea asp-for="DescriptionBengali" class="form-control bengali-only" rows="4" placeholder="বাংলায় পণ্যের বিবরণ লিখুন"></textarea>
                                <span class="text-danger small bengali-error" style="display:none;">@Localizer["OnlyBengaliAllowed"]</span>
                                <span asp-validation-for="DescriptionBengali" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="DescriptionEnglish" class="form-label fw-semibold">@Localizer["DescriptionEnglish"]</label>
                                <textarea asp-for="DescriptionEnglish" class="form-control english-only" rows="4" placeholder="@Localizer["EnterProductDescriptionEnglish"]"></textarea>
                                <span class="text-danger small english-error" style="display:none;">@Localizer["OnlyEnglishAllowed"]</span>
                                <span asp-validation-for="DescriptionEnglish" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="ShortDescription" class="form-label fw-semibold">@Localizer["ShortDescription"]</label>
                                <textarea asp-for="ShortDescription" class="form-control" rows="2" placeholder="@Localizer["ShortDescriptionPlaceholder"]" maxlength="500"></textarea>
                                <span asp-validation-for="ShortDescription" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="Highlights" class="form-label fw-semibold">@Localizer["ProductHighlights"]</label>
                                <textarea asp-for="Highlights" class="form-control" rows="3" placeholder="@Localizer["KeyFeaturesOrHighlights"]"></textarea>
                                <small class="text-muted">@Localizer["EnterKeyFeaturesPerLine"]</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Pricing & Inventory Section -->
                <div class="card mb-4 border-primary">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="fas fa-tags text-primary me-2"></i>@Localizer["PricingAndInventory"]</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Price" class="form-label fw-semibold">@Localizer["PriceBDT"] <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">৳</span>
                                    <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="DiscountPrice" class="form-label fw-semibold">@Localizer["DiscountPriceBDT"]</label>
                                <div class="input-group">
                                    <span class="input-group-text">৳</span>
                                    <input asp-for="DiscountPrice" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
                                </div>
                                <small class="text-muted">@Localizer["LeaveEmptyIfNoDiscount"]</small>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Stock" class="form-label fw-semibold">@Localizer["StockQuantity"] <span class="text-danger">*</span></label>
                                <input asp-for="Stock" class="form-control" type="number" min="0" placeholder="0" id="stockInput" />
                                <span asp-validation-for="Stock" class="text-danger small"></span>
                                <small class="text-muted">@Localizer["SetToZeroForOutOfStock"]</small>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="SKU" class="form-label fw-semibold">@Localizer["SKU"]</label>
                                <input asp-for="SKU" class="form-control" placeholder="@Localizer["ProductSKUCode"]" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Status" class="form-label fw-semibold">@Localizer["ProductStatus"] <span class="text-danger">*</span></label>
                                <select asp-for="Status" class="form-select" id="statusSelect" asp-items="ViewBag.productStatuses">
                                    <option value="">@Localizer["SelectStatus"]</option>
                                </select>
                                <small class="text-muted">@Localizer["AutoSetOutOfStock"]</small>
                            </div>
                            <input type="hidden" asp-for="IsAvailable" value="true" />
                        </div>
                    </div>
                </div>

                <!-- Category & Classification Section -->
                <div class="card mb-4 border-warning">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="fas fa-folder-open text-warning me-2"></i>@Localizer["CategoryAndClassification"]</h5>
                    </div>
                    <div class="card-body">
                        <!-- Cascading Category Selection - 2 per row -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@Localizer["Category"] <span class="text-danger">*</span> <span class="text-muted">(@Localizer["SelectFromHierarchy"])</span></label>
                            <div id="categoryBreadcrumb" class="mb-2" style="display:none;">
                                <small class="text-info"><i class="fas fa-sitemap me-1"></i>@Localizer["Selected"]: <span id="categoryPath"></span></small>
                            </div>
                            <div id="cascadingCategories" class="row g-2">
                                <div class="col-md-6">
                                    <select class="form-select category-select" data-level="0" asp-items="ViewBag.rootCategories" required>
                                        <option value="">@Localizer["SelectCategory"]</option>
                                    </select>
                                </div>
                            </div>
                            <input type="hidden" asp-for="CategoryId" id="finalCategoryId" />
                            <span id="categoryValidation" class="text-danger small" style="display:none;">@Localizer["PleaseSelectCategory"]</span>
                            <small class="text-muted">@Localizer["SelectMostSpecificCategory"]</small>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="Tags" class="form-label fw-semibold">@Localizer["Tags"]</label>
                                <input asp-for="Tags" class="form-control" placeholder="@Localizer["EnterTagsSeparatedByCommas"]" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Brand" class="form-label fw-semibold">@Localizer["Brand"]</label>
                                <input asp-for="Brand" class="form-control" placeholder="@Localizer["BrandName"]" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Manufacturer" class="form-label fw-semibold">@Localizer["Manufacturer"]</label>
                                <input asp-for="Manufacturer" class="form-control" placeholder="@Localizer["ManufacturerName"]" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="CountryOfOrigin" class="form-label fw-semibold">@Localizer["CountryOfOrigin"]</label>
                                <input asp-for="CountryOfOrigin" class="form-control" placeholder="@Localizer["CountryOfOriginExample"]" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Product Details Section -->
                <div class="card mb-4 border-info">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="fas fa-clipboard-list text-info me-2"></i>@Localizer["ProductDetails"]</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Fabric" class="form-label fw-semibold">@Localizer["FabricMaterial"]</label>
                                <input asp-for="Fabric" class="form-control" placeholder="@Localizer["FabricMaterialExample"]" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Weight" class="form-label fw-semibold">@Localizer["WeightGrams"]</label>
                                <input asp-for="Weight" class="form-control" type="number" step="0.01" min="0" placeholder="@Localizer["WeightInGrams"]" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CareInstructions" class="form-label fw-semibold">@Localizer["CareInstructions"]</label>
                                <textarea asp-for="CareInstructions" class="form-control" rows="3" placeholder="@Localizer["CareInstructionsPlaceholder"]"></textarea>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="WarrantyInfo" class="form-label fw-semibold">@Localizer["WarrantyInformation"]</label>
                                <textarea asp-for="WarrantyInfo" class="form-control" rows="3" placeholder="@Localizer["WarrantyInfoPlaceholder"]"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Product Variants Section -->
                <div class="card mb-4 border-purple" style="border-color: #6f42c1 !important;">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-palette me-2" style="color: #6f42c1;"></i>@Localizer["ProductVariants"]</h5>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="addVariantBtn">
                            <i class="fas fa-plus me-1"></i>@Localizer["AddVariant"]
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info mb-3">
                            <i class="fas fa-info-circle me-2"></i>
                            @Localizer["VariantsDescription"]
                        </div>

                        <div id="variantsContainer">
                            <div class="text-center py-4" id="noVariantsMessage">
                                <i class="fas fa-cubes fa-3x text-muted mb-3"></i>
                                <p class="text-muted mb-0">@Localizer["NoVariantsYet"]</p>
                            </div>
                            <div class="table-responsive" id="variantsTableContainer" style="display: none;">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>@Localizer["Size"]</th>
                                            <th>@Localizer["Color"]</th>
                                            <th>@Localizer["SKU"]</th>
                                            <th class="text-center">@Localizer["Stock"]</th>
                                            <th class="text-end">@Localizer["AdditionalPrice"]</th>
                                            <th class="text-center">@Localizer["Status"]</th>
                                            <th class="text-end">@Localizer["Actions"]</th>
                                        </tr>
                                    </thead>
                                    <tbody id="variantsTableBody">
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Hidden input to store variants JSON -->
                        <input type="hidden" name="VariantsJson" id="variantsJsonInput" value="[]" />
                    </div>
                </div>

                <!-- Images Section -->
                <div class="card mb-4 border-secondary">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="fas fa-images text-secondary me-2"></i>@Localizer["ProductImages"] <span class="text-danger">*</span></h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info mb-3">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>@Localizer["Instructions"]:</strong> @Localizer["ImageUploadInstructions"]
                        </div>
                        <div class="row mb-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold">@Localizer["UploadImages"] <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input type="file" class="form-control" id="imageUploadInput" accept="image/*" multiple />
                                    <!-- Native camera capture for mobile (works on HTTP) -->
                                    <input type="file" accept="image/*" capture="environment" id="nativeCameraInput" class="d-none" />
                                    <button type="button" class="btn btn-outline-success camera-capture-btn" id="openCameraBtn" title="@Localizer["CaptureFromCamera"]">
                                        <i class="fas fa-camera"></i>
                                    </button>
                                </div>
                                <small class="text-muted">@Localizer["ImageUploadHint"]</small>
                            </div>
                        </div>

                        <!-- Image Preview Grid -->
                        <div id="imagePreviewGrid" class="row g-3 mb-3" style="min-height: 100px;">
                            <div class="col-12 text-center text-muted py-4" id="noImagesPlaceholder">
                                <i class="fas fa-cloud-upload-alt fa-3x mb-2"></i>
                                <p class="mb-0">@Localizer["NoImagesUploadedYet"]</p>
                            </div>
                        </div>

                        <!-- Hidden inputs for form submission -->
                        <input type="file" name="ImageUrl" id="primaryImageFile" style="display:none;" />
                        <input type="file" name="AdditionalImages" id="additionalImagesFile" multiple style="display:none;" />

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="VideoUrl" class="form-label fw-semibold">@Localizer["VideoURL"]</label>
                                <input asp-for="VideoUrl" class="form-control" placeholder="@Localizer["VideoURLPlaceholder"]" />
                                <small class="text-muted">@Localizer["ProductDemoVideo"]</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Shipping & Returns Section -->
                <div class="card mb-4 border-success">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="fas fa-truck text-success me-2"></i>@Localizer["ShippingAndReturns"]</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="EstimatedDeliveryDays" class="form-label fw-semibold">@Localizer["EstimatedDeliveryDays"]</label>
                                <input asp-for="EstimatedDeliveryDays" class="form-control" type="text" placeholder="@Localizer["DeliveryDaysExample"]" oninput="this.value = this.value.replace(/[^0-9-]/g, '')" />
                                <small class="text-muted">@Localizer["LeaveEmptyForDefault"]</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ReturnDays" class="form-label fw-semibold">@Localizer["ReturnPeriodDays"]</label>
                                <input asp-for="ReturnDays" class="form-control" type="number" min="0" value="7" id="returnDaysInput" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="IsCODAvailable" class="form-label fw-semibold d-block">@Localizer["CashOnDelivery"]</label>
                                <div class="form-check form-switch">
                                    <input asp-for="IsCODAvailable" class="form-check-input" type="checkbox" checked />
                                    <label class="form-check-label" for="IsCODAvailable">@Localizer["CODAvailable"]</label>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="IsReturnable" class="form-label fw-semibold d-block">@Localizer["Returnable"]</label>
                                <div class="form-check form-switch">
                                    <input asp-for="IsReturnable" class="form-check-input" type="checkbox" id="isReturnableCheck" checked />
                                    <label class="form-check-label" for="isReturnableCheck">@Localizer["AcceptReturns"]</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>@Localizer["BackToList"]
                    </a>
                    <div>
                        <button type="reset" class="btn btn-outline-warning me-2">
                            <i class="fas fa-undo me-2"></i>@Localizer["Reset"]
                        </button>
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save me-2"></i>@Localizer["SaveProduct"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add/Edit Variant Modal for Create -->
<div class="modal fade" id="createVariantModal" tabindex="-1" aria-labelledby="createVariantModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header modal-header-purple-gradient">
                <h5 class="modal-title text-white" id="createVariantModalLabel">
                    <i class="fas fa-palette me-2"></i><span id="createVariantModalTitle">Add New Variant</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="createVariantSize" class="form-label fw-semibold">Size</label>
                        <select id="createVariantSize" class="form-select">
                            <option value="">Select Size</option>
                            <option value="XS">XS</option>
                            <option value="S">S</option>
                            <option value="M">M</option>
                            <option value="L">L</option>
                            <option value="XL">XL</option>
                            <option value="XXL">XXL</option>
                            <option value="XXXL">XXXL</option>
                            <option value="Free Size">Free Size</option>
                            <option value="Custom">Custom...</option>
                        </select>
                        <input type="text" id="createCustomSize" class="form-control mt-2" placeholder="Enter custom size" style="display: none;" />
                    </div>
                    <div class="col-md-6">
                        <label for="createVariantColor" class="form-label fw-semibold">Color</label>
                        <input type="text" id="createVariantColor" class="form-control" placeholder="e.g., Red, Blue" />
                    </div>
                    <div class="col-md-6">
                        <label for="createVariantColorCode" class="form-label fw-semibold">Color Code</label>
                        <div class="input-group">
                            <input type="color" id="createVariantColorPicker" class="form-control form-control-color" value="#6f42c1" />
                            <input type="text" id="createVariantColorCode" class="form-control" placeholder="#FFFFFF" />
                        </div>
                        <small class="text-muted">Pick or enter hex color code</small>
                    </div>
                    <div class="col-md-6">
                        <label for="createVariantSKU" class="form-label fw-semibold">SKU</label>
                        <input type="text" id="createVariantSKU" class="form-control" placeholder="Variant SKU" />
                    </div>
                    <div class="col-md-6">
                        <label for="createVariantStock" class="form-label fw-semibold">Stock Quantity</label>
                        <input type="number" id="createVariantStock" class="form-control" min="0" value="0" />
                    </div>
                    <div class="col-md-6">
                        <label for="createVariantAdditionalPrice" class="form-label fw-semibold">Additional Price (BDT)</label>
                        <div class="input-group">
                            <span class="input-group-text">+৳</span>
                            <input type="number" id="createVariantAdditionalPrice" class="form-control" min="0" step="1" value="0" />
                        </div>
                        <small class="text-muted">Extra charge for this variant</small>
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="createVariantIsAvailable" checked />
                            <label class="form-check-label" for="createVariantIsAvailable">Available for purchase</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancel
                </button>
                <button type="button" class="btn text-white" id="saveCreateVariantBtn" style="background: #6f42c1;">
                    <i class="fas fa-save me-1"></i>Save Variant
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Variant Confirmation Modal for Create Page -->
<div class="modal fade" id="deleteCreateVariantModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content confirm-modal-content border-0 shadow-lg">
            <button type="button" class="btn-close confirm-modal-close" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="modal-body text-center p-4">
                <div class="confirm-icon-wrapper mb-3">
                    <div class="confirm-icon-circle confirm-icon-danger">
                        <i class="fas fa-trash-alt" style="font-size: 2.5rem;"></i>
                    </div>
                </div>
                <h4 class="modal-title fw-bold mb-2">Remove Variant?</h4>
                <p class="text-muted mb-1">Are you sure you want to remove this variant?</p>
                <p class="text-muted small mb-0">This variant will be removed from the list.</p>
                <input type="hidden" id="deleteCreateVariantIndex" />
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2 pt-0 pb-4">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Cancel
                </button>
                <button type="button" class="btn btn-danger px-4" id="confirmDeleteCreateVariantBtn">
                    <i class="fas fa-check me-1"></i> Yes, Remove
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Camera Capture Modal -->
<div class="modal fade" id="cameraCaptureModal" tabindex="-1" aria-labelledby="cameraCaptureModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="cameraCaptureModalLabel"><i class="fas fa-camera me-2"></i>Capture Image</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="closeCameraModal"></button>
            </div>
            <div class="modal-body text-center">
                <div id="cameraContainer">
                    <video id="cameraVideo" autoplay playsinline class="w-100 rounded"></video>
                </div>
                <div id="cameraError" class="alert alert-danger d-none mt-3">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <span id="cameraErrorText">Unable to access camera</span>
                </div>
                <div id="cameraControls" class="mt-3">
                    <select id="cameraSelect" class="form-select mb-3" style="max-width: 300px; margin: 0 auto;">
                        <option value="">Select Camera</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="cancelCameraBtn">
                    <i class="fas fa-times me-2"></i>Cancel
                </button>
                <button type="button" class="btn btn-success" id="capturePhotoBtn">
                    <i class="fas fa-camera me-2"></i>Capture Photo
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Image Editor Modal - Powered by Cropper.js -->
