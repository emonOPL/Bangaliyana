@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <!-- Cropper.js Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js" integrity="sha512-9KkIqdfN7ipEW6B6k+Aq20PV31bjODg4AA52W+tYtAE0jE0kMx49bjJ3FgvS56wzmyfMUHbQ4Km2b7l9+Y/+Eg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        $(document).ready(function () {
            // Cascading Category Selection
            var categorySelections = [];

            function updateCategoryPath() {
                if (categorySelections.length > 0) {
                    var pathNames = categorySelections.map(function(s) { return s.name; });
                    $('#categoryPath').text(pathNames.join(' > '));
                    $('#categoryBreadcrumb').show();
                } else {
                    $('#categoryBreadcrumb').hide();
                }
            }

            function loadChildCategories(parentId, level) {
                $.get('@Url.Action("GetCategoriesByParent", "Product", new { area = "Seller" })', { parentId: parentId }, function (data) {
                    if (data && data.length > 0) {
                        var newWrapper = $('<div class="col-md-6"></div>');
                        var newSelect = $('<select class="form-select category-select" data-level="' + level + '">' +
                            '<option value="">Select Subcategory</option>' +
                            '</select>');

                        $.each(data, function (i, item) {
                            newSelect.append(
                                $('<option></option>')
                                    .val(item.id)
                                    .text(item.name)
                                    .data('hasChildren', item.hasChildren)
                            );
                        });

                        newWrapper.append(newSelect);
                        $('#cascadingCategories').append(newWrapper);
                    }
                });
            }

            $(document).on('change', '.category-select', function () {
                var $this = $(this);
                var level = parseInt($this.data('level'));
                var selectedId = $this.val();
                var selectedText = $this.find('option:selected').text();
                var hasChildren = $this.find('option:selected').data('hasChildren');

                $('.category-select').filter(function() {
                    return parseInt($(this).data('level')) > level;
                }).closest('.col-md-6').remove();

                categorySelections = categorySelections.slice(0, level);

                if (selectedId) {
                    categorySelections.push({ id: selectedId, name: selectedText });
                    $('#finalCategoryId').val(selectedId);
                    $('#categoryValidation').hide();
                    $('#cascadingCategories .category-select').removeClass('is-invalid');

                    if (hasChildren) {
                        loadChildCategories(selectedId, level + 1);
                    }
                } else {
                    if (categorySelections.length > 0) {
                        $('#finalCategoryId').val(categorySelections[categorySelections.length - 1].id);
                    } else {
                        $('#finalCategoryId').val('');
                    }
