@using Bangaliyana.Models
@model IEnumerable<StockHistory>
@{
    ViewData["Title"] = "Stock History";
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var productId = ViewBag.ProductId as int?;
    var productName = ViewBag.ProductName as string;
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Inventory</a></li>
            <li class="breadcrumb-item active">Stock History</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="fas fa-history text-info me-2"></i>Stock History</h1>
            <p class="text-muted mb-0">
                @if (productId.HasValue)
                {
                    <span>History for: <strong>@productName</strong></span>
                }
                else
                {
                    <span>All stock changes for your products</span>
                }
            </p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to Inventory
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Date/Time</th>
                                @if (!productId.HasValue)
                                {
                                    <th>Product</th>
                                }
                                <th>Variant</th>
                                <th class="text-center">Before</th>
                                <th class="text-center">After</th>
                                <th class="text-center">Change</th>
                                <th>Reason</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var history in Model)
                            {
                                var changeBadge = history.QuantityChanged > 0 ? "bg-success" : "bg-danger";
                                <tr>
                                    <td>
                                        <small>@history.ChangedAt.ToBangladeshString("MMM dd, yyyy")</small><br>
                                        <small class="text-muted">@history.ChangedAt.ToBangladeshString("Hh:mm")</small>
                                    </td>
                                    @if (!productId.HasValue)
                                    {
                                        <td>@(history.Product?.Name ?? "Unknown")</td>
                                    }
                                    <td>
                                        @if (history.ProductVariant != null)
                                        {
                                            <small>@history.ProductVariant.Size / @history.ProductVariant.Color</small>
                                        }
                                        else
                                        {
                                            <small class="text-muted">-</small>
                                        }
                                    </td>
                                    <td class="text-center">@history.OldStock</td>
                                    <td class="text-center fw-bold">@history.NewStock</td>
                                    <td class="text-center">
                                        <span class="badge @changeBadge">
                                            @(history.QuantityChanged > 0 ? "+" : "")@history.QuantityChanged
                                        </span>
                                    </td>
                                    <td>
                                        @{
                                            var reasonBadge = history.Reason switch
                                            {
                                                StockChangeReason.OrderPlaced => "bg-primary",
                                                StockChangeReason.OrderCancelled => "bg-warning text-dark",
                                                StockChangeReason.Restock => "bg-success",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @reasonBadge">@history.Reason.ToString()</span>
                                        @if (history.Order != null)
                                        {
                                            <br><small class="text-muted">#@history.Order.OrderNumber</small>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">@(history.Notes ?? "-")</small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-history fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No stock history found</h5>
                    <p class="text-muted mb-0">Stock changes will appear here as they occur</p>
                </div>
            }
        </div>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="History" asp-route-page="@(currentPage - 1)" asp-route-productId="@productId">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                </li>
                @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="History" asp-route-page="@i" asp-route-productId="@productId">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="History" asp-route-page="@(currentPage + 1)" asp-route-productId="@productId">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>
