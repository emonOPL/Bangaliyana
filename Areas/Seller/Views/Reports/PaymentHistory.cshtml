@model X.PagedList.IPagedList<Bangaliyana.Models.SellerMonthlyReport>
@using X.PagedList.Mvc.Core
@using Bangaliyana.Extensions
@{
    ViewData["Title"] = "Payment History";
    var seller = ViewBag.Seller as Bangaliyana.Models.Seller;
    var legacyPayouts = ViewBag.LegacyPayouts as List<Bangaliyana.Models.ManualSellerPayout>;
    var totalPaid = (decimal)ViewBag.TotalPaid;
}

<div class="container py-4">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">My Reports</a></li>
                    <li class="breadcrumb-item active">Payment History</li>
                </ol>
            </nav>
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h4 class="mb-1">
                        <i class="fas fa-history text-success me-2"></i>Payment History
                    </h4>
                    <p class="text-muted mb-0">All your received payments</p>
                </div>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Back to Reports
                </a>
            </div>
        </div>
    </div>

    <!-- Summary Card -->
    <div class="row mb-4">
        <div class="col-md-6 mx-auto">
            <div class="card border-0 shadow-sm border-start border-success border-4">
                <div class="card-body text-center">
                    <h3 class="text-success mb-1">@totalPaid.ToString("N0") BDT</h3>
                    <small class="text-muted">Total Amount Received</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Paid Reports -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent">
            <h6 class="mb-0"><i class="fas fa-check-circle text-success me-2"></i>Completed Payments</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Period</th>
                            <th>Report #</th>
                            <th class="text-end">Sales</th>
                            <th class="text-end">Commission</th>
                            <th class="text-end">Amount Paid</th>
                            <th class="text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var report in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@(new DateTime(report.Year, report.Month, 1).ToString("MMMM yyyy"))</strong>
                                    </td>
                                    <td><span class="text-muted">@report.ReportNumber</span></td>
                                    <td class="text-end">@report.TotalSales.ToString("N0") BDT</td>
                                    <td class="text-end text-danger">-@report.CommissionAmount.ToString("N0") BDT</td>
                                    <td class="text-end fw-bold text-success">@report.PayoutAmount.ToString("N0") BDT</td>
                                    <td class="text-center">
                                        <span class="badge bg-success">Paid</span>
                                    </td>
                                </tr>
                            }
                        }
                        else if (legacyPayouts?.Any() != true)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                    No payment history yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model.PageCount > 1)
        {
            <div class="card-footer bg-transparent">
                <nav>
                    @Html.PagedListPager(Model, page => Url.Action("PaymentHistory", new { page }),
                        new PagedListRenderOptions
                        {
                            LiElementClasses = new[] { "page-item" },
                            PageClasses = new[] { "page-link" },
                            UlElementClasses = new[] { "pagination", "justify-content-center", "mb-0" }
                        })
                </nav>
            </div>
        }
    </div>

    <!-- Legacy Payouts (if any) -->
    @if (legacyPayouts?.Any() == true)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent">
                <h6 class="mb-0"><i class="fas fa-clock-rotate-left me-2"></i>Previous Payouts</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Payout #</th>
                                <th>Date</th>
                                <th>Method</th>
                                <th class="text-end">Amount</th>
                                <th class="text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payout in legacyPayouts)
                            {
                                <tr>
                                    <td><strong>@payout.PayoutNumber</strong></td>
                                    <td>@payout.CompletedAt?.ToString("dd MMM yyyy")</td>
                                    <td>@payout.PaymentMethod.GetDisplayName()</td>
                                    <td class="text-end fw-bold text-success">@payout.Amount.ToString("N0") BDT</td>
                                    <td class="text-center">
                                        <span class="badge bg-success">Completed</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
