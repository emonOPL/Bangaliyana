@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Return request modal
            const returnModal = document.getElementById('returnModal');
            returnModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const orderId = button.getAttribute('data-order-id');
                const orderNumber = button.getAttribute('data-order-number');

                document.getElementById('modalOrderId').value = orderId;
                // Use orderNumber if available, otherwise fall back to orderId
                const displayOrderNum = orderNumber && orderNumber.trim() !== '' ? orderNumber : orderId;
                document.getElementById('modalOrderNumber').textContent = '#' + displayOrderNum;

                // Reset form
                resetReturnForm();
            });

            // Cancel return confirmation modal
            let currentCancelForm = null;
            const cancelReturnModal = new bootstrap.Modal(document.getElementById('cancelReturnModal'));

            document.querySelectorAll('.cancel-return-btn').forEach(btn => {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    currentCancelForm = this.closest('.cancel-return-form');
                    cancelReturnModal.show();
                });
            });

            document.getElementById('confirmCancelReturnBtn')?.addEventListener('click', function () {
                if (currentCancelForm) {
                    cancelReturnModal.hide();
                    currentCancelForm.submit();
                }
            });

            // Image Upload Functionality
            const imageUploadZone = document.getElementById('imageUploadZone');
            const returnImagesInput = document.getElementById('returnImagesInput');
            const uploadPlaceholder = document.getElementById('uploadPlaceholder');
            const imagePreviewGrid = document.getElementById('imagePreviewGrid');
            let selectedFiles = [];
            const maxFiles = 5;
            const maxSize = 5 * 1024 * 1024; // 5MB
            const allowedTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];

            // Click to browse
            imageUploadZone.addEventListener('click', function (e) {
                if (e.target.closest('.remove-image')) return;
                returnImagesInput.click();
            });

            // File input change
            returnImagesInput.addEventListener('change', function () {
                handleFiles(this.files);
            });

            // Drag and drop
            imageUploadZone.addEventListener('dragover', function (e) {
                e.preventDefault();
                this.classList.add('dragover');
            });

            imageUploadZone.addEventListener('dragleave', function () {
                this.classList.remove('dragover');
            });

            imageUploadZone.addEventListener('drop', function (e) {
                e.preventDefault();
                this.classList.remove('dragover');
                handleFiles(e.dataTransfer.files);
            });

            function handleFiles(files) {
                for (let file of files) {
                    if (selectedFiles.length >= maxFiles) {
                        alert(`Maximum ${maxFiles} images allowed.`);
                        break;
                    }

                    if (!allowedTypes.includes(file.type)) {
                        alert(`${file.name} is not a supported image type.`);
                        continue;
                    }

                    if (file.size > maxSize) {
                        alert(`${file.name} exceeds 5MB limit.`);
                        continue;
                    }

                    selectedFiles.push(file);
                }

                updateImagePreviews();
                updateFileInput();
            }

            function updateImagePreviews() {
                imagePreviewGrid.innerHTML = '';

                if (selectedFiles.length > 0) {
                    uploadPlaceholder.style.display = 'none';

                    selectedFiles.forEach((file, index) => {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            const previewItem = document.createElement('div');
                            previewItem.className = 'image-preview-item';
                            previewItem.innerHTML = `
                                <img src="${e.target.result}" alt="Preview ${index + 1}" />
                                <button type="button" class="remove-image" data-index="${index}" title="Remove">
                                    <i class="fas fa-times"></i>
                                </button>
                            `;
                            imagePreviewGrid.appendChild(previewItem);
                        };
                        reader.readAsDataURL(file);
                    });
                } else {
                    uploadPlaceholder.style.display = 'block';
                }
            }

            function updateFileInput() {
                const dataTransfer = new DataTransfer();
                selectedFiles.forEach(file => dataTransfer.items.add(file));
                returnImagesInput.files = dataTransfer.files;
            }

            // Remove image
            imagePreviewGrid.addEventListener('click', function (e) {
                const removeBtn = e.target.closest('.remove-image');
                if (removeBtn) {
                    e.stopPropagation();
                    const index = parseInt(removeBtn.dataset.index);
                    selectedFiles.splice(index, 1);
                    updateImagePreviews();
                    updateFileInput();
                }
            });

            // Refund Method Functionality
            const preferReplacementCheck = document.getElementById('preferReplacementCheck');
            const refundMethodFields = document.getElementById('refundMethodFields');
            const mobileAccountSection = document.getElementById('mobileAccountSection');
            const bankAccountSection = document.getElementById('bankAccountSection');
            const refundMethodRadios = document.querySelectorAll('.refund-method-radio');
            const accountNumberLabel = document.getElementById('accountNumberLabel');

            // Toggle refund fields based on replacement preference
            preferReplacementCheck.addEventListener('change', function () {
                refundMethodFields.style.display = this.checked ? 'none' : 'block';
                if (this.checked) {
                    mobileAccountSection.style.display = 'none';
                    bankAccountSection.style.display = 'none';
                }
            });

            // Show/hide account details based on refund method
            refundMethodRadios.forEach(radio => {
                radio.addEventListener('change', function () {
                    const method = this.value;

                    mobileAccountSection.style.display = 'none';
                    bankAccountSection.style.display = 'none';

                    if (['Bkash', 'Nagad', 'Upay', 'Rocket'].includes(method)) {
                        mobileAccountSection.style.display = 'block';
                        const methodName = method === 'Bkash' ? 'bKash' : method;
                        accountNumberLabel.textContent = `Personal ${methodName} Number`;
                    } else if (method === 'BankTransfer') {
                        bankAccountSection.style.display = 'block';
                    }
                });
            });

            // Reset form function
            function resetReturnForm() {
                selectedFiles = [];
                updateImagePreviews();
                updateFileInput();

                // Reset reason select
                const reasonSelect = document.getElementById('returnReasonSelect');
                if (reasonSelect) {
                    reasonSelect.selectedIndex = 0;
                }

                // Reset details textarea
                const detailsTextarea = document.getElementById('Input_Details');
                if (detailsTextarea) {
                    detailsTextarea.value = '';
                }

                // Reset refund method
                const walletRadio = document.getElementById('refund_WalletCredit');
                if (walletRadio) {
                    walletRadio.checked = true;
                }
                mobileAccountSection.style.display = 'none';
                bankAccountSection.style.display = 'none';

                // Reset replacement checkbox
                preferReplacementCheck.checked = false;
                refundMethodFields.style.display = 'block';

                // Reset account number fields
                const accountNumberInput = document.getElementById('Input_AccountNumber');
                const accountHolderInput = document.getElementById('Input_AccountHolderName');
                const bankNameInput = document.getElementById('Input_BankName');
                if (accountNumberInput) accountNumberInput.value = '';
                if (accountHolderInput) accountHolderInput.value = '';
                if (bankNameInput) bankNameInput.value = '';
            }

            // Initialize tooltips
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}
