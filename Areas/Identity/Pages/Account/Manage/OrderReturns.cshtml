@page
@model OrderReturnsModel
@using Bangaliyana.Models
@using Bangaliyana.Extensions
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Bangaliyana.SharedResources> Localizer
@{
    ViewData["Title"] = Localizer["ReturnsReplacements"].Value;
    ViewData["ActivePage"] = ManageNavPages.OrderReturns;
}

<div class="returns-container">
    <!-- Header Section -->
    <div class="page-header mb-4">
        <div class="header-content">
            <h4 class="mb-1"><i class="fas fa-undo-alt me-2 text-warning"></i>@Localizer["ReturnsReplacements"]</h4>
            <p class="text-muted mb-0">@Localizer["ReturnsReplacementsDescription"]</p>
        </div>
    </div>

    <!-- Status Message -->
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        var alertClass = Model.StatusMessage.StartsWith("Error") ? "alert-danger" : "alert-success";
        <div class="alert @alertClass alert-dismissible fade show" role="alert">
            <i class="fas @(Model.StatusMessage.StartsWith("Error") ? "fa-exclamation-circle" : "fa-check-circle") me-2"></i>
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="stat-card stat-total">
                <div class="stat-icon">
                    <i class="fas fa-box-open"></i>
                </div>
                <div class="stat-info">
                    <span class="stat-value">@Model.TotalReturns</span>
                    <span class="stat-label">@Localizer["TotalReturns"]</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card stat-pending">
                <div class="stat-icon">
                    <i class="fas fa-hourglass-half"></i>
                </div>
                <div class="stat-info">
                    <span class="stat-value">@Model.PendingReturns</span>
                    <span class="stat-label">@Localizer["Pending"]</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card stat-completed">
                <div class="stat-icon">
                    <i class="fas fa-check-double"></i>
                </div>
                <div class="stat-info">
                    <span class="stat-value">@Model.CompletedReturns</span>
                    <span class="stat-label">@Localizer["Completed"]</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card stat-refunded">
                <div class="stat-icon">
                    <i class="fas fa-money-bill-wave"></i>
                </div>
                <div class="stat-info">
                    <span class="stat-value">৳@Model.TotalRefunded.ToString("N0")</span>
                    <span class="stat-label">@Localizer["Refunded"]</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Eligible for Return Section -->
    @if (Model.EligibleOrders.Any())
    {
        <div class="section-card mb-4">
            <div class="section-header">
                <h5 class="mb-0">
                    <i class="fas fa-shipping-fast me-2 text-success"></i>@Localizer["EligibleForReturn"]
                    <span class="badge bg-success ms-2">@Model.EligibleOrders.Count</span>
                </h5>
                <small class="text-muted">@Localizer["OrdersDeliveredWithin7Days"]</small>
            </div>
            <div class="section-body">
                @foreach (var order in Model.EligibleOrders)
                {
                    <div class="eligible-order-card">
                        <div class="order-header">
                            <div class="order-info">
                                <span class="order-number">#@order.OrderNumber</span>
                                <span class="order-date">@Localizer["Delivered"] @order.DeliveredAt?.ToBangladeshShortDateString()</span>
                            </div>
                            <div class="order-amount">৳@order.TotalAmount.ToString("N0")</div>
                        </div>
                        <div class="order-items">
                            @foreach (var item in order.OrderItems.Take(3))
                            {
                                <div class="order-item-mini">
                                    <img src="@(item.ProductImageUrl ?? "/images/products/noimage.jpg")" alt="@item.ProductName" class="item-thumb" />
                                    <div class="item-info">
                                        <span class="item-name">@item.ProductName</span>
                                        <span class="item-qty">@Localizer["Qty"]: @item.Quantity</span>
                                    </div>
                                </div>
                            }
                            @if (order.OrderItems.Count > 3)
                            {
                                <span class="more-items">+@(order.OrderItems.Count - 3) @Localizer["more"]</span>
                            }
                        </div>
                        <div class="order-actions">
                            <span class="return-deadline">
                                <i class="fas fa-clock me-1"></i>
                                @{
                                    var daysLeft = 7 - (DateTime.UtcNow - order.DeliveredAt!.Value).Days;
                                }
                                @daysLeft @Localizer["DaysLeftToReturn"]
                            </span>
                            <button type="button" class="btn btn-outline-warning btn-sm"
                                    data-bs-toggle="modal" data-bs-target="#returnModal"
                                    data-order-id="@order.Id"
                                    data-order-number="@order.OrderNumber">
                                <i class="fas fa-undo me-1"></i>@Localizer["RequestReturn"]
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Return History Section -->
    <div class="section-card">
        <div class="section-header">
            <h5 class="mb-0">
                <i class="fas fa-history me-2 text-info"></i>@Localizer["ReturnHistory"]
            </h5>
        </div>
        <div class="section-body">
            @if (Model.ReturnedOrders.Any())
            {
                @foreach (var order in Model.ReturnedOrders)
                {
                    var statusClass = order.PaymentStatus == PaymentStatus.Refunded ? "status-refunded" :
                                     order.PaymentStatus == PaymentStatus.PartiallyRefunded ? "status-partial" : "status-pending";
                    var statusText = order.PaymentStatus == PaymentStatus.Refunded ? Localizer["Refunded"].Value :
                                    order.PaymentStatus == PaymentStatus.PartiallyRefunded ? Localizer["PartiallyRefunded"].Value : Localizer["Processing"].Value;
                    var statusIcon = order.PaymentStatus == PaymentStatus.Refunded ? "fa-check-circle" :
                                    order.PaymentStatus == PaymentStatus.PartiallyRefunded ? "fa-minus-circle" : "fa-spinner fa-spin";

                    <div class="return-order-card">
                        <div class="return-status-indicator @statusClass"></div>
                        <div class="return-content">
                            <div class="return-header">
                                <div class="return-info">
                                    <span class="order-number">#@order.OrderNumber</span>
                                    <span class="return-date">@Localizer["Returned"] @order.ReturnedAt?.ToBangladeshShortDateString()</span>
                                </div>
                                <div class="return-badge @statusClass">
                                    <i class="fas @statusIcon me-1"></i>@statusText
                                </div>
                            </div>

                            <div class="return-reason">
                                <i class="fas fa-comment-alt me-2"></i>
                                @Model.FormatReturnReasonForDisplay(order.ReturnReason)
                            </div>

                            @if (order.PrefersReplacement)
                            {
                                <div class="replacement-badge mb-2">
                                    <i class="fas fa-exchange-alt me-1"></i>@Localizer["ReplacementRequested"]
                                </div>
                            }

                            <!-- Return Images -->
                            @{
                                var returnImages = Model.GetReturnImages(order);
                            }
                            @if (returnImages.Any())
                            {
                                <div class="return-images-section mb-3">
                                    <small class="text-muted d-block mb-2"><i class="fas fa-images me-1"></i>@Localizer["AttachedImages"]</small>
                                    <div class="return-images-grid">
                                        @foreach (var img in returnImages)
                                        {
                                            <a href="@img" target="_blank" class="return-image-thumb" data-bs-toggle="tooltip" title="Click to view full size">
                                                <img src="@img" alt="Return evidence" />
                                                <div class="image-overlay">
                                                    <i class="fas fa-search-plus"></i>
                                                </div>
                                            </a>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Refund Method Details -->
                            @if (order.PreferredRefundMethod != null && order.PreferredRefundMethod != RefundMethod.OriginalMethod && !order.PrefersReplacement)
                            {
                                <div class="refund-method-display mb-3">
                                    <small class="text-muted d-block mb-2"><i class="fas fa-money-check me-1"></i>@Localizer["RefundMethod"]</small>
                                    <div class="refund-method-info">
                                        <span class="method-badge" style="--method-color: @(order.PreferredRefundMethod switch {
                                            RefundMethod.WalletCredit => "#10b981",
                                            RefundMethod.Bkash => "#e2136e",
                                            RefundMethod.Nagad => "#f26622",
                                            RefundMethod.Upay => "#00a884",
                                            RefundMethod.Rocket => "#8c28bc",
                                            RefundMethod.BankTransfer => "#2563eb",
                                            _ => "#6b7280"
                                        })">
                                            @Model.GetRefundMethodDisplay(order.PreferredRefundMethod)
                                        </span>
                                        @if (!string.IsNullOrEmpty(order.RefundAccountNumber))
                                        {
                                            <span class="account-info">
                                                @if (order.PreferredRefundMethod == RefundMethod.BankTransfer)
                                                {
                                                    <span>@order.RefundBankName - @order.RefundAccountNumber</span>
                                                    @if (!string.IsNullOrEmpty(order.RefundAccountHolderName))
                                                    {
                                                        <span class="text-muted">(@order.RefundAccountHolderName)</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span>@order.RefundAccountNumber</span>
                                                }
                                            </span>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="return-items">
                                @foreach (var item in order.OrderItems.Take(2))
                                {
                                    <div class="return-item">
                                        <img src="@(item.ProductImageUrl ?? "/images/products/noimage.jpg")" alt="@item.ProductName" />
                                        <div class="item-details">
                                            <span class="item-name">@item.ProductName</span>
                                            <span class="item-meta">@Localizer["Qty"]: @item.Quantity × ৳@item.UnitPrice.ToString("N0")</span>
                                        </div>
                                    </div>
                                }
                                @if (order.OrderItems.Count > 2)
                                {
                                    <div class="more-items-badge">+@(order.OrderItems.Count - 2) @Localizer["MoreItems"]</div>
                                }
                            </div>

                            <div class="return-footer">
                                <div class="return-amount">
                                    <span class="amount-label">@Localizer["RefundAmount"]:</span>
                                    <span class="amount-value">৳@order.TotalAmount.ToString("N0")</span>
                                </div>
                                @if (order.PaymentStatus != PaymentStatus.Refunded && order.PaymentStatus != PaymentStatus.PartiallyRefunded)
                                {
                                    <form method="post" asp-page-handler="CancelReturn" class="d-inline cancel-return-form">
                                        <input type="hidden" name="orderId" value="@order.Id" />
                                        <button type="button" class="btn btn-outline-secondary btn-sm cancel-return-btn">
                                            <i class="fas fa-times me-1"></i>@Localizer["CancelReturn"]
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="fas fa-box-open"></i>
                    </div>
                    <h5>@Localizer["NoReturnsYet"]</h5>
                    <p class="text-muted">@Localizer["NoReturnsDescription"]</p>
                </div>
            }
        </div>
    </div>

    <!-- Return Policy Info -->
    <div class="policy-card mt-4">
        <div class="policy-header">
            <i class="fas fa-info-circle me-2"></i>@Localizer["ReturnReplacementPolicy"]
        </div>
        <div class="policy-content">
            <div class="row">
                <div class="col-md-4">
                    <div class="policy-item">
                        <div class="policy-icon bg-success-soft">
                            <i class="fas fa-calendar-check text-success"></i>
                        </div>
                        <div class="policy-text">
                            <strong>@Localizer["SevenDayReturnWindow"]</strong>
                            <p class="mb-0 small">@Localizer["ReturnWindowDescription"]</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="policy-item">
                        <div class="policy-icon bg-info-soft">
                            <i class="fas fa-exchange-alt text-info"></i>
                        </div>
                        <div class="policy-text">
                            <strong>@Localizer["FreeReplacements"]</strong>
                            <p class="mb-0 small">@Localizer["FreeReplacementsDescription"]</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="policy-item">
                        <div class="policy-icon bg-warning-soft">
                            <i class="fas fa-money-check-alt text-warning"></i>
                        </div>
                        <div class="policy-text">
                            <strong>@Localizer["QuickRefunds"]</strong>
                            <p class="mb-0 small">@Localizer["QuickRefundsDescription"]</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Return Request Modal -->
<div class="modal fade" id="returnModal" tabindex="-1" aria-labelledby="returnModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="returnModalLabel">
                    <i class="fas fa-undo me-2"></i>@Localizer["RequestReturn"]
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="RequestReturn" enctype="multipart/form-data">
                <div class="modal-body">
                    <input type="hidden" asp-for="Input.OrderId" id="modalOrderId" />

                    <div class="order-ref-display mb-3">
                        <span class="label">@Localizer["Order"]:</span>
                        <span class="value" id="modalOrderNumber"></span>
                    </div>

                    <!-- Return Reason Section -->
                    <div class="return-section mb-4">
                        <h6 class="section-title"><i class="fas fa-clipboard-list me-2"></i>@Localizer["ReturnDetails"]</h6>

                        <div class="mb-3">
                            <label asp-for="Input.Reason" class="form-label">@Localizer["ReasonForReturn"] <span class="text-danger">*</span></label>
                            <select asp-for="Input.Reason" class="form-select" id="returnReasonSelect" required>
                                <option value="" selected disabled>@Localizer["SelectAReason"]</option>
                                @foreach (var reason in Enum.GetValues<OrderReturnsModel.ReturnReason>())
                                {
                                    var displayName = reason.GetType().GetField(reason.ToString())
                                        ?.GetCustomAttributes(typeof(System.ComponentModel.DataAnnotations.DisplayAttribute), false)
                                        .Cast<System.ComponentModel.DataAnnotations.DisplayAttribute>()
                                        .FirstOrDefault()?.Name ?? reason.ToString();
                                    <option value="@reason">@displayName</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Details" class="form-label">@Localizer["AdditionalDetails"]</label>
                            <textarea asp-for="Input.Details" class="form-control" rows="3"
                                      placeholder="@Localizer["ProvideMoreDetailsPlaceholder"].Value"></textarea>
                        </div>
                    </div>

                    <!-- Image Upload Section -->
                    <div class="return-section mb-4">
                        <h6 class="section-title"><i class="fas fa-camera me-2"></i>@Localizer["UploadImages"] <span class="text-muted small fw-normal">(@Localizer["OptionalMax5Images"])</span></h6>

                        <div class="image-upload-zone" id="imageUploadZone">
                            <input type="file" name="ReturnImages" id="returnImagesInput"
                                   accept=".jpg,.jpeg,.png,.gif,.webp" multiple class="d-none" />
                            <div class="upload-placeholder" id="uploadPlaceholder">
                                <div class="upload-icon">
                                    <i class="fas fa-cloud-upload-alt"></i>
                                </div>
                                <p class="upload-text">@Localizer["DragDropOrBrowse"]</p>
                                <p class="upload-hint">@Localizer["SupportedFormatsMax5MB"]</p>
                            </div>
                            <div class="image-preview-grid" id="imagePreviewGrid"></div>
                        </div>
                    </div>

                    <!-- Refund Method Section -->
                    <div class="return-section mb-4" id="refundMethodSection">
                        <h6 class="section-title"><i class="fas fa-money-bill-wave me-2"></i>@Localizer["RefundMethod"]</h6>

                        <div class="form-check form-check-inline mb-3">
                            <input asp-for="Input.PreferReplacement" class="form-check-input" type="checkbox" id="preferReplacementCheck" />
                            <label asp-for="Input.PreferReplacement" class="form-check-label">
                                <i class="fas fa-exchange-alt me-1 text-info"></i>
                                @Localizer["PreferReplacementInsteadOfRefund"]
                            </label>
                        </div>

                        <div id="refundMethodFields">
                            <div class="mb-3">
                                <label asp-for="Input.RefundMethod" class="form-label">@Localizer["SelectRefundMethod"] <span class="text-danger">*</span></label>
                                <div class="refund-method-grid">
                                    @foreach (var method in Enum.GetValues<RefundMethod>().Where(m => m != RefundMethod.OriginalMethod))
                                    {
                                        var displayName = method.GetType().GetField(method.ToString())
                                            ?.GetCustomAttributes(typeof(System.ComponentModel.DataAnnotations.DisplayAttribute), false)
                                            .Cast<System.ComponentModel.DataAnnotations.DisplayAttribute>()
                                            .FirstOrDefault()?.Name ?? method.ToString();
                                        var iconClass = method switch
                                        {
                                            RefundMethod.WalletCredit => "fas fa-wallet",
                                            RefundMethod.BankTransfer => "fas fa-university",
                                            _ => ""
                                        };
                                        var logoUrl = method switch
                                        {
                                            RefundMethod.Bkash => "/images/logos/bkash-logo.png",
                                            RefundMethod.Nagad => "/images/logos/nagad-logo.png",
                                            RefundMethod.Upay => "/images/logos/upay-logo.png",
                                            RefundMethod.Rocket => "/images/logos/rocket-logo.png",
                                            _ => ""
                                        };
                                        var methodColor = method switch
                                        {
                                            RefundMethod.WalletCredit => "#10b981",
                                            RefundMethod.Bkash => "#e2136e",
                                            RefundMethod.Nagad => "#f26622",
                                            RefundMethod.Upay => "#00a884",
                                            RefundMethod.Rocket => "#8c28bc",
                                            RefundMethod.BankTransfer => "#2563eb",
                                            _ => "#6b7280"
                                        };
                                        var hasLogo = !string.IsNullOrEmpty(logoUrl);
                                        <div class="refund-method-option" data-method="@method">
                                            @if (method == RefundMethod.WalletCredit)
                                            {
                                                <input type="radio" name="Input.RefundMethod" value="@method" id="refund_@method"
                                                       class="refund-method-radio" checked />
                                            }
                                            else
                                            {
                                                <input type="radio" name="Input.RefundMethod" value="@method" id="refund_@method"
                                                       class="refund-method-radio" />
                                            }
                                            <label for="refund_@method" class="refund-method-label" style="--method-color: @methodColor">
                                                @if (hasLogo)
                                                {
                                                    <img src="@logoUrl" alt="@displayName" class="method-logo" />
                                                }
                                                else
                                                {
                                                    <i class="@iconClass method-icon"></i>
                                                }
                                                <span class="method-name">@displayName</span>
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Mobile Banking Account Details -->
                            <div class="account-details-section" id="mobileAccountSection" style="display: none;">
                                <div class="mb-3">
                                    <label asp-for="Input.AccountNumber" class="form-label">
                                        <span id="accountNumberLabel">@Localizer["AccountNumber"]</span> <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-phone"></i></span>
                                        <input asp-for="Input.AccountNumber" class="form-control"
                                               placeholder="01XXXXXXXXX" maxlength="11" />
                                    </div>
                                    <small class="text-muted">@Localizer["EnterMobileBankingNumber"]</small>
                                </div>
                            </div>

                            <!-- Bank Transfer Details -->
                            <div class="account-details-section" id="bankAccountSection" style="display: none;">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Input.AccountHolderName" class="form-label">@Localizer["AccountHolderName"] <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="fas fa-user"></i></span>
                                            <input asp-for="Input.AccountHolderName" class="form-control" placeholder="@Localizer["FullNameAsPerBank"].Value" />
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Input.BankName" class="form-label">@Localizer["BankName"] <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="fas fa-university"></i></span>
                                            <input asp-for="Input.BankName" class="form-control" placeholder="@Localizer["BankNamePlaceholder"].Value" />
                                        </div>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="Input.AccountNumber" class="form-label">@Localizer["AccountNumber"] <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-credit-card"></i></span>
                                        <input asp-for="Input.AccountNumber" class="form-control" placeholder="@Localizer["BankAccountNumberPlaceholder"].Value" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info small mb-0">
                        <i class="fas fa-info-circle me-2"></i>
                        @Localizer["ReturnRequestReviewInfo"]
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-paper-plane me-1"></i>@Localizer["SubmitRequest"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Cancel Return Confirmation Modal -->
<div class="modal fade" id="cancelReturnModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center px-4 pt-0 pb-4">
                <div class="cancel-icon-wrapper mb-3">
                    <div class="cancel-icon-circle">
                        <i class="fas fa-undo-alt text-warning"></i>
                    </div>
                </div>
                <h4 class="modal-title fw-bold mb-2">@Localizer["CancelReturnRequestQuestion"]</h4>
                <p class="text-muted mb-0">@Localizer["CancelReturnConfirmation"]</p>
                <p class="text-muted small">@Localizer["CanRequestReturnAgain"]</p>
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2 pt-0 pb-4">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                    <i class="fas fa-arrow-left me-1"></i> @Localizer["GoBack"]
                </button>
                <button type="button" class="btn btn-warning px-4" id="confirmCancelReturnBtn">
                    <i class="fas fa-check me-1"></i> @Localizer["YesCancel"]
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .returns-container {
        max-width: 100%;
    }

    .page-header {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: white;
        padding: 1.5rem;
        border-radius: 16px;
        margin-bottom: 1.5rem;
    }

    .page-header h4, .page-header p {
        color: white !important;
    }

    /* Stat Cards */
    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        transition: transform 0.2s ease;
    }

    .stat-card:hover {
        transform: translateY(-2px);
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
