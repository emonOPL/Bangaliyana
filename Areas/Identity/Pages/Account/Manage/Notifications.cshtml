<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Event delegation for copy buttons - much more reliable than inline onclick
        document.addEventListener('click', function(e) {
            // Find if clicked element is a copy button or inside one
            var button = e.target.closest('.copy-btn');
            if (!button) return;

            // Prevent the click from bubbling to the parent <a> tag
            e.preventDefault();
            e.stopPropagation();

            var code = button.getAttribute('data-code');
            if (!code) return;

            var copyIcon = button.querySelector('.copy-icon');
            var checkIcon = button.querySelector('.check-icon');
            var tooltip = button.querySelector('.copy-tooltip');

            // Show feedback immediately (synchronously) before async clipboard operation
            function showSuccess() {
                if (copyIcon) copyIcon.style.display = 'none';
                if (checkIcon) checkIcon.style.display = 'inline';
                button.classList.add('copied');
                if (tooltip) tooltip.classList.add('show');

                setTimeout(function() {
                    if (copyIcon) copyIcon.style.display = 'inline';
                    if (checkIcon) checkIcon.style.display = 'none';
                    button.classList.remove('copied');
                    if (tooltip) tooltip.classList.remove('show');
                }, 2000);
            }

            // Try modern clipboard API first
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(code).then(function() {
                    showSuccess();
                }).catch(function(err) {
                    console.error('Clipboard API failed:', err);
                    // Fallback to execCommand
                    fallbackCopy(code);
                    showSuccess();
                });
            } else {
                // Fallback for older browsers
                fallbackCopy(code);
                showSuccess();
            }
        });

        // Fallback copy method using execCommand
        function fallbackCopy(text) {
            var textArea = document.createElement('textarea');
            textArea.value = text;
            textArea.style.position = 'fixed';
            textArea.style.left = '-9999px';
            textArea.style.top = '-9999px';
            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();
            try {
                document.execCommand('copy');
            } catch (err) {
                console.error('Fallback copy failed:', err);
            }
            document.body.removeChild(textArea);
        }
    });
</script>
