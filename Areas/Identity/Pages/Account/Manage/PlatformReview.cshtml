@page
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Bangaliyana.SharedResources> Localizer
@model PlatformReviewModel
@{
    ViewData["Title"] = Localizer["PlatformReview"].Value;
    ViewData["ActivePage"] = ManageNavPages.PlatformReview;
}

<style>
    .star-rating {
        display: flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
        gap: 5px;
    }

    .star-rating input {
        display: none;
    }

    .star-rating label {
        cursor: pointer;
        font-size: 2rem;
        color: #ddd;
        transition: color 0.2s ease;
    }

    .star-rating label:hover,
    .star-rating label:hover ~ label,
    .star-rating input:checked ~ label {
        color: #ffc107;
    }

    .star-rating label::before {
        content: '\f005';
        font-family: 'Font Awesome 5 Free';
        font-weight: 900;
    }

    .review-card {
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .review-card .card-header {
        border-radius: 15px 15px 0 0;
        background: linear-gradient(135deg, #0066cc, #004499);
    }

    .review-preview {
        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
        border-radius: 10px;
        padding: 20px;
        margin-top: 20px;
    }

    .review-preview .stars {
        color: #ffc107;
    }

    /* Dark mode styles */
    [data-theme="dark"] .review-card {
        background-color: #1e1e2d;
        border-color: #3d3d5c;
    }

    [data-theme="dark"] .review-card .card-header {
        background: linear-gradient(135deg, #4a6cf7, #6366f1);
    }

    [data-theme="dark"] .review-card .card-body {
        background-color: #1e1e2d;
        color: #e0e0e0;
    }

    [data-theme="dark"] .form-control {
        background-color: #252538;
        border-color: #3d3d5c;
        color: #e0e0e0;
    }

    [data-theme="dark"] .form-control:focus {
        background-color: #2a2a40;
        border-color: #4a6cf7;
        color: #fff;
    }

    [data-theme="dark"] .star-rating label {
        color: #555;
    }

    [data-theme="dark"] .star-rating label:hover,
    [data-theme="dark"] .star-rating label:hover ~ label,
    [data-theme="dark"] .star-rating input:checked ~ label {
        color: #ffc107;
    }

    [data-theme="dark"] .review-preview {
        background: linear-gradient(135deg, #252538, #1e1e2d);
        border: 1px solid #3d3d5c;
    }

    [data-theme="dark"] .review-preview p {
        color: #e0e0e0;
    }

    [data-theme="dark"] h3, [data-theme="dark"] h5, [data-theme="dark"] h6 {
        color: #e0e0e0;
    }

    [data-theme="dark"] .text-muted {
        color: #a0a0a0 !important;
    }

    [data-theme="dark"] .form-label {
        color: #e0e0e0;
    }
</style>

<h3>
    @if (Model.HasExistingReview)
    {
        <i class="fa fa-edit text-primary me-2"></i>@Localizer["EditYourOpinion"]
    }
    else
    {
        <i class="fa fa-star text-warning me-2"></i>@Localizer["WriteSomethingAboutUs"]
    }
</h3>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-lg-8">
        <div class="card review-card">
            <div class="card-header text-white">
                <h5 class="mb-0">
                    <i class="fa fa-comment-dots me-2"></i>
                    @(Model.HasExistingReview ? Localizer["UpdateYourReview"].Value : Localizer["ShareYourExperience"].Value)
                </h5>
            </div>
            <div class="card-body">
                <form method="post">
                    <div class="mb-4">
                        <label class="form-label fw-bold">@Localizer["HowWouldYouRateExperience"]</label>
                        <div class="star-rating">
                            <input type="radio" id="star5" name="Input.Rating" value="5" @(Model.Input.Rating == 5 ? "checked" : "") />
                            <label for="star5" title="5 stars - Excellent!"></label>
                            <input type="radio" id="star4" name="Input.Rating" value="4" @(Model.Input.Rating == 4 ? "checked" : "") />
                            <label for="star4" title="4 stars - Great!"></label>
                            <input type="radio" id="star3" name="Input.Rating" value="3" @(Model.Input.Rating == 3 ? "checked" : "") />
                            <label for="star3" title="3 stars - Good"></label>
                            <input type="radio" id="star2" name="Input.Rating" value="2" @(Model.Input.Rating == 2 ? "checked" : "") />
                            <label for="star2" title="2 stars - Fair"></label>
                            <input type="radio" id="star1" name="Input.Rating" value="1" @(Model.Input.Rating == 1 ? "checked" : "") />
                            <label for="star1" title="1 star - Poor"></label>
                        </div>
                        <span asp-validation-for="Input.Rating" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.ReviewText" class="form-label fw-bold">@Localizer["YourReview"]</label>
                        <textarea asp-for="Input.ReviewText" class="form-control" rows="5"
                                  placeholder="Tell us about your experience with Bangaliyana. What did you like? What can we improve?"></textarea>
                        <span asp-validation-for="Input.ReviewText" class="text-danger"></span>
                        <small class="text-muted">@Localizer["ReviewCharacterLimit"]</small>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-save me-2"></i>@(Model.HasExistingReview ? Localizer["UpdateReview"].Value : Localizer["SubmitReview"].Value)
                        </button>
                        @if (Model.HasExistingReview)
                        {
                            <button type="button" class="btn btn-outline-danger" id="deleteReviewBtn">
                                <i class="fa fa-trash me-2"></i>@Localizer["DeleteReview"]
                            </button>
                        }
                    </div>
                </form>

                @if (Model.HasExistingReview)
                {
                    <div class="review-preview mt-4">
                        <h6 class="mb-3"><i class="fa fa-eye me-2"></i>@Localizer["PreviewHowOthersSeeIt"]</h6>
                        <div class="d-flex align-items-start">
                            <div>
                                <div class="stars mb-2">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= Model.Input.Rating)
                                        {
                                            <i class="fa fa-star"></i>
                                        }
                                        else
                                        {
                                            <i class="fa fa-star text-muted"></i>
                                        }
                                    }
                                </div>
                                <p class="mb-0" style="font-style: italic;">"@Model.Input.ReviewText"</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4 mt-4 mt-lg-0">
        <div class="card border-0 bg-light">
            <div class="card-body">
                <h6 class="card-title"><i class="fa fa-info-circle text-primary me-2"></i>@Localizer["AboutReviews"]</h6>
                <ul class="list-unstyled small text-muted mb-0">
                    <li class="mb-2"><i class="fa fa-check text-success me-2"></i>@Localizer["ReviewHelpsOthers"]</li>
                    <li class="mb-2"><i class="fa fa-check text-success me-2"></i>@Localizer["EditDeleteAnytime"]</li>
                    <li class="mb-2"><i class="fa fa-check text-success me-2"></i>@Localizer["OneReviewPerAccount"]</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@if (Model.HasExistingReview)
{
    <!-- Delete Review Confirmation Modal -->
    <div class="modal fade" id="deleteReviewModal" tabindex="-1" aria-labelledby="deleteReviewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content confirm-modal-content border-0 shadow-lg">
                <button type="button" class="btn-close confirm-modal-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="modal-body text-center p-4">
                    <div class="confirm-icon-wrapper mb-3">
                        <div class="confirm-icon-circle confirm-icon-danger">
                            <i class="fas fa-trash-alt" style="font-size: 2.5rem;"></i>
                        </div>
                    </div>
                    <h4 class="modal-title fw-bold mb-2" id="deleteReviewModalLabel">@Localizer["DeleteReviewQuestion"]</h4>
                    <p class="text-muted mb-1">@Localizer["ConfirmDeleteReview"]</p>
                    <p class="text-muted small mb-0">@Localizer["ActionCannotBeUndone"]</p>
                </div>
                <div class="modal-footer border-0 justify-content-center gap-2 pt-0 pb-4">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i> @Localizer["Cancel"]
                    </button>
                    <form method="post" asp-page-handler="Delete" class="d-inline">
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="fas fa-check me-1"></i> @Localizer["YesDelete"]
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.HasExistingReview)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const deleteModal = new bootstrap.Modal(document.getElementById('deleteReviewModal'));
                const deleteBtn = document.getElementById('deleteReviewBtn');

                if (deleteBtn) {
                    deleteBtn.addEventListener('click', function (e) {
                        e.preventDefault();
                        deleteModal.show();
                    });
                }
            });
        </script>
    }
}
