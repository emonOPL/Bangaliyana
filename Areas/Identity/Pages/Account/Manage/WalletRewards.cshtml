@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const convertInput = document.getElementById('convert-points');
        const walletAmount = document.getElementById('wallet-amount');
        const isPremium = @(Model.IsPremiumMember ? "true" : "false");
        const conversionRate = isPremium ? 50 : 100;

        if (convertInput && walletAmount) {
            convertInput.addEventListener('input', function() {
                const points = parseInt(this.value) || 0;
                const wallet = Math.round(points / conversionRate);
                walletAmount.textContent = wallet;
            });
        }
    });
</script>
}
