@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = Localizer["ForgotPassword"].Value;
}

<div class="auth-wrapper">
    <div class="container">
        <div class="row min-vh-100 align-items-center justify-content-center py-5">
            <div class="col-sm-10 col-md-8 col-lg-6 col-xl-5 col-xxl-4">
                <div class="auth-card shadow-lg rounded-4 overflow-hidden">
                    <div class="auth-form-panel p-4 p-md-5">
                        <!-- Header -->
                        <div class="auth-header text-center mb-4">
                            <h1 class="auth-title h3 mb-2">@Localizer["ForgotYourPassword"]</h1>
                            <p class="auth-subtitle text-muted">@Localizer["ForgotPasswordSubtitle"]</p>
                        </div>

                        <!-- Form -->
                        <form method="post" class="auth-form">
                            <div class="form-group mb-4">
                                <label asp-for="Input.Email" class="form-label">@Localizer["EmailAddress"]</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                    <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="@Localizer["EnterYourEmailAddress"]" />
                                </div>
                                <span asp-validation-for="Input.Email" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-warning btn-lg w-100 mb-3 text-white">
                                <i class="fas fa-paper-plane me-2"></i>@Localizer["SendResetLink"]
                            </button>
                        </form>

                        <!-- Info Alert -->
                        <div class="alert alert-info bg-info bg-opacity-10 border-info border-opacity-25 mb-4">
                            <div class="d-flex">
                                <i class="fas fa-info-circle me-2 mt-1 text-info"></i>
                                <div class="small">
                                    <strong>@Localizer["Note"]:</strong> @Localizer["CheckSpamFolderNote"]
                                </div>
                            </div>
                        </div>

                        <!-- Back to Login -->
                        <div class="text-center">
                            <a asp-page="./Login" class="text-decoration-none">
                                <i class="fas fa-arrow-left me-1"></i>@Localizer["BackToSignIn"]
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
/* Auth Wrapper */
.auth-wrapper {
    min-height: 100vh;
    background: linear-gradient(135deg, #f5f7fa 0%, #e4e8ec 100%);
}

[data-theme="dark"] .auth-wrapper {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
}

/* Auth Card */
.auth-card {
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.auth-card:hover {
    transform: translateY(-2px);
}

[data-theme="dark"] .auth-card {
    background-color: #1e1e2d;
    border-color: #3d3d5c;
}

/* Auth Header */
.auth-title {
    color: var(--text-color);
    font-weight: 700;
}

.auth-subtitle {
    font-size: 0.95rem;
}


/* Form Controls */
.auth-form .form-label {
    font-weight: 500;
    color: var(--text-color);
    margin-bottom: 0.5rem;
}

.auth-form .input-group-text {
    background-color: var(--bg-secondary);
    border-color: var(--border-color);
    color: var(--text-muted);
}

.auth-form .form-control {
    background-color: var(--bg-color);
    border-color: var(--border-color);
    color: var(--text-color);
    padding: 0.75rem 1rem;
}

.auth-form .form-control:focus {
    border-color: var(--primary-color);
    box-shadow: 0 0 0 0.2rem rgba(var(--primary-rgb), 0.15);
}

.auth-form .form-control::placeholder {
    color: var(--text-muted);
    opacity: 0.7;
}

/* Dark Mode Form Styles */
[data-theme="dark"] .auth-form .input-group-text {
    background-color: #2a2a40;
    border-color: #3d3d5c;
    color: #a0a0a0;
}

[data-theme="dark"] .auth-form .form-control {
    background-color: #1e1e2d;
    border-color: #3d3d5c;
    color: #e0e0e0;
}

[data-theme="dark"] .auth-form .form-control:focus {
    background-color: #2a2a40;
    border-color: #4a6cf7;
    color: #e0e0e0;
}

[data-theme="dark"] .auth-form .form-control::placeholder {
    color: #6c6c8a;
}

/* Button Styles */
.auth-form .btn-warning {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    border: none;
    font-weight: 600;
    padding: 0.875rem 1.5rem;
    transition: all 0.3s ease;
}

.auth-form .btn-warning:hover {
    background: linear-gradient(135deg, #d97706 0%, #b45309 100%);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.35);
}

/* Alert Styles - Hide empty validation messages */
.auth-form .alert-danger:empty,
.auth-form .alert-danger:not(:has(*:not(i))),
.text-danger:empty,
[asp-validation-summary]:empty,
.validation-summary-valid {
    display: none !important;
}

[data-theme="dark"] .alert-info {
    background-color: rgba(59, 130, 246, 0.1) !important;
    border-color: rgba(59, 130, 246, 0.2) !important;
    color: #93c5fd !important;
}

[data-theme="dark"] .alert-info .text-info {
    color: #60a5fa !important;
}

[data-theme="dark"] .alert-danger {
    background-color: rgba(239, 68, 68, 0.1);
    border-color: rgba(239, 68, 68, 0.2);
    color: #fca5a5;
}

/* Link Styles */
.auth-form-panel a {
    color: var(--primary-color);
    transition: color 0.2s ease;
}

.auth-form-panel a:hover {
    color: var(--primary-hover);
}

/* Animation */
.auth-card {
    animation: slideInUp 0.5s ease-out;
}

@@keyframes slideInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Responsive Adjustments */
@@media (max-width: 576px) {
    .auth-form-panel {
        padding: 1.5rem !important;
    }

    .auth-title {
        font-size: 1.5rem;
    }
}
</style>
