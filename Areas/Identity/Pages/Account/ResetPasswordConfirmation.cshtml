@page
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Bangaliyana.SharedResources> Localizer
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = Localizer["ResetPasswordConfirmation"].Value;
}

<h1>@ViewData["Title"]</h1>
<p>
    @Localizer["PasswordResetSuccess"] <a asp-page="./Login">@Localizer["ClickHereToLogin"]</a>
</p>
