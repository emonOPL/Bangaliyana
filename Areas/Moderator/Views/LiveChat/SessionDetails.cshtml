@model Bangaliyana.Models.SupportChatSession
@using Bangaliyana.Models
@using Bangaliyana.Extensions
@{
    ViewData["Title"] = "Session Details";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">
                <i class="fas fa-comments text-primary me-2"></i>Session Details
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Live Chat</a></li>
                    <li class="breadcrumb-item"><a asp-action="History">History</a></li>
                    <li class="breadcrumb-item active">@Model.SessionCode</li>
                </ol>
            </nav>
        </div>
        <a asp-action="History" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to History
        </a>
    </div>

    <div class="row">
        <!-- Chat Transcript -->
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="fas fa-comment-alt text-primary me-2"></i>Chat Transcript
                        </h5>
                        @switch (Model.Status)
                        {
                            case ChatSessionStatus.Waiting:
                                <span class="badge bg-warning text-dark fs-6">Waiting</span>
                                break;
                            case ChatSessionStatus.Active:
                                <span class="badge bg-success fs-6">Active</span>
                                break;
                            case ChatSessionStatus.OnHold:
                                <span class="badge bg-info fs-6">On Hold</span>
                                break;
                            case ChatSessionStatus.Closed:
                                <span class="badge bg-secondary fs-6">Closed</span>
                                break;
                            case ChatSessionStatus.Abandoned:
                                <span class="badge bg-danger fs-6">Abandoned</span>
                                break;
                        }
                    </div>
                </div>
                <div class="card-body chat-transcript">
                    @if (Model.Messages?.Any() == true)
                    {
                        @foreach (var msg in Model.Messages.OrderBy(m => m.CreatedAt))
                        {
                            if (msg.IsSystemMessage)
                            {
                                <div class="system-message">
                                    <p>@msg.Content</p>
                                    <small class="text-muted">@msg.CreatedAt.ToBangladeshTimeString()</small>
                                </div>
                            }
                            else
                            {
                                <div class="message @(msg.IsAgentMessage ? "agent" : "customer")">
                                    <div class="message-header">
                                        <strong>@(msg.IsAgentMessage ? (Model.Agent?.FullName ?? "Agent") : Model.VisitorName)</strong>
                                        <small class="text-muted">@msg.CreatedAt.ToBangladeshTimeString()</small>
                                    </div>
                                    <div class="message-bubble">@msg.Content</div>
                                    @if (!string.IsNullOrEmpty(msg.AttachmentUrl))
                                    {
                                        <div class="attachment mt-2">
                                            <a href="@msg.AttachmentUrl" target="_blank" class="btn btn-sm btn-outline-secondary">
                                                <i class="fas fa-paperclip me-1"></i>@msg.AttachmentName
                                            </a>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fas fa-comments fa-3x mb-3"></i>
                            <p>No messages in this session</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Feedback -->
            @if (!string.IsNullOrEmpty(Model.Feedback))
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-comment text-info me-2"></i>Customer Feedback
                        </h5>
                    </div>
                    <div class="card-body">
                        <p class="mb-0">@Model.Feedback</p>
                    </div>
                </div>
            }
        </div>

        <!-- Session Info Sidebar -->
        <div class="col-lg-4">
            <!-- Visitor Info -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-user text-primary me-2"></i>Visitor Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="avatar-lg me-3">
                            <div class="avatar-placeholder">
                                <i class="fas fa-user"></i>
                            </div>
                        </div>
                        <div>
                            <h6 class="mb-0">@Model.VisitorName</h6>
                            @if (Model.User != null)
                            {
                                <span class="badge bg-success">Registered User</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Guest</span>
                            }
                        </div>
                    </div>
                    <div class="info-list">
                        <div class="info-item">
                            <i class="fas fa-envelope text-muted"></i>
                            <span>@Model.VisitorEmail</span>
                        </div>
                        <div class="info-item">
                            <i class="fas fa-building text-muted"></i>
                            <span>@Model.Department</span>
                        </div>
                        <div class="info-item">
                            <i class="fas fa-globe text-muted"></i>
                            <span>@(Model.IpAddress ?? "Unknown")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Session Details -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle text-primary me-2"></i>Session Details
                    </h5>
                </div>
                <div class="card-body">
                    <div class="detail-row">
                        <span class="detail-label">Session Code</span>
                        <code>@Model.SessionCode</code>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Started</span>
                        <span>@Model.CreatedAt.ToBangladeshDateString()</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Agent Joined</span>
                        <span>@(Model.AgentJoinedAt?.ToBangladeshTimeString() ?? "N/A")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Ended</span>
                        <span>@(Model.ClosedAt?.ToBangladeshDateString() ?? "N/A")</span>
                    </div>
                    @if (Model.ClosedAt.HasValue)
                    {
                        var duration = Model.ClosedAt.Value - Model.CreatedAt;
                        <div class="detail-row">
                            <span class="detail-label">Duration</span>
                            <span>@duration.TotalMinutes.ToString("F0") minutes</span>
                        </div>
                    }
                    <div class="detail-row">
                        <span class="detail-label">Messages</span>
                        <span>@(Model.Messages?.Count ?? 0)</span>
                    </div>
                </div>
            </div>

            <!-- Agent Info -->
            @if (Model.Agent != null)
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-headset text-success me-2"></i>Assigned Agent
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="avatar-lg me-3">
                                <div class="avatar-placeholder bg-success-soft">
                                    <i class="fas fa-headset text-success"></i>
                                </div>
                            </div>
                            <div>
                                <h6 class="mb-0">@Model.Agent.FullName</h6>
                                <small class="text-muted">@Model.Agent.Email</small>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Rating -->
            @if (Model.Rating.HasValue)
            {
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-star text-warning me-2"></i>Customer Rating
                        </h5>
                    </div>
                    <div class="card-body text-center">
                        <div class="star-display mb-2">
                            @for (int i = 0; i < Model.Rating.Value; i++)
                            {
                                <i class="fas fa-star text-warning"></i>
                            }
                            @for (int i = Model.Rating.Value; i < 5; i++)
                            {
                                <i class="far fa-star text-muted"></i>
                            }
                        </div>
                        <h4 class="mb-0">@Model.Rating / 5</h4>
                    </div>
                </div>
            }

            <!-- Initial Query -->
            @if (!string.IsNullOrEmpty(Model.InitialQuery))
            {
                <div class="card mt-4">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-question-circle text-info me-2"></i>Initial Query
                        </h5>
                    </div>
                    <div class="card-body">
                        <p class="mb-0">@Model.InitialQuery</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .chat-transcript {
        max-height: 600px;
        overflow-y: auto;
        background: #f9fafb;
    }

    .message {
        margin-bottom: 1.5rem;
    }

    .message.customer {
        padding-right: 20%;
    }

    .message.agent {
        padding-left: 20%;
    }

    .message-header {
        margin-bottom: 0.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .message.agent .message-header {
        flex-direction: row-reverse;
    }

    .message-bubble {
        padding: 0.75rem 1rem;
        border-radius: 12px;
        line-height: 1.6;
    }

    .message.customer .message-bubble {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px 12px 12px 0;
    }

    .message.agent .message-bubble {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        border-radius: 12px 12px 0 12px;
    }

    .system-message {
        text-align: center;
        margin: 1.5rem 0;
    }

    .system-message p {
        display: inline-block;
        background: #e5e7eb;
        color: #6b7280;
        padding: 0.5rem 1rem;
        border-radius: 50px;
        margin: 0;
    }

    .avatar-lg {
        width: 50px;
        height: 50px;
    }

    .avatar-placeholder {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 1.25rem;
    }

    .bg-success-soft {
        background: rgba(16, 185, 129, 0.1) !important;
    }

    .info-list {
        border-top: 1px solid #e5e7eb;
        padding-top: 1rem;
        margin-top: 1rem;
    }

    .info-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem 0;
    }

    .info-item i {
        width: 20px;
        text-align: center;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
        border-bottom: 1px solid #f3f4f6;
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-label {
        color: #6b7280;
    }

    .star-display i {
        font-size: 1.5rem;
    }

    /* Dark mode */
    [data-theme="dark"] .card {
        background: #1f2937;
        border-color: #374151;
    }

    [data-theme="dark"] .chat-transcript {
        background: #111827;
    }

    [data-theme="dark"] .message.customer .message-bubble {
        background: #374151;
        border-color: #4b5563;
        color: #f3f4f6;
    }

    [data-theme="dark"] .system-message p {
        background: #374151;
        color: #d1d5db;
    }

    [data-theme="dark"] .info-list {
        border-color: #374151;
    }

    [data-theme="dark"] .detail-row {
        border-color: #374151;
    }
</style>
