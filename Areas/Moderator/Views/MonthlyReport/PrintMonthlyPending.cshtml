@model IEnumerable<Bangaliyana.Models.SellerMonthlyReport>
@using Bangaliyana.Extensions
@{
    Layout = null;
    var year = (int)ViewBag.Year;
    var month = (int)ViewBag.Month;
    var monthName = ViewBag.MonthName as string;
    var printDate = (DateTime)ViewBag.PrintDate;
    var generatedBy = ViewBag.GeneratedBy as string;
    var totalPayable = (decimal)ViewBag.TotalPayable;
    var totalSales = (decimal)ViewBag.TotalSales;
    var totalCommission = (decimal)ViewBag.TotalCommission;
}

<!DOCTYPE html>
<html>
<head>
    <title>Pending Payouts - @monthName</title>
    <style>
        body { font-family: Arial, sans-serif; font-size: 12px; margin: 20px; }
        .header { text-align: center; margin-bottom: 20px; border-bottom: 2px solid #333; padding-bottom: 10px; }
        .header h1 { margin: 0; font-size: 18px; }
        .header p { margin: 5px 0; color: #666; }
        .summary-box { background: #f5f5f5; padding: 15px; margin-bottom: 20px; display: flex; justify-content: space-around; }
        .summary-item { text-align: center; }
        .summary-item .value { font-size: 18px; font-weight: bold; }
        .summary-item .label { color: #666; font-size: 11px; }
        .reports-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        .reports-table th, .reports-table td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        .reports-table th { background: #f5f5f5; }
        .reports-table .text-end { text-align: right; }
        .reports-table .text-center { text-align: center; }
        .reports-table .text-danger { color: #dc3545; }
        .reports-table .text-success { color: #198754; }
        .reports-table tfoot { font-weight: bold; background: #e8f5e9; }
        .footer { margin-top: 30px; font-size: 10px; color: #666; text-align: center; border-top: 1px solid #ddd; padding-top: 10px; }
        @@media print { body { margin: 0; } .no-print { display: none; } }
    </style>
</head>
<body>
    <div class="no-print" style="margin-bottom: 20px;">
        <button onclick="window.print()" style="padding: 10px 20px; cursor: pointer;">Print Report</button>
        <button onclick="window.close()" style="padding: 10px 20px; cursor: pointer; margin-left: 10px;">Close</button>
    </div>

    <div class="header">
        <h1>Pending Seller Payouts</h1>
        <p>@monthName</p>
    </div>

    <div class="summary-box">
        <div class="summary-item">
            <div class="value">@Model.Count()</div>
            <div class="label">Total Reports</div>
        </div>
        <div class="summary-item">
            <div class="value">@totalSales.ToString("N0") BDT</div>
            <div class="label">Total Sales</div>
        </div>
        <div class="summary-item">
            <div class="value text-danger">@totalCommission.ToString("N0") BDT</div>
            <div class="label">Total Commission</div>
        </div>
        <div class="summary-item">
            <div class="value text-success">@totalPayable.ToString("N0") BDT</div>
            <div class="label">Total Payable</div>
        </div>
    </div>

    <table class="reports-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Report #</th>
                <th>Seller</th>
                <th class="text-end">Sales</th>
                <th class="text-end">Commission</th>
                <th class="text-end">Deductions</th>
                <th class="text-end">Carry Forward</th>
                <th class="text-end">Net Payable</th>
                <th class="text-center">Status</th>
            </tr>
        </thead>
        <tbody>
            @{ var index = 0; }
            @foreach (var report in Model)
            {
                index++;
                <tr>
                    <td>@index</td>
                    <td>@report.ReportNumber</td>
                    <td>@(report.Seller?.ShopName ?? "N/A")</td>
                    <td class="text-end">@report.TotalSales.ToString("N0")</td>
                    <td class="text-end text-danger">-@report.CommissionAmount.ToString("N0")</td>
                    <td class="text-end text-danger">-@((report.RefundDeductions + report.ReturnDeductions).ToString("N0"))</td>
                    <td class="text-end">+@report.CarryForwardFromPrevious.ToString("N0")</td>
                    <td class="text-end text-success">@report.NetPayable.ToString("N0")</td>
                    <td class="text-center">@report.Status.GetDisplayName()</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3">TOTAL</td>
                <td class="text-end">@totalSales.ToString("N0")</td>
                <td class="text-end text-danger">-@totalCommission.ToString("N0")</td>
                <td class="text-end text-danger">-@Model.Sum(r => r.RefundDeductions + r.ReturnDeductions).ToString("N0")</td>
                <td class="text-end">+@Model.Sum(r => r.CarryForwardFromPrevious).ToString("N0")</td>
                <td class="text-end text-success">@totalPayable.ToString("N0")</td>
                <td></td>
            </tr>
        </tfoot>
    </table>

    <div class="footer">
        <p>Generated on @printDate.ToString("dd MMMM yyyy, hh:mm tt") by @generatedBy</p>
        <p>This is a computer-generated document. No signature required.</p>
    </div>
</body>
</html>
