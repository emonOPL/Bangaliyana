@model X.PagedList.IPagedList<Bangaliyana.Models.SellerMonthlyReport>
@using X.PagedList.Mvc.Core
@using Bangaliyana.Extensions
@{
    ViewData["Title"] = "Pending Payout Reports";
    var sellerGroups = ViewBag.SellerGroups as IEnumerable<dynamic>;
    var totalPendingAmount = (decimal)ViewBag.TotalPendingAmount;
    var totalPendingReports = (int)ViewBag.TotalPendingReports;
}

<div class="container py-4">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-2">
                            <li class="breadcrumb-item"><a href="@Url.Action("Index")">Monthly Reports</a></li>
                            <li class="breadcrumb-item active">Pending Payout</li>
                        </ol>
                    </nav>
                    <h4 class="mb-1">
                        <i class="fas fa-clock text-warning me-2"></i>Pending Payout Reports
                    </h4>
                    <p class="text-muted mb-0">Reports eligible for payment (>= 500 BDT)</p>
                </div>
                <div class="d-flex gap-2">
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Back to Reports
                    </a>
                    @if (Model.Any())
                    {
                        <a href="@Url.Action("PrintPendingPayouts", new { year = DateTime.Now.Year, month = DateTime.Now.Month })" target="_blank" class="btn btn-outline-primary">
                            <i class="fas fa-print me-1"></i>Print All
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card border-0 shadow-sm h-100 border-start border-warning border-4">
                <div class="card-body text-center">
                    <h3 class="text-warning mb-1">@totalPendingReports</h3>
                    <small class="text-muted">Pending Reports</small>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card border-0 shadow-sm h-100 border-start border-success border-4">
                <div class="card-body text-center">
                    <h3 class="text-success mb-1">@totalPendingAmount.ToString("N0") BDT</h3>
                    <small class="text-muted">Total Pending Amount</small>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card border-0 shadow-sm h-100 border-start border-info border-4">
                <div class="card-body text-center">
                    <h3 class="text-info mb-1">@(sellerGroups?.Count() ?? 0)</h3>
                    <small class="text-muted">Sellers with Pending Payouts</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Seller Summary -->
    @if (sellerGroups?.Any() == true)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent">
                <h6 class="mb-0"><i class="fas fa-users me-2"></i>Summary by Seller</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Seller</th>
                                <th class="text-center">Reports</th>
                                <th class="text-end">Total Payable</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var seller in sellerGroups)
                            {
                                <tr>
                                    <td><strong>@seller.SellerName</strong></td>
                                    <td class="text-center"><span class="badge bg-warning text-dark">@seller.ReportCount</span></td>
                                    <td class="text-end fw-bold text-success">@(((decimal)seller.TotalPayable).ToString("N0")) BDT</td>
                                    <td class="text-center">
                                        <a asp-area="Moderator" asp-controller="Payment" asp-action="SellerPaymentDetails" asp-route-id="@seller.SellerId" class="btn btn-sm btn-primary">
                                            <i class="fas fa-money-bill-wave me-1"></i>Process Payment
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- Detailed Reports Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent">
            <h6 class="mb-0"><i class="fas fa-list me-2"></i>Pending Reports Detail</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Report #</th>
                            <th>Seller</th>
                            <th>Period</th>
                            <th class="text-end">Sales</th>
                            <th class="text-end">Commission</th>
                            <th class="text-end">Net Payable</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var report in Model)
                            {
                                var statusClass = report.Status switch
                                {
                                    MonthlyReportStatus.PendingPayout => "bg-warning text-dark",
                                    MonthlyReportStatus.Finalized => "bg-info",
                                    _ => "bg-secondary"
                                };
                                <tr>
                                    <td>
                                        <a href="@Url.Action("Details", new { id = report.Id })">
                                            <strong>@report.ReportNumber</strong>
                                        </a>
                                    </td>
                                    <td>
                                        <a href="@Url.Action("SellerHistory", new { sellerId = report.SellerId })">
                                            @(report.Seller?.ShopName ?? "N/A")
                                        </a>
                                    </td>
                                    <td>@(new DateTime(report.Year, report.Month, 1).ToString("MMM yyyy"))</td>
                                    <td class="text-end">@report.TotalSales.ToString("N0")</td>
                                    <td class="text-end text-danger">-@report.CommissionAmount.ToString("N0")</td>
                                    <td class="text-end fw-bold text-success">@report.NetPayable.ToString("N0")</td>
                                    <td class="text-center">
                                        <span class="badge @statusClass">@report.Status.GetDisplayName()</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <a href="@Url.Action("Details", new { id = report.Id })" class="btn btn-outline-primary" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="@Url.Action("PrintReport", new { id = report.Id })" class="btn btn-outline-secondary" target="_blank" title="Print">
                                                <i class="fas fa-print"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="fas fa-check-circle fa-2x mb-2 d-block text-success"></i>
                                    No pending payout reports. All payments are up to date!
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model.PageCount > 1)
        {
            <div class="card-footer bg-transparent">
                <nav>
                    @Html.PagedListPager(Model, page => Url.Action("PendingPayout", new { page }),
                        new PagedListRenderOptions
                        {
                            LiElementClasses = new[] { "page-item" },
                            PageClasses = new[] { "page-link" },
                            UlElementClasses = new[] { "pagination", "justify-content-center", "mb-0" }
                        })
                </nav>
            </div>
        }
    </div>
</div>
