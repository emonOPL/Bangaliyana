@model X.PagedList.IPagedList<Bangaliyana.Models.SellerMonthlyReport>
@using X.PagedList.Mvc.Core
@using Bangaliyana.Extensions
@{
    ViewData["Title"] = "Monthly Reports";
    var summary = ViewBag.Summary as Bangaliyana.Services.SellerMonthlyReportSummary;
}

<div class="container py-4">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h4 class="mb-1">
                        <i class="fas fa-file-invoice-dollar text-primary me-2"></i>Seller Monthly Reports
                    </h4>
                    <p class="text-muted mb-0">@ViewBag.MonthName - Period-based payment tracking</p>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="@Url.Action("PendingPayout")" class="btn btn-warning">
                        <i class="fas fa-clock me-1"></i>Pending Payouts
                    </a>
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#seedHistoricalModal">
                        <i class="fas fa-database me-1"></i>Seed Historical Data
                    </button>
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#processMonthEndModal">
                        <i class="fas fa-calendar-check me-1"></i>Process Month End
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    @if (summary != null)
    {
        <div class="row mb-4">
            <div class="col-md-6 col-lg-3 mb-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <h3 class="text-primary mb-1">@summary.TotalSellers</h3>
                        <small class="text-muted">Total Sellers</small>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 mb-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <h3 class="text-success mb-1">@summary.TotalSales.ToString("N0") BDT</h3>
                        <small class="text-muted">Total Sales</small>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 mb-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <h3 class="text-warning mb-1">@summary.EligibleForPayout</h3>
                        <small class="text-muted">Eligible for Payout</small>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 mb-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <h3 class="text-info mb-1">@summary.TotalPayable.ToString("N0") BDT</h3>
                        <small class="text-muted">Total Payable</small>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Year</label>
                    <select name="year" class="form-select">
                        @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 5; y--)
                        {
                            <option value="@y" selected="@(ViewBag.CurrentYear == y)">@y</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Month</label>
                    <select name="month" class="form-select">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(ViewBag.CurrentMonth == m)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Status</label>
                    <select name="status" class="form-select">
                        <option value="">All Status</option>
                        @foreach (var status in (MonthlyReportStatus[])ViewBag.ReportStatuses)
                        {
                            <option value="@status" selected="@(ViewBag.CurrentStatus?.ToString() == status.ToString())">@status.GetDisplayName()</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-filter me-1"></i>Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Reports Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Report #</th>
                            <th>Seller</th>
                            <th>Period</th>
                            <th class="text-end">Sales</th>
                            <th class="text-end">Commission</th>
                            <th class="text-end">Net Payable</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var report in Model)
                            {
                                <tr>
                                    <td>
                                        <a href="@Url.Action("Details", new { id = report.Id })">
                                            <strong>@report.ReportNumber</strong>
                                        </a>
                                    </td>
                                    <td>
                                        <a href="@Url.Action("SellerHistory", new { sellerId = report.SellerId })">
                                            @(report.Seller?.ShopName ?? "N/A")
                                        </a>
                                    </td>
                                    <td>@(new DateTime(report.Year, report.Month, 1).ToString("MMM yyyy"))</td>
                                    <td class="text-end">@report.TotalSales.ToString("N0")</td>
                                    <td class="text-end text-danger">-@report.CommissionAmount.ToString("N0")</td>
                                    <td class="text-end fw-bold text-success">@report.NetPayable.ToString("N0")</td>
                                    <td class="text-center">
                                        @{
                                            var statusClass = report.Status switch
                                            {
                                                MonthlyReportStatus.Open => "bg-primary",
                                                MonthlyReportStatus.Finalized => "bg-info",
                                                MonthlyReportStatus.PendingPayout => "bg-warning",
                                                MonthlyReportStatus.PayoutCreated => "bg-secondary",
                                                MonthlyReportStatus.Paid => "bg-success",
                                                MonthlyReportStatus.CarriedForward => "bg-dark",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @statusClass">@report.Status.GetDisplayName()</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <a href="@Url.Action("Details", new { id = report.Id })" class="btn btn-outline-primary" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="@Url.Action("PrintReport", new { id = report.Id })" class="btn btn-outline-secondary" target="_blank" title="Print">
                                                <i class="fas fa-print"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                    No reports found for the selected period.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model.PageCount > 1)
        {
            <div class="card-footer bg-transparent">
                <nav>
                    @Html.PagedListPager(Model, page => Url.Action("Index", new { page, year = ViewBag.CurrentYear, month = ViewBag.CurrentMonth, status = ViewBag.CurrentStatus }),
                        new PagedListRenderOptions
                        {
                            LiElementClasses = new[] { "page-item" },
                            PageClasses = new[] { "page-link" },
                            UlElementClasses = new[] { "pagination", "justify-content-center", "mb-0" }
                        })
                </nav>
            </div>
        }
    </div>
</div>

<!-- Seed Historical Data Confirmation Modal -->
<div class="modal fade" id="seedHistoricalModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-body text-center p-4">
                <div class="mb-3">
                    <div class="bg-secondary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="fas fa-database text-secondary" style="font-size: 2rem;"></i>
                    </div>
                </div>
                <h4 class="fw-bold mb-2">Seed Historical Data?</h4>
                <p class="text-muted mb-1">This will process all existing delivered orders into monthly reports.</p>
                <p class="text-muted small mb-0">This operation may take some time depending on the number of orders.</p>
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2 py-4">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancel
                </button>
                <form asp-action="SeedHistoricalData" method="post" class="m-0 d-inline-flex">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-database me-1"></i>Seed Data
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Process Month End Confirmation Modal -->
<div class="modal fade" id="processMonthEndModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-body text-center p-4">
                <div class="mb-3">
                    <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="fas fa-calendar-check text-danger" style="font-size: 2rem;"></i>
                    </div>
                </div>
                <h4 class="fw-bold mb-2">Process Month End?</h4>
                <p class="text-muted mb-1">This will finalize the previous month and process all seller reports.</p>
                <p class="text-muted small mb-0">Reports will be marked as pending payout or carried forward based on minimum threshold.</p>
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2 py-4">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancel
                </button>
                <form asp-action="ProcessMonthEnd" method="post" class="m-0 d-inline-flex">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="fas fa-calendar-check me-1"></i>Process
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
