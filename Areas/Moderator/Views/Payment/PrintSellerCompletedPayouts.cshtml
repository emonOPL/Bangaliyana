@using Bangaliyana.Models
@{
    Layout = null;
    var seller = ViewBag.Seller as Seller;
    var completedPayouts = ViewBag.CompletedPayouts as IEnumerable<ManualSellerPayout>;
    var printDate = (DateTime)ViewBag.PrintDate;
    var generatedBy = ViewBag.GeneratedBy as string;
    var totalAmount = (decimal)ViewBag.TotalAmount;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Completed Payouts - @seller?.ShopName</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Tahoma, sans-serif; font-size: 10px; line-height: 1.4; color: #333; padding: 15px; }
        .header { text-align: center; margin-bottom: 20px; padding-bottom: 15px; border-bottom: 2px solid #27ae60; }
        .header h1 { font-size: 18px; margin-bottom: 5px; color: #27ae60; }
        .header h2 { font-size: 14px; font-weight: normal; color: #666; }
        .seller-info { background: #f8f9fa; padding: 10px; border-radius: 5px; margin-bottom: 15px; }
        .seller-info h3 { font-size: 14px; margin-bottom: 5px; }
        .meta-info { display: flex; justify-content: space-between; margin-bottom: 15px; font-size: 10px; color: #666; }
        .meta-info span { background: #e8f5e9; padding: 4px 8px; border-radius: 3px; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        th, td { border: 1px solid #ddd; padding: 6px 4px; text-align: left; font-size: 9px; }
        th { background: #27ae60; color: white; font-weight: 600; text-transform: uppercase; }
        tr:nth-child(even) { background: #f9f9f9; }
        .text-right { text-align: right; }
        .text-center { text-align: center; }
        .amount { font-weight: bold; color: #27ae60; }
        .summary-row { background: #e8f5e9 !important; font-weight: bold; }
        .summary-row td { border-top: 2px solid #27ae60; }
        .footer { margin-top: 30px; padding-top: 15px; border-top: 1px solid #ddd; font-size: 9px; color: #666; display: flex; justify-content: space-between; }
        .signature-section { margin-top: 40px; display: flex; justify-content: space-between; }
        .signature-box { width: 200px; text-align: center; }
        .signature-line { border-top: 1px solid #333; margin-top: 40px; padding-top: 5px; font-size: 10px; }
        .no-print { position: fixed; top: 10px; right: 10px; z-index: 1000; }
        .btn { padding: 8px 16px; background: #27ae60; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 12px; margin-left: 5px; }
        .btn:hover { background: #219a52; }
        .btn-secondary { background: #6c757d; }
        @@media print { .no-print { display: none; } body { padding: 0; } }
    </style>
</head>
<body>
    <div class="no-print">
        <button class="btn" onclick="window.print()">Print</button>
        <button class="btn btn-secondary" onclick="window.close()">Close</button>
    </div>

    <div class="header">
        <h1>Bangaliyana - Completed Seller Payouts</h1>
        <h2>Payment Report for @seller?.ShopName</h2>
    </div>

    <div class="seller-info">
        <h3>@seller?.ShopName</h3>
        <p>Email: @seller?.User?.Email | Phone: @seller?.User?.PhoneNumber</p>
    </div>

    <div class="meta-info">
        <span>Generated: @printDate.ToString("dd MMM yyyy HH:mm")</span>
        <span>Generated By: @generatedBy</span>
        <span>Total Payouts: @(completedPayouts?.Count() ?? 0)</span>
        <span>Total Amount: ৳@totalAmount.ToString("N0")</span>
    </div>

    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Payout No</th>
                <th>Date</th>
                <th>Method</th>
                <th>Sender Info</th>
                <th>Reference/TrxID</th>
                <th class="text-right">Amount</th>
                <th>Processed By</th>
            </tr>
        </thead>
        <tbody>
            @if (completedPayouts != null && completedPayouts.Any())
            {
                var index = 1;
                decimal grandTotal = 0;
                foreach (var payout in completedPayouts)
                {
                    grandTotal += payout.Amount;
                    <tr>
                        <td class="text-center">@index</td>
                        <td>@payout.PayoutNumber</td>
                        <td>@payout.PaymentDate?.ToString("dd/MM/yy")</td>
                        <td>@payout.PaymentMethodDisplay</td>
                        <td>
                            @if (payout.IsBankTransfer)
                            {
                                <span>@payout.SenderBankName - @payout.SenderAccountNumber</span>
                            }
                            else if (payout.IsMobileBanking)
                            {
                                <span>@payout.SenderMobileNumber</span>
                            }
                            else
                            {
                                <span>Cash</span>
                            }
                        </td>
                        <td>
                            @if (payout.IsBankTransfer)
                            {
                                @(payout.BankTransactionReference ?? "-")
                            }
                            else if (payout.IsMobileBanking)
                            {
                                @(payout.MobileTransactionId ?? "-")
                            }
                            else
                            {
                                @(payout.Notes ?? "-")
                            }
                        </td>
                        <td class="text-right amount">৳@payout.Amount.ToString("N0")</td>
                        <td>@payout.ProcessedByName</td>
                    </tr>
                    index++;
                }
                <tr class="summary-row">
                    <td colspan="6" class="text-right"><strong>TOTAL:</strong></td>
                    <td class="text-right amount">৳@grandTotal.ToString("N0")</td>
                    <td></td>
                </tr>
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center" style="padding: 30px;">No completed payouts found</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="signature-section">
        <div class="signature-box"><div class="signature-line">Prepared By</div></div>
        <div class="signature-box"><div class="signature-line">Verified By</div></div>
        <div class="signature-box"><div class="signature-line">Approved By</div></div>
    </div>

    <div class="footer">
        <span>Bangaliyana E-commerce Platform</span>
        <span>Confidential - For Accounting Use Only</span>
    </div>
</body>
</html>
