@using Bangaliyana.Models
@{
    Layout = null;
    var pendingPayments = ViewBag.PendingPayments as IEnumerable<dynamic>;
    var month = (int)ViewBag.Month;
    var year = (int)ViewBag.Year;
    var printDate = (DateTime)ViewBag.PrintDate;
    var generatedBy = ViewBag.GeneratedBy as string;
    var monthName = new DateTime(year, month, 1).ToString("MMMM yyyy");
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Pending Seller Payouts - @monthName</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 11px;
            line-height: 1.4;
            color: #333;
            padding: 15px;
        }
        .header {
            text-align: center;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 2px solid #333;
        }
        .header h1 {
            font-size: 20px;
            margin-bottom: 5px;
            color: #1a1a1a;
        }
        .header h2 {
            font-size: 14px;
            font-weight: normal;
            color: #666;
        }
        .meta-info {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
            font-size: 10px;
            color: #666;
        }
        .meta-info span {
            background: #f5f5f5;
            padding: 4px 8px;
            border-radius: 3px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 8px 6px;
            text-align: left;
        }
        th {
            background: #2c3e50;
            color: white;
            font-weight: 600;
            font-size: 10px;
            text-transform: uppercase;
        }
        tr:nth-child(even) {
            background: #f9f9f9;
        }
        tr:hover {
            background: #f0f0f0;
        }
        .text-right {
            text-align: right;
        }
        .text-center {
            text-align: center;
        }
        .amount {
            font-weight: bold;
            color: #27ae60;
        }
        .shop-name {
            font-weight: 600;
            color: #2c3e50;
        }
        .contact-info {
            font-size: 9px;
            color: #666;
        }
        .bank-info, .mobile-info {
            font-size: 9px;
            color: #555;
            line-height: 1.3;
        }
        .completion-cell {
            min-width: 120px;
            height: 60px;
            background: #fffef0;
        }
        .summary-row {
            background: #ecf0f1 !important;
            font-weight: bold;
        }
        .summary-row td {
            border-top: 2px solid #333;
        }
        .footer {
            margin-top: 30px;
            padding-top: 15px;
            border-top: 1px solid #ddd;
            font-size: 9px;
            color: #666;
            display: flex;
            justify-content: space-between;
        }
        .signature-section {
            margin-top: 40px;
            display: flex;
            justify-content: space-between;
        }
        .signature-box {
            width: 200px;
            text-align: center;
        }
        .signature-line {
            border-top: 1px solid #333;
            margin-top: 40px;
            padding-top: 5px;
            font-size: 10px;
        }
        .no-print {
            position: fixed;
            top: 10px;
            right: 10px;
            z-index: 1000;
        }
        .btn {
            padding: 8px 16px;
            background: #3498db;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 12px;
            margin-left: 5px;
        }
        .btn:hover {
            background: #2980b9;
        }
        .btn-success {
            background: #27ae60;
        }
        .btn-success:hover {
            background: #219a52;
        }
        @@media print {
            .no-print {
                display: none;
            }
            body {
                padding: 0;
            }
            table {
                page-break-inside: auto;
            }
            tr {
                page-break-inside: avoid;
                page-break-after: auto;
            }
        }
    </style>
</head>
<body>
    <div class="no-print">
        <button class="btn" onclick="window.print()"><i class="fas fa-print"></i> Print</button>
        <button class="btn btn-success" onclick="window.close()"><i class="fas fa-times"></i> Close</button>
    </div>

    <div class="header">
        <h1>Bangaliyana - Pending Seller Payouts</h1>
        <h2>Payment Schedule for @monthName</h2>
    </div>

    <div class="meta-info">
        <span>Generated: @printDate.ToString("dd MMM yyyy HH:mm")</span>
        <span>Generated By: @generatedBy</span>
        <span>Total Sellers: @(pendingPayments?.Count() ?? 0)</span>
    </div>

    <table>
        <thead>
            <tr>
                <th style="width: 30px">#</th>
                <th style="width: 150px">Seller Info</th>
                <th style="width: 130px">Bank Account</th>
                <th style="width: 100px">Mobile Banking</th>
                <th class="text-right" style="width: 80px">Total Sales</th>
                <th class="text-right" style="width: 70px">Commission</th>
                <th class="text-right" style="width: 80px">Payable</th>
                <th style="width: 120px">Payment Completion</th>
            </tr>
        </thead>
        <tbody>
            @if (pendingPayments != null)
            {
                var index = 1;
                decimal totalSales = 0;
                decimal totalCommission = 0;
                decimal totalPayable = 0;

                foreach (var item in pendingPayments)
                {
                    var seller = item.Seller as Seller;
                    var sales = (decimal)item.TotalSales;
                    var commission = (decimal)item.CommissionAmount;
                    var payable = (decimal)item.PayableAmount;

                    totalSales += sales;
                    totalCommission += commission;
                    totalPayable += payable;

                    var primaryBank = seller?.BankAccounts?.FirstOrDefault(b => b.IsPrimary && b.IsVerified)
                                    ?? seller?.BankAccounts?.FirstOrDefault(b => b.IsVerified);

                    <tr>
                        <td class="text-center">@index</td>
                        <td>
                            <div class="shop-name">@seller?.ShopName</div>
                            <div class="contact-info">
                                @seller?.User?.Email<br />
                                @seller?.User?.PhoneNumber
                            </div>
                        </td>
                        <td>
                            @if (primaryBank != null)
                            {
                                <div class="bank-info">
                                    <strong>@primaryBank.BankName</strong><br />
                                    A/C: @primaryBank.AccountNumber<br />
                                    @primaryBank.AccountHolderName<br />
                                    @primaryBank.BranchName
                                </div>
                            }
                            else
                            {
                                <span style="color: #999;">N/A</span>
                            }
                        </td>
                        <td>
                            @if (seller?.MobileBankingProvider != MobileBankingProvider.None && !string.IsNullOrEmpty(seller?.MobileBankingNumber))
                            {
                                <div class="mobile-info">
                                    <strong>@seller.MobileBankingProvider</strong><br />
                                    @seller.MobileBankingNumber
                                </div>
                            }
                            else
                            {
                                <span style="color: #999;">N/A</span>
                            }
                        </td>
                        <td class="text-right">@sales.ToString("N0")</td>
                        <td class="text-right" style="color: #e74c3c;">@commission.ToString("N0")</td>
                        <td class="text-right amount">@payable.ToString("N0")</td>
                        <td class="completion-cell">
                            <!-- Empty cell for manual completion data -->
                        </td>
                    </tr>
                    index++;
                }

                <tr class="summary-row">
                    <td colspan="4" class="text-right"><strong>TOTAL:</strong></td>
                    <td class="text-right">@totalSales.ToString("N0")</td>
                    <td class="text-right" style="color: #e74c3c;">@totalCommission.ToString("N0")</td>
                    <td class="text-right amount">@totalPayable.ToString("N0")</td>
                    <td></td>
                </tr>
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center" style="padding: 30px; color: #666;">No pending payouts found</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="signature-section">
        <div class="signature-box">
            <div class="signature-line">Prepared By</div>
        </div>
        <div class="signature-box">
            <div class="signature-line">Verified By</div>
        </div>
        <div class="signature-box">
            <div class="signature-line">Approved By</div>
        </div>
    </div>

    <div class="footer">
        <span>Bangaliyana E-commerce Platform</span>
        <span>Confidential - For Internal Use Only</span>
        <span>Page 1 of 1</span>
    </div>
</body>
</html>
