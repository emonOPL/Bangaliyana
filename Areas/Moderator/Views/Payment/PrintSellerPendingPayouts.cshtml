@using Bangaliyana.Models
@{
    Layout = null;
    var seller = ViewBag.Seller as Seller;
    var sellerOrders = ViewBag.SellerOrders as List<OrderItem>;
    var totalSales = (decimal)ViewBag.TotalSales;
    var commissionAmount = (decimal)ViewBag.CommissionAmount;
    var payableAmount = (decimal)ViewBag.PayableAmount;
    var totalPaidAmount = (decimal)ViewBag.TotalPaidAmount;
    var printDate = (DateTime)ViewBag.PrintDate;
    var generatedBy = ViewBag.GeneratedBy as string;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Pending Payout - @seller?.ShopName</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Tahoma, sans-serif; font-size: 10px; line-height: 1.4; color: #333; padding: 15px; }
        .header { text-align: center; margin-bottom: 20px; padding-bottom: 15px; border-bottom: 2px solid #3498db; }
        .header h1 { font-size: 18px; margin-bottom: 5px; color: #3498db; }
        .header h2 { font-size: 14px; font-weight: normal; color: #666; }
        .seller-info { background: #f8f9fa; padding: 10px; border-radius: 5px; margin-bottom: 15px; }
        .seller-info h3 { font-size: 14px; margin-bottom: 5px; }
        .meta-info { display: flex; justify-content: space-between; margin-bottom: 15px; font-size: 10px; color: #666; }
        .meta-info span { background: #e3f2fd; padding: 4px 8px; border-radius: 3px; }
        .summary-box { display: flex; gap: 15px; margin-bottom: 20px; }
        .summary-card { flex: 1; padding: 15px; border-radius: 5px; text-align: center; }
        .summary-card.sales { background: #e3f2fd; }
        .summary-card.commission { background: #ffebee; }
        .summary-card.paid { background: #fff3e0; }
        .summary-card.payable { background: #e8f5e9; }
        .summary-card h4 { font-size: 16px; margin-bottom: 5px; }
        .summary-card p { font-size: 10px; color: #666; margin: 0; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        th, td { border: 1px solid #ddd; padding: 6px 4px; text-align: left; font-size: 9px; }
        th { background: #3498db; color: white; font-weight: 600; text-transform: uppercase; }
        tr:nth-child(even) { background: #f9f9f9; }
        .text-right { text-align: right; }
        .text-center { text-align: center; }
        .amount { font-weight: bold; color: #27ae60; }
        .summary-row { background: #e3f2fd !important; font-weight: bold; }
        .summary-row td { border-top: 2px solid #3498db; }
        .footer { margin-top: 30px; padding-top: 15px; border-top: 1px solid #ddd; font-size: 9px; color: #666; display: flex; justify-content: space-between; }
        .signature-section { margin-top: 40px; display: flex; justify-content: space-between; }
        .signature-box { width: 200px; text-align: center; }
        .signature-line { border-top: 1px solid #333; margin-top: 40px; padding-top: 5px; font-size: 10px; }
        .no-print { position: fixed; top: 10px; right: 10px; z-index: 1000; }
        .btn { padding: 8px 16px; background: #3498db; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 12px; margin-left: 5px; }
        .btn:hover { background: #2980b9; }
        .btn-secondary { background: #6c757d; }
        @@media print { .no-print { display: none; } body { padding: 0; } }
    </style>
</head>
<body>
    <div class="no-print">
        <button class="btn" onclick="window.print()">Print</button>
        <button class="btn btn-secondary" onclick="window.close()">Close</button>
    </div>

    <div class="header">
        <h1>Bangaliyana - Pending Seller Payout</h1>
        <h2>Payment Summary for @seller?.ShopName</h2>
    </div>

    <div class="seller-info">
        <h3>@seller?.ShopName</h3>
        <p>Email: @seller?.User?.Email | Phone: @seller?.User?.PhoneNumber</p>
        <p>Commission Rate: @seller?.CommissionRate%</p>
    </div>

    <div class="meta-info">
        <span>Generated: @printDate.ToString("dd MMM yyyy HH:mm")</span>
        <span>Generated By: @generatedBy</span>
        <span>Total Orders: @(sellerOrders?.Count ?? 0)</span>
    </div>

    <div class="summary-box">
        <div class="summary-card sales">
            <h4>৳@totalSales.ToString("N0")</h4>
            <p>Total Sales</p>
        </div>
        <div class="summary-card commission">
            <h4>৳@commissionAmount.ToString("N0")</h4>
            <p>Commission (@seller?.CommissionRate%)</p>
        </div>
        <div class="summary-card paid">
            <h4>৳@totalPaidAmount.ToString("N0")</h4>
            <p>Already Paid</p>
        </div>
        <div class="summary-card payable">
            <h4>৳@payableAmount.ToString("N0")</h4>
            <p>Payable Amount</p>
        </div>
    </div>

    <h4 style="margin-bottom: 10px;">Delivered Orders</h4>
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Order ID</th>
                <th>Product</th>
                <th class="text-center">Qty</th>
                <th class="text-right">Amount</th>
                <th>Delivered Date</th>
            </tr>
        </thead>
        <tbody>
            @if (sellerOrders != null && sellerOrders.Any())
            {
                var index = 1;
                foreach (var item in sellerOrders)
                {
                    <tr>
                        <td class="text-center">@index</td>
                        <td>#@item.OrderId</td>
                        <td>@item.Product?.Name</td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-right amount">৳@item.TotalPrice.ToString("N0")</td>
                        <td>@item.Order?.DeliveredAt?.ToString("dd/MM/yy")</td>
                    </tr>
                    index++;
                }
                <tr class="summary-row">
                    <td colspan="4" class="text-right"><strong>TOTAL SALES:</strong></td>
                    <td class="text-right amount">৳@totalSales.ToString("N0")</td>
                    <td></td>
                </tr>
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center" style="padding: 30px;">No delivered orders found</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="signature-section">
        <div class="signature-box"><div class="signature-line">Prepared By</div></div>
        <div class="signature-box"><div class="signature-line">Verified By</div></div>
        <div class="signature-box"><div class="signature-line">Approved By</div></div>
    </div>

    <div class="footer">
        <span>Bangaliyana E-commerce Platform</span>
        <span>Confidential - For Accounting Use Only</span>
    </div>
</body>
</html>
