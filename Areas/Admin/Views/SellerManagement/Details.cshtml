<!-- Reactivate Confirmation Modal -->
<div class="modal fade" id="reactivateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-body text-center p-4">
                <div class="mb-3">
                    <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="fas fa-undo text-success" style="font-size: 2rem;"></i>
                    </div>
                </div>
                <h4 class="fw-bold mb-2">Reactivate Seller?</h4>
                <p class="text-muted mb-1">Are you sure you want to reactivate "<span class="fw-semibold">@Model.ShopName</span>"?</p>
                <p class="text-muted small mb-0">The seller will be able to access their shop and sell products again.</p>
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2 py-4">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-success px-4" id="confirmReactivateBtn">
                    <i class="fas fa-undo me-1"></i>Yes, Reactivate
                </button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        // Approve modal handler
        var approveModal = document.getElementById('approveModal');
        document.getElementById('confirmApproveBtn').addEventListener('click', function() {
            var btn = this;
            var originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Approving...';

            $.ajax({
                url: '@Url.Action("Approve", "SellerManagement", new { area = "Admin" })/@Model.Id',
                type: 'POST',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    bootstrap.Modal.getInstance(approveModal).hide();
                    showToast('Seller approved successfully!', 'success');
                    setTimeout(function() { location.reload(); }, 1000);
                },
                error: function(xhr) {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                    showToast('Error approving seller: ' + (xhr.responseText || 'Unknown error'), 'danger');
                }
            });
        });

        approveModal.addEventListener('hidden.bs.modal', function () {
            var btn = document.getElementById('confirmApproveBtn');
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-check me-1"></i>Yes, Approve';
        });

        // Reactivate modal handler
        var reactivateModal = document.getElementById('reactivateModal');
        document.getElementById('confirmReactivateBtn').addEventListener('click', function() {
            var btn = this;
            var originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Reactivating...';

            $.ajax({
                url: '@Url.Action("Reactivate", "SellerManagement", new { area = "Admin" })/@Model.Id',
                type: 'POST',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    bootstrap.Modal.getInstance(reactivateModal).hide();
                    showToast('Seller reactivated successfully!', 'success');
                    setTimeout(function() { location.reload(); }, 1000);
                },
                error: function(xhr) {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                    showToast('Error reactivating seller: ' + (xhr.responseText || 'Unknown error'), 'danger');
                }
            });
        });

        reactivateModal.addEventListener('hidden.bs.modal', function () {
            var btn = document.getElementById('confirmReactivateBtn');
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-undo me-1"></i>Yes, Reactivate';
        });

        function showToast(message, type) {
            var toastHtml = '<div class="position-fixed top-0 end-0 p-3" style="z-index: 9999;">' +
                '<div class="toast show align-items-center text-white bg-' + type + ' border-0" role="alert">' +
                '<div class="d-flex">' +
                '<div class="toast-body">' + message + '</div>' +
                '<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>' +
                '</div></div></div>';
            var $toast = $(toastHtml).appendTo('body');
            setTimeout(function() { $toast.fadeOut(function() { $(this).remove(); }); }, 3000);
        }

        // Commission Rate custom validation
        $(document).ready(function() {
            var $input = $('#commissionRateInput');
            var $error = $('#commissionError');
            var $form = $('#commissionForm');

            $form.on('submit', function(e) {
                var value = parseFloat($input.val());

                if (isNaN(value) || $input.val() === '') {
                    e.preventDefault();
                    $error.text('Commission rate is required.').show();
                    $input.addClass('is-invalid');
                    return false;
                }

                if (value < 0 || value > 100) {
                    e.preventDefault();
                    $error.text('Commission rate must be between 0 and 100.').show();
                    $input.addClass('is-invalid');
                    return false;
                }

                // Check step validation (must be multiple of 0.5)
                var remainder = (value * 10) % 5;
                if (remainder !== 0) {
                    e.preventDefault();
                    $error.text('Commission rate must be in 0.5 increments (e.g., 5, 5.5, 6, 6.5).').show();
                    $input.addClass('is-invalid');
                    return false;
                }

                $error.hide();
                $input.removeClass('is-invalid');
                return true;
            });

            $input.on('input', function() {
                $error.hide();
                $input.removeClass('is-invalid');
            });
        });
    </script>
}

