@using Bangaliyana.Models
@using Bangaliyana.Extensions
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Bangaliyana.SharedResources> Localizer

@{
    ViewData["Title"] = Localizer["CreateSeller"].Value;
    var availableUsers = ViewBag.AvailableUsers as List<ApplicationUser>;
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">@Localizer["SellerManagement"]</a></li>
            <li class="breadcrumb-item active">@Localizer["CreateSeller"]</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="fas fa-plus-circle text-success me-2"></i>@Localizer["CreateNewSeller"]</h1>
            <p class="text-muted mb-0">@Localizer["CreateSellerDescription"]</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>@Localizer["BackToList"]
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (availableUsers == null || !availableUsers.Any())
    {
        <div class="alert alert-warning">
            <i class="fas fa-info-circle me-2"></i>
            @Localizer["NoUsersAvailableForSeller"]
        </div>
        <a asp-action="Index" class="btn btn-primary">
            <i class="fas fa-arrow-left me-1"></i>@Localizer["BackToSellers"]
        </a>
    }
    else
    {
        <form asp-action="Create" method="post" id="createSellerForm" novalidate>
            <!-- User Selection -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-user me-2"></i>@Localizer["SelectUser"]</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">@Localizer["UserAccount"] <span class="text-danger">*</span></label>
                        <select name="userId" id="userSelect" class="form-select form-select-lg" required>
                            <option value="">-- @Localizer["SearchAndSelectUser"] --</option>
                            @foreach (var user in availableUsers)
                            {
                                <option value="@user.Id"
                                        data-email="@user.Email"
                                        data-phone="@user.PhoneNumber"
                                        data-address="@user.Address">
                                    @(user.FullName ?? Localizer["NA"].Value) - @user.Email
                                    @if (!string.IsNullOrEmpty(user.PhoneNumber))
                                    {
                                        @:(@user.PhoneNumber)
                                    }
                                </option>
                            }
                        </select>
                        <div class="invalid-feedback">@Localizer["PleaseSelectUserAccount"]</div>
                        <small class="text-muted">@Localizer["OnlyUsersWithoutSellerAccounts"]</small>
                    </div>
                </div>
            </div>

            <!-- Shop Details -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-store text-primary me-2"></i>@Localizer["ShopDetails"]</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Localizer["ShopName"] <span class="text-danger">*</span></label>
                            <input name="shopName" id="shopName" class="form-control" placeholder="@Localizer["EnterShopName"]" required />
                            <div class="invalid-feedback">@Localizer["PleaseEnterShopName"]</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Localizer["BusinessCategory"] <span class="text-danger">*</span></label>
                            <select name="businessCategory" class="form-select" required>
                                @foreach (var category in Enum.GetValues<BusinessCategory>())
                                {
                                    <option value="@category">@category.GetDisplayName()</option>
                                }
                            </select>
                            <div class="invalid-feedback">@Localizer["PleaseSelectBusinessCategory"]</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contact Information -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-address-card text-primary me-2"></i>@Localizer["ContactInformation"]</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Localizer["BusinessPhone"] <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-phone"></i></span>
                                <input name="businessPhone" id="businessPhone" type="tel" class="form-control" placeholder="@Localizer["BusinessPhonePlaceholder"]" required />
                            </div>
                            <div class="invalid-feedback">@Localizer["PleaseEnterValidPhone"]</div>
                            <small class="text-muted">@Localizer["UsedForCustomerContact"]</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Localizer["BusinessEmail"] <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                <input name="businessEmail" id="businessEmail" type="email" class="form-control" placeholder="@Localizer["BusinessEmailPlaceholder"]" required />
                            </div>
                            <div class="invalid-feedback">@Localizer["PleaseEnterValidEmail"]</div>
                            <small class="text-muted">@Localizer["UsedForOrderNotifications"]</small>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 mb-3">
                            <label class="form-label">@Localizer["BusinessAddress"] <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-map-marker-alt"></i></span>
                                <textarea name="businessAddress" id="businessAddress" class="form-control" rows="2" placeholder="@Localizer["EnterFullBusinessAddress"]" required></textarea>
                            </div>
                            <div class="invalid-feedback">@Localizer["PleaseEnterBusinessAddress"]</div>
                            <small class="text-muted">@Localizer["AddressShownToCustomers"]</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Commission Settings -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-percentage text-primary me-2"></i>@Localizer["CommissionSettings"]</h5>
                </div>
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <label class="form-label">@Localizer["CommissionRate"]</label>
                            <div class="input-group">
                                <input name="commissionRate" type="number" class="form-control" value="5" min="0" max="100" step="0.5" />
                                <span class="input-group-text">%</span>
                            </div>
                            <small class="text-muted">@Localizer["CommissionRateDescription"]</small>
                        </div>
                        <div class="col-md-6">
                            <div class="alert alert-info mb-0 mt-3 mt-md-0">
                                <i class="fas fa-info-circle me-1"></i>
                                @Localizer["SellerAutoApprovalNote"]
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Submit -->
            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-times me-1"></i>@Localizer["Cancel"]
                </a>
                <button type="submit" class="btn btn-success btn-lg">
                    <i class="fas fa-check me-2"></i>@Localizer["CreateSellerAccount"]
                </button>
            </div>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <!-- Select2 CSS and JS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function() {
            // Initialize Select2 for user dropdown with search
            $('#userSelect').select2({
                theme: 'bootstrap-5',
                placeholder: 'Search by name, email or phone...',
                allowClear: true,
                width: '100%',
                language: {
                    noResults: function() {
                        return "No users found";
                    },
                    searching: function() {
                        return "Searching...";
                    }
                }
            });

            // Auto-fill contact info when user is selected
            $('#userSelect').on('change', function() {
                var selectedOption = $(this).find('option:selected');
                var email = selectedOption.data('email') || '';
                var phone = selectedOption.data('phone') || '';
                var address = selectedOption.data('address') || '';

                $('#businessEmail').val(email);
                $('#businessPhone').val(phone);
                $('#businessAddress').val(address);
            });

            // Custom validation
            var form = document.getElementById('createSellerForm');

            form.addEventListener('submit', function(event) {
                var isValid = true;

                // Check User Selection
                var userSelect = document.getElementById('userSelect');
                if (!userSelect.value) {
                    userSelect.classList.add('is-invalid');
                    isValid = false;
                } else {
                    userSelect.classList.remove('is-invalid');
                    userSelect.classList.add('is-valid');
                }

                // Check Shop Name
                var shopName = document.getElementById('shopName');
                if (!shopName.value.trim()) {
                    shopName.classList.add('is-invalid');
                    isValid = false;
                } else {
                    shopName.classList.remove('is-invalid');
                    shopName.classList.add('is-valid');
                }

                // Check Phone
                var phone = document.getElementById('businessPhone');
                var phoneValue = phone.value.trim().replace(/\D/g, '');
                if (!phoneValue || phoneValue.length < 10 || phoneValue.length > 15) {
                    phone.classList.add('is-invalid');
                    isValid = false;
                } else {
                    phone.classList.remove('is-invalid');
                    phone.classList.add('is-valid');
                }

                // Check Email
                var email = document.getElementById('businessEmail');
                var emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                if (!email.value.trim() || !emailRegex.test(email.value.trim())) {
                    email.classList.add('is-invalid');
                    isValid = false;
                } else {
                    email.classList.remove('is-invalid');
                    email.classList.add('is-valid');
                }

                // Check Address
                var address = document.getElementById('businessAddress');
                if (!address.value.trim()) {
                    address.classList.add('is-invalid');
                    isValid = false;
                } else {
                    address.classList.remove('is-invalid');
                    address.classList.add('is-valid');
                }

                if (!isValid) {
                    event.preventDefault();
                    event.stopPropagation();

                    // Scroll to first invalid field
                    var firstInvalid = form.querySelector('.is-invalid');
                    if (firstInvalid) {
                        firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        firstInvalid.focus();
                    }
                }

                form.classList.add('was-validated');
            });

            // Real-time validation
            ['shopName', 'businessPhone', 'businessEmail', 'businessAddress'].forEach(function(id) {
                var element = document.getElementById(id);
                if (element) {
                    element.addEventListener('input', function() {
                        if (this.value.trim()) {
                            this.classList.remove('is-invalid');
                        }
                    });
                }
            });
        });
    </script>
}

@section Styles {
    <style>
        /* Select2 custom styling */
        .select2-container--bootstrap-5 .select2-selection {
            min-height: 48px;
            padding: 0.5rem 0.75rem;
            font-size: 1.1rem;
        }

        .select2-container--bootstrap-5 .select2-selection--single .select2-selection__rendered {
            line-height: 1.8;
        }

        .select2-container--bootstrap-5 .select2-selection--single .select2-selection__arrow {
            height: 46px;
        }

        .select2-container--bootstrap-5 .select2-dropdown {
            border-color: var(--bs-primary);
        }

        .select2-container--bootstrap-5 .select2-results__option--highlighted {
            background-color: var(--bs-primary);
        }

        .select2-container--bootstrap-5 .select2-search--dropdown .select2-search__field {
            padding: 0.5rem;
            border-radius: 0.375rem;
        }

        /* Validation styles */
        .was-validated .form-control:invalid,
        .form-control.is-invalid {
            border-color: #dc3545;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
        }

        .was-validated .form-control:valid,
        .form-control.is-valid {
            border-color: #198754;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%23198754' d='M2.3 6.73.6 4.53c-.4-1.04.46-1.4 1.1-.8l1.1 1.4 3.4-3.8c.6-.63 1.6-.27 1.2.7l-4 4.6c-.43.5-.8.4-1.1.1z'/%3e%3c/svg%3e");
        }

        .invalid-feedback {
            display: none;
            font-size: 0.875rem;
            color: #dc3545;
            margin-top: 0.25rem;
        }

        .is-invalid ~ .invalid-feedback,
        .was-validated :invalid ~ .invalid-feedback {
            display: block;
        }

        /* Select2 validation */
        .select2-container--bootstrap-5.is-invalid .select2-selection {
            border-color: #dc3545;
        }

        .select2-container--bootstrap-5.is-valid .select2-selection {
            border-color: #198754;
        }

        /* Dark mode */
        [data-theme="dark"] .card {
            background-color: var(--bs-dark);
            border-color: var(--bs-gray-700);
        }
        [data-theme="dark"] .card-header {
            background-color: var(--bs-gray-800);
            border-color: var(--bs-gray-700);
        }
        [data-theme="dark"] .form-control,
        [data-theme="dark"] .form-select,
        [data-theme="dark"] textarea.form-control {
            background-color: var(--bs-gray-700);
            border-color: var(--bs-gray-600);
            color: var(--bs-light);
        }
        [data-theme="dark"] .input-group-text {
            background-color: var(--bs-gray-700);
            border-color: var(--bs-gray-600);
            color: var(--bs-light);
        }
        [data-theme="dark"] .form-label {
            color: var(--bs-light);
        }
        [data-theme="dark"] .select2-container--bootstrap-5 .select2-selection {
            background-color: var(--bs-gray-700);
            border-color: var(--bs-gray-600);
            color: var(--bs-light);
        }
        [data-theme="dark"] .select2-container--bootstrap-5 .select2-dropdown {
            background-color: var(--bs-gray-800);
            border-color: var(--bs-gray-600);
        }
        [data-theme="dark"] .select2-container--bootstrap-5 .select2-results__option {
            color: var(--bs-light);
        }
        [data-theme="dark"] .select2-container--bootstrap-5 .select2-search--dropdown .select2-search__field {
            background-color: var(--bs-gray-700);
            border-color: var(--bs-gray-600);
            color: var(--bs-light);
        }
    </style>
}
