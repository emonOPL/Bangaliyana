@model Bangaliyana.Models.ContactInquiry
@using Bangaliyana.Models
@using Bangaliyana.Extensions
@{
    ViewData["Title"] = Localizer["InquiryDetails"].Value;
    var areaName = ViewBag.AreaName as string ?? "Admin";
    var controllerName = ViewBag.ControllerName as string ?? "ContactInquiries";
}

<div class="container py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">
                <i class="fas fa-envelope-open text-primary me-2"></i>@Localizer["InquiryNumber", Model.Id]
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-area="@areaName" asp-action="Index" asp-controller="Dashboard">@Localizer["Dashboard"]</a></li>
                    <li class="breadcrumb-item"><a asp-area="@areaName" asp-controller="@controllerName" asp-action="Index">@Localizer["ContactInquiries"]</a></li>
                    <li class="breadcrumb-item active">@Localizer["Details"]</li>
                </ol>
            </nav>
        </div>
        <div>
            <a asp-area="@areaName" asp-controller="@controllerName" asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>@Localizer["BackToList"]
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Warning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Main Content -->
        <div class="col-lg-8">
            <!-- Inquiry Details -->
            <div class="card mb-4">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="fas fa-comment-alt text-primary me-2"></i>Customer Message
                        </h5>
                        @switch (Model.Status)
                        {
                            case InquiryStatus.New:
                                <span class="badge bg-danger fs-6">New</span>
                                break;
                            case InquiryStatus.InProgress:
                                <span class="badge bg-warning text-dark fs-6">In Progress</span>
                                break;
                            case InquiryStatus.Responded:
                                <span class="badge bg-success fs-6">Responded</span>
                                break;
                            case InquiryStatus.Closed:
                                <span class="badge bg-secondary fs-6">Closed</span>
                                break;
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h5 class="text-primary mb-2">@Model.Subject</h5>
                        <div class="d-flex gap-2 mb-3">
                            <span class="badge bg-secondary">@Model.Category</span>
                            <small class="text-muted">
                                <i class="fas fa-clock me-1"></i>@Model.CreatedAt.ToBangladeshDateString()
                            </small>
                        </div>
                    </div>
                    <div class="message-content p-3 bg-light rounded">
                        @Html.Raw(Model.Message.Replace("\n", "<br/>"))
                    </div>
                </div>
            </div>

            <!-- Admin Response Section -->
            @if (!string.IsNullOrEmpty(Model.AdminResponse))
            {
                <div class="card mb-4 border-success">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-reply me-2"></i>Admin Response
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="response-content p-3 bg-light rounded">
                            @Html.Raw(Model.AdminResponse.Replace("\n", "<br/>"))
                        </div>
                        <div class="mt-3 text-muted small">
                            <i class="fas fa-user me-1"></i>
                            Responded by: @(Model.RespondedBy?.FullName ?? "Unknown")
                            <span class="ms-3">
                                <i class="fas fa-clock me-1"></i>@(Model.RespondedAt?.ToBangladeshDateString() ?? "N/A")
                            </span>
                        </div>
                    </div>
                </div>
            }

            <!-- Response Form -->
            @if (Model.Status != InquiryStatus.Closed)
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-paper-plane text-primary me-2"></i>
                            @(string.IsNullOrEmpty(Model.AdminResponse) ? "Send Response" : "Update Response")
                        </h5>
                    </div>
                    <div class="card-body">
                        <form asp-area="@areaName" asp-controller="@controllerName" asp-action="Respond" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />

                            <div class="mb-3">
                                <label for="response" class="form-label">Your Response *</label>
                                <textarea class="form-control" id="response" name="response" rows="6"
                                          placeholder="Type your response here..." required>@Model.AdminResponse</textarea>
                            </div>

                            <div class="mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="sendEmail" name="sendEmail" value="true" checked>
                                    <label class="form-check-label" for="sendEmail">
                                        <i class="fas fa-envelope me-1"></i>Send response via email to @Model.Email
                                    </label>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-paper-plane me-1"></i>Send Response
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Customer Info -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-user text-primary me-2"></i>Customer Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="avatar-lg me-3">
                            <div class="avatar-placeholder">
                                <i class="fas fa-user"></i>
                            </div>
                        </div>
                        <div>
                            <h6 class="mb-0">@Model.FullName</h6>
                            @if (Model.User != null)
                            {
                                <span class="badge bg-success">Registered User</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Guest</span>
                            }
                        </div>
                    </div>

                    <div class="info-list">
                        <div class="info-item">
                            <i class="fas fa-envelope text-muted"></i>
                            <a href="mailto:@Model.Email">@Model.Email</a>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Phone))
                        {
                            <div class="info-item">
                                <i class="fas fa-phone text-muted"></i>
                                <a href="tel:@Model.Phone">@Model.Phone</a>
                            </div>
                        }
                        <div class="info-item">
                            <i class="fas fa-globe text-muted"></i>
                            <small class="text-muted">@(Model.IpAddress ?? "Unknown")</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Status Update -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-cog text-primary me-2"></i>Update Status
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-area="@areaName" asp-controller="@controllerName" asp-action="UpdateStatus" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="mb-3">
                            <select class="form-select" name="status" id="statusSelect">
                                @foreach (InquiryStatus status in Enum.GetValues(typeof(InquiryStatus)))
                                {
                                    <option value="@status" selected="@(Model.Status == status)">@status</option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-outline-primary w-100">
                            <i class="fas fa-sync-alt me-1"></i>Update Status
                        </button>
                    </form>
                </div>
            </div>

            <!-- Actions -->
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>Danger Zone
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small">Deleting this inquiry cannot be undone.</p>
                    <form asp-area="@areaName" asp-controller="@controllerName" asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this inquiry? This action cannot be undone.');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-outline-danger w-100">
                            <i class="fas fa-trash me-1"></i>Delete Inquiry
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-lg {
        width: 60px;
        height: 60px;
    }

    .avatar-placeholder {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 1.5rem;
    }

    .info-list {
        border-top: 1px solid #e5e7eb;
        padding-top: 1rem;
    }

    .info-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem 0;
    }

    .info-item i {
        width: 20px;
        text-align: center;
    }

    .info-item a {
        color: inherit;
        text-decoration: none;
    }

    .info-item a:hover {
        color: var(--bs-primary);
    }

    .message-content,
    .response-content {
        line-height: 1.8;
    }

    /* Dark mode */
    [data-theme="dark"] .card {
        background: #1f2937;
        border-color: #374151;
    }

    [data-theme="dark"] .bg-light {
        background: #374151 !important;
    }

    [data-theme="dark"] .info-list {
        border-color: #374151;
    }
</style>
