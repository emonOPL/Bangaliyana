@using Bangaliyana.Models
@{
    ViewData["Title"] = "Reports & Analytics";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="fas fa-chart-bar text-primary me-2"></i>Reports & Analytics</h1>
            <p class="text-muted mb-0">Comprehensive overview of your business performance</p>
        </div>
        <div class="d-flex gap-2">
            <form method="get" class="d-flex gap-2">
                <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate" />
                <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate" />
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-filter"></i>
                </button>
            </form>
        </div>
    </div>

    <!-- Quick Date Filters -->
    <div class="mb-4">
        <div class="btn-group" role="group">
            <a asp-action="Index" asp-route-period="today" class="btn btn-outline-secondary @(ViewBag.Period == "today" ? "active" : "")">Today</a>
            <a asp-action="Index" asp-route-period="week" class="btn btn-outline-secondary @(ViewBag.Period == "week" ? "active" : "")">This Week</a>
            <a asp-action="Index" asp-route-period="month" class="btn btn-outline-secondary @(ViewBag.Period == "month" ? "active" : "")">This Month</a>
            <a asp-action="Index" asp-route-period="year" class="btn btn-outline-secondary @(ViewBag.Period == "year" ? "active" : "")">This Year</a>
            <a asp-action="Index" class="btn btn-outline-secondary @(string.IsNullOrEmpty(ViewBag.Period) ? "active" : "")">All Time</a>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-primary bg-opacity-10">
                <div class="card-body text-center py-4">
                    <i class="fas fa-shopping-cart text-primary fa-2x mb-3"></i>
                    <h3 class="mb-1 fw-bold">@ViewBag.TotalOrders</h3>
                    <p class="text-muted mb-0">Total Orders</p>
                    @if (ViewBag.OrdersGrowth != null)
                    {
                        var growth = (decimal)ViewBag.OrdersGrowth;
                        <small class="@(growth >= 0 ? "text-success" : "text-danger")">
                            <i class="fas fa-@(growth >= 0 ? "arrow-up" : "arrow-down")"></i>
                            @Math.Abs(growth).ToString("N1")% vs last period
                        </small>
                    }
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-success bg-opacity-10">
                <div class="card-body text-center py-4">
                    <i class="fas fa-money-bill-wave text-success fa-2x mb-3"></i>
                    <h3 class="mb-1 fw-bold">৳@(((decimal)ViewBag.TotalRevenue).ToString("N0"))</h3>
                    <p class="text-muted mb-0">Total Revenue</p>
                    @if (ViewBag.RevenueGrowth != null)
                    {
                        var growth = (decimal)ViewBag.RevenueGrowth;
                        <small class="@(growth >= 0 ? "text-success" : "text-danger")">
                            <i class="fas fa-@(growth >= 0 ? "arrow-up" : "arrow-down")"></i>
                            @Math.Abs(growth).ToString("N1")% vs last period
                        </small>
                    }
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-info bg-opacity-10">
                <div class="card-body text-center py-4">
                    <i class="fas fa-users text-info fa-2x mb-3"></i>
                    <h3 class="mb-1 fw-bold">@ViewBag.TotalUsers</h3>
                    <p class="text-muted mb-0">Total Users</p>
                    @if (ViewBag.NewUsers != null)
                    {
                        <small class="text-success">
                            <i class="fas fa-plus"></i>
                            @ViewBag.NewUsers new this period
                        </small>
                    }
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-warning bg-opacity-10">
                <div class="card-body text-center py-4">
                    <i class="fas fa-chart-line text-warning fa-2x mb-3"></i>
                    <h3 class="mb-1 fw-bold">৳@(((decimal)ViewBag.AverageOrderValue).ToString("N0"))</h3>
                    <p class="text-muted mb-0">Avg. Order Value</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Additional Stats Row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-2">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <i class="fas fa-box text-secondary fa-lg mb-2"></i>
                    <h5 class="mb-0 fw-bold">@ViewBag.TotalProducts</h5>
                    <small class="text-muted">Products</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <i class="fas fa-store text-secondary fa-lg mb-2"></i>
                    <h5 class="mb-0 fw-bold">@ViewBag.TotalSellers</h5>
                    <small class="text-muted">Sellers</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <i class="fas fa-tags text-secondary fa-lg mb-2"></i>
                    <h5 class="mb-0 fw-bold">@ViewBag.TotalCategories</h5>
                    <small class="text-muted">Categories</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <i class="fas fa-undo text-danger fa-lg mb-2"></i>
                    <h5 class="mb-0 fw-bold">৳@(((decimal)ViewBag.TotalRefunds).ToString("N0"))</h5>
                    <small class="text-muted">Refunds</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <i class="fas fa-clock text-warning fa-lg mb-2"></i>
                    <h5 class="mb-0 fw-bold">@ViewBag.PendingOrders</h5>
                    <small class="text-muted">Pending Orders</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <i class="fas fa-percentage text-success fa-lg mb-2"></i>
                    <h5 class="mb-0 fw-bold">৳@(((decimal)ViewBag.TotalCommissions).ToString("N0"))</h5>
                    <small class="text-muted">Commissions</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Revenue Chart -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-chart-area text-primary me-2"></i>Revenue Overview</h5>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn btn-outline-secondary active" data-chart-type="line">Line</button>
                <button type="button" class="btn btn-outline-secondary" data-chart-type="bar">Bar</button>
            </div>
        </div>
        <div class="card-body">
            <canvas id="revenueChart" height="100"></canvas>
        </div>
    </div>

    <!-- Report Cards -->
    <h5 class="mb-3"><i class="fas fa-file-alt text-muted me-2"></i>Detailed Reports</h5>
    <div class="row g-4 mb-4">
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100 report-card">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-success bg-opacity-10 rounded-circle p-3 me-3">
                            <i class="fas fa-chart-line text-success fa-lg"></i>
                        </div>
                        <div>
                            <h5 class="mb-0">Sales Report</h5>
                            <small class="text-muted">Revenue & order analysis</small>
                        </div>
                    </div>
                    <p class="text-muted small mb-3">View detailed sales data with daily, weekly, monthly breakdowns. Track revenue trends and order patterns.</p>
                    <a asp-action="SalesReport" class="btn btn-success btn-sm">
                        <i class="fas fa-arrow-right me-1"></i>View Report
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100 report-card">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-info bg-opacity-10 rounded-circle p-3 me-3">
                            <i class="fas fa-users text-info fa-lg"></i>
                        </div>
                        <div>
                            <h5 class="mb-0">User Growth</h5>
                            <small class="text-muted">Registration & activity trends</small>
                        </div>
                    </div>
                    <p class="text-muted small mb-3">Monitor user registrations, active users, and membership growth over time.</p>
                    <a asp-action="UserGrowthReport" class="btn btn-info btn-sm">
                        <i class="fas fa-arrow-right me-1"></i>View Report
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100 report-card">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-warning bg-opacity-10 rounded-circle p-3 me-3">
                            <i class="fas fa-box text-warning fa-lg"></i>
                        </div>
                        <div>
                            <h5 class="mb-0">Product Performance</h5>
                            <small class="text-muted">Best & low sellers</small>
                        </div>
                    </div>
                    <p class="text-muted small mb-3">Identify best-selling products, low performers, and analyze sales-to-stock ratios.</p>
                    <a asp-action="ProductPerformance" class="btn btn-warning btn-sm">
                        <i class="fas fa-arrow-right me-1"></i>View Report
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100 report-card">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-danger bg-opacity-10 rounded-circle p-3 me-3">
                            <i class="fas fa-tags text-danger fa-lg"></i>
                        </div>
                        <div>
                            <h5 class="mb-0">Category Performance</h5>
                            <small class="text-muted">Sales by category</small>
                        </div>
                    </div>
                    <p class="text-muted small mb-3">Analyze category-wise sales distribution and identify high-performing categories.</p>
                    <a asp-action="CategoryPerformance" class="btn btn-danger btn-sm">
                        <i class="fas fa-arrow-right me-1"></i>View Report
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100 report-card">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 rounded-circle p-3 me-3">
                            <i class="fas fa-store text-primary fa-lg"></i>
                        </div>
                        <div>
                            <h5 class="mb-0">Seller Performance</h5>
                            <small class="text-muted">Top sellers & commissions</small>
                        </div>
                    </div>
                    <p class="text-muted small mb-3">Track seller performance, order fulfillment rates, and commission earnings.</p>
                    <a asp-action="SellerPerformance" class="btn btn-primary btn-sm">
                        <i class="fas fa-arrow-right me-1"></i>View Report
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100 report-card">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-secondary bg-opacity-10 rounded-circle p-3 me-3">
                            <i class="fas fa-download text-secondary fa-lg"></i>
                        </div>
                        <div>
                            <h5 class="mb-0">Export Reports</h5>
                            <small class="text-muted">CSV & PDF downloads</small>
                        </div>
                    </div>
                    <p class="text-muted small mb-3">Export any report to CSV or PDF format for offline analysis and record keeping.</p>
                    <div class="dropdown">
                        <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="fas fa-download me-1"></i>Quick Export
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-action="ExportCsv" asp-route-reportType="sales"><i class="fas fa-file-csv me-2"></i>Sales CSV</a></li>
                            <li><a class="dropdown-item" asp-action="ExportCsv" asp-route-reportType="users"><i class="fas fa-file-csv me-2"></i>Users CSV</a></li>
                            <li><a class="dropdown-item" asp-action="ExportCsv" asp-route-reportType="products"><i class="fas fa-file-csv me-2"></i>Products CSV</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" asp-action="ExportPdf" asp-route-reportType="sales"><i class="fas fa-file-pdf me-2"></i>Sales PDF</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Orders & Top Products Side by Side -->
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-clock text-primary me-2"></i>Recent Orders</h5>
                    <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (ViewBag.RecentOrders != null && ((IEnumerable<Order>)ViewBag.RecentOrders).Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Order</th>
                                        <th>Customer</th>
                                        <th class="text-end">Amount</th>
                                        <th class="text-center">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in (IEnumerable<Order>)ViewBag.RecentOrders)
                                    {
                                        var statusClass = order.Status switch
                                        {
                                            OrderStatus.Pending => "bg-warning text-dark",
                                            OrderStatus.Processing => "bg-info",
                                            OrderStatus.Shipped => "bg-primary",
                                            OrderStatus.Delivered => "bg-success",
                                            OrderStatus.Cancelled => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                        <tr>
                                            <td>
                                                <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="text-decoration-none fw-bold">
                                                    #@order.OrderNumber
                                                </a>
                                            </td>
                                            <td>
                                                <small>@(order.User?.FirstName ?? "-") @(order.User?.LastName ?? "")</small>
                                            </td>
                                            <td class="text-end">
                                                <span class="fw-bold">৳@order.TotalAmount.ToString("N0")</span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge @statusClass">@order.Status</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-inbox fa-2x text-muted mb-2"></i>
                            <p class="text-muted mb-0">No recent orders</p>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-fire text-danger me-2"></i>Top Selling Products</h5>
                    <a asp-action="ProductPerformance" class="btn btn-sm btn-outline-danger">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (ViewBag.TopProducts != null && ((IEnumerable<dynamic>)ViewBag.TopProducts).Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Product</th>
                                        <th class="text-center">Sold</th>
                                        <th class="text-end">Revenue</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in (IEnumerable<dynamic>)ViewBag.TopProducts)
                                    {
                                        <tr>
                                            <td>
                                                <small class="fw-bold">@product.Name</small>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-primary">@product.TotalSold</span>
                                            </td>
                                            <td class="text-end">
                                                <span class="text-success fw-bold">৳@((decimal)product.Revenue).ToString("N0")</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-box fa-2x text-muted mb-2"></i>
                            <p class="text-muted mb-0">No product data available</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Fetch chart data
            fetch('@Url.Action("GetChartData", "Reports", new { area = "Admin", reportType = "revenue" })')
                .then(response => response.json())
                .then(data => {
                    const ctx = document.getElementById('revenueChart').getContext('2d');
                    let chart = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: data.labels,
                            datasets: [{
                                label: 'Revenue (৳)',
                                data: data.data,
                                borderColor: 'rgb(75, 192, 192)',
                                backgroundColor: 'rgba(75, 192, 192, 0.1)',
                                tension: 0.4,
                                fill: true
                            }]
                        },
                        options: {
                            responsive: true,
                            plugins: {
                                legend: {
                                    display: false
                                }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    ticks: {
                                        callback: function(value) {
                                            return '৳' + value.toLocaleString();
                                        }
                                    }
                                }
                            }
                        }
                    });

                    // Chart type toggle
                    document.querySelectorAll('[data-chart-type]').forEach(btn => {
                        btn.addEventListener('click', function() {
                            document.querySelectorAll('[data-chart-type]').forEach(b => b.classList.remove('active'));
                            this.classList.add('active');
                            chart.config.type = this.dataset.chartType;
                            chart.update();
                        });
                    });
                })
                .catch(err => console.log('Chart data error:', err));
        });
    </script>
}

<style>
    .report-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .report-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }
</style>
