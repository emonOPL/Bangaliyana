@model Bangaliyana.Areas.Admin.Controllers.CustomerRefundsViewModel
@using Bangaliyana.Models
@using Bangaliyana.Extensions

@{
    ViewData["Title"] = "Customer Refunds";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Customer Refunds</h1>
            <p class="text-muted mb-0">
                Manage refunds for: <strong>@Model.FullName</strong>
            </p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.UserId" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to Details
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Refund Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-1">Total Paid</h6>
                            <h3 class="mb-0">৳@((int)Math.Round(Model.TotalPaid))</h3>
                        </div>
                        <i class="fas fa-credit-card fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-warning text-dark">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-1">Pending Refunds</h6>
                            <h3 class="mb-0">৳@((int)Math.Round(Model.PendingRefunds))</h3>
                        </div>
                        <i class="fas fa-clock fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-1">Refunded</h6>
                            <h3 class="mb-0">৳@((int)Math.Round(Model.RefundedAmount))</h3>
                        </div>
                        <i class="fas fa-undo fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Orders Requiring Refund -->
    <div class="card mb-4">
        <div class="card-header bg-warning">
            <h5 class="mb-0 text-dark">
                <i class="fas fa-exclamation-circle me-2"></i>Orders Eligible for Refund
            </h5>
        </div>
        <div class="card-body p-0">
            @{
                var eligibleOrders = Model.Orders
                    .Where(o => (o.Status == OrderStatus.Returned || o.Status == OrderStatus.Cancelled) &&
                               (o.PaymentStatus == PaymentStatus.Completed || o.PaymentStatus == PaymentStatus.PartiallyRefunded))
                    .ToList();
            }
            @if (eligibleOrders.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Order #</th>
                                <th>Date</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Payment</th>
                                <th>Reason</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in eligibleOrders)
                            {
                                <tr>
                                    <td>
                                        <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">
                                            #@order.OrderNumber
                                        </a>
                                    </td>
                                    <td>@order.OrderDate.ToBangladeshShortDateString()</td>
                                    <td><strong>৳@((int)Math.Round(order.TotalAmount))</strong></td>
                                    <td>
                                        <span class="badge bg-danger">@order.Status.GetDisplayName()</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-success">@order.PaymentStatus.GetDisplayName()</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(order.ReturnReason))
                                        {
                                            <span title="@order.ReturnReason.FormatAsDisplayName()">@order.ReturnReason.FormatAndTruncate(30)</span>
                                        }
                                        else if (!string.IsNullOrEmpty(order.CancellationReason))
                                        {
                                            <span title="@order.CancellationReason.FormatAsDisplayName()">@order.CancellationReason.FormatAndTruncate(30)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-info btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#refundModal"
                                                data-order-id="@order.Id"
                                                data-order-number="@order.OrderNumber"
                                                data-order-amount="@order.TotalAmount">
                                            <i class="fas fa-undo me-1"></i> Process Refund
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                    <p class="text-muted">No orders pending refund!</p>
                </div>
            }
        </div>
    </div>

    <!-- All Orders Table -->
    <div class="card">
        <div class="card-header bg-light">
            <h5 class="mb-0">
                <i class="fas fa-list me-2"></i>All Orders
            </h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Orders.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Order #</th>
                                <th>Date</th>
                                <th>Amount</th>
                                <th>Payment Method</th>
                                <th>Order Status</th>
                                <th>Payment Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.Orders.Take(50))
                            {
                                <tr>
                                    <td>
                                        <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">
                                            #@order.OrderNumber
                                        </a>
                                    </td>
                                    <td>@order.OrderDate.ToBangladeshShortDateString()</td>
                                    <td>৳@((int)Math.Round(order.TotalAmount))</td>
                                    <td>
                                        @if (order.PaymentMethod == PaymentMethod.CashOnDelivery)
                                        {
                                            <span class="badge bg-secondary">COD</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info">@order.PaymentMethod.GetDisplayName()</span>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            var statusClass = order.Status switch
                                            {
                                                OrderStatus.Delivered => "bg-success",
                                                OrderStatus.Returned => "bg-danger",
                                                OrderStatus.Refunded => "bg-info",
                                                OrderStatus.Cancelled => "bg-secondary",
                                                OrderStatus.Pending => "bg-warning",
                                                _ => "bg-info"
                                            };
                                        }
                                        <span class="badge @statusClass">@order.Status.GetDisplayName()</span>
                                    </td>
                                    <td>
                                        @{
                                            var paymentClass = order.PaymentStatus switch
                                            {
                                                PaymentStatus.Completed => "bg-success",
                                                PaymentStatus.Refunded => "bg-info",
                                                PaymentStatus.Failed => "bg-danger",
                                                PaymentStatus.Pending => "bg-warning",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @paymentClass">@order.PaymentStatus.GetDisplayName()</span>
                                    </td>
                                    <td>
                                        @if (order.Status == OrderStatus.Delivered && order.PaymentMethod == PaymentMethod.CashOnDelivery)
                                        {
                                            <button type="button" class="btn btn-outline-danger btn-sm"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#returnModal"
                                                    data-order-id="@order.Id"
                                                    data-order-number="@order.OrderNumber">
                                                <i class="fas fa-undo me-1"></i> Mark Returned
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No orders found for this customer.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Process Refund Modal -->
<div class="modal fade" id="refundModal" tabindex="-1" aria-labelledby="refundModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="refundModalLabel">
                    <i class="fas fa-undo me-2"></i>Process Refund
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="ProcessRefund" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" value="@Model.UserId" />
                <input type="hidden" name="orderId" id="refundModalOrderId" />
                <div class="modal-body">
                    <div class="text-center mb-4">
                        <i class="fas fa-undo text-info fa-4x mb-3"></i>
                        <h5>Process refund for Order #<span id="refundModalOrderNumber"></span></h5>
                        <p class="text-muted mb-0">
                            Original Amount: <strong id="refundModalOrderAmount"></strong>
                        </p>
                    </div>
                    <div class="mb-3">
                        <label for="refundAmount" class="form-label">Refund Amount</label>
                        <input type="number" step="0.01" class="form-control" id="refundAmount" name="refundAmount" required
                               placeholder="Enter refund amount">
                    </div>
                    <div class="mb-3">
                        <label for="refundTransactionId" class="form-label">Transaction ID</label>
                        <input type="text" class="form-control" id="refundTransactionId" name="transactionId" required
                               placeholder="Enter refund transaction ID">
                    </div>
                    <div class="mb-3">
                        <label for="refundNotes" class="form-label">Notes</label>
                        <textarea class="form-control" id="refundNotes" name="notes" rows="2"
                                  placeholder="Refund method, reason, etc."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i>Cancel
                    </button>
                    <button type="submit" class="btn btn-info">
                        <i class="fas fa-check me-1"></i>Process Refund
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Mark as Returned Modal -->
<div class="modal fade" id="returnModal" tabindex="-1" aria-labelledby="returnModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="returnModalLabel">
                    <i class="fas fa-undo me-2"></i>Mark Order as Returned
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="MarkOrderAsReturned" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" id="returnModalOrderId" />
                <div class="modal-body">
                    <div class="text-center mb-4">
                        <i class="fas fa-exclamation-triangle text-danger fa-4x mb-3"></i>
                        <h5>Mark Order #<span id="returnModalOrderNumber"></span> as Returned?</h5>
                    </div>
                    <div class="mb-3">
                        <label for="returnReason" class="form-label">Return Reason</label>
                        <textarea class="form-control" id="returnReason" name="returnReason" rows="3" required
                                  placeholder="Why is this order being returned?"></textarea>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="customerRefused" name="customerRefused" value="true">
                        <label class="form-check-label" for="customerRefused">
                            <strong class="text-danger">Customer refused delivery</strong>
                            <br><small class="text-muted">This will restrict COD for this customer</small>
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i>Cancel
                    </button>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-undo me-1"></i>Mark as Returned
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        [data-theme="dark"] .card {
            background-color: var(--bs-dark);
            border-color: var(--bs-gray-700);
        }
        [data-theme="dark"] .card-header.bg-light {
            background-color: var(--bs-gray-800) !important;
            border-color: var(--bs-gray-700);
            color: var(--bs-light);
        }
        [data-theme="dark"] .table {
            color: var(--bs-light);
        }
        [data-theme="dark"] .table-light {
            background-color: var(--bs-gray-800);
            color: var(--bs-light);
        }
        [data-theme="dark"] .modal-content {
            background-color: var(--bs-gray-800);
            border-color: var(--bs-gray-700);
        }
        [data-theme="dark"] .modal-body {
            color: var(--bs-light);
        }
        [data-theme="dark"] .form-control {
            background-color: var(--bs-gray-700);
            border-color: var(--bs-gray-600);
            color: var(--bs-light);
        }
        [data-theme="dark"] .form-check-label {
            color: var(--bs-light);
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Refund Modal
            var refundModal = document.getElementById('refundModal');
            refundModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var orderId = button.getAttribute('data-order-id');
                var orderNumber = button.getAttribute('data-order-number');
                var orderAmount = button.getAttribute('data-order-amount');

                document.getElementById('refundModalOrderId').value = orderId;
                document.getElementById('refundModalOrderNumber').textContent = orderNumber;
                document.getElementById('refundModalOrderAmount').textContent = '৳' + Math.round(parseFloat(orderAmount));
                document.getElementById('refundAmount').value = orderAmount;
            });

            // Return Modal
            var returnModal = document.getElementById('returnModal');
            returnModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var orderId = button.getAttribute('data-order-id');
                var orderNumber = button.getAttribute('data-order-number');

                document.getElementById('returnModalOrderId').value = orderId;
                document.getElementById('returnModalOrderNumber').textContent = orderNumber;
            });
        });
    </script>
}
