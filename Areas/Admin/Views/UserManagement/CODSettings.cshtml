@model Bangaliyana.Areas.Admin.Controllers.CODSettingsViewModel
@using Bangaliyana.Models
@using Bangaliyana.Extensions

@{
    ViewData["Title"] = "COD Settings";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">COD Settings</h1>
            <p class="text-muted mb-0">
                Manage Cash on Delivery settings for: <strong>@Model.FullName</strong>
            </p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.UserId" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to Details
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            <!-- COD Status Card -->
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-money-bill-wave me-2"></i>COD Status
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <div class="me-3">
                                    @if (Model.IsCODAllowed)
                                    {
                                        <span class="badge bg-success fs-6 p-2">
                                            <i class="fas fa-check-circle me-1"></i> COD Allowed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger fs-6 p-2">
                                            <i class="fas fa-ban me-1"></i> COD Restricted
                                        </span>
                                    }
                                </div>
                            </div>

                            @if (!Model.IsCODAllowed && Model.CODRestrictedAt.HasValue)
                            {
                                <p class="text-muted mb-2">
                                    <strong>Restricted on:</strong> @Model.CODRestrictedAt.Value.ToBangladeshString()
                                </p>
                                <p class="text-muted mb-0">
                                    <strong>Reason:</strong> @Model.CODRestrictionReason
                                </p>
                            }
                        </div>
                        <div class="col-md-6">
                            <div class="row text-center">
                                <div class="col-6">
                                    <div class="border rounded p-3">
                                        <h4 class="mb-0 text-danger">@Model.FailedCODOrdersCount</h4>
                                        <small class="text-muted">Failed COD Orders</small>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-3">
                                        <h4 class="mb-0 text-warning">@Model.ReturnedOrdersCount</h4>
                                        <small class="text-muted">Returned Orders</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <!-- Actions -->
                    <div class="d-flex gap-2">
                        @if (Model.IsCODAllowed)
                        {
                            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#restrictModal">
                                <i class="fas fa-ban me-1"></i> Restrict COD
                            </button>
                        }
                        else
                        {
                            <form asp-action="AllowCOD" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@Model.UserId" />
                                <button type="submit" class="btn btn-success">
                                    <i class="fas fa-check me-1"></i> Allow COD
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>

            <!-- Recent COD Orders -->
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-history me-2"></i>Recent COD Orders
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentCODOrders.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Order #</th>
                                        <th>Date</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Delivery</th>
                                        <th>Refused</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.RecentCODOrders)
                                    {
                                        <tr>
                                            <td>
                                                <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">
                                                    #@order.OrderNumber
                                                </a>
                                            </td>
                                            <td>@order.OrderDate.ToBangladeshShortDateString()</td>
                                            <td>৳@((int)Math.Round(order.TotalAmount))</td>
                                            <td>
                                                @{
                                                    var statusClass = order.Status switch
                                                    {
                                                        OrderStatus.Delivered => "bg-success",
                                                        OrderStatus.Returned => "bg-danger",
                                                        OrderStatus.Cancelled => "bg-secondary",
                                                        OrderStatus.Pending => "bg-warning",
                                                        _ => "bg-info"
                                                    };
                                                }
                                                <span class="badge @statusClass">@order.Status.GetDisplayName()</span>
                                            </td>
                                            <td>
                                                @{
                                                    var deliveryClass = order.DeliveryStatus switch
                                                    {
                                                        DeliveryStatus.Delivered => "bg-success",
                                                        DeliveryStatus.Returned => "bg-danger",
                                                        DeliveryStatus.Failed => "bg-danger",
                                                        _ => "bg-info"
                                                    };
                                                }
                                                <span class="badge @deliveryClass">@order.DeliveryStatus.GetDisplayName()</span>
                                            </td>
                                            <td>
                                                @if (order.CustomerRefusedDelivery)
                                                {
                                                    <span class="badge bg-danger">
                                                        <i class="fas fa-times"></i> Yes
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No COD orders found for this user.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar Info -->
        <div class="col-lg-4">
            <div class="card sticky-top" style="top: 1rem;">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Information</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info small">
                        <i class="fas fa-lightbulb me-2"></i>
                        <strong>COD Restriction Policy:</strong>
                        <ul class="mb-0 mt-2">
                            <li>COD is automatically restricted when customer refuses delivery</li>
                            <li>Customers with restricted COD must use online payment</li>
                            <li>Admin can manually allow/restrict COD</li>
                        </ul>
                    </div>

                    <hr />

                    <h6>Quick Actions</h6>
                    <div class="d-grid gap-2">
                        <a asp-action="Details" asp-route-id="@Model.UserId" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-user me-1"></i> View Profile
                        </a>
                        <a asp-action="CustomerRefunds" asp-route-id="@Model.UserId" class="btn btn-outline-info btn-sm">
                            <i class="fas fa-undo me-1"></i> Refunds
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-list me-1"></i> All Users
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Restrict COD Modal -->
<div class="modal fade" id="restrictModal" tabindex="-1" aria-labelledby="restrictModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="restrictModalLabel">
                    <i class="fas fa-ban me-2"></i>Restrict COD
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="RestrictCOD" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" value="@Model.UserId" />
                <div class="modal-body">
                    <div class="text-center mb-4">
                        <i class="fas fa-exclamation-triangle text-danger fa-4x mb-3"></i>
                        <h5>Restrict COD for this user?</h5>
                        <p class="text-muted mb-0">
                            <strong>@Model.FullName</strong> (@Model.Email)
                        </p>
                    </div>
                    <div class="mb-3">
                        <label for="reason" class="form-label">Reason for restriction</label>
                        <textarea class="form-control" id="reason" name="reason" rows="3" required
                                  placeholder="Enter reason for restricting COD..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i>Cancel
                    </button>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-ban me-1"></i>Restrict COD
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        [data-theme="dark"] .card {
            background-color: var(--bs-dark);
            border-color: var(--bs-gray-700);
        }
        [data-theme="dark"] .card-header.bg-light {
            background-color: var(--bs-gray-800) !important;
            border-color: var(--bs-gray-700);
            color: var(--bs-light);
        }
        [data-theme="dark"] .table {
            color: var(--bs-light);
        }
        [data-theme="dark"] .table-light {
            background-color: var(--bs-gray-800);
            color: var(--bs-light);
        }
        [data-theme="dark"] .modal-content {
            background-color: var(--bs-gray-800);
            border-color: var(--bs-gray-700);
        }
        [data-theme="dark"] .modal-body {
            color: var(--bs-light);
        }
        [data-theme="dark"] .form-control {
            background-color: var(--bs-gray-700);
            border-color: var(--bs-gray-600);
            color: var(--bs-light);
        }
        .d-flex.gap-2 { gap: 0.5rem; }
    </style>
}
