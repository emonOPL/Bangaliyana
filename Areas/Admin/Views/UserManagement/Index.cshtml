@model List<Bangaliyana.Areas.Admin.Controllers.UserManagementViewModel>
@using Bangaliyana.Models

@{
    ViewData["Title"] = Localizer["UserManagement"];
    var searchTerm = ViewBag.SearchTerm as string;
    var roleFilter = ViewBag.RoleFilter as string;
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
    var totalUsers = (int)ViewBag.TotalUsers;
    var allRoles = ViewBag.AllRoles as List<string>;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">@Localizer["UserManagement"]</h1>
            <p class="text-muted mb-0">@Localizer["ManageUsersRolesPermissions"]</p>
        </div>
        <div>
            <span class="badge bg-primary fs-6">@Localizer["TotalUsersCount", totalUsers]</span>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search and Filter -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" name="searchTerm" class="form-control" placeholder="@Localizer["SearchByNameEmailPhone"]" value="@searchTerm" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="roleFilter" class="form-select">
                        <option value="">@Localizer["AllRoles"]</option>
                        @if (allRoles != null)
                        {
                            @foreach (var role in allRoles)
                            {
                                <option value="@role" selected="@(roleFilter == role)">@role</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-filter me-1"></i> @Localizer["Filter"]
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-1"></i> @Localizer["Clear"]
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Users Table -->
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px;"></th>
                            <th>@Localizer["User"]</th>
                            <th>@Localizer["Contact"]</th>
                            <th>@Localizer["Role"]</th>
                            <th>@Localizer["Status"]</th>
                            <th>@Localizer["Joined"]</th>
                            <th style="width: 150px;">@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var user in Model)
                            {
                                var roleClass = user.Roles.Contains("Admin") ? "bg-danger" :
                                                user.Roles.Contains("Seller") ? "bg-primary" : "bg-success";
                                var roleIcon = user.Roles.Contains("Admin") ? "fas fa-user-shield" :
                                               user.Roles.Contains("Seller") ? "fas fa-store" : "fas fa-user";

                                <tr class="@(user.IsLocked ? "table-danger" : "")">
                                    <td>
                                        @if (!string.IsNullOrEmpty(user.AvatarUrl))
                                        {
                                            <img src="@user.AvatarUrl" alt="@user.FullName" class="rounded-circle" width="40" height="40" style="object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                <i class="fas fa-user text-white"></i>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <strong>@user.FullName</strong>
                                        @if (user.IsVerified)
                                        {
                                            <i class="fas fa-check-circle text-success ms-1" title="@Localizer["Verified"]"></i>
                                        }
                                        <br />
                                        <small class="text-muted">@user.Email</small>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(user.PhoneNumber))
                                        {
                                            <i class="fas fa-phone text-muted me-1"></i>@user.PhoneNumber
                                            @if (user.PhoneNumberConfirmed)
                                            {
                                                <i class="fas fa-check-circle text-success ms-1" title="@Localizer["PhoneVerified"]"></i>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">@Localizer["NoPhone"]</span>
                                        }
                                    </td>
                                    <td>
                                        @foreach (var role in user.Roles)
                                        {
                                            var badgeClass = role == "Admin" ? "bg-danger" :
                                                            role == "Seller" ? "bg-primary" : "bg-success";
                                            <span class="badge @badgeClass me-1">@role</span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.IsLocked)
                                        {
                                            <span class="badge bg-danger"><i class="fas fa-lock me-1"></i>@Localizer["Locked"]</span>
                                        }
                                        else if (user.EmailConfirmed)
                                        {
                                            <span class="badge bg-success"><i class="fas fa-check me-1"></i>@Localizer["Active"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>@Localizer["Pending"]</span>
                                        }
                                    </td>
                                    <td>
                                        <small>@user.CreatedAt.ToBangladeshShortDateString()</small>
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary" title="@Localizer["ViewDetails"]">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-warning" title="@Localizer["EditUser"]">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Permissions" asp-route-id="@user.Id" class="btn btn-sm btn-outline-info" title="@Localizer["MenuPermissions"]">
                                                <i class="fas fa-shield-alt"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="fas fa-users fa-2x mb-2"></i>
                                    <p class="mb-0">@Localizer["NoUsersFound"]</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (totalPages > 1)
        {
            <div class="card-footer">
                <nav aria-label="User pagination">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchTerm="@searchTerm" asp-route-roleFilter="@roleFilter">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>
                        @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchTerm="@searchTerm" asp-route-roleFilter="@roleFilter">@i</a>
                            </li>
                        }
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchTerm="@searchTerm" asp-route-roleFilter="@roleFilter">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        /* Dark mode support */
        [data-theme="dark"] .card {
            background-color: var(--bs-dark);
            border-color: var(--bs-gray-700);
        }
        [data-theme="dark"] .card-body {
            color: var(--bs-light);
        }
        [data-theme="dark"] .table {
            color: var(--bs-light);
        }
        [data-theme="dark"] .table-light {
            background-color: var(--bs-gray-800) !important;
            color: var(--bs-light);
        }
        [data-theme="dark"] .table-light th {
            background-color: var(--bs-gray-800) !important;
            color: var(--bs-light);
            border-color: var(--bs-gray-700);
        }
        [data-theme="dark"] .table-hover tbody tr:hover {
            background-color: var(--bs-gray-700) !important;
            color: var(--bs-light);
        }
        [data-theme="dark"] .table td,
        [data-theme="dark"] .table th {
            border-color: var(--bs-gray-700);
        }
        [data-theme="dark"] .text-muted {
            color: var(--bs-gray-400) !important;
        }
        [data-theme="dark"] h1,
        [data-theme="dark"] strong {
            color: var(--bs-light);
        }
        [data-theme="dark"] .form-control,
        [data-theme="dark"] .form-select {
            background-color: var(--bs-gray-800);
            border-color: var(--bs-gray-600);
            color: var(--bs-light);
        }
        [data-theme="dark"] .input-group-text {
            background-color: var(--bs-gray-700);
            border-color: var(--bs-gray-600);
            color: var(--bs-light);
        }
        [data-theme="dark"] .table-danger {
            background-color: rgba(220, 53, 69, 0.2) !important;
        }
        [data-theme="dark"] .card-footer {
            background-color: var(--bs-gray-800);
            border-color: var(--bs-gray-700);
        }
        [data-theme="dark"] .page-link {
            background-color: var(--bs-gray-800);
            border-color: var(--bs-gray-600);
            color: var(--bs-light);
        }
        [data-theme="dark"] .page-item.active .page-link {
            background-color: var(--bs-primary);
            border-color: var(--bs-primary);
        }
        [data-theme="dark"] .page-item.disabled .page-link {
            background-color: var(--bs-gray-700);
            border-color: var(--bs-gray-600);
            color: var(--bs-gray-500);
        }

        .gap-1 {
            gap: 0.25rem;
        }
    </style>
}
