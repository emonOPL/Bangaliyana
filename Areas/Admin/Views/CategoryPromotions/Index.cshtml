@using Bangaliyana.Models
@using Microsoft.AspNetCore.Mvc.Rendering
@model IEnumerable<CategoryPromotion>
@{
    ViewData["Title"] = "Category Promotions Management";
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var totalPromotions = ViewBag.TotalPromotions as int? ?? 0;
    var activePromotions = ViewBag.ActivePromotions as int? ?? 0;
    var featuredPromotions = ViewBag.FeaturedPromotions as int? ?? 0;
    var status = ViewBag.Status as string;
    var categoryId = ViewBag.CategoryId as int?;
    var categories = ViewBag.Categories as SelectList;
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="h3 mb-1"><i class="fas fa-tags text-primary me-2"></i>Category Promotions</h1>
            <p class="text-muted mb-0">Promote categories with banners and discounts</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i>Create Promotion
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-primary bg-opacity-10">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-primary bg-opacity-25 p-3 me-3">
                        <i class="fas fa-tags text-primary fa-lg"></i>
                    </div>
                    <div>
                        <h3 class="mb-0 fw-bold">@totalPromotions</h3>
                        <small class="text-muted">Total Promotions</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-success bg-opacity-10">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-success bg-opacity-25 p-3 me-3">
                        <i class="fas fa-check-circle text-success fa-lg"></i>
                    </div>
                    <div>
                        <h3 class="mb-0 fw-bold">@activePromotions</h3>
                        <small class="text-muted">Active Promotions</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-warning bg-opacity-10">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-warning bg-opacity-25 p-3 me-3">
                        <i class="fas fa-star text-warning fa-lg"></i>
                    </div>
                    <div>
                        <h3 class="mb-0 fw-bold">@featuredPromotions</h3>
                        <small class="text-muted">Featured</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["onSave"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["onSave"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["onEdit"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show">
            <i class="fas fa-info-circle me-2"></i>@TempData["onEdit"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["onDelete"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["onDelete"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filters Card -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Status</label>
                    <select name="status" class="form-select">
                        <option value="">All Status</option>
                        <option value="active" selected="@(status == "active")">Active</option>
                        <option value="upcoming" selected="@(status == "upcoming")">Upcoming</option>
                        <option value="expired" selected="@(status == "expired")">Expired</option>
                        <option value="inactive" selected="@(status == "inactive")">Inactive</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Category</label>
                    <select name="categoryId" class="form-select">
                        <option value="">All Categories</option>
                        @if (categories != null)
                        {
                            @foreach (var item in categories)
                            {
                                <option value="@item.Value" selected="@(categoryId.HasValue && item.Value == categoryId.Value.ToString())">@item.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1">
                            <i class="fas fa-filter me-1"></i>Filter
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-times"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Anti-forgery token for AJAX requests -->
    @Html.AntiForgeryToken()

    <!-- Promotions Table Card -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Promotion</th>
                                <th>Category</th>
                                <th>Discount</th>
                                <th>Duration</th>
                                <th class="text-center">Status</th>
                                <th style="width: 160px;" class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var promo in Model)
                            {
                                var now = DateTime.UtcNow;
                                var isExpired = promo.EndDate.HasValue && promo.EndDate < now;
                                var isUpcoming = promo.StartDate.HasValue && promo.StartDate > now;
                                var isActive = promo.IsActive && !isExpired && !isUpcoming;

                                var statusClass = isActive ? "bg-success" : (isExpired ? "bg-danger" : (isUpcoming ? "bg-info" : "bg-secondary"));
                                var statusText = isActive ? "Active" : (isExpired ? "Expired" : (isUpcoming ? "Upcoming" : "Inactive"));

                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(promo.ThumbnailImageUrl))
                                            {
                                                <img src="@promo.ThumbnailImageUrl" alt="Thumbnail" class="rounded me-2" style="width: 50px; height: 50px; object-fit: cover;">
                                            }
                                            else if (!string.IsNullOrEmpty(promo.BannerImageUrl))
                                            {
                                                <img src="@promo.BannerImageUrl" alt="Banner" class="rounded me-2" style="width: 50px; height: 50px; object-fit: cover;">
                                            }
                                            <div>
                                                <strong>@promo.Name</strong>
                                                @if (promo.IsFeatured)
                                                {
                                                    <span class="badge bg-warning text-dark ms-1">Featured</span>
                                                }
                                                @if (!string.IsNullOrEmpty(promo.Tagline))
                                                {
                                                    <br /><small class="text-muted">@promo.Tagline</small>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@promo.Category?.Name</span>
                                    </td>
                                    <td>
                                        @if (promo.PromotionType == PromotionType.PercentageDiscount)
                                        {
                                            <span class="badge bg-danger fs-6">@promo.DiscountValue%</span>
                                        }
                                        else if (promo.PromotionType == PromotionType.FixedAmountDiscount)
                                        {
                                            <span class="badge bg-success fs-6">৳@promo.DiscountValue?.ToString("N0")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info">Banner Only</span>
                                        }
                                    </td>
                                    <td>
                                        @if (promo.StartDate.HasValue || promo.EndDate.HasValue)
                                        {
                                            <small>
                                                @if (promo.StartDate.HasValue)
                                                {
                                                    <i class="fas fa-calendar text-muted me-1"></i>@promo.StartDate.Value.ToString("MMM dd")
                                                }
                                                @if (promo.EndDate.HasValue)
                                                {
                                                    <br /><i class="fas fa-calendar-check text-muted me-1"></i>@promo.EndDate.Value.ToString("MMM dd")
                                                }
                                            </small>
                                        }
                                        else
                                        {
                                            <small class="text-muted">No limit</small>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @statusClass">@statusText</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Edit" asp-route-id="@promo.Id" class="btn btn-outline-secondary" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-secondary toggle-active-btn" data-id="@promo.Id" title="@(promo.IsActive ? "Deactivate" : "Activate")">
                                                <i class="fas @(promo.IsActive ? "fa-toggle-on text-success" : "fa-toggle-off")"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-warning toggle-featured-btn" data-id="@promo.Id" title="@(promo.IsFeatured ? "Remove Featured" : "Mark Featured")">
                                                <i class="fas @(promo.IsFeatured ? "fa-star text-warning" : "fa-star")"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="@promo.Id" data-name="@promo.Name" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <div class="d-flex justify-content-center p-3">
                        <nav>
                            <ul class="pagination mb-0">
                                @if (currentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" asp-action="Index" asp-route-status="@status" asp-route-categoryId="@categoryId" asp-route-page="@(currentPage - 1)">Previous</a>
                                    </li>
                                }
                                @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <a class="page-link" asp-action="Index" asp-route-status="@status" asp-route-categoryId="@categoryId" asp-route-page="@i">@i</a>
                                    </li>
                                }
                                @if (currentPage < totalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" asp-action="Index" asp-route-status="@status" asp-route-categoryId="@categoryId" asp-route-page="@(currentPage + 1)">Next</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-tags fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No promotions found</h5>
                    <p class="text-muted">Create your first category promotion</p>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i>Create Promotion
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle me-2"></i>Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the promotion "<strong id="promoName"></strong>"?</p>
                <p class="text-danger mb-0"><small>This action cannot be undone.</small></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" asp-action="Delete" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-1"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Delete modal
            $('#deleteModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var id = button.data('id');
                var name = button.data('name');
                $('#promoName').text(name);
                $('#deleteForm').attr('action', '@Url.Action("Delete")/' + id);
            });

            // Toggle active status
            $(document).on('click', '.toggle-active-btn', function (e) {
                e.preventDefault();
                var $btn = $(this);
                var id = $btn.data('id');

                $btn.prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("ToggleActive")',
                    type: 'POST',
                    data: { id: id },
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    success: function (response) {
                        if (response.success) {
                            if (response.isActive) {
                                $btn.html('<i class="fas fa-toggle-on text-success"></i>');
                            } else {
                                $btn.html('<i class="fas fa-toggle-off"></i>');
                            }
                            location.reload();
                        }
                    },
                    complete: function () {
                        $btn.prop('disabled', false);
                    }
                });
            });

            // Toggle featured status
            $(document).on('click', '.toggle-featured-btn', function (e) {
                e.preventDefault();
                var $btn = $(this);
                var id = $btn.data('id');

                $btn.prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("ToggleFeatured")',
                    type: 'POST',
                    data: { id: id },
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    success: function (response) {
                        if (response.success) {
                            if (response.isFeatured) {
                                $btn.html('<i class="fas fa-star text-warning"></i>');
                            } else {
                                $btn.html('<i class="fas fa-star"></i>');
                            }
                            location.reload();
                        }
                    },
                    complete: function () {
                        $btn.prop('disabled', false);
                    }
                });
            });
        });
    </script>
}
