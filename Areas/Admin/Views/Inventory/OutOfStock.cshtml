@using Bangaliyana.Models
@model IEnumerable<Products>
@{
    ViewData["Title"] = "Out of Stock Products";
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Inventory</a></li>
            <li class="breadcrumb-item active">Out of Stock</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="fas fa-times-circle text-danger me-2"></i>Out of Stock Products</h1>
            <p class="text-muted mb-0">Products with zero stock that need immediate attention</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to Inventory
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="alert alert-danger mb-4">
            <i class="fas fa-exclamation-circle me-2"></i>
            <strong>@Model.Count() products</strong> are out of stock and unavailable for purchase.
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th>SKU</th>
                                <th>Category</th>
                                <th>Seller</th>
                                <th class="text-center">Stock</th>
                                <th class="text-end">Price</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model.OrderBy(p => p.Name))
                            {
                                var firstImage = product.Images?.FirstOrDefault()?.ImageUrl ?? product.ImageUrl ?? "images/products/noimage.jpg";
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="~/@firstImage" alt="@product.Name" class="rounded me-2" style="width: 40px; height: 40px; object-fit: cover;">
                                            <span class="fw-medium">@product.Name</span>
                                        </div>
                                    </td>
                                    <td><small class="text-muted">@(product.SKU ?? "-")</small></td>
                                    <td><small>@(product.Category?.Name ?? "-")</small></td>
                                    <td><small>@(product.Seller?.ShopName ?? "Own")</small></td>
                                    <td class="text-center">
                                        <span class="badge bg-danger fw-bold fs-6">@product.Stock</span>
                                    </td>
                                    <td class="text-end">@product.EffectivePrice.ToString("N0")</td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Adjust" asp-route-id="@product.Id" class="btn btn-success" title="Restock Now">
                                                <i class="fas fa-plus"></i>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-primary" title="Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                <h5 class="text-muted">Excellent! All products are in stock!</h5>
                <p class="text-muted mb-0">No products are currently out of stock</p>
            </div>
        </div>
    }
</div>
