@model IEnumerable<Bangaliyana.Models.AuditLog>
@using Bangaliyana.Models
@using Bangaliyana.Extensions

@{
    ViewData["Title"] = "User Activity";
    var user = ViewBag.User as ApplicationUser;
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Audit Logs</a></li>
            <li class="breadcrumb-item active">User Activity</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="fas fa-user-clock text-primary me-2"></i>User Activity</h1>
            <p class="text-muted mb-0">Activity history for @user?.Email</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to Logs
        </a>
    </div>

    @if (user != null)
    {
        <div class="row mb-4">
            <div class="col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="fas fa-user me-2"></i>User Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="text-center mb-3">
                            <i class="fas fa-user-circle fa-4x text-muted"></i>
                        </div>
                        <table class="table table-sm table-borderless mb-0">
                            <tr>
                                <td class="text-muted">Email:</td>
                                <td><strong>@user.Email</strong></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Name:</td>
                                <td>@(user.FirstName ?? "-") @(user.LastName ?? "")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Phone:</td>
                                <td>@(user.PhoneNumber ?? "-")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Joined:</td>
                                <td>@user.CreatedAt.ToString("dd MMM yyyy")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Status:</td>
                                <td>
                                    @if (user.EmailConfirmed)
                                    {
                                        <span class="badge bg-success">Verified</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Unverified</span>
                                    }
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-history me-2"></i>Recent Activity (@Model.Count() entries)</h5>
                        <a asp-action="Index" asp-route-userId="@user.Id" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-search me-1"></i>View All Logs
                        </a>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0 align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Timestamp</th>
                                            <th>Action</th>
                                            <th>Module</th>
                                            <th>Description</th>
                                            <th>Status</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var log in Model)
                                        {
                                            var actionClass = log.ActionType switch
                                            {
                                                AuditActionType.Create => "bg-success",
                                                AuditActionType.Update => "bg-warning text-dark",
                                                AuditActionType.Delete => "bg-danger",
                                                AuditActionType.Login => "bg-info",
                                                AuditActionType.Logout => "bg-secondary",
                                                AuditActionType.Approve => "bg-success",
                                                AuditActionType.Reject => "bg-danger",
                                                _ => "bg-primary"
                                            };
                                            <tr>
                                                <td>
                                                    <small>@log.CreatedAt.ToString("dd MMM yyyy")</small><br />
                                                    <small class="text-muted">@log.CreatedAt.ToString("HH:mm:ss")</small>
                                                </td>
                                                <td><span class="badge @actionClass">@log.ActionType.GetDisplayName()</span></td>
                                                <td><span class="badge bg-secondary">@log.Module.GetDisplayName()</span></td>
                                                <td>
                                                    <span class="d-inline-block text-truncate" style="max-width: 250px;" title="@log.Description">
                                                        @log.Description
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (log.IsSuccess)
                                                    {
                                                        <span class="badge bg-success"><i class="fas fa-check"></i></span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger"><i class="fas fa-times"></i></span>
                                                    }
                                                </td>
                                                <td>
                                                    <a asp-action="Details" asp-route-id="@log.Id" class="btn btn-sm btn-outline-info">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                                <p class="text-muted mb-0">No activity found for this user</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Styles {
    <style>
        [data-theme="dark"] .card { background-color: var(--bs-dark); border-color: var(--bs-gray-700); }
        [data-theme="dark"] .card-header.bg-light { background-color: var(--bs-gray-800) !important; color: var(--bs-light); }
        [data-theme="dark"] .table { color: var(--bs-light); }
        [data-theme="dark"] .table-light { background-color: var(--bs-gray-800) !important; }
        [data-theme="dark"] .table-light th { background-color: var(--bs-gray-800) !important; color: var(--bs-light); }
    </style>
}
