@model Bangaliyana.Models.ProductQuestion
@{
    ViewData["Title"] = Localizer["AnswerQuestion"];
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-outline-secondary me-3">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <h2 class="mb-0"><i class="fas fa-reply me-2"></i>@Localizer["AnswerQuestion"]</h2>
                    <p class="text-muted mb-0">@Localizer["ProvideHelpfulAnswer"]</p>
                </div>
            </div>

            <!-- Product Info Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        @if (Model.Product != null)
                        {
                            <img src="@(Model.Product.ImageUrl ?? "/images/products/noimage.jpg")"
                                 alt="@Model.Product.Name"
                                 class="rounded me-3"
                                 style="width: 80px; height: 80px; object-fit: cover;">
                            <div>
                                <h5 class="mb-1">@Model.Product.Name</h5>
                                @if (Model.Product.Seller != null)
                                {
                                    <small class="text-muted d-block mb-2">
                                        <i class="fas fa-store me-1"></i>@Model.Product.Seller.ShopName
                                    </small>
                                }
                                <a asp-area="Customer" asp-controller="Home" asp-action="Details" asp-route-id="@Model.ProductId"
                                   class="btn btn-sm btn-outline-primary" target="_blank">
                                    <i class="fas fa-external-link-alt me-1"></i>@Localizer["ViewProduct"]
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Question Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="fas fa-question-circle text-primary me-2"></i>@Localizer["CustomerQuestion"]</h6>
                </div>
                <div class="card-body">
                    <div class="d-flex">
                        <div class="me-3">
                            <div class="avatar-circle bg-primary text-white">
                                @(Model.User?.FirstName?.Substring(0, 1).ToUpper() ?? "C")
                            </div>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <strong>@(Model.User?.FirstName ?? Localizer["Customer"])</strong>
                                    <small class="text-muted ms-2">@Model.CreatedAt.ToBangladeshString()</small>
                                </div>
                            </div>
                            <p class="mt-2 mb-0 fs-5">@Model.Question</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Answer Form -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-success text-white">
                    <h6 class="mb-0"><i class="fas fa-pen me-2"></i>@Localizer["YourAnswer"]</h6>
                </div>
                <div class="card-body">
                    <form asp-action="Answer" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label">@Localizer["Answer"] <span class="text-danger">*</span></label>
                            <textarea name="answer" class="form-control" rows="5" required
                                      placeholder="@Localizer["TypeYourAnswerHereDetailed"]"></textarea>
                            <small class="text-muted">@Localizer["WriteClearHelpfulResponse"]</small>
                        </div>

                        <div class="alert alert-info mb-4">
                            <i class="fas fa-info-circle me-2"></i>
                            <small>@Localizer["AnswerVisibilityNote"]</small>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-paper-plane me-1"></i>@Localizer["SubmitAnswer"]
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-circle {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 1.25rem;
    }
</style>

@section Scripts {
    <script>
        @if (TempData["error"] != null)
        {
            <text>alertify.error('@TempData["error"]');</text>
        }
    </script>
}
