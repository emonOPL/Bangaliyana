@model IEnumerable<Bangaliyana.Models.SellerPayment>
@using Bangaliyana.Extensions
@{
    ViewData["Title"] = "Seller Payments";
    var statusCounts = ViewBag.StatusCounts as Dictionary<Bangaliyana.Models.SellerPaymentStatus, int> ?? new Dictionary<Bangaliyana.Models.SellerPaymentStatus, int>();
    var currentStatus = ViewBag.CurrentStatus as Bangaliyana.Models.SellerPaymentStatus?;
    var currentSearch = ViewBag.CurrentSearch as string;
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1"><i class="fas fa-money-bill-wave text-primary me-2"></i>Seller Payments</h4>
            <p class="text-muted mb-0">Manage and process seller payment requests</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Logs")" class="btn btn-outline-info">
                <i class="fas fa-clipboard-list me-1"></i>Logs
            </a>
            @if (User.IsInRole("SuperAdmin"))
            {
                <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#triggerPaymentsModal">
                    <i class="fas fa-play me-1"></i>Trigger Payments
                </button>
            }
            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
            {
                <a href="@Url.Action("Settings")" class="btn btn-outline-secondary">
                    <i class="fas fa-cog me-1"></i>Settings
                </a>
            }
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card border-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-1">Pending Amount</p>
                            <h4 class="mb-0">BDT @((int)Math.Round((decimal)(ViewBag.TotalPendingAmount ?? 0m)))</h4>
                        </div>
                        <div class="bg-warning bg-opacity-10 p-3 rounded">
                            <i class="fas fa-clock text-warning fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-1">Processing</p>
                            <h4 class="mb-0">BDT @((int)Math.Round((decimal)(ViewBag.TotalProcessingAmount ?? 0m)))</h4>
                        </div>
                        <div class="bg-info bg-opacity-10 p-3 rounded">
                            <i class="fas fa-spinner text-info fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-1">Total Paid</p>
                            <h4 class="mb-0">BDT @((int)Math.Round((decimal)(ViewBag.TotalPaidAmount ?? 0m)))</h4>
                        </div>
                        <div class="bg-success bg-opacity-10 p-3 rounded">
                            <i class="fas fa-check-circle text-success fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-danger">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-1">Failed</p>
                            <h4 class="mb-0">BDT @((int)Math.Round((decimal)(ViewBag.TotalFailedAmount ?? 0m)))</h4>
                        </div>
                        <div class="bg-danger bg-opacity-10 p-3 rounded">
                            <i class="fas fa-times-circle text-danger fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filters and Search -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label">Search</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" name="search" class="form-control" placeholder="Payment #, Shop name..." value="@currentSearch" />
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Status</label>
                    <select name="status" class="form-select">
                        <option value="">All Statuses</option>
                        @foreach (Bangaliyana.Models.SellerPaymentStatus status in Enum.GetValues(typeof(Bangaliyana.Models.SellerPaymentStatus)))
                        {
                            var count = statusCounts.ContainsKey(status) ? statusCounts[status] : 0;
                            <option value="@status" selected="@(currentStatus == status)">@status.GetDisplayName() (@count)</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-filter me-1"></i>Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Status Tabs -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link @(currentStatus == null ? "active" : "")" href="@Url.Action("Index")">
                All <span class="badge bg-secondary">@statusCounts.Values.Sum()</span>
            </a>
        </li>
        @foreach (Bangaliyana.Models.SellerPaymentStatus status in Enum.GetValues(typeof(Bangaliyana.Models.SellerPaymentStatus)))
        {
            var count = statusCounts.ContainsKey(status) ? statusCounts[status] : 0;
            var badgeClass = status switch
            {
                Bangaliyana.Models.SellerPaymentStatus.Pending => "bg-warning text-dark",
                Bangaliyana.Models.SellerPaymentStatus.UnderReview => "bg-info",
                Bangaliyana.Models.SellerPaymentStatus.Processing => "bg-primary",
                Bangaliyana.Models.SellerPaymentStatus.Paid => "bg-success",
                Bangaliyana.Models.SellerPaymentStatus.Failed => "bg-danger",
                _ => "bg-secondary"
            };
            <li class="nav-item">
                <a class="nav-link @(currentStatus == status ? "active" : "")" href="@Url.Action("Index", new { status = status })">
                    @status.GetDisplayName() <span class="badge @badgeClass">@count</span>
                </a>
            </li>
        }
    </ul>

    <!-- Payments Table -->
    <div class="card">
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Payment #</th>
                                <th>Seller / Shop</th>
                                <th>Amount</th>
                                <th>Payment Account</th>
                                <th>Status</th>
                                <th>Period</th>
                                <th>Dates</th>
                                <th class="text-center" style="width: 180px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in Model)
                            {
                                var statusBadge = payment.Status switch
                                {
                                    Bangaliyana.Models.SellerPaymentStatus.Pending => "bg-warning text-dark",
                                    Bangaliyana.Models.SellerPaymentStatus.UnderReview => "bg-info",
                                    Bangaliyana.Models.SellerPaymentStatus.Processing => "bg-primary",
                                    Bangaliyana.Models.SellerPaymentStatus.Paid => "bg-success",
                                    Bangaliyana.Models.SellerPaymentStatus.Failed => "bg-danger",
                                    _ => "bg-secondary"
                                };
                                var canEdit = payment.Status == Bangaliyana.Models.SellerPaymentStatus.Pending || payment.Status == Bangaliyana.Models.SellerPaymentStatus.UnderReview;
                                var canDelete = payment.Status == Bangaliyana.Models.SellerPaymentStatus.Pending || payment.Status == Bangaliyana.Models.SellerPaymentStatus.Failed;
                                <tr>
                                    <td>
                                        <a href="@Url.Action("Details", new { id = payment.Id })" class="fw-bold text-decoration-none">
                                            @payment.PaymentNumber
                                        </a>
                                        @if (!string.IsNullOrEmpty(payment.TransactionReference))
                                        {
                                            <br><small class="text-success"><i class="fas fa-check-circle me-1"></i>@payment.TransactionReference</small>
                                        }
                                    </td>
                                    <td>
                                        @if (payment.Seller != null)
                                        {
                                            <div class="d-flex align-items-center">
                                                @if (!string.IsNullOrEmpty(payment.Seller.ShopLogoUrl))
                                                {
                                                    <img src="@payment.Seller.ShopLogoUrl" alt="@payment.Seller.ShopName" class="rounded-circle me-2" style="width: 40px; height: 40px; object-fit: cover;">
                                                }
                                                else
                                                {
                                                    <div class="bg-primary bg-opacity-10 rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                        <i class="fas fa-store text-primary"></i>
                                                    </div>
                                                }
                                                <div>
                                                    <a href="/Admin/SellerManagement/Details/@payment.SellerId" class="fw-medium text-decoration-none">@payment.Seller.ShopName</a>
                                                    <br><small class="text-muted">@payment.Seller.User?.Email</small>
                                                    <br><small class="text-muted">Bal: BDT @((int)Math.Round(payment.Seller.AccountBalance))</small>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <span class="fw-bold text-success fs-6">BDT @((int)Math.Round(payment.Amount))</span>
                                    </td>
                                    <td>
                                        @if (payment.PaymentMethod == Bangaliyana.Models.SellerPaymentMethod.BankTransfer)
                                        {
                                            <span class="badge bg-secondary mb-1"><i class="fas fa-university me-1"></i>Bank Transfer</span>
                                            @if (!string.IsNullOrEmpty(payment.BankName))
                                            {
                                                <br><small class="fw-medium">@payment.BankName</small>
                                                @if (!string.IsNullOrEmpty(payment.AccountNumber))
                                                {
                                                    <br><small class="text-muted">A/C: @payment.AccountNumber</small>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-success mb-1"><i class="fas fa-mobile-alt me-1"></i>Mobile Banking</span>
                                            @if (payment.MobileBankingProvider != null)
                                            {
                                                <br><small class="fw-medium">@payment.MobileBankingProvider.GetDisplayName()</small>
                                            }
                                            @if (!string.IsNullOrEmpty(payment.MobileNumber))
                                            {
                                                <br><small class="text-muted">@payment.MobileNumber</small>
                                            }
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @statusBadge">@payment.Status.GetDisplayName()</span>
                                        @if (!string.IsNullOrEmpty(payment.FailureReason))
                                        {
                                            <br><small class="text-danger" title="@payment.FailureReason"><i class="fas fa-exclamation-circle"></i> Failed</small>
                                        }
                                    </td>
                                    <td>
                                        <small>@payment.PeriodStart.ToBangladeshString("MMM dd") - @payment.PeriodEnd.ToBangladeshShortDateString()</small>
                                    </td>
                                    <td>
                                        <small class="d-block"><i class="fas fa-plus-circle text-muted me-1"></i>@payment.CreatedAt.ToBangladeshShortDateString()</small>
                                        @if (payment.CompletedAt.HasValue)
                                        {
                                            <small class="d-block text-success"><i class="fas fa-check-circle me-1"></i>@payment.CompletedAt.Value.ToBangladeshShortDateString()</small>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <a href="@Url.Action("Details", new { id = payment.Id })" class="btn btn-outline-primary" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            @if (canEdit && (User.IsInRole("SuperAdmin") || User.IsInRole("Admin")))
                                            {
                                                <a href="@Url.Action("Edit", new { id = payment.Id })" class="btn btn-outline-secondary" title="Edit Payment">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                            }
                                            <a href="@Url.Action("Messages", new { id = payment.Id })" class="btn btn-outline-info" title="Messages">
                                                <i class="fas fa-comments"></i>
                                                @if (payment.Messages?.Any(m => !m.IsRead && !m.IsStaffReply) == true)
                                                {
                                                    <span class="badge bg-danger ms-1">@payment.Messages.Count(m => !m.IsRead && !m.IsStaffReply)</span>
                                                }
                                            </a>
                                            @if (canDelete && User.IsInRole("SuperAdmin"))
                                            {
                                                <button type="button" class="btn btn-outline-danger delete-btn"
                                                        data-id="@payment.Id"
                                                        data-number="@payment.PaymentNumber"
                                                        data-amount="@((int)Math.Round(payment.Amount))"
                                                        data-seller="@payment.Seller?.ShopName"
                                                        title="Delete Payment">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No payments found.</p>
                </div>
            }
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="deletePaymentModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body text-center p-4">
                    <div class="mb-3">
                        <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                            <i class="fas fa-trash text-danger" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold mb-2">Delete Payment?</h4>
                    <p class="text-muted mb-1">Are you sure you want to delete payment <strong id="deletePaymentNumber"></strong>?</p>
                    <p class="text-muted mb-0"><strong>Seller:</strong> <span id="deleteSellerName"></span></p>
                    <p class="text-muted mb-0"><strong>Amount:</strong> BDT <span id="deleteAmount"></span></p>
                    <div class="alert alert-warning mt-3 mb-0 text-start small">
                        <i class="fas fa-exclamation-triangle me-1"></i>
                        If the payment is Pending, the amount will be refunded to the seller's balance.
                    </div>
                </div>
                <div class="modal-footer border-0 justify-content-center gap-2 py-4">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i>Cancel
                    </button>
                    <form method="post" asp-action="Delete" id="deletePaymentForm" class="m-0 d-inline-flex">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" id="deletePaymentId" />
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="fas fa-trash me-1"></i>Delete Payment
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { status = currentStatus, search = currentSearch, page = currentPage - 1 })">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                </li>
                @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { status = currentStatus, search = currentSearch, page = i })">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { status = currentStatus, search = currentSearch, page = currentPage + 1 })">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

<!-- Trigger Payments Confirmation Modal -->
<div class="modal fade" id="triggerPaymentsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-body text-center p-4">
                <div class="mb-3">
                    <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="fas fa-play text-warning" style="font-size: 2rem;"></i>
                    </div>
                </div>
                <h4 class="fw-bold mb-2">Trigger Monthly Payments?</h4>
                <p class="text-muted mb-1">Are you sure you want to trigger monthly payments now?</p>
                <p class="text-muted small mb-0">This will process all eligible sellers.</p>
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2 py-4">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancel
                </button>
                <form method="post" asp-action="TriggerMonthlyPayments" class="m-0 d-inline-flex">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning px-4">
                        <i class="fas fa-play me-1"></i>Yes, Trigger Payments
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    [data-theme="dark"] .card {
        background-color: #1f2937;
        border-color: #374151;
    }
    [data-theme="dark"] .table {
        color: #e5e7eb;
    }
    [data-theme="dark"] .table-light {
        background-color: #374151;
        color: #e5e7eb;
    }
    [data-theme="dark"] .table-light th {
        background-color: #374151;
        color: #e5e7eb;
    }
    [data-theme="dark"] .nav-tabs .nav-link {
        color: #9ca3af;
    }
    [data-theme="dark"] .nav-tabs .nav-link.active {
        background-color: #1f2937;
        border-color: #374151;
        color: #fff;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Delete button click handler
            document.querySelectorAll('.delete-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    document.getElementById('deletePaymentId').value = this.dataset.id;
                    document.getElementById('deletePaymentNumber').textContent = this.dataset.number;
                    document.getElementById('deleteSellerName').textContent = this.dataset.seller || 'Unknown';
                    document.getElementById('deleteAmount').textContent = this.dataset.amount;
                    new bootstrap.Modal(document.getElementById('deletePaymentModal')).show();
                });
            });
        });
    </script>
}
