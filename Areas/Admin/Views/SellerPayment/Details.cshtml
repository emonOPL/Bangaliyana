@model Bangaliyana.Models.SellerPayment
@using Bangaliyana.Extensions
@{
    ViewData["Title"] = $"Payment #{Model.PaymentNumber}";
    var messages = ViewBag.Messages as IEnumerable<Bangaliyana.Models.SellerPaymentMessage> ?? Enumerable.Empty<Bangaliyana.Models.SellerPaymentMessage>();
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Seller Payments</a></li>
                    <li class="breadcrumb-item active">@Model.PaymentNumber</li>
                </ol>
            </nav>
            <h4 class="mb-0"><i class="fas fa-file-invoice-dollar text-primary me-2"></i>Payment Details</h4>
        </div>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to List
        </a>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Payment Info -->
        <div class="col-lg-8">
            <!-- Payment Overview Card -->
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Payment Information</h5>
                    @{
                        var statusBadge = Model.Status switch
                        {
                            Bangaliyana.Models.SellerPaymentStatus.Pending => "bg-warning text-dark",
                            Bangaliyana.Models.SellerPaymentStatus.UnderReview => "bg-info",
                            Bangaliyana.Models.SellerPaymentStatus.Processing => "bg-primary",
                            Bangaliyana.Models.SellerPaymentStatus.Paid => "bg-success",
                            Bangaliyana.Models.SellerPaymentStatus.Failed => "bg-danger",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @statusBadge fs-6">@Model.Status.GetDisplayName()</span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <small class="text-muted d-block">Payment Number</small>
                            <strong class="fs-5">@Model.PaymentNumber</strong>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted d-block">Amount</small>
                            <strong class="fs-5 text-success">BDT @((int)Math.Round(Model.Amount))</strong>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted d-block">Payment Method</small>
                            @if (Model.PaymentMethod == Bangaliyana.Models.SellerPaymentMethod.BankTransfer)
                            {
                                <span class="badge bg-secondary"><i class="fas fa-university me-1"></i>Bank Transfer</span>
                            }
                            else
                            {
                                <span class="badge bg-success"><i class="fas fa-mobile-alt me-1"></i>Mobile Banking</span>
                            }
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted d-block">Period</small>
                            <strong>@Model.PeriodStart.ToBangladeshString("MMM dd") - @Model.PeriodEnd.ToBangladeshShortDateString()</strong>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted d-block">Created At</small>
                            <strong>@Model.CreatedAt.ToBangladeshString()</strong>
                        </div>
                        @if (Model.CompletedAt.HasValue)
                        {
                            <div class="col-md-6">
                                <small class="text-muted d-block">Completed At</small>
                                <strong>@Model.CompletedAt.Value.ToBangladeshString()</strong>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.TransactionReference))
                        {
                            <div class="col-12">
                                <small class="text-muted d-block">Transaction Reference</small>
                                <code class="fs-5">@Model.TransactionReference</code>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.FailureReason))
                        {
                            <div class="col-12">
                                <div class="alert alert-danger mb-0">
                                    <small class="text-muted d-block">Failure Reason</small>
                                    <strong>@Model.FailureReason</strong>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Order Breakdown Card -->
            @{
                var periodTransactions = ViewBag.PeriodTransactions as List<Bangaliyana.Models.SellerTransaction> ?? new List<Bangaliyana.Models.SellerTransaction>();
                var totalProductPayout = (decimal)(ViewBag.TotalProductPayout ?? 0m);
                var totalCommission = (decimal)(ViewBag.TotalCommission ?? 0m);
            }
            @if (periodTransactions.Any())
            {
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-list-alt me-2"></i>Order Breakdown</h5>
                        <span class="badge bg-primary">@periodTransactions.Count orders</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Order #</th>
                                        <th>Type</th>
                                        <th>Product Payout</th>
                                        <th>Delivery Charge</th>
                                        <th class="text-end">Total</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tx in periodTransactions)
                                    {
                                        var isCOD = tx.Type == Bangaliyana.Models.SellerTransactionType.Commission;
                                        var orderNumber = tx.Order?.OrderNumber ?? tx.OrderId?.ToString() ?? "-";
                                        var deliveryCharge = tx.Order?.DeliveryCharge ?? 0m;

                                        // Parse product payout from description or calculate
                                        decimal productAmount = 0;
                                        if (isCOD)
                                        {
                                            // For COD: commission is deducted, product+delivery goes to seller
                                            productAmount = (tx.Order?.SubTotal ?? 0m) - Math.Abs(tx.Amount);
                                        }
                                        else
                                        {
                                            // For online: parse from description or calculate
                                            productAmount = tx.Amount - deliveryCharge;
                                        }

                                        <tr>
                                            <td>
                                                <a href="@Url.Action("Details", "Orders", new { area = "Admin", id = tx.OrderId })" class="text-decoration-none fw-bold">
                                                    #@orderNumber
                                                </a>
                                            </td>
                                            <td>
                                                @if (isCOD)
                                                {
                                                    <span class="badge bg-warning text-dark"><i class="fas fa-money-bill me-1"></i>COD</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success"><i class="fas fa-credit-card me-1"></i>Online</span>
                                                }
                                            </td>
                                            <td>
                                                @if (isCOD)
                                                {
                                                    <span class="text-muted">-৳@Math.Abs(tx.Amount).ToString("N0")</span>
                                                    <small class="text-muted d-block">commission</small>
                                                }
                                                else
                                                {
                                                    <span class="text-success">৳@productAmount.ToString("N0")</span>
                                                }
                                            </td>
                                            <td>
                                                @if (deliveryCharge > 0)
                                                {
                                                    @if (isCOD)
                                                    {
                                                        <span class="text-muted">collected</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-info">৳@deliveryCharge.ToString("N0")</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <span class="@(tx.Amount >= 0 ? "text-success" : "text-danger") fw-bold">
                                                    @(tx.Amount >= 0 ? "+" : "")৳@tx.Amount.ToString("N0")
                                                </span>
                                            </td>
                                            <td>
                                                <small class="text-muted">@tx.CreatedAt.ToBangladeshString("dd MMM")</small>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr class="fw-bold">
                                        <td colspan="4" class="text-end">Total Payout:</td>
                                        <td class="text-end text-success">৳@totalProductPayout.ToString("N0")</td>
                                        <td></td>
                                    </tr>
                                    @if (totalCommission > 0)
                                    {
                                        <tr class="fw-bold">
                                            <td colspan="4" class="text-end">Total Commission Deducted:</td>
                                            <td class="text-end text-danger">-৳@totalCommission.ToString("N0")</td>
                                            <td></td>
                                        </tr>
                                    }
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <!-- Payment Details Card -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        @if (Model.PaymentMethod == Bangaliyana.Models.SellerPaymentMethod.BankTransfer)
                        {
                            <i class="fas fa-university me-2"></i>@:Bank Account Details
                        }
                        else
                        {
                            <i class="fas fa-mobile-alt me-2"></i>@:Mobile Banking Details
                        }
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.PaymentMethod == Bangaliyana.Models.SellerPaymentMethod.BankTransfer)
                    {
                        <div class="row g-3">
                            <div class="col-md-6">
                                <small class="text-muted d-block">Bank Name</small>
                                <strong>@(Model.BankName ?? "-")</strong>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted d-block">Branch Name</small>
                                <strong>@(Model.BranchName ?? "-")</strong>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted d-block">Account Holder</small>
                                <strong>@(Model.AccountHolderName ?? "-")</strong>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted d-block">Account Number</small>
                                <code class="fs-6">@(Model.AccountNumber ?? "-")</code>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.RoutingNumber))
                            {
                                <div class="col-md-6">
                                    <small class="text-muted d-block">Routing Number</small>
                                    <code>@Model.RoutingNumber</code>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="row g-3">
                            <div class="col-md-6">
                                <small class="text-muted d-block">Provider</small>
                                <strong>@(Model.MobileBankingProvider?.GetDisplayName() ?? "-")</strong>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted d-block">Mobile Number</small>
                                <code class="fs-6">@(Model.MobileNumber ?? "-")</code>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted d-block">Account Name</small>
                                <strong>@(Model.MobileAccountName ?? "-")</strong>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Status Actions -->
            @if (Model.Status != Bangaliyana.Models.SellerPaymentStatus.Paid && Model.Status != Bangaliyana.Models.SellerPaymentStatus.Failed)
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fas fa-tasks me-2"></i>Actions</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <!-- Update Status -->
                            <div class="col-md-6">
                                <form method="post" asp-action="UpdateStatus">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <div class="mb-3">
                                        <label class="form-label">Update Status</label>
                                        <select name="status" class="form-select">
                                            @foreach (Bangaliyana.Models.SellerPaymentStatus status in Enum.GetValues(typeof(Bangaliyana.Models.SellerPaymentStatus)))
                                            {
                                                if (status != Bangaliyana.Models.SellerPaymentStatus.Paid && status != Bangaliyana.Models.SellerPaymentStatus.Failed)
                                                {
                                                    <option value="@status" selected="@(status == Model.Status)">@status.GetDisplayName()</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Notes (Optional)</label>
                                        <textarea name="notes" class="form-control" rows="2" placeholder="Add internal notes...">@Model.AdminNotes</textarea>
                                    </div>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-save me-1"></i>Update Status
                                    </button>
                                </form>
                            </div>

                            <!-- Quick Actions -->
                            <div class="col-md-6">
                                <!-- Mark as Paid -->
                                <div class="border rounded p-3 mb-3">
                                    <h6 class="text-success"><i class="fas fa-check-circle me-1"></i>Mark as Paid</h6>
                                    <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#markPaidModal">
                                        <i class="fas fa-check me-1"></i>Confirm Paid
                                    </button>
                                </div>

                                <!-- Mark as Failed -->
                                <div class="border rounded p-3 border-danger">
                                    <h6 class="text-danger"><i class="fas fa-times-circle me-1"></i>Mark as Failed</h6>
                                    <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#markFailedModal">
                                        <i class="fas fa-times me-1"></i>Mark Failed
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Messages Section -->
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-comments me-2"></i>Support Messages</h5>
                    <a href="@Url.Action("Messages", new { id = Model.Id })" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-expand me-1"></i>Full View
                    </a>
                </div>
                <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                    @if (messages.Any())
                    {
                        @foreach (var msg in messages.TakeLast(5))
                        {
                            var isStaff = msg.IsStaffReply;
                            <div class="d-flex mb-3 @(isStaff ? "justify-content-end" : "")">
                                <div class="@(isStaff ? "bg-primary text-white" : "bg-light") rounded p-3" style="max-width: 80%;">
                                    <div class="d-flex align-items-center mb-1">
                                        <small class="@(isStaff ? "text-white-50" : "text-muted")">
                                            @(isStaff ? "Staff" : (Model.Seller?.ShopName ?? "Seller"))
                                            - @msg.CreatedAt.ToBangladeshString("dd MMM, hh:mm tt")
                                        </small>
                                    </div>
                                    <p class="mb-0">@msg.Message</p>
                                    @if (msg.Attachments?.Any() == true)
                                    {
                                        <div class="mt-2">
                                            @foreach (var att in msg.Attachments)
                                            {
                                                <a href="@att.FileUrl" target="_blank" class="badge @(isStaff ? "bg-light text-dark" : "bg-secondary")">
                                                    <i class="fas fa-paperclip me-1"></i>@att.FileName
                                                </a>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-comments fa-2x mb-2"></i>
                            <p class="mb-0">No messages yet</p>
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <form method="post" asp-action="SendMessage" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="paymentId" value="@Model.Id" />
                        <div class="input-group">
                            <input type="text" name="message" class="form-control" placeholder="Type your message..." required />
                            <input type="file" name="attachment" class="d-none" id="attachmentInput" />
                            <button type="button" class="btn btn-outline-secondary" onclick="document.getElementById('attachmentInput').click();" title="Attach File">
                                <i class="fas fa-paperclip"></i>
                            </button>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-paper-plane"></i>
                            </button>
                        </div>
                        <small class="text-muted" id="attachmentName"></small>
                    </form>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            @{
                var canEdit = Model.Status == Bangaliyana.Models.SellerPaymentStatus.Pending || Model.Status == Bangaliyana.Models.SellerPaymentStatus.UnderReview;
                var canDelete = Model.Status == Bangaliyana.Models.SellerPaymentStatus.Pending || Model.Status == Bangaliyana.Models.SellerPaymentStatus.Failed;
            }

            <!-- Quick Actions -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-bolt me-2"></i>Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        @if (canEdit && (User.IsInRole("SuperAdmin") || User.IsInRole("Admin")))
                        {
                            <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-outline-secondary">
                                <i class="fas fa-edit me-1"></i>Edit Payment
                            </a>
                        }
                        <a href="@Url.Action("Messages", new { id = Model.Id })" class="btn btn-outline-info">
                            <i class="fas fa-comments me-1"></i>Messages
                        </a>
                        @if (canDelete && User.IsInRole("SuperAdmin"))
                        {
                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                                <i class="fas fa-trash me-1"></i>Delete Payment
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Seller Info -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-store me-2"></i>Seller & Shop Information</h5>
                </div>
                <div class="card-body">
                    @if (Model.Seller != null)
                    {
                        <div class="text-center mb-3">
                            @if (!string.IsNullOrEmpty(Model.Seller.ShopLogoUrl))
                            {
                                <img src="@Model.Seller.ShopLogoUrl" alt="@Model.Seller.ShopName" class="rounded-circle mb-2" style="width: 80px; height: 80px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="bg-primary bg-opacity-10 rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                                    <i class="fas fa-store fa-2x text-primary"></i>
                                </div>
                            }
                            <h5 class="mb-0">@Model.Seller.ShopName</h5>
                            <span class="badge @(Model.Seller.Status == Bangaliyana.Models.SellerStatus.Approved ? "bg-success" : "bg-warning")">@Model.Seller.Status.GetDisplayName()</span>
                        </div>

                        <!-- Seller User Info -->
                        <div class="bg-light rounded p-3 mb-3">
                            <small class="text-muted d-block mb-1">Owner Information</small>
                            @if (Model.Seller.User != null)
                            {
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fas fa-user text-muted me-2"></i>
                                    <span>@Model.Seller.User.FullName</span>
                                </div>
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fas fa-envelope text-muted me-2"></i>
                                    <small>@Model.Seller.User.Email</small>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.Seller.User.PhoneNumber))
                                {
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-phone text-muted me-2"></i>
                                        <small>@Model.Seller.User.PhoneNumber</small>
                                    </div>
                                }
                            }
                        </div>

                        <!-- Account Summary -->
                        <div class="row g-2 text-center mb-3">
                            <div class="col-6">
                                <div class="border rounded p-2">
                                    <small class="text-muted d-block">Current Balance</small>
                                    <strong class="text-success fs-5">BDT @((int)Math.Round(Model.Seller.AccountBalance))</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="border rounded p-2">
                                    <small class="text-muted d-block">Total Sales</small>
                                    <strong class="fs-5">BDT @((int)Math.Round(Model.Seller.TotalSales))</strong>
                                </div>
                            </div>
                        </div>

                        <a href="/Admin/SellerManagement/Details/@Model.Seller.Id" class="btn btn-outline-primary btn-sm w-100">
                            <i class="fas fa-external-link-alt me-1"></i>View Full Seller Profile
                        </a>
                    }
                </div>
            </div>

            <!-- Payment Account Details -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-credit-card me-2"></i>Payment Account</h5>
                </div>
                <div class="card-body">
                    @if (Model.PaymentMethod == Bangaliyana.Models.SellerPaymentMethod.BankTransfer)
                    {
                        <span class="badge bg-secondary mb-3"><i class="fas fa-university me-1"></i>Bank Transfer</span>
                        <table class="table table-sm table-borderless mb-0">
                            <tr>
                                <td class="text-muted" style="width: 40%;">Bank Name</td>
                                <td><strong>@(Model.BankName ?? "-")</strong></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Branch</td>
                                <td>@(Model.BranchName ?? "-")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Account Holder</td>
                                <td><strong>@(Model.AccountHolderName ?? "-")</strong></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Account No.</td>
                                <td><code>@(Model.AccountNumber ?? "-")</code></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Routing No.</td>
                                <td>@(Model.RoutingNumber ?? "-")</td>
                            </tr>
                        </table>
                    }
                    else
                    {
                        <span class="badge bg-success mb-3"><i class="fas fa-mobile-alt me-1"></i>Mobile Banking</span>
                        <table class="table table-sm table-borderless mb-0">
                            <tr>
                                <td class="text-muted" style="width: 40%;">Provider</td>
                                <td><strong>@(Model.MobileBankingProvider?.GetDisplayName() ?? "-")</strong></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Mobile No.</td>
                                <td><code>@(Model.MobileNumber ?? "-")</code></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Account Name</td>
                                <td>@(Model.MobileAccountName ?? "-")</td>
                            </tr>
                        </table>
                    }
                </div>
            </div>

            <!-- Other Bank Accounts (if any) -->
            @{
                var sellerBankAccounts = ViewBag.SellerBankAccounts as List<Bangaliyana.Models.SellerBankAccount> ?? new List<Bangaliyana.Models.SellerBankAccount>();
            }
            @if (sellerBankAccounts.Any())
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fas fa-wallet me-2"></i>All Seller Bank Accounts</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            @foreach (var account in sellerBankAccounts)
                            {
                                var isSelected = Model.PaymentMethod == Bangaliyana.Models.SellerPaymentMethod.BankTransfer && Model.AccountNumber == account.AccountNumber;
                                <div class="list-group-item @(isSelected ? "bg-success bg-opacity-10 border-success" : "")">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <strong>@account.BankName</strong>
                                            @if (isSelected)
                                            {
                                                <span class="badge bg-success ms-1">Selected</span>
                                            }
                                            @if (account.IsPrimary)
                                            {
                                                <span class="badge bg-primary ms-1">Primary</span>
                                            }
                                            <br><small class="text-muted">A/C: @account.AccountNumber</small>
                                            <br><small>@account.AccountHolderName</small>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Timeline -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-history me-2"></i>Timeline</h5>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        <div class="timeline-item">
                            <div class="timeline-marker bg-secondary"></div>
                            <div class="timeline-content">
                                <small class="text-muted">Created</small>
                                <p class="mb-0">@Model.CreatedAt.ToBangladeshString("dd MMM yyyy, hh:mm tt")</p>
                            </div>
                        </div>
                        @if (Model.ReviewedAt.HasValue)
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker bg-info"></div>
                                <div class="timeline-content">
                                    <small class="text-muted">Under Review</small>
                                    <p class="mb-0">@Model.ReviewedAt.Value.ToBangladeshString("dd MMM yyyy, hh:mm tt")</p>
                                </div>
                            </div>
                        }
                        @if (Model.ProcessedAt.HasValue)
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker bg-primary"></div>
                                <div class="timeline-content">
                                    <small class="text-muted">Processing</small>
                                    <p class="mb-0">@Model.ProcessedAt.Value.ToBangladeshString("dd MMM yyyy, hh:mm tt")</p>
                                </div>
                            </div>
                        }
                        @if (Model.CompletedAt.HasValue)
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker @(Model.Status == Bangaliyana.Models.SellerPaymentStatus.Paid ? "bg-success" : "bg-danger")"></div>
                                <div class="timeline-content">
                                    <small class="text-muted">@(Model.Status == Bangaliyana.Models.SellerPaymentStatus.Paid ? "Completed" : "Failed")</small>
                                    <p class="mb-0">@Model.CompletedAt.Value.ToBangladeshString("dd MMM yyyy, hh:mm tt")</p>
                                    @if (Model.ProcessedBy != null)
                                    {
                                        <small class="text-muted">By: @Model.ProcessedBy.Email</small>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Mark as Paid Modal -->
<div class="modal fade" id="markPaidModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-body text-center p-4">
                <div class="mb-3">
                    <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="fas fa-check-circle text-success" style="font-size: 2rem;"></i>
                    </div>
                </div>
                <h4 class="fw-bold mb-2">Mark Payment as Paid?</h4>
                <p class="text-muted mb-3">This will mark the payment as completed.</p>
                <form method="post" asp-action="MarkAsPaid">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-3 text-start">
                        <label class="form-label">Transaction Reference *</label>
                        <input type="text" name="transactionReference" class="form-control" placeholder="Enter transaction reference" required />
                    </div>
                    <div class="d-flex justify-content-center gap-2">
                        <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                            <i class="fas fa-times me-1"></i>Cancel
                        </button>
                        <button type="submit" class="btn btn-success px-4">
                            <i class="fas fa-check me-1"></i>Confirm Paid
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Mark as Failed Modal -->
<div class="modal fade" id="markFailedModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-body text-center p-4">
                <div class="mb-3">
                    <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="fas fa-times-circle text-danger" style="font-size: 2rem;"></i>
                    </div>
                </div>
                <h4 class="fw-bold mb-2">Mark Payment as Failed?</h4>
                <p class="text-muted mb-3">The amount will be refunded to seller balance.</p>
                <form method="post" asp-action="MarkAsFailed">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-3 text-start">
                        <label class="form-label">Failure Reason *</label>
                        <input type="text" name="failureReason" class="form-control" placeholder="Enter failure reason" required />
                    </div>
                    <div class="d-flex justify-content-center gap-2">
                        <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                            <i class="fas fa-times me-1"></i>Cancel
                        </button>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="fas fa-times me-1"></i>Mark Failed
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Delete Payment Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-body text-center p-4">
                <div class="mb-3">
                    <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="fas fa-trash text-danger" style="font-size: 2rem;"></i>
                    </div>
                </div>
                <h4 class="fw-bold mb-2">Delete Payment?</h4>
                <p class="text-muted mb-1">Are you sure you want to delete this payment?</p>
                <p class="text-muted mb-0"><strong>@Model.PaymentNumber</strong> - BDT @((int)Math.Round(Model.Amount))</p>
                @if (Model.Status == Bangaliyana.Models.SellerPaymentStatus.Pending)
                {
                    <div class="alert alert-warning mt-3 mb-0 text-start small">
                        <i class="fas fa-exclamation-triangle me-1"></i>
                        The payment amount will be refunded to the seller's balance.
                    </div>
                }
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2 py-4">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancel
                </button>
                <form method="post" asp-action="Delete" class="m-0 d-inline-flex">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="fas fa-trash me-1"></i>Delete Payment
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .timeline {
        position: relative;
        padding-left: 30px;
    }
    .timeline-item {
        position: relative;
        padding-bottom: 20px;
    }
    .timeline-item:not(:last-child)::before {
        content: '';
        position: absolute;
        left: -24px;
        top: 12px;
        height: calc(100%);
        width: 2px;
        background: #dee2e6;
    }
    .timeline-marker {
        position: absolute;
        left: -30px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        top: 4px;
    }
    [data-theme="dark"] .card {
        background-color: #1f2937;
        border-color: #374151;
    }
    [data-theme="dark"] .bg-light {
        background-color: #374151 !important;
    }
    [data-theme="dark"] .timeline-item:not(:last-child)::before {
        background: #4b5563;
    }
</style>

@section Scripts {
    <script>
        document.getElementById('attachmentInput').addEventListener('change', function() {
            var fileName = this.files[0]?.name || '';
            document.getElementById('attachmentName').textContent = fileName ? 'Attached: ' + fileName : '';
        });
    </script>
}
