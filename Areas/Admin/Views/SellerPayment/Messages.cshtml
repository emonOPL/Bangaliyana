@model IEnumerable<Bangaliyana.Models.SellerPaymentMessage>
@using Bangaliyana.Extensions
@{
    var payment = ViewBag.Payment as Bangaliyana.Models.SellerPayment;
    ViewData["Title"] = $"Messages - Payment #{payment?.PaymentNumber}";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Seller Payments</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Details", new { id = payment?.Id })">@payment?.PaymentNumber</a></li>
                    <li class="breadcrumb-item active">Messages</li>
                </ol>
            </nav>
            <h4 class="mb-0"><i class="fas fa-comments text-primary me-2"></i>Payment Support Messages</h4>
        </div>
        <a href="@Url.Action("Details", new { id = payment?.Id })" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to Details
        </a>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Warning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            <!-- Messages Card -->
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-envelope me-2"></i>Conversation
                    </h5>
                    @if (payment != null)
                    {
                        <span class="badge bg-secondary">@payment.PaymentNumber</span>
                    }
                </div>
                <div class="card-body chat-container" id="chatContainer" style="height: 500px; overflow-y: auto;">
                    @if (Model.Any())
                    {
                        @foreach (var msg in Model)
                        {
                            var isStaff = msg.IsStaffReply;
                            <div class="d-flex mb-3 @(isStaff ? "justify-content-end" : "")">
                                @if (!isStaff)
                                {
                                    <div class="flex-shrink-0 me-2">
                                        @if (payment?.Seller?.ShopLogoUrl != null)
                                        {
                                            <img src="@payment.Seller.ShopLogoUrl" alt="" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="bg-secondary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                <i class="fas fa-store text-secondary"></i>
                                            </div>
                                        }
                                    </div>
                                }
                                <div class="@(isStaff ? "bg-primary text-white" : "bg-light") rounded p-3" style="max-width: 70%;">
                                    <div class="d-flex align-items-center mb-1">
                                        <strong class="@(isStaff ? "text-white" : "")">
                                            @(isStaff ? (msg.Sender?.Email ?? "Staff") : (payment?.Seller?.ShopName ?? "Seller"))
                                        </strong>
                                        <small class="@(isStaff ? "text-white-50" : "text-muted") ms-2">
                                            @msg.CreatedAt.ToBangladeshString("dd MMM, hh:mm tt")
                                        </small>
                                        @if (!isStaff && msg.IsRead)
                                        {
                                            <i class="fas fa-check-double text-primary ms-2" title="Read"></i>
                                        }
                                    </div>
                                    <p class="mb-0" style="white-space: pre-wrap;">@msg.Message</p>
                                    @if (msg.Attachments?.Any() == true)
                                    {
                                        <div class="mt-2 pt-2 border-top @(isStaff ? "border-light" : "")">
                                            @foreach (var att in msg.Attachments)
                                            {
                                                var isImage = att.ContentType?.StartsWith("image/") == true;
                                                if (isImage)
                                                {
                                                    <a href="@att.FileUrl" target="_blank" class="d-block mb-1">
                                                        <img src="@att.FileUrl" alt="@att.FileName" class="img-thumbnail" style="max-width: 200px; max-height: 150px;">
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a href="@att.FileUrl" target="_blank" class="badge @(isStaff ? "bg-light text-dark" : "bg-secondary") text-decoration-none">
                                                        <i class="fas fa-paperclip me-1"></i>@att.FileName
                                                        @if (att.FileSize.HasValue)
                                                        {
                                                            <span class="ms-1">(@(att.FileSize.Value / 1024)KB)</span>
                                                        }
                                                    </a>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                                @if (isStaff)
                                {
                                    <div class="flex-shrink-0 ms-2">
                                        @if (msg.Sender?.AvatarUrl != null)
                                        {
                                            <img src="@msg.Sender.AvatarUrl" alt="" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                <i class="fas fa-user-shield text-primary"></i>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <i class="fas fa-comments fa-3x mb-3"></i>
                            <p class="mb-0">No messages yet. Start the conversation!</p>
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <form method="post" asp-action="SendMessage" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="paymentId" value="@payment?.Id" />
                        <div class="mb-2">
                            <textarea name="message" class="form-control" rows="3" placeholder="Type your message..." required></textarea>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <input type="file" name="attachment" class="d-none" id="attachmentInput" accept="image/*,.pdf,.doc,.docx" />
                                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('attachmentInput').click();">
                                    <i class="fas fa-paperclip me-1"></i>Attach File
                                </button>
                                <small class="text-muted ms-2" id="attachmentName"></small>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-paper-plane me-1"></i>Send Message
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Payment Summary -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Payment Summary</h5>
                </div>
                <div class="card-body">
                    @if (payment != null)
                    {
                        var statusBadge = payment.Status switch
                        {
                            Bangaliyana.Models.SellerPaymentStatus.Pending => "bg-warning text-dark",
                            Bangaliyana.Models.SellerPaymentStatus.UnderReview => "bg-info",
                            Bangaliyana.Models.SellerPaymentStatus.Processing => "bg-primary",
                            Bangaliyana.Models.SellerPaymentStatus.Paid => "bg-success",
                            Bangaliyana.Models.SellerPaymentStatus.Failed => "bg-danger",
                            _ => "bg-secondary"
                        };
                        <div class="text-center mb-3">
                            <span class="badge @statusBadge fs-6">@payment.Status.GetDisplayName()</span>
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <small class="text-muted d-block">Amount</small>
                                <strong class="text-success">BDT @((int)Math.Round(payment.Amount))</strong>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block">Method</small>
                                <strong>@payment.PaymentMethod.GetDisplayName()</strong>
                            </div>
                            <div class="col-12">
                                <small class="text-muted d-block">Period</small>
                                <strong>@payment.PeriodStart.ToBangladeshString("MMM dd") - @payment.PeriodEnd.ToBangladeshShortDateString()</strong>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Seller Info -->
            @if (payment?.Seller != null)
            {
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fas fa-store me-2"></i>Seller</h5>
                    </div>
                    <div class="card-body text-center">
                        @if (!string.IsNullOrEmpty(payment.Seller.ShopLogoUrl))
                        {
                            <img src="@payment.Seller.ShopLogoUrl" alt="@payment.Seller.ShopName" class="rounded-circle mb-2" style="width: 60px; height: 60px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-primary bg-opacity-10 rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                <i class="fas fa-store fa-xl text-primary"></i>
                            </div>
                        }
                        <h6 class="mb-0">@payment.Seller.ShopName</h6>
                        <small class="text-muted">@payment.Seller.User?.Email</small>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    [data-theme="dark"] .card {
        background-color: #1f2937;
        border-color: #374151;
    }
    [data-theme="dark"] .bg-light {
        background-color: #374151 !important;
    }
    [data-theme="dark"] .chat-container {
        background-color: #111827;
    }
</style>

@section Scripts {
    <script>
        // Scroll to bottom of chat
        document.addEventListener('DOMContentLoaded', function() {
            var chatContainer = document.getElementById('chatContainer');
            chatContainer.scrollTop = chatContainer.scrollHeight;
        });

        // Show attachment name
        document.getElementById('attachmentInput').addEventListener('change', function() {
            var fileName = this.files[0]?.name || '';
            document.getElementById('attachmentName').textContent = fileName ? 'Selected: ' + fileName : '';
        });
    </script>
}
