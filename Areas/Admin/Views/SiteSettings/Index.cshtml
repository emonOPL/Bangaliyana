@model Bangaliyana.Models.SiteSettings
@{
    ViewData["Title"] = Localizer["SiteSettings"].Value;
}

<div class="container px-4">
    <h1 class="mt-4">
        <i class="fas fa-cog me-2"></i>@Localizer["SiteSettings"]
    </h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Product" asp-action="Index">@Localizer["Dashboard"]</a></li>
        <li class="breadcrumb-item active">@Localizer["SiteSettings"]</li>
    </ol>

    <!-- Quick Links -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-gradient-primary text-white">
                <div class="card-body">
                    <h5 class="card-title mb-3">@Localizer["ContentManagement"]</h5>
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-action="Banners" class="btn btn-light btn-sm">
                            <i class="fas fa-images me-1"></i> @Localizer["Banners"]
                        </a>
                        <a asp-action="Features" class="btn btn-light btn-sm">
                            <i class="fas fa-star me-1"></i> @Localizer["Features"]
                        </a>
                        <a asp-action="SocialLinks" class="btn btn-light btn-sm">
                            <i class="fas fa-share-alt me-1"></i> @Localizer["SocialLinks"]
                        </a>
                        <a asp-action="Pages" class="btn btn-light btn-sm">
                            <i class="fas fa-file-alt me-1"></i> @Localizer["Pages"]
                        </a>
                        <a asp-action="Testimonials" class="btn btn-light btn-sm">
                            <i class="fas fa-quote-left me-1"></i> @Localizer["Testimonials"]
                        </a>
                        <a asp-action="FAQs" class="btn btn-light btn-sm">
                            <i class="fas fa-question-circle me-1"></i> @Localizer["FAQs"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="Index" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedAt" />

        <div class="row">
            <!-- Branding Section -->
            <div class="col-lg-6">
                <div class="card mb-4">
                    <div class="card-header">
                        <i class="fas fa-palette me-1"></i> @Localizer["Branding"]
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="SiteName" class="form-label"></label>
                            <input asp-for="SiteName" class="form-control" />
                            <span asp-validation-for="SiteName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="SiteTagline" class="form-label"></label>
                            <input asp-for="SiteTagline" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="CompanyName" class="form-label"></label>
                            <input asp-for="CompanyName" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="FoundingYear" class="form-label"></label>
                            <input asp-for="FoundingYear" class="form-control" type="number" min="1900" max="2100" />
                        </div>
                        <!-- Logo Row (Light + Dark) -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">@Localizer["Logo"] <small class="text-muted">(@Localizer["LightMode"])</small></label>
                                <input type="file" name="logoFile" class="form-control" accept="image/*" />
                                @if (!string.IsNullOrEmpty(Model.LogoUrl))
                                {
                                    <img src="~/@Model.LogoUrl" alt="Logo" class="img-thumbnail mt-2" style="max-height: 50px;" />
                                }
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">@Localizer["Logo"] <small class="text-muted">(@Localizer["DarkMode"])</small></label>
                                <input type="file" name="darkModeLogoFile" class="form-control" accept="image/*" />
                                @if (!string.IsNullOrEmpty(Model.DarkModeLogoUrl))
                                {
                                    <div class="p-2 mt-2 rounded" style="background: #1a1a2e;">
                                        <img src="~/@Model.DarkModeLogoUrl" alt="Dark Mode Logo" style="max-height: 50px;" />
                                    </div>
                                }
                                <small class="text-muted">@Localizer["DarkModeLogoHelp"]</small>
                            </div>
                        </div>
                        <!-- Footer Logo Row (Light + Dark) -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">@Localizer["FooterLogo"] <small class="text-muted">(@Localizer["LightMode"])</small></label>
                                <input type="file" name="footerLogoFile" class="form-control" accept="image/*" />
                                @if (!string.IsNullOrEmpty(Model.FooterLogoUrl))
                                {
                                    <img src="~/@Model.FooterLogoUrl" alt="Footer Logo" class="img-thumbnail mt-2" style="max-height: 50px;" />
                                }
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">@Localizer["FooterLogo"] <small class="text-muted">(@Localizer["DarkMode"])</small></label>
                                <input type="file" name="darkModeFooterLogoFile" class="form-control" accept="image/*" />
                                @if (!string.IsNullOrEmpty(Model.DarkModeFooterLogoUrl))
                                {
                                    <div class="p-2 mt-2 rounded" style="background: #1a1a2e;">
                                        <img src="~/@Model.DarkModeFooterLogoUrl" alt="Dark Mode Footer Logo" style="max-height: 50px;" />
                                    </div>
                                }
                                <small class="text-muted">@Localizer["DarkModeLogoHelp"]</small>
                            </div>
                        </div>
                        <!-- Favicon Row -->
                        <div class="mb-3">
                            <label class="form-label">@Localizer["Favicon"]</label>
                            <input type="file" name="faviconFile" class="form-control" accept="image/*" />
                            @if (!string.IsNullOrEmpty(Model.FaviconUrl))
                            {
                                <img src="~/@Model.FaviconUrl" alt="Favicon" class="img-thumbnail mt-2" style="max-height: 32px;" />
                            }
                            <small class="text-muted">@Localizer["FaviconHelp"]</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SEO Section -->
            <div class="col-lg-6">
                <div class="card mb-4">
                    <div class="card-header">
                        <i class="fas fa-search me-1"></i> @Localizer["SEOSettings"]
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="SiteDescription" class="form-label"></label>
                            <textarea asp-for="SiteDescription" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label asp-for="SiteKeywords" class="form-label"></label>
                            <textarea asp-for="SiteKeywords" class="form-control" rows="2" placeholder="@Localizer["KeywordsPlaceholder"]"></textarea>
                        </div>
                    </div>
                </div>

                <!-- Footer Settings -->
                <div class="card mb-4">
                    <div class="card-header">
                        <i class="fas fa-shoe-prints me-1"></i> @Localizer["FooterSettings"]
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="FooterAboutText" class="form-label"></label>
                            <textarea asp-for="FooterAboutText" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label asp-for="CopyrightText" class="form-label"></label>
                            <input asp-for="CopyrightText" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contact Section -->
            <div class="col-lg-6">
                <div class="card mb-4">
                    <div class="card-header">
                        <i class="fas fa-address-book me-1"></i> @Localizer["ContactInformation"]
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="ContactEmail" class="form-label"></label>
                            <input asp-for="ContactEmail" class="form-control" type="email" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="ContactPhone" class="form-label"></label>
                            <input asp-for="ContactPhone" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="ContactAddress" class="form-label"></label>
                            <textarea asp-for="ContactAddress" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Business Settings -->
            <div class="col-lg-6">
                <div class="card mb-4">
                    <div class="card-header">
                        <i class="fas fa-store me-1"></i> @Localizer["BusinessSettings"]
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CurrencySymbol" class="form-label"></label>
                                <input asp-for="CurrencySymbol" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="CurrencyCode" class="form-label"></label>
                                <input asp-for="CurrencyCode" class="form-control" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DefaultDeliveryCharge" class="form-label"></label>
                                <input asp-for="DefaultDeliveryCharge" class="form-control" type="number" step="0.01" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="FreeDeliveryThreshold" class="form-label"></label>
                                <input asp-for="FreeDeliveryThreshold" class="form-control" type="number" step="0.01" placeholder="@Localizer["FreeDeliveryPlaceholder"]" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile Financial Services (MFS) Settings -->
            <div class="col-lg-6">
                <div class="card mb-4">
                    <div class="card-header">
                        <i class="fas fa-mobile-alt me-1"></i> @Localizer["MFSSettings"]
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-3">@Localizer["MFSDescription"]</p>
                        <div class="mb-3">
                            <label asp-for="BkashNumber" class="form-label">
                                <img src="https://www.bkash.com/sites/all/themes/flavor/logo.png" alt="bKash" style="height: 20px;" onerror="this.style.display='none'" />
                                bKash Number
                            </label>
                            <input asp-for="BkashNumber" class="form-control" placeholder="01XXXXXXXXX" />
                            <span asp-validation-for="BkashNumber" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NagadNumber" class="form-label">
                                <img src="https://nagad.com.bd/wp-content/uploads/2021/09/logo-1.png" alt="Nagad" style="height: 20px;" onerror="this.style.display='none'" />
                                Nagad Number
                            </label>
                            <input asp-for="NagadNumber" class="form-control" placeholder="01XXXXXXXXX" />
                            <span asp-validation-for="NagadNumber" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="RocketNumber" class="form-label">
                                <img src="https://www.dutchbanglabank.com/img/rocket-logo.png" alt="Rocket" style="height: 20px;" onerror="this.style.display='none'" />
                                Rocket Number
                            </label>
                            <input asp-for="RocketNumber" class="form-control" placeholder="01XXXXXXXXX" />
                            <span asp-validation-for="RocketNumber" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="UpayNumber" class="form-label">
                                <img src="https://upaybd.com/wp-content/uploads/2023/01/upay-logo.png" alt="Upay" style="height: 20px;" onerror="this.style.display='none'" />
                                Upay Number
                            </label>
                            <input asp-for="UpayNumber" class="form-control" placeholder="01XXXXXXXXX" />
                            <span asp-validation-for="UpayNumber" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Theme Settings -->
            <div class="col-lg-6">
                <div class="card mb-4">
                    <div class="card-header">
                        <i class="fas fa-paint-brush me-1"></i> @Localizer["ThemeSettings"]
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="PrimaryColor" class="form-label"></label>
                                <input asp-for="PrimaryColor" class="form-control form-control-color" type="color" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="SecondaryColor" class="form-label"></label>
                                <input asp-for="SecondaryColor" class="form-control form-control-color" type="color" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="AccentColor" class="form-label"></label>
                                <input asp-for="AccentColor" class="form-control form-control-color" type="color" />
                            </div>
                        </div>
                        <div class="form-check">
                            <input asp-for="EnableDarkMode" class="form-check-input" type="checkbox" />
                            <label asp-for="EnableDarkMode" class="form-check-label"></label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Maintenance Mode -->
            <div class="col-lg-12">
                <div class="card mb-4">
                    <div class="card-header bg-warning" style="color: #000 !important;">
                        <i class="fas fa-tools me-1"></i> @Localizer["MaintenanceMode"]
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input asp-for="IsMaintenanceMode" class="form-check-input" type="checkbox" />
                                    <label asp-for="IsMaintenanceMode" class="form-check-label"></label>
                                </div>
                            </div>
                            <div class="col-md-9">
                                <input asp-for="MaintenanceMessage" class="form-control" placeholder="@Localizer["MaintenancePlaceholder"]" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end mb-4">
            <button type="submit" class="btn btn-primary btn-lg">
                <i class="fas fa-save me-2"></i>@Localizer["SaveSettings"]
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
