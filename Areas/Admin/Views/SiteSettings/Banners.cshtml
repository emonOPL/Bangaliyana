@model List<Bangaliyana.Models.Banner>
@{
    ViewData["Title"] = "Manage Banners";
}

<div class="container px-4">
    <h1 class="mt-4">
        <i class="fas fa-images me-2"></i>Banners
    </h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="Index">Site Settings</a></li>
        <li class="breadcrumb-item active">Banners</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="fas fa-table me-1"></i> All Banners</span>
            <a asp-action="CreateBanner" class="btn btn-primary btn-sm">
                <i class="fas fa-plus me-1"></i> Add Banner
            </a>
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Title</th>
                        <th>Location</th>
                        <th>Order</th>
                        <th>Status</th>
                        <th>Schedule</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var banner in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(banner.ImageUrl))
                                {
                                    <img src="~/@banner.ImageUrl" alt="@banner.Title" style="max-height: 50px; max-width: 100px;" class="rounded" />
                                }
                                else
                                {
                                    <span class="text-muted">No image</span>
                                }
                            </td>
                            <td>
                                <strong>@banner.Title</strong>
                                @if (!string.IsNullOrEmpty(banner.Subtitle))
                                {
                                    <br /><small class="text-muted">@banner.Subtitle</small>
                                }
                            </td>
                            <td><span class="badge bg-info">@banner.Location</span></td>
                            <td>@banner.DisplayOrder</td>
                            <td>
                                @if (banner.IsCurrentlyActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else if (!banner.IsActive)
                                {
                                    <span class="badge bg-secondary">Disabled</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Scheduled</span>
                                }
                            </td>
                            <td>
                                @if (banner.StartDate.HasValue || banner.EndDate.HasValue)
                                {
                                    <small>
                                        @(banner.StartDate?.ToBangladeshString("MMM dd") ?? "Always") - @(banner.EndDate?.ToBangladeshString("MMM dd") ?? "Forever")
                                    </small>
                                }
                                else
                                {
                                    <span class="text-muted">Always</span>
                                }
                            </td>
                            <td>
                                <a asp-action="EditBanner" asp-route-id="@banner.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="DeleteBanner" asp-route-id="@banner.Id" method="post" class="d-inline delete-banner-form">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn btn-sm btn-outline-danger delete-banner-btn">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-images fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No banners found. Create your first banner!</p>
                    <a asp-action="CreateBanner" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i> Add Banner
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Banner Confirmation Modal -->
<div class="modal fade" id="deleteBannerModal" tabindex="-1" aria-labelledby="deleteBannerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center px-4 pt-0 pb-4">
                <div class="delete-icon-wrapper mb-3">
                    <div class="delete-icon-circle">
                        <i class="fas fa-trash-alt text-danger"></i>
                    </div>
                </div>
                <h4 class="modal-title fw-bold mb-2" id="deleteBannerModalLabel">Delete Banner?</h4>
                <p class="text-muted mb-0">Are you sure you want to delete this banner?</p>
                <p class="text-muted small">This action cannot be undone.</p>
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2 pt-0 pb-4">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Cancel
                </button>
                <button type="button" class="btn btn-danger px-4" id="confirmDeleteBannerBtn">
                    <i class="fas fa-check me-1"></i> Yes, Delete
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .delete-icon-wrapper { display: flex; justify-content: center; }
    .delete-icon-circle {
        width: 80px; height: 80px; border-radius: 50%;
        background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
        display: flex; align-items: center; justify-content: center;
        animation: pulse-danger 2s infinite;
    }
    .delete-icon-circle i { font-size: 2.5rem; }
    @@keyframes pulse-danger {
        0% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.4); }
        70% { box-shadow: 0 0 0 15px rgba(220, 53, 69, 0); }
        100% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); }
    }
    #deleteBannerModal .modal-content { border-radius: 1rem; }
    #deleteBannerModal .btn { border-radius: 0.5rem; font-weight: 500; }
    [data-theme="dark"] #deleteBannerModal .modal-content { background-color: #252538; }
    [data-theme="dark"] #deleteBannerModal .modal-title { color: #e0e0e0; }
    [data-theme="dark"] #deleteBannerModal .text-muted { color: #a0a0a0 !important; }
    [data-theme="dark"] .delete-icon-circle { background: linear-gradient(135deg, #3d2020 0%, #4a2525 100%); }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            let currentForm = null;
            const deleteBannerModal = new bootstrap.Modal(document.getElementById('deleteBannerModal'));

            document.querySelectorAll('.delete-banner-btn').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    currentForm = this.closest('.delete-banner-form');
                    deleteBannerModal.show();
                });
            });

            document.getElementById('confirmDeleteBannerBtn')?.addEventListener('click', function() {
                if (currentForm) {
                    deleteBannerModal.hide();
                    currentForm.submit();
                }
            });
        });
    </script>
}
