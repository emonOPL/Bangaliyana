@model List<Bangaliyana.Models.SellerSubscription>
@using Bangaliyana.Models
@using Bangaliyana.Extensions

@{
    ViewData["Title"] = "Seller Subscription History";
    var seller = ViewBag.Seller as Seller;
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Subscription Plans</a></li>
            <li class="breadcrumb-item"><a asp-action="Subscribers">Subscribers</a></li>
            <li class="breadcrumb-item active">@seller?.ShopName</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="fas fa-store text-primary me-2"></i>@seller?.ShopName</h1>
            <p class="text-muted mb-0">Subscription history and details</p>
        </div>
        <a asp-action="Subscribers" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to Subscribers
        </a>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Seller Info -->
        <div class="col-lg-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-user me-2"></i>Seller Information</h5>
                </div>
                <div class="card-body">
                    @if (seller != null)
                    {
                        <div class="text-center mb-3">
                            @if (!string.IsNullOrEmpty(seller.ShopLogoUrl))
                            {
                                <img src="~/@seller.ShopLogoUrl" alt="@seller.ShopName" class="rounded-circle" style="width: 80px; height: 80px; object-fit: cover;" />
                            }
                            else
                            {
                                <i class="fas fa-store fa-4x text-muted"></i>
                            }
                        </div>
                        <table class="table table-sm table-borderless mb-0">
                            <tr>
                                <td class="text-muted">Shop Name:</td>
                                <td><strong>@seller.ShopName</strong></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Owner:</td>
                                <td>@seller.User?.Email</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Phone:</td>
                                <td>@(seller.BusinessPhone ?? "-")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Commission:</td>
                                <td><strong>@seller.CommissionRate%</strong></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Status:</td>
                                <td>
                                    @if (seller.Status == SellerStatus.Approved)
                                    {
                                        <span class="badge bg-success">Approved</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@seller.Status</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td class="text-muted">Joined:</td>
                                <td>@seller.CreatedAt.ToString("dd MMM yyyy")</td>
                            </tr>
                        </table>
                    }
                </div>
            </div>

            <!-- Current Subscription -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-crown me-2"></i>Current Subscription</h5>
                </div>
                <div class="card-body">
                    @if (seller?.CurrentSubscription != null && seller.CurrentSubscription.Status == SubscriptionStatus.Active)
                    {
                        <div class="text-center mb-3">
                            <span class="badge fs-5 @(seller.CurrentSubscription.Plan?.BadgeColor ?? "bg-primary") p-2">
                                <i class="@(seller.CurrentSubscription.Plan?.IconClass ?? "fas fa-star") me-1"></i>
                                @seller.CurrentSubscription.Plan?.Name
                            </span>
                        </div>
                        <table class="table table-sm table-borderless mb-3">
                            <tr>
                                <td class="text-muted">Expires:</td>
                                <td>@seller.CurrentSubscription.EndDate.ToString("dd MMM yyyy")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Days Left:</td>
                                <td>
                                    @{
                                        var daysLeft = (seller.CurrentSubscription.EndDate - DateTime.UtcNow).Days;
                                    }
                                    <span class="@(daysLeft <= 7 ? "text-danger fw-bold" : "")">
                                        @daysLeft days
                                    </span>
                                </td>
                            </tr>
                        </table>
                    }
                    else
                    {
                        <div class="text-center text-muted py-3">
                            <i class="fas fa-times-circle fa-2x mb-2"></i>
                            <p class="mb-0">No active subscription</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Assign Plan -->
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-gift me-2"></i>Assign Plan</h5>
                </div>
                <div class="card-body">
                    <form asp-action="AssignPlan" method="post">
                        <input type="hidden" name="sellerId" value="@seller?.Id" />
                        <div class="mb-3">
                            <label class="form-label">Select Plan</label>
                            <select name="planId" class="form-select" required>
                                <option value="">-- Select Plan --</option>
                                @{
                                    var availablePlans = ViewBag.AvailablePlans as List<SellerSubscriptionPlan> ?? new List<SellerSubscriptionPlan>();
                                }
                                @foreach (var plan in availablePlans)
                                {
                                    <option value="@plan.Id">@plan.Name - ৳@plan.MonthlyPrice/month</option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-gift me-1"></i>Assign Plan
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Subscription History -->
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-history me-2"></i>Subscription History
                        <span class="badge bg-primary ms-2">@Model.Count</span>
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Plan</th>
                                        <th>Period</th>
                                        <th>Amount</th>
                                        <th>Payment</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var sub in Model)
                                    {
                                        var statusClass = sub.Status switch
                                        {
                                            SubscriptionStatus.Active => "bg-success",
                                            SubscriptionStatus.Expired => "bg-secondary",
                                            SubscriptionStatus.Cancelled => "bg-danger",
                                            SubscriptionStatus.PendingPayment => "bg-warning text-dark",
                                            SubscriptionStatus.Suspended => "bg-dark",
                                            _ => "bg-primary"
                                        };
                                        <tr>
                                            <td>
                                                @if (sub.Plan != null)
                                                {
                                                    <span class="badge @(sub.Plan.BadgeColor ?? "bg-primary")">
                                                        <i class="@(sub.Plan.IconClass ?? "fas fa-tag") me-1"></i>@sub.Plan.Name
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <small>
                                                    @sub.StartDate.ToString("dd MMM yyyy") - @sub.EndDate.ToString("dd MMM yyyy")
                                                </small>
                                            </td>
                                            <td>
                                                <strong>৳@sub.AmountPaid.ToString("N0")</strong>
                                                @if (sub.IsTrial)
                                                {
                                                    <span class="badge bg-info ms-1">Trial</span>
                                                }
                                            </td>
                                            <td>
                                                <small class="text-muted">@(sub.PaymentMethod ?? "-")</small>
                                                @if (!string.IsNullOrEmpty(sub.TransactionId))
                                                {
                                                    <br /><code class="small">@sub.TransactionId</code>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge @statusClass">@sub.Status.GetDisplayName()</span>
                                                @if (sub.Status == SubscriptionStatus.Cancelled && !string.IsNullOrEmpty(sub.CancellationReason))
                                                {
                                                    <br /><small class="text-muted" title="@sub.CancellationReason">
                                                        <i class="fas fa-info-circle"></i>
                                                    </small>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                            <p class="text-muted mb-0">No subscription history found</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        [data-theme="dark"] .card { background-color: var(--bs-dark); border-color: var(--bs-gray-700); }
        [data-theme="dark"] .card-header.bg-light { background-color: var(--bs-gray-800) !important; color: var(--bs-light); }
        [data-theme="dark"] .table { color: var(--bs-light); }
        [data-theme="dark"] .table-light { background-color: var(--bs-gray-800) !important; }
        [data-theme="dark"] .table-light th { background-color: var(--bs-gray-800) !important; color: var(--bs-light); }
        [data-theme="dark"] .form-control, [data-theme="dark"] .form-select { background-color: var(--bs-gray-800); color: var(--bs-light); border-color: var(--bs-gray-600); }
    </style>
}
