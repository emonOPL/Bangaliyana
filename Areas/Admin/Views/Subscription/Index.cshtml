@model List<Bangaliyana.Models.SellerSubscriptionPlan>

@{
    ViewData["Title"] = "Subscription Plans";
    var totalSubscribers = (int)ViewBag.TotalSubscribers;
    var activeSubscribers = (int)ViewBag.ActiveSubscribers;
    var monthlyRevenue = (decimal)ViewBag.MonthlyRevenue;
    var subscriptionsByPlan = ViewBag.SubscriptionsByPlan as Dictionary<string, int> ?? new Dictionary<string, int>();
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="fas fa-tags text-primary me-2"></i>Subscription Plans</h1>
            <p class="text-muted mb-0">Manage seller subscription plans and pricing</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Subscribers" class="btn btn-outline-info">
                <i class="fas fa-users me-1"></i>View Subscribers
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i>Add Plan
            </a>
        </div>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="fas fa-info-circle me-2"></i>@TempData["info"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-primary bg-opacity-10">
                <div class="card-body text-center py-3">
                    <i class="fas fa-users text-primary fa-lg mb-2"></i>
                    <h5 class="mb-0 fw-bold">@totalSubscribers</h5>
                    <small class="text-muted">Total Subscribers</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-success bg-opacity-10">
                <div class="card-body text-center py-3">
                    <i class="fas fa-user-check text-success fa-lg mb-2"></i>
                    <h5 class="mb-0 fw-bold">@activeSubscribers</h5>
                    <small class="text-muted">Active Subscribers</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-warning bg-opacity-10">
                <div class="card-body text-center py-3">
                    <i class="fas fa-tags text-warning fa-lg mb-2"></i>
                    <h5 class="mb-0 fw-bold">@Model.Count</h5>
                    <small class="text-muted">Total Plans</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-info bg-opacity-10">
                <div class="card-body text-center py-3">
                    <i class="fas fa-bangladeshi-taka-sign text-info fa-lg mb-2"></i>
                    <h5 class="mb-0 fw-bold">৳@monthlyRevenue.ToString("N0")</h5>
                    <small class="text-muted">Monthly Revenue</small>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="fas fa-tags fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">No subscription plans found</h5>
                <p class="text-muted mb-3">Create your first subscription plan to get started.</p>
                <div class="d-flex gap-2 justify-content-center">
                    <a asp-action="SeedPlans" class="btn btn-outline-success">
                        <i class="fas fa-magic me-1"></i>Seed Default Plans
                    </a>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i>Create Plan
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Plans Grid -->
        <div class="row g-4">
            @foreach (var plan in Model.OrderBy(p => p.SortOrder))
            {
                var subscribers = subscriptionsByPlan.GetValueOrDefault(plan.Name, 0);
                <div class="col-md-4">
                    <div class="card shadow-sm h-100 @(plan.IsFeatured ? "border-primary border-2" : "") @(!plan.IsActive ? "opacity-50" : "")">
                        @if (plan.IsFeatured)
                        {
                            <div class="position-absolute top-0 start-50 translate-middle">
                                <span class="badge bg-primary px-3 py-2">Recommended</span>
                            </div>
                        }
                        <div class="card-header text-center py-4 @(plan.BadgeColor ?? "bg-primary") text-white">
                            <i class="@(plan.IconClass ?? "fas fa-star") fa-2x mb-2"></i>
                            <h4 class="mb-0">@plan.Name</h4>
                            @if (!plan.IsActive)
                            {
                                <span class="badge bg-dark mt-2">Inactive</span>
                            }
                        </div>
                        <div class="card-body text-center">
                            <div class="mb-3">
                                <h2 class="mb-0">
                                    @if (plan.MonthlyPrice == 0)
                                    {
                                        <span class="text-success">Free</span>
                                    }
                                    else
                                    {
                                        <span>৳@plan.MonthlyPrice.ToString("N0")</span>
                                        <small class="text-muted fs-6">/month</small>
                                    }
                                </h2>
                            </div>
                            <p class="text-muted mb-4">@plan.Description</p>

                            <ul class="list-unstyled text-start mb-4">
                                <li class="mb-2">
                                    <i class="fas fa-box text-primary me-2"></i>
                                    <strong>@(plan.MaxProducts == -1 ? "Unlimited" : plan.MaxProducts.ToString())</strong> Products
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-percentage text-success me-2"></i>
                                    <strong>@plan.CommissionRate%</strong> Commission Rate
                                </li>
                                <li class="mb-2">
                                    @if (plan.HasPrioritySupport)
                                    {
                                        <i class="fas fa-check-circle text-success me-2"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-times-circle text-muted me-2"></i>
                                    }
                                    Priority Support
                                </li>
                                <li class="mb-2">
                                    @if (plan.HasFeaturedListing)
                                    {
                                        <i class="fas fa-check-circle text-success me-2"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-times-circle text-muted me-2"></i>
                                    }
                                    Featured Listing
                                </li>
                                <li class="mb-2">
                                    @if (plan.HasAdvancedAnalytics)
                                    {
                                        <i class="fas fa-check-circle text-success me-2"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-times-circle text-muted me-2"></i>
                                    }
                                    Advanced Analytics
                                </li>
                                <li class="mb-2">
                                    @if (plan.HasPromotionalTools)
                                    {
                                        <i class="fas fa-check-circle text-success me-2"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-times-circle text-muted me-2"></i>
                                    }
                                    Promotional Tools
                                </li>
                            </ul>

                            <div class="border-top pt-3 mb-3">
                                <small class="text-muted">
                                    <i class="fas fa-users me-1"></i>@subscribers Active Subscribers
                                </small>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@plan.Id" class="btn btn-outline-primary btn-sm flex-grow-1">
                                <i class="fas fa-edit me-1"></i>Edit
                            </a>
                            <form asp-action="ToggleStatus" asp-route-id="@plan.Id" method="post" class="flex-grow-1">
                                <button type="submit" class="btn btn-outline-@(plan.IsActive ? "warning" : "success") btn-sm w-100">
                                    <i class="fas fa-@(plan.IsActive ? "ban" : "check") me-1"></i>@(plan.IsActive ? "Disable" : "Enable")
                                </button>
                            </form>
                            @if (subscribers == 0)
                            {
                                <form asp-action="Delete" asp-route-id="@plan.Id" method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this plan?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Styles {
    <style>
        [data-theme="dark"] .card { background-color: var(--bs-dark); border-color: var(--bs-gray-700); }
        [data-theme="dark"] .card-header { border-color: var(--bs-gray-700); }
        [data-theme="dark"] .card-footer { border-color: var(--bs-gray-700); }
        [data-theme="dark"] .border-top { border-color: var(--bs-gray-700) !important; }
    </style>
}
