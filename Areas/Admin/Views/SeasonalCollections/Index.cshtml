@model List<Bangaliyana.Models.SeasonalCollection>
@{ ViewData["Title"] = Localizer["SeasonalCollections"].Value; }

<div class="container px-4">
    <h1 class="mt-4"><i class="fas fa-snowflake me-2"></i>@Localizer["SeasonalCollections"]</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">@Localizer["Dashboard"]</a></li>
        <li class="breadcrumb-item active">@Localizer["SeasonalCollections"]</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="fas fa-table me-1"></i> @Localizer["AllCollections"]</span>
            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i> @Localizer["AddCollection"]</a>
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>@Localizer["Name"]</th>
                        <th>@Localizer["Season"]</th>
                        <th>@Localizer["Year"]</th>
                        <th>@Localizer["DateRange"]</th>
                        <th>@Localizer["Status"]</th>
                        <th>@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var collection in Model)
                    {
                        <tr>
                            <td>
                                <strong>@collection.Name</strong>
                                @if (collection.IsFeatured)
                                {
                                    <span class="badge bg-warning ms-1">@Localizer["Featured"]</span>
                                }
                                @if (collection.IsCurrentlyActive)
                                {
                                    <span class="badge bg-success ms-1">@Localizer["Live"]</span>
                                }
                            </td>
                            <td><span class="badge bg-info">@collection.SeasonType</span></td>
                            <td>@collection.Year</td>
                            <td>
                                @if (collection.StartDate.HasValue || collection.EndDate.HasValue)
                                {
                                    <small>@collection.StartDate?.ToString("dd MMM") - @collection.EndDate?.ToString("dd MMM yyyy")</small>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>@(collection.IsActive ? Html.Raw($"<span class='badge bg-success'>{Localizer["Active"].Value}</span>") : Html.Raw($"<span class='badge bg-secondary'>{Localizer["Inactive"].Value}</span>"))</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@collection.Id" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></a>
                                @if (collection.IsCurrentlyActive)
                                {
                                    <a asp-area="Customer" asp-controller="SeasonalCollection" asp-action="Details" asp-route-slug="@collection.Slug" target="_blank" class="btn btn-sm btn-outline-info"><i class="fas fa-eye"></i></a>
                                }
                                <form asp-action="Delete" asp-route-id="@collection.Id" method="post" class="d-inline delete-form">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn btn-sm btn-outline-danger delete-btn"><i class="fas fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-snowflake fa-3x text-muted mb-3"></i>
                    <p class="text-muted">@Localizer["NoSeasonalCollectionsFound"]</p>
                    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i> @Localizer["AddCollection"]</a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button>
            </div>
            <div class="modal-body text-center px-4 pt-0 pb-4">
                <div class="delete-icon-wrapper mb-3"><div class="delete-icon-circle"><i class="fas fa-trash-alt text-danger"></i></div></div>
                <h4 class="modal-title fw-bold mb-2">@Localizer["DeleteCollection"]</h4>
                <p class="text-muted mb-0">@Localizer["ConfirmDeleteCollection"]</p>
                <p class="text-muted small">@Localizer["ActionCannotBeUndone"]</p>
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2 pt-0 pb-4">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i> @Localizer["Cancel"]</button>
                <button type="button" class="btn btn-danger px-4" id="confirmDeleteBtn"><i class="fas fa-check me-1"></i> @Localizer["YesDelete"]</button>
            </div>
        </div>
    </div>
</div>

<style>
    .delete-icon-wrapper { display: flex; justify-content: center; }
    .delete-icon-circle { width: 80px; height: 80px; border-radius: 50%; background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%); display: flex; align-items: center; justify-content: center; animation: pulse-danger 2s infinite; }
    .delete-icon-circle i { font-size: 2.5rem; }
    @@keyframes pulse-danger { 0% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.4); } 70% { box-shadow: 0 0 0 15px rgba(220, 53, 69, 0); } 100% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); } }
    #deleteModal .modal-content { border-radius: 1rem; }
    #deleteModal .btn { border-radius: 0.5rem; font-weight: 500; }
    [data-theme="dark"] #deleteModal .modal-content { background-color: #252538; }
    [data-theme="dark"] #deleteModal .modal-title { color: #e0e0e0; }
    [data-theme="dark"] #deleteModal .text-muted { color: #a0a0a0 !important; }
    [data-theme="dark"] .delete-icon-circle { background: linear-gradient(135deg, #3d2020 0%, #4a2525 100%); }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            let currentForm = null;
            const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            document.querySelectorAll('.delete-btn').forEach(btn => { btn.addEventListener('click', function(e) { e.preventDefault(); currentForm = this.closest('.delete-form'); deleteModal.show(); }); });
            document.getElementById('confirmDeleteBtn')?.addEventListener('click', function() { if (currentForm) { deleteModal.hide(); currentForm.submit(); } });
        });
    </script>
}
