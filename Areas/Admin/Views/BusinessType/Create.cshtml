@model Bangaliyana.Models.BusinessType
@{
    ViewData["Title"] = Localizer["AddBusinessType"];
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">@Localizer["BusinessTypes"]</a></li>
                    <li class="breadcrumb-item active">@Localizer["AddNew"]</li>
                </ol>
            </nav>
            <h2 class="mb-0"><i class="fas fa-plus-circle text-success me-2"></i>@Localizer["AddBusinessType"]</h2>
        </div>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@ViewBag.Error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">@Localizer["Name"] <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="@Localizer["BusinessTypeNamePlaceholder"]" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">@Localizer["Description"]</label>
                            <textarea asp-for="Description" class="form-control" rows="3"
                                      placeholder="@Localizer["BusinessTypeDescriptionPlaceholder"]"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="IconClass" class="form-label">@Localizer["IconClass"] (FontAwesome)</label>
                                <div class="input-group">
                                    <span class="input-group-text" id="iconPreview">
                                        <i class="fas fa-briefcase"></i>
                                    </span>
                                    <input asp-for="IconClass" class="form-control" id="iconInput"
                                           placeholder="@Localizer["IconClassPlaceholder"]" />
                                </div>
                                <small class="text-muted">
                                    @Localizer["BrowseIconsAt"] <a href="https://fontawesome.com/icons" target="_blank">FontAwesome</a>
                                </small>
                                <span asp-validation-for="IconClass" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="DisplayOrder" class="form-label">@Localizer["DisplayOrder"]</label>
                                <input asp-for="DisplayOrder" type="number" class="form-control" min="1" />
                                <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label asp-for="IsActive" class="form-check-label">@Localizer["Active"]</label>
                            </div>
                            <small class="text-muted">@Localizer["OnlyActiveBusinessTypesShown"]</small>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-1"></i>@Localizer["Cancel"]
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save me-1"></i>@Localizer["CreateBusinessType"]
                            </button>
                        </div>
                    </form>
        </div>
    </div>
</div>

<style>
    [data-theme="dark"] .card {
        background-color: #1f2937;
        border-color: #374151;
    }

    [data-theme="dark"] .form-control,
    [data-theme="dark"] .form-select {
        background-color: #374151;
        border-color: #4b5563;
        color: #f3f4f6;
    }

    [data-theme="dark"] .input-group-text {
        background-color: #374151;
        border-color: #4b5563;
        color: #9ca3af;
    }

    [data-theme="dark"] .breadcrumb {
        background-color: transparent;
    }

    [data-theme="dark"] .breadcrumb-item a {
        color: #60a5fa;
    }

    [data-theme="dark"] .breadcrumb-item.active {
        color: #9ca3af;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            // Update icon preview on input change
            $('#iconInput').on('input', function () {
                var iconClass = $(this).val() || 'fas fa-briefcase';
                $('#iconPreview i').attr('class', iconClass);
            });
        });
    </script>
}
