@using Bangaliyana.Models
@model IEnumerable<ProductReview>
@{
    ViewData["Title"] = "Reviews Management";
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var totalReviews = ViewBag.TotalReviews as int? ?? 0;
    var search = ViewBag.Search as string;
    var rating = ViewBag.Rating as int?;
    var status = ViewBag.Status as string;
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="h3 mb-1"><i class="fas fa-star text-warning me-2"></i>Reviews Management</h1>
            <p class="text-muted mb-0">Manage all product reviews and replies</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge bg-primary fs-6 d-flex align-items-center" style="height: 38px;">
                <i class="fas fa-star me-1"></i>@totalReviews Reviews
            </span>
        </div>
    </div>

    @if (TempData["onSave"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["onSave"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["onEdit"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show">
            <i class="fas fa-info-circle me-2"></i>@TempData["onEdit"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["onDelete"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["onDelete"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filters Card -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small text-muted mb-1">Search</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" name="search" value="@search" class="form-control" placeholder="Product, customer, or comment..." />
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Rating</label>
                    <select name="rating" class="form-select">
                        <option value="">All Ratings</option>
                        @for (int i = 5; i >= 1; i--)
                        {
                            <option value="@i" selected="@(rating == i)">@i Star@(i > 1 ? "s" : "")</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Status</label>
                    <select name="status" class="form-select">
                        <option value="">All Status</option>
                        <option value="approved" selected="@(status == "approved")">Approved</option>
                        <option value="pending" selected="@(status == "pending")">Pending</option>
                        <option value="hasreply" selected="@(status == "hasreply")">Has Reply</option>
                        <option value="noreply" selected="@(status == "noreply")">No Reply</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1">
                            <i class="fas fa-filter me-1"></i>Filter
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-times"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Reviews Table Card -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 60px;">Product</th>
                                <th>Review</th>
                                <th>Customer</th>
                                <th class="text-center">Rating</th>
                                <th class="text-center">Status</th>
                                <th class="text-center">Reply</th>
                                <th>Date</th>
                                <th style="width: 120px;" class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var review in Model)
                            {
                                var productImage = review.Product?.ImageUrl ?? "images/products/noimage.jpg";
                                var statusClass = review.IsApproved ? "bg-success" : "bg-warning text-dark";
                                var statusText = review.IsApproved ? "Approved" : "Pending";
                                <tr>
                                    <td>
                                        <img src="~/@productImage" alt="Product"
                                             class="rounded shadow-sm" style="width: 50px; height: 50px; object-fit: cover;" />
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@review.Id" class="fw-semibold text-decoration-none review-link">
                                            @if (!string.IsNullOrEmpty(review.Title))
                                            {
                                                @(review.Title.Length > 30 ? review.Title.Substring(0, 30) + "..." : review.Title)
                                            }
                                            else if (!string.IsNullOrEmpty(review.Comment))
                                            {
                                                @(review.Comment.Length > 30 ? review.Comment.Substring(0, 30) + "..." : review.Comment)
                                            }
                                            else
                                            {
                                                <span class="text-muted">No comment</span>
                                            }
                                        </a>
                                        <br />
                                        <small class="text-muted">
                                            <i class="fas fa-box me-1"></i>@(review.Product?.Name?.Length > 25 ? review.Product.Name.Substring(0, 25) + "..." : review.Product?.Name ?? "Unknown")
                                        </small>
                                    </td>
                                    <td>
                                        <span class="fw-medium">@(review.User?.FullName ?? "Unknown")</span>
                                        @if (review.IsVerifiedPurchase)
                                        {
                                            <br /><span class="badge bg-info text-white"><i class="fas fa-check-circle me-1"></i>Verified</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-1">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= review.Rating)
                                                {
                                                    <i class="fas fa-star text-warning"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star text-muted"></i>
                                                }
                                            }
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @statusClass">@statusText</span>
                                    </td>
                                    <td class="text-center">
                                        @if (review.Reply != null)
                                        {
                                            <span class="badge bg-success"><i class="fas fa-reply me-1"></i>Yes</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">No</span>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            @review.CreatedAt.ToString("MMM dd, yyyy")
                                            <br />@review.CreatedAt.ToString("hh:mm tt")
                                        </small>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@review.Id" class="btn btn-outline-info" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            @if (!review.IsApproved)
                                            {
                                                <form asp-action="Approve" asp-route-id="@review.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-success" title="Approve">
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                </form>
                                            }
                                            <button type="button" class="btn btn-outline-danger" title="Delete"
                                                    data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                    data-review-id="@review.Id" data-review-product="@review.Product?.Name">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <nav class="p-3 border-top">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)"
                                   asp-route-search="@search" asp-route-rating="@rating" asp-route-status="@status">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                            @{
                                var startPage = Math.Max(1, currentPage - 2);
                                var endPage = Math.Min(totalPages, startPage + 4);
                                if (endPage - startPage < 4)
                                {
                                    startPage = Math.Max(1, endPage - 4);
                                }
                            }
                            @if (startPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" asp-route-page="1"
                                       asp-route-search="@search" asp-route-rating="@rating" asp-route-status="@status">1</a>
                                </li>
                                @if (startPage > 2)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                            }
                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i"
                                       asp-route-search="@search" asp-route-rating="@rating" asp-route-status="@status">@i</a>
                                </li>
                            }
                            @if (endPage < totalPages)
                            {
                                @if (endPage < totalPages - 1)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" asp-route-page="@totalPages"
                                       asp-route-search="@search" asp-route-rating="@rating" asp-route-status="@status">@totalPages</a>
                                </li>
                            }
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)"
                                   asp-route-search="@search" asp-route-rating="@rating" asp-route-status="@status">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                        <div class="text-center text-muted small mt-2">
                            Showing @((currentPage - 1) * 15 + 1) - @(Math.Min(currentPage * 15, totalReviews)) of @totalReviews reviews
                        </div>
                    </nav>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-star fa-4x text-muted mb-3"></i>
                    <h5 class="text-muted">No reviews found</h5>
                    <p class="text-muted">
                        @if (!string.IsNullOrEmpty(search) || rating.HasValue || !string.IsNullOrEmpty(status))
                        {
                            <text>Try adjusting your filters or search criteria</text>
                        }
                        else
                        {
                            <text>No product reviews have been submitted yet</text>
                        }
                    </p>
                    @if (!string.IsNullOrEmpty(search) || rating.HasValue || !string.IsNullOrEmpty(status))
                    {
                        <a asp-action="Index" class="btn btn-outline-primary">
                            <i class="fas fa-times me-1"></i>Clear Filters
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-body text-center p-4">
                <div class="mb-3">
                    <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="fas fa-trash-alt text-danger" style="font-size: 2rem;"></i>
                    </div>
                </div>
                <h4 class="fw-bold mb-2">Delete Review?</h4>
                <p class="text-muted mb-1">Are you sure you want to delete this review for "<span id="deleteProductName" class="fw-semibold"></span>"?</p>
                <p class="text-muted small mb-0">This action cannot be undone.</p>
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2 py-4">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancel
                </button>
                <form id="deleteForm" method="post" class="m-0 d-inline-flex">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="fas fa-trash me-1"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .review-link {
            color: var(--bs-body-color);
            transition: color 0.2s;
        }
        .review-link:hover {
            color: var(--bs-primary);
        }

        .table > tbody > tr:hover {
            background-color: rgba(var(--bs-primary-rgb), 0.05);
        }

        /* Dark mode styles */
        [data-theme="dark"] .card {
            background-color: var(--bs-dark);
            border-color: var(--bs-gray-700);
        }

        [data-theme="dark"] .table {
            color: var(--bs-light);
        }

        [data-theme="dark"] .table-light {
            background-color: #374151 !important;
            color: #f3f4f6 !important;
        }

        [data-theme="dark"] .table-light th {
            background-color: #374151 !important;
            color: #f3f4f6 !important;
        }

        [data-theme="dark"] .form-control,
        [data-theme="dark"] .form-select {
            background-color: var(--bs-gray-800);
            border-color: var(--bs-gray-600);
            color: var(--bs-light);
        }

        [data-theme="dark"] .input-group-text {
            background-color: var(--bs-gray-700);
            border-color: var(--bs-gray-600);
            color: var(--bs-light);
        }

        [data-theme="dark"] .page-link {
            background-color: var(--bs-gray-800);
            border-color: var(--bs-gray-600);
            color: var(--bs-light);
        }

        [data-theme="dark"] .page-item.active .page-link {
            background-color: var(--bs-primary);
            border-color: var(--bs-primary);
        }

        [data-theme="dark"] .page-item.disabled .page-link {
            background-color: var(--bs-gray-900);
            color: var(--bs-gray-500);
        }

        [data-theme="dark"] .border-top {
            border-color: var(--bs-gray-700) !important;
        }

        [data-theme="dark"] .modal-content {
            background-color: var(--bs-dark);
            color: var(--bs-light);
        }
    </style>
}

@section Scripts {
    <script>
        // Delete modal handler
        document.getElementById('deleteModal').addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var reviewId = button.getAttribute('data-review-id');
            var productName = button.getAttribute('data-review-product');

            document.getElementById('deleteProductName').textContent = productName || 'Unknown Product';
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + reviewId;
        });
    </script>
}
