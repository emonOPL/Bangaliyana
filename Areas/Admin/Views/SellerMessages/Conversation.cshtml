@model List<Bangaliyana.Models.SellerMessage>

@{
    var conversation = ViewBag.Conversation as Bangaliyana.Models.SellerConversation;
    var currentUserId = ViewBag.CurrentUserId as string;
    var quickReplies = ViewBag.QuickReplies as List<Bangaliyana.Areas.Admin.Controllers.QuickReplyTemplate>;
    var sellerProducts = ViewBag.SellerProducts as dynamic;
    ViewData["Title"] = $"Conversation with {conversation?.Buyer?.FullName ?? "Customer"}";

    // Bangladesh Standard Time (UTC+6)
    var bdTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Bangladesh Standard Time");
    Func<DateTime, DateTime> toBdTime = (utcTime) => TimeZoneInfo.ConvertTimeFromUtc(utcTime, bdTimeZone);
}

<div class="container py-4">
    <div class="row">
        <!-- Main Chat Area -->
        <div class="col-lg-8">
            <!-- Back Button and Header -->
            <div class="chat-header d-flex align-items-center mb-3 p-3 rounded shadow-sm" style="background-color: var(--bg-color);">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div class="d-flex align-items-center flex-grow-1">
                    <div class="avatar-circle bg-secondary text-white me-3">
                        @(conversation?.Buyer?.FullName?.Substring(0, 1).ToUpper() ?? "C")
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold">@(conversation?.Buyer?.FullName ?? "Customer")</h6>
                        <small class="text-muted">@(conversation?.Buyer?.Email ?? "")</small>
                    </div>
                </div>
                <div class="btn-group btn-group-sm">
                    @if (conversation != null && !conversation.IsClosedBySeller)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#closeConversationModal">
                            <i class="fas fa-times me-1"></i>Close
                        </button>
                    }
                </div>
            </div>

            @if (TempData["success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Context Info -->
            @if (!string.IsNullOrEmpty(conversation?.Subject) || conversation?.Order != null || conversation?.Product != null)
            {
                <div class="context-card p-3 mb-3 rounded shadow-sm">
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        @if (!string.IsNullOrEmpty(conversation?.Subject))
                        {
                            <span class="badge bg-primary-subtle text-primary">
                                <i class="fas fa-tag me-1"></i>@conversation.Subject
                            </span>
                        }
                        @if (conversation?.Order != null)
                        {
                            <a href="@Url.Action("Details", "Orders", new { id = conversation.Order.Id })"
                               class="badge bg-info-subtle text-info text-decoration-none">
                                <i class="fas fa-shopping-bag me-1"></i>Order #@conversation.Order.OrderNumber
                            </a>
                        }
                        @if (conversation?.Product != null)
                        {
                            <a href="@Url.Action("Edit", "Product", new { id = conversation.Product.Id })"
                               class="badge bg-secondary text-decoration-none">
                                <i class="fas fa-box me-1"></i>@conversation.Product.Name
                            </a>
                        }
                        <span class="text-muted small ms-auto">
                            <i class="fas fa-clock me-1"></i>Started @conversation?.CreatedAt.ToBangladeshShortDateString()
                        </span>
                    </div>
                </div>
            }

            <!-- Unified Chatbox Container -->
            <div class="card border-0 shadow-sm chatbox-unified">
                <!-- Search Within Conversation - Integrated in chatbox header -->
                <div class="chatbox-search-bar">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-transparent border-0">
                            <i class="fas fa-search text-muted"></i>
                        </span>
                        <input type="text" id="messageSearch" class="form-control border-0"
                               placeholder="Search in this conversation... (Ctrl+F)" />
                        <span id="searchResults" class="input-group-text bg-transparent text-muted d-none border-0">
                            <span id="currentMatch">0</span>/<span id="totalMatches">0</span>
                        </span>
                        <button type="button" id="prevMatch" class="btn btn-sm btn-link text-muted d-none" title="Previous match">
                            <i class="fas fa-chevron-up"></i>
                        </button>
                        <button type="button" id="nextMatch" class="btn btn-sm btn-link text-muted d-none" title="Next match">
                            <i class="fas fa-chevron-down"></i>
                        </button>
                        <button type="button" id="clearSearch" class="btn btn-sm btn-link text-muted d-none" title="Clear search">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>

                <!-- Messages Container -->
                <div class="chat-container" id="chatContainer">
                    @if (Model.Any())
                    {
                        var lastDate = DateTime.MinValue;
                        @foreach (var message in Model)
                        {
                            var bdMessageTime = toBdTime(message.CreatedAt);
                            // Date separator
                            if (bdMessageTime.Date != lastDate.Date)
                            {
                                lastDate = bdMessageTime;
                                <div class="date-separator my-3">
                                    <span>@bdMessageTime.ToBangladeshDateString()</span>
                                </div>
                            }

                            var isMe = message.IsSentBySeller;
                            var canEditDelete = isMe && !message.IsRead && !message.IsDeleted && (DateTime.UtcNow - message.CreatedAt).TotalMinutes <= 15;
                            <div class="d-flex @(isMe ? "justify-content-end" : "justify-content-start") mb-3 message-row" data-message-id="@message.Id">
                                @if (!isMe)
                                {
                                    <div class="message-avatar me-2">
                                        <div class="avatar-sm bg-secondary text-white">
                                            @(conversation?.Buyer?.FullName?.Substring(0, 1).ToUpper() ?? "C")
                                        </div>
                                    </div>
                                }
                                @if (isMe && canEditDelete)
                                {
                                    <div class="message-actions me-2 d-flex align-items-start dropdown">
                                        <button type="button" class="btn btn-sm btn-link text-muted p-1 message-menu-btn"
                                                data-bs-toggle="dropdown" aria-expanded="false" title="Message options">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end message-dropdown shadow-sm">
                                            <li>
                                                <button type="button" class="dropdown-item"
                                                        onclick="openEditModal(@message.Id, '@Html.Raw(message.Message.Replace("'", "\\'").Replace("\n", "\\n").Replace("\r", ""))')">
                                                    <i class="fas fa-pencil-alt me-2 text-primary"></i>Edit
                                                </button>
                                            </li>
                                            <li>
                                                <button type="button" class="dropdown-item text-danger"
                                                        onclick="openDeleteModal(@message.Id)">
                                                    <i class="fas fa-trash-alt me-2"></i>Delete
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                }
                                <div class="chat-bubble @(isMe ? "chat-bubble-me" : "chat-bubble-other") @(message.IsDeleted ? "deleted-message" : "")">
                                    @if (message.IsDeleted)
                                    {
                                        <div class="message-content deleted-text">
                                            <i class="fas fa-ban me-1"></i>This message was deleted
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- Message Type Badge -->
                                        @if (message.MessageType == "rating_request")
                                        {
                                            <div class="message-type-badge mb-2">
                                                <span class="badge bg-warning text-dark">
                                                    <i class="fas fa-star me-1"></i>Rating Request
                                                </span>
                                            </div>
                                        }
                                        @if (message.MessageType == "shared_product" && message.SharedProductId.HasValue)
                                        {
                                            <div class="shared-content shared-product mb-2">
                                                <i class="fas fa-box me-1"></i>
                                                <span>Shared Product</span>
                                                <a href="@Url.Action("Edit", "Product", new { id = message.SharedProductId })"
                                                   class="btn btn-sm btn-outline-light ms-2">View</a>
                                            </div>
                                        }
                                        @if (message.SharedOrderId.HasValue)
                                        {
                                            <div class="shared-content shared-order mb-2">
                                                <i class="fas fa-shopping-bag me-1"></i>
                                                <span>Shared Order #@message.SharedOrderId</span>
                                                <a href="@Url.Action("Details", "Orders", new { id = message.SharedOrderId })"
                                                   class="btn btn-sm btn-outline-light ms-2">View</a>
                                            </div>
                                        }

                                        @* Don't show auto-generated attachment message if attachment is present *@
                                        @if (!(!string.IsNullOrEmpty(message.AttachmentUrl) && (message.Message.StartsWith("Sent an attachment:") || string.IsNullOrWhiteSpace(message.Message))) && !string.IsNullOrWhiteSpace(message.Message))
                                        {
                                            <div class="message-content">@message.Message</div>
                                        }
                                        @if (message.IsEdited)
                                        {
                                            <small class="edited-indicator"><i class="fas fa-pencil-alt me-1"></i>edited</small>
                                        }
                                    }

                                    @if (!string.IsNullOrEmpty(message.AttachmentUrl))
                                    {
                                        <div class="attachment-preview mt-2">
                                            @if (message.AttachmentType == "image")
                                            {
                                                <a href="@message.AttachmentUrl" target="_blank" data-lightbox="messages">
                                                    <img src="@message.AttachmentUrl" alt="Attachment" class="attachment-image">
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="@message.AttachmentUrl" target="_blank" class="attachment-file">
                                                    <i class="fas fa-file me-1"></i>@(message.AttachmentName ?? "Download File")
                                                </a>
                                            }
                                        </div>
                                    }

                                    <div class="message-time">
                                        @bdMessageTime.ToBangladeshString("hh:mm tt")
                                        @if (isMe)
                                        {
                                            @if (message.IsRead)
                                            {
                                                <i class="fas fa-check-double text-info ms-1" title="Read"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-check ms-1" title="Sent"></i>
                                            }
                                        }
                                    </div>
                                </div>
                                @if (isMe)
                                {
                                    <div class="message-avatar ms-2">
                                        <div class="avatar-sm bg-success text-white">
                                            <i class="fas fa-store"></i>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <i class="fas fa-comments fa-3x mb-3"></i>
                            <p>No messages yet. Start the conversation!</p>
                        </div>
                    }
                </div>

                <!-- Reply Form - Integrated in chatbox footer -->
                @if (conversation != null && !conversation.IsClosedBySeller && !conversation.IsClosedByBuyer)
                {
                    <div class="chatbox-input-area">
                        <form asp-action="SendMessage" method="post" enctype="multipart/form-data" id="messageForm">
                            <input type="hidden" name="conversationId" value="@conversation.Id" />
                            <input type="hidden" name="sharedProductId" id="sharedProductId" />

                            <!-- Attachment Preview -->
                            <div id="attachmentPreview" class="attachment-preview-container d-none mb-2">
                                <div class="d-flex align-items-center p-2 bg-light rounded">
                                    <i class="fas fa-paperclip me-2"></i>
                                    <span id="attachmentName" class="flex-grow-1"></span>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeAttachment()">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Shared Content Preview -->
                            <div id="sharedContentPreview" class="shared-preview-container d-none mb-2">
                                <div class="d-flex align-items-center p-2 bg-light rounded">
                                    <i id="sharedContentIcon" class="fas fa-share me-2"></i>
                                    <span id="sharedContentText" class="flex-grow-1"></span>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeSharedContent()">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="input-group">
                                <!-- Quick Actions Button -->
                                <div class="btn-group dropup">
                                    <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" title="Quick Actions">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#quickReplyModal">
                                                <i class="fas fa-reply me-2 text-primary"></i>Quick Replies
                                            </button>
                                        </li>
                                        <li>
                                            <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#shareProductModal">
                                                <i class="fas fa-box me-2 text-info"></i>Share Product
                                            </button>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#requestRatingModal">
                                                <i class="fas fa-star me-2 text-warning"></i>Request Rating
                                            </button>
                                        </li>
                                    </ul>
                                </div>

                                <!-- Attachment Button -->
                                <label class="btn btn-outline-secondary" for="attachmentInput" title="Attach File">
                                    <i class="fas fa-paperclip"></i>
                                </label>
                                <input type="file" name="attachment" id="attachmentInput" class="d-none"
                                       accept="image/*,.pdf,.doc,.docx" onchange="previewAttachment(this)">

                                <textarea name="message" class="form-control" rows="1" id="messageInput"
                                          placeholder="Type your message... (Ctrl+Enter to send)"
                                          style="min-height: 44px; max-height: 120px; resize: none;"></textarea>
                                <button type="submit" class="btn btn-success" title="Send Message (Ctrl+Enter)">
                                    <i class="fas fa-paper-plane"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                }
                else if (conversation?.IsClosedBySeller == true)
                {
                    <div class="chatbox-closed-notice">
                        <i class="fas fa-lock me-2"></i>You have closed this conversation.
                        <form asp-action="ReopenConversation" asp-route-id="@conversation.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-link p-0">Reopen</button>
                        </form>
                    </div>
                }
                else if (conversation?.IsClosedByBuyer == true)
                {
                    <div class="chatbox-closed-notice">
                        <i class="fas fa-lock me-2"></i>The customer has closed this conversation.
                    </div>
                }
            </div>
        </div>

        <!-- Sidebar - Quick Actions -->
        <div class="col-lg-4 d-none d-lg-block">
            <!-- Customer Info Card -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-transparent">
                    <h6 class="mb-0"><i class="fas fa-user me-2"></i>Customer Info</h6>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="avatar-circle bg-secondary text-white me-3" style="width: 50px; height: 50px;">
                            @(conversation?.Buyer?.FullName?.Substring(0, 1).ToUpper() ?? "C")
                        </div>
                        <div>
                            <h6 class="mb-0">@(conversation?.Buyer?.FullName ?? "Customer")</h6>
                            <small class="text-muted">@(conversation?.Buyer?.Email ?? "")</small>
                        </div>
                    </div>
                    @if (conversation?.Order != null)
                    {
                        <hr>
                        <h6 class="small text-muted mb-2">RELATED ORDER</h6>
                        <div class="small">
                            <strong>Order #@conversation.Order.OrderNumber</strong>
                            <br><span class="text-muted">@conversation.Order.OrderDate.ToBangladeshShortDateString()</span>
                            <br><span class="text-primary fw-bold">৳@conversation.Order.TotalAmount.ToString("N0")</span>
                        </div>
                    }
                    @if (conversation?.Product != null)
                    {
                        <hr>
                        <h6 class="small text-muted mb-2">RELATED PRODUCT</h6>
                        <div class="d-flex align-items-center">
                            <img src="~/@(conversation.Product.ImageUrl ?? "images/products/noimage.jpg")"
                                 alt="@conversation.Product.Name" class="rounded me-2"
                                 style="width: 40px; height: 40px; object-fit: cover;"
                                 onerror="this.src='/images/products/noimage.jpg'">
                            <div class="small">
                                <div class="text-truncate" style="max-width: 150px;">@conversation.Product.Name</div>
                                <span class="text-primary fw-bold">৳@((conversation.Product.DiscountPrice ?? conversation.Product.Price).ToString("N0"))</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Quick Actions Card -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent">
                    <h6 class="mb-0"><i class="fas fa-bolt me-2"></i>Seller Actions</h6>
                </div>
                <div class="card-body p-2">
                    <div class="list-group list-group-flush">
                        <button type="button" class="list-group-item list-group-item-action" data-bs-toggle="modal" data-bs-target="#quickReplyModal">
                            <i class="fas fa-reply me-2 text-primary"></i>Quick Replies
                        </button>
                        <button type="button" class="list-group-item list-group-item-action" data-bs-toggle="modal" data-bs-target="#shareProductModal">
                            <i class="fas fa-box me-2 text-info"></i>Share a Product
                        </button>
                        <button type="button" class="list-group-item list-group-item-action" data-bs-toggle="modal" data-bs-target="#requestRatingModal">
                            <i class="fas fa-star me-2 text-warning"></i>Request Rating
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Reply Modal -->
<div class="modal fade" id="quickReplyModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-reply me-2"></i>Quick Replies</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Select a template to use:</p>
                <div class="list-group" id="quickReplyList">
                    @if (quickReplies != null)
                    {
                        foreach (var reply in quickReplies)
                        {
                            <button type="button" class="list-group-item list-group-item-action"
                                    onclick="useQuickReply('@reply.Message.Replace("'", "\\'").Replace("\n", "\\n")')">
                                <strong>@reply.Title</strong>
                                <br><small class="text-muted text-truncate d-block">@reply.Message</small>
                            </button>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Share Product Modal -->
<div class="modal fade" id="shareProductModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-box me-2"></i>Share Product</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">Select a product to share with the customer:</p>
                <div class="list-group" id="productList" style="max-height: 300px; overflow-y: auto;">
                    @if (sellerProducts != null)
                    {
                        foreach (var product in (IEnumerable<dynamic>)sellerProducts)
                        {
                            var productImgUrl = !string.IsNullOrEmpty((string)product.ImageUrl)
                                ? (((string)product.ImageUrl).StartsWith("/") ? (string)product.ImageUrl : "/" + (string)product.ImageUrl)
                                : "/images/products/noimage.jpg";
                            <button type="button" class="list-group-item list-group-item-action"
                                    onclick="selectProduct(@product.Id, '@product.Name.Replace("'", "\\'")')">
                                <div class="d-flex align-items-center">
                                    <img src="@productImgUrl" class="rounded me-2" style="width: 40px; height: 40px; object-fit: cover;"
                                         onerror="this.src='/images/products/noimage.jpg'">
                                    <div class="flex-grow-1">
                                        <div class="text-truncate" style="max-width: 200px;">@product.Name</div>
                                        <small class="text-primary fw-bold">৳@((decimal)product.Price).ToString("N0")</small>
                                    </div>
                                </div>
                            </button>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-3">
                            <p>No products available</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Request Rating Modal -->
<div class="modal fade" id="requestRatingModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title"><i class="fas fa-star me-2"></i>Request Rating</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="RequestRating" method="post">
                <input type="hidden" name="conversationId" value="@conversation?.Id" />
                <div class="modal-body">
                    <p class="text-muted">
                        Send a friendly request to the customer asking them to rate their experience.
                    </p>
                    @if (conversation?.OrderId != null)
                    {
                        <input type="hidden" name="orderId" value="@conversation.OrderId" />
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            This will request a rating for Order #@conversation.Order?.OrderNumber
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-secondary">
                            <i class="fas fa-info-circle me-2"></i>
                            No specific order linked to this conversation. A general rating request will be sent.
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-star me-1"></i>Send Rating Request
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    /* Unified Chatbox Container */
    .chatbox-unified {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 280px);
        min-height: 500px;
        max-height: 700px;
        border-radius: 1rem;
        overflow: hidden;
        background-color: #fff;
    }

    /* Search bar at top of chatbox */
    .chatbox-search-bar {
        padding: 0.5rem 1rem;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-bottom: 1px solid #dee2e6;
        flex-shrink: 0;
    }

    .chatbox-search-bar .form-control {
        background-color: transparent;
    }

    .chatbox-search-bar .form-control:focus {
        box-shadow: none;
        background-color: #fff;
    }

    /* Search highlight styling */
    .search-highlight {
        background-color: #ffc107;
        color: #000;
        padding: 0 2px;
        border-radius: 2px;
    }

    .message-row.search-match {
        animation: highlightFade 1s ease;
    }

    .message-row.search-current .chat-bubble {
        box-shadow: 0 0 0 2px var(--success-color, #198754), 0 0 8px rgba(25, 135, 84, 0.4);
    }

    @@keyframes highlightFade {
        0%, 50% { background-color: rgba(255, 193, 7, 0.2); }
        100% { background-color: transparent; }
    }

    [data-theme="dark"] .search-highlight {
        background-color: #ffc107;
        color: #000;
    }

    [data-theme="dark"] .chatbox-search-bar {
        background: linear-gradient(135deg, #1e1e2d 0%, #252538 100%);
        border-bottom-color: #3d3d5c;
    }

    [data-theme="dark"] .chatbox-search-bar .input-group-text {
