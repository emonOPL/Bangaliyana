@functions {
    List<string> GetReturnImages(Order order)
    {
        if (string.IsNullOrEmpty(order.ReturnImages))
            return new List<string>();

        try
        {
            return JsonSerializer.Deserialize<List<string>>(order.ReturnImages) ?? new List<string>();
        }
        catch
        {
            return new List<string>();
        }
    }

    string FormatReturnReason(string? reason)
    {
        if (string.IsNullOrEmpty(reason))
            return "No reason specified";

        var mappings = new Dictionary<string, string>
        {
            { "Damaged", "Damaged Product" },
            { "WrongItem", "Wrong Item Received" },
            { "NotAsDescribed", "Product Not as Described" },
            { "QualityIssue", "Quality Not Satisfactory" },
            { "SizeIssue", "Size/Fit Issue" },
            { "ChangedMind", "Changed Mind" },
            { "Other", "Other" }
        };

        foreach (var m in mappings)
        {
            if (reason.StartsWith(m.Key + ":"))
                return m.Value + reason.Substring(m.Key.Length);
            if (reason == m.Key)
                return m.Value;
        }
        return reason;
    }

    string GetRefundMethodDisplay(RefundMethod? method)
    {
        if (method == null) return "Not specified";
        return method switch
        {
            RefundMethod.WalletCredit => "Wallet Credit",
            RefundMethod.Bkash => "bKash",
            RefundMethod.Nagad => "Nagad",
            RefundMethod.Upay => "Upay",
            RefundMethod.Rocket => "Rocket",
            RefundMethod.BankTransfer => "Bank Transfer",
            RefundMethod.OriginalMethod => "Original Payment Method",
            _ => method.ToString() ?? "Unknown"
        };
    }

    string GetRefundMethodIcon(RefundMethod? method)
    {
        return method switch
        {
            RefundMethod.WalletCredit => "fas fa-wallet",
            RefundMethod.Bkash => "fas fa-mobile-alt",
            RefundMethod.Nagad => "fas fa-mobile-alt",
            RefundMethod.Upay => "fas fa-mobile-alt",
            RefundMethod.Rocket => "fas fa-mobile-alt",
            RefundMethod.BankTransfer => "fas fa-university",
            _ => "fas fa-credit-card"
        };
    }

    string GetRefundStatusDisplay(RefundStatus status)
    {
        return status switch
        {
            RefundStatus.Pending => "Pending",
            RefundStatus.Reviewing => "Reviewing",
            RefundStatus.InProgress => "In Progress",
            RefundStatus.Approved => "Approved",
            RefundStatus.Rejected => "Rejected",
            RefundStatus.Completed => "Completed",
            _ => status.ToString()
        };
    }

    string GetPaymentMethodDisplay(PaymentMethod method)
    {
        return method switch
        {
            PaymentMethod.CashOnDelivery => "Cash On Delivery",
            PaymentMethod.OnlinePayment => "Online Payment",
            PaymentMethod.bKash => "bKash",
            PaymentMethod.Nagad => "Nagad",
            PaymentMethod.Rocket => "Rocket",
            PaymentMethod.CreditDebitCard => "Credit/Debit Card",
            PaymentMethod.Upay => "Upay",
            _ => method.ToString()
        };
    }

    string GetStatusAlertClass(RefundStatus status)
    {
        return status switch
        {
            RefundStatus.Pending => "alert-warning",
            RefundStatus.Reviewing => "alert-info",
            RefundStatus.InProgress => "alert-primary",
            RefundStatus.Approved => "alert-success",
            RefundStatus.Rejected => "alert-danger",
            RefundStatus.Completed => "alert-success",
            _ => "alert-secondary"
        };
    }

    string GetStatusIconClass(RefundStatus status)
    {
        return status switch
        {
            RefundStatus.Pending => "fas fa-clock",
            RefundStatus.Reviewing => "fas fa-search",
            RefundStatus.InProgress => "fas fa-spinner",
            RefundStatus.Approved => "fas fa-check-circle",
            RefundStatus.Rejected => "fas fa-times-circle",
            RefundStatus.Completed => "fas fa-check-double",
            _ => "fas fa-question-circle"
        };
    }

    string GetRefundStatusTimelineColor(RefundStatus status)
    {
        return status switch
        {
            RefundStatus.Pending => "bg-warning",
            RefundStatus.Reviewing => "bg-info",
            RefundStatus.InProgress => "bg-primary",
            RefundStatus.Approved => "bg-success",
            RefundStatus.Rejected => "bg-danger",
            RefundStatus.Completed => "bg-success",
            _ => "bg-secondary"
        };
    }

    string GetOrderStatusBadgeClass(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Pending => "bg-warning text-dark",
            OrderStatus.Confirmed => "bg-info",
            OrderStatus.Delivered => "bg-success",
            OrderStatus.Returned => "bg-warning text-dark",
            OrderStatus.Refunded => "bg-success",
            OrderStatus.Cancelled => "bg-danger",
            _ => "bg-secondary"
        };
    }

    string GetPaymentStatusBadgeClass(PaymentStatus status)
    {
        return status switch
        {
            PaymentStatus.Pending => "bg-warning text-dark",
            PaymentStatus.Processing => "bg-info",
            PaymentStatus.Completed => "bg-success",
            PaymentStatus.Failed => "bg-danger",
            PaymentStatus.Refunded => "bg-success",
            PaymentStatus.PartiallyRefunded => "bg-info",
            _ => "bg-secondary"
        };
    }

    string GetRefundStatusBadgeClass(RefundStatus status)
    {
        return status switch
        {
            RefundStatus.Pending => "bg-warning text-dark",
            RefundStatus.Reviewing => "bg-info",
            RefundStatus.InProgress => "bg-primary",
            RefundStatus.Approved => "bg-success",
            RefundStatus.Rejected => "bg-danger",
            RefundStatus.Completed => "bg-success",
            _ => "bg-secondary"
        };
    }
}

@section Styles {
    <style>
        /* Prevent auto-hide and ensure persistent visibility for all cards and alerts */
        .container .alert,
        .container .card {
            animation: none !important;
            opacity: 1 !important;
            visibility: visible !important;
            display: block !important;
            transition: none !important;
        }

        /* Keep text color consistent in both light and dark mode for status banner */
        .alert-primary,
        .alert-primary h5,
        .alert-primary small,
        .alert-primary .badge {
            color: #084298 !important;
        }
        .alert-warning,
        .alert-warning h5,
        .alert-warning small {
            color: #664d03 !important;
        }
        .alert-success,
        .alert-success h5,
        .alert-success small {
            color: #0f5132 !important;
        }
        .alert-danger,
        .alert-danger h5,
        .alert-danger small {
            color: #842029 !important;
        }
        .alert-info,
        .alert-info h5,
        .alert-info small {
            color: #055160 !important;
        }

        /* Dark mode - keep same text colors */
        [data-theme="dark"] .alert-primary,
        [data-theme="dark"] .alert-primary h5,
        [data-theme="dark"] .alert-primary small {
            color: #084298 !important;
        }
        [data-theme="dark"] .alert-warning,
        [data-theme="dark"] .alert-warning h5,
        [data-theme="dark"] .alert-warning small {
            color: #664d03 !important;
        }
        [data-theme="dark"] .alert-success,
        [data-theme="dark"] .alert-success h5,
        [data-theme="dark"] .alert-success small {
            color: #0f5132 !important;
        }
        [data-theme="dark"] .alert-danger,
        [data-theme="dark"] .alert-danger h5,
        [data-theme="dark"] .alert-danger small {
            color: #842029 !important;
        }
        [data-theme="dark"] .alert-info,
        [data-theme="dark"] .alert-info h5,
        [data-theme="dark"] .alert-info small {
            color: #055160 !important;
        }

        /* Refund code styling - works in both light and dark mode */
        .refund-code {
            display: inline-block;
            padding: 0.25rem 0.5rem;
            font-family: SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
            font-size: 0.875rem;
            background-color: rgba(var(--bs-success-rgb), 0.15);
            color: var(--bs-success);
            border-radius: 0.375rem;
            border: 1px solid rgba(var(--bs-success-rgb), 0.3);
        }
        [data-theme="dark"] .refund-code {
            background-color: rgba(25, 135, 84, 0.2);
            color: #75b798;
            border-color: rgba(25, 135, 84, 0.4);
        }

        .return-image-wrapper {
            position: relative;
            overflow: hidden;
            border-radius: 0.5rem;
            aspect-ratio: 1;
        }
        .return-image-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }
        .return-image-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        .return-image-overlay i {
            color: white;
            font-size: 1.5rem;
        }
        .return-image-link:hover .return-image-wrapper img {
            transform: scale(1.05);
        }
        .return-image-link:hover .return-image-overlay {
            opacity: 1;
        }

        /* Timeline */
        .timeline {
            position: relative;
            padding-left: 30px;
        }
        .timeline::before {
            content: '';
            position: absolute;
            left: 8px;
            top: 5px;
            bottom: 5px;
            width: 2px;
            background: #e5e7eb;
        }
        .timeline-item {
            position: relative;
            margin-bottom: 1rem;
        }
        .timeline-item:last-child {
            margin-bottom: 0;
        }
        .timeline-marker {
            position: absolute;
            left: -26px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            top: 3px;
        }
        .timeline-content p {
            font-size: 0.9rem;
        }

        /* Dark mode fixes */
        [data-theme="dark"] .table-light,
        [data-theme="dark"] .table-light th,
        [data-theme="dark"] .table-light td {
            background-color: #374151 !important;
            color: #e5e7eb !important;
        }
        [data-theme="dark"] .table-primary,
        [data-theme="dark"] .table-primary th,
        [data-theme="dark"] .table-primary td {
            background-color: #1e3a5f !important;
            color: #e5e7eb !important;
        }
        [data-theme="dark"] .bg-light {
            background-color: #374151 !important;
        }
        [data-theme="dark"] .card {
            background-color: #1f2937;
        }
        [data-theme="dark"] .modal-content {
            background-color: #1f2937;
        }
        [data-theme="dark"] .timeline::before {
            background: #4b5563;
        }
        [data-theme="dark"] .form-control,
        [data-theme="dark"] .form-select {
            background-color: #374151;
            border-color: #4b5563;
            color: #e5e7eb;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Show/hide approved amount field based on status
            $('#newStatusSelect').on('change', function() {
                var status = $(this).val();
                if (status === 'Approved') {
                    $('#approvedAmountGroup').slideDown();
                } else {
                    $('#approvedAmountGroup').slideUp();
                }
            }).trigger('change');

            // Show/hide payment detail fields based on refund method
            $('#quickRefundMethodSelect').on('change', function() {
                var method = $(this).val();
                if (method !== 'WalletCredit') {
                    $('#quickPaidFromGroup').slideDown();
                    $('#quickReceiverGroup').slideDown();
                    $('#quickTransactionIdGroup').slideDown();
                } else {
                    $('#quickPaidFromGroup').slideUp();
                    $('#quickReceiverGroup').slideUp();
                    $('#quickTransactionIdGroup').slideUp();
                }
            }).trigger('change');

            // Update Refund Status
            $('#updateStatusBtn').on('click', function() {
                var btn = $(this);
                var form = $('#statusUpdateForm');
                var formData = form.serialize();

                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Updating...');

                $.ajax({
                    url: '@Url.Action("UpdateRefundStatus", "Orders", new { area = "Admin" })',
                    type: 'POST',
                    data: formData,
                    success: function(response) {
                        if (response.success) {
                            alertify.success(response.message);
                            setTimeout(function() {
                                location.reload();
                            }, 1500);
                        } else {
                            alertify.error(response.message);
                            btn.prop('disabled', false).html('<i class="fas fa-save me-1"></i> Update Status');
                        }
                    },
                    error: function() {
                        alertify.error('An error occurred. Please try again.');
                        btn.prop('disabled', false).html('<i class="fas fa-save me-1"></i> Update Status');
                    }
                });
            });

            // Update Order Status
            $('#updateOrderStatusBtn').on('click', function() {
                var btn = $(this);
                var form = $('#orderStatusUpdateForm');
                var formData = form.serialize();

                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Updating...');

                $.ajax({
                    url: '@Url.Action("UpdateStatus", "Orders", new { area = "Admin" })',
                    type: 'POST',
                    data: formData,
                    success: function(response) {
                        if (response.success) {
                            alertify.success(response.message);
                            setTimeout(function() {
                                location.reload();
                            }, 1500);
                        } else {
                            alertify.error(response.message);
                            btn.prop('disabled', false).html('<i class="fas fa-save me-1"></i> Update Order Status');
                        }
                    },
                    error: function() {
                        alertify.error('An error occurred. Please try again.');
                        btn.prop('disabled', false).html('<i class="fas fa-save me-1"></i> Update Order Status');
                    }
                });
            });

            // Refer to Accounting
            $('#referAccountingBtn').on('click', function() {
                var btn = $(this);
                var form = $('#referAccountingForm');
                var personName = form.find('[name="accountingPersonName"]').val();

                if (!personName || personName.trim() === '') {
                    alertify.error('Please enter the accounting team member name.');
                    return;
                }

                var formData = form.serialize();

                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Referring...');

                $.ajax({
                    url: '@Url.Action("ReferToAccounting", "Orders", new { area = "Admin" })',
                    type: 'POST',
                    data: formData,
                    success: function(response) {
                        if (response.success) {
                            alertify.success(response.message);
                            setTimeout(function() {
                                location.reload();
                            }, 1500);
                        } else {
                            alertify.error(response.message);
                            btn.prop('disabled', false).html('<i class="fas fa-paper-plane me-1"></i> Refer to Accounting');
                        }
                    },
                    error: function() {
                        alertify.error('An error occurred. Please try again.');
                        btn.prop('disabled', false).html('<i class="fas fa-paper-plane me-1"></i> Refer to Accounting');
                    }
                });
            });

            // Quick Approve & Process
            $('#quickApproveBtn').on('click', function() {
                var btn = $(this);
                var form = $('#quickApproveForm');
                var method = $('#quickRefundMethodSelect').val();

                // Validate required fields for non-wallet methods
                if (method !== 'WalletCredit') {
                    var paidFrom = $('#paidFromAccount').val();
                    var receiver = $('#receiverNumber').val();
                    var transactionId = $('#transactionId').val();

                    if (!paidFrom || paidFrom.trim() === '') {
                        alertify.error('Please enter the account from which refund was sent.');
                        $('#paidFromAccount').focus();
                        return;
                    }
                    if (!receiver || receiver.trim() === '') {
                        alertify.error('Please enter the receiver account/number.');
                        $('#receiverNumber').focus();
                        return;
                    }
                    if (!transactionId || transactionId.trim() === '') {
                        alertify.error('Please enter the transaction ID.');
                        $('#transactionId').focus();
                        return;
                    }
                }

                var formData = form.serialize();

                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Processing...');

                $.ajax({
                    url: '@Url.Action("ProcessRefund", "Orders", new { area = "Admin" })',
                    type: 'POST',
                    data: formData,
                    success: function(response) {
                        if (response.success) {
                            alertify.success(response.message);
                            setTimeout(function() {
                                location.reload();
                            }, 1500);
                        } else {
                            alertify.error(response.message);
                            btn.prop('disabled', false).html('<i class="fas fa-check me-1"></i> Approve & Process');
                        }
                    },
                    error: function() {
                        alertify.error('An error occurred. Please try again.');
                        btn.prop('disabled', false).html('<i class="fas fa-check me-1"></i> Approve & Process');
                    }
                });
            });

            // Process Replacement
            $('#processReplacementBtn').on('click', function() {
                var btn = $(this);
                var form = $('#replacementForm');
                var formData = form.serialize();

                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Creating...');

                $.ajax({
                    url: '@Url.Action("ProcessReplacement", "Orders", new { area = "Admin" })',
                    type: 'POST',
                    data: formData,
                    success: function(response) {
                        if (response.success) {
                            alertify.success(response.message);
                            setTimeout(function() {
                                if (response.replacementOrderId) {
                                    window.location.href = '@Url.Action("Details")/' + response.replacementOrderId;
                                } else {
                                    location.reload();
                                }
                            }, 1500);
                        } else {
                            alertify.error(response.message);
                            btn.prop('disabled', false).html('<i class="fas fa-check me-1"></i> Create Replacement');
                        }
                    },
                    error: function() {
                        alertify.error('An error occurred. Please try again.');
                        btn.prop('disabled', false).html('<i class="fas fa-check me-1"></i> Create Replacement');
                    }
                });
            });

            // Reject Return
            $('#rejectReturnBtn').on('click', function() {
                var btn = $(this);
                var form = $('#rejectForm');
                var reason = form.find('[name="rejectionReason"]').val();

                if (!reason || reason.trim() === '') {
                    alertify.error('Please enter a rejection reason.');
                    return;
                }

                var formData = form.serialize();

                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Rejecting...');

                $.ajax({
                    url: '@Url.Action("RejectReturn", "Orders", new { area = "Admin" })',
                    type: 'POST',
                    data: formData,
                    success: function(response) {
                        if (response.success) {
                            alertify.success(response.message);
                            setTimeout(function() {
                                window.location.href = '@Url.Action("Returns")';
                            }, 1500);
                        } else {
                            alertify.error(response.message);
                            btn.prop('disabled', false).html('<i class="fas fa-times me-1"></i> Reject Return');
                        }
                    },
                    error: function() {
                        alertify.error('An error occurred. Please try again.');
                        btn.prop('disabled', false).html('<i class="fas fa-times me-1"></i> Reject Return');
                    }
                });
            });

            // Show/hide fields based on edit refund method
            $('#editRefundMethodSelect').on('change', function() {
                var method = $(this).val();
                if (method !== 'WalletCredit') {
                    $('#editPaidFromGroup').slideDown();
                    $('#editReceiverGroup').slideDown();
                    $('#editTransactionIdGroup').slideDown();
                } else {
                    $('#editPaidFromGroup').slideUp();
                    $('#editReceiverGroup').slideUp();
                    $('#editTransactionIdGroup').slideUp();
                }
            }).trigger('change');

            // Save Refund Details
            $('#saveRefundDetailsBtn').on('click', function() {
                var btn = $(this);
                var form = $('#editRefundDetailsForm');
                var formData = form.serialize();

                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Saving...');

                $.ajax({
                    url: '@Url.Action("UpdateRefundPaymentDetails", "Orders", new { area = "Admin" })',
                    type: 'POST',
                    data: formData,
                    success: function(response) {
                        if (response.success) {
                            alertify.success(response.message);
                            $('#editRefundDetailsModal').modal('hide');
                            setTimeout(function() {
                                location.reload();
                            }, 1500);
                        } else {
                            alertify.error(response.message);
                            btn.prop('disabled', false).html('<i class="fas fa-save me-1"></i> Save Changes');
                        }
                    },
                    error: function() {
                        alertify.error('An error occurred. Please try again.');
                        btn.prop('disabled', false).html('<i class="fas fa-save me-1"></i> Save Changes');
                    }
                });
            });

            // Show TempData messages
            @if (TempData["success"] != null)
            {
                <text>alertify.success('@Html.Raw(TempData["success"])');</text>
            }
            @if (TempData["error"] != null)
            {
                <text>alertify.error('@Html.Raw(TempData["error"])');</text>
            }
        });
    </script>
}
