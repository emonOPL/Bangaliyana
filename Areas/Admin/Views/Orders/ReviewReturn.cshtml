                                {
                                    <br><strong>Name:</strong> @Model.RefundAccountHolderName
                                }
                                @if (!string.IsNullOrEmpty(Model.RefundBankName))
                                {
                                    <br><strong>Bank:</strong> @Model.RefundBankName
                                }
                            </small>
                        </div>
