                    <div class="mb-3" id="quickPaidFromGroup" style="display: none;">
                        <label class="form-label">Paid From Account <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="paidFromAccount" id="paidFromAccount"
                               placeholder="Enter the account/number from which refund was sent" />
