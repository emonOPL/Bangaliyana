                            }
                            else
                            {
                                <option value="WalletCredit">Wallet Credit (Instant)</option>
                            }
                            @if (Model.PreferredRefundMethod == RefundMethod.Bkash)
                            {
                                <option value="Bkash" selected>bKash</option>
                            }
                            else
                            {
                                <option value="Bkash">bKash</option>
                            }
                            @if (Model.PreferredRefundMethod == RefundMethod.Nagad)
                            {
                                <option value="Nagad" selected>Nagad</option>
                            }
                            else
                            {
                                <option value="Nagad">Nagad</option>
                            }
                            @if (Model.PreferredRefundMethod == RefundMethod.Upay)
                            {
                                <option value="Upay" selected>Upay</option>
                            }
                            else
                            {
                                <option value="Upay">Upay</option>
                            }
                            @if (Model.PreferredRefundMethod == RefundMethod.Rocket)
                            {
                                <option value="Rocket" selected>Rocket</option>
                            }
                            else
                            {
                                <option value="Rocket">Rocket</option>
                            }
                            @if (Model.PreferredRefundMethod == RefundMethod.BankTransfer)
                            {
                                <option value="BankTransfer" selected>Bank Transfer</option>
                            }
                            else
                            {
                                <option value="BankTransfer">Bank Transfer</option>
                            }
