@using Bangaliyana.Models
@using Bangaliyana.Extensions
@using System.Text.Json
@model Order

@{
    ViewData["Title"] = $"Review Return - Order #{Model.OrderNumber ?? Model.Id.ToString()}";
    var returnImages = GetReturnImages(Model);
    var isRefunded = Model.PaymentStatus == PaymentStatus.Refunded || Model.PaymentStatus == PaymentStatus.PartiallyRefunded || Model.RefundStatus == RefundStatus.Completed;
    var isApproved = Model.RefundStatus == RefundStatus.Approved;
    var isRejected = Model.RefundStatus == RefundStatus.Rejected;
    var isPending = Model.Status == OrderStatus.Returned && !isRefunded && !isRejected;
    // Calculate SubTotal from OrderItems if it's 0 (for backward compatibility)
    var subTotal = Model.SubTotal > 0 ? Model.SubTotal : Model.OrderItems.Sum(i => i.TotalPrice);
    // Calculate total discounts (voucher/coupon + reward discount + premium discount)
    var totalDiscounts = Model.DiscountAmount + Model.RewardDiscountAmount + Model.PremiumDiscountAmount;
    // Refundable amount = SubTotal - all discounts (delivery charge is non-refundable, already excluded from subtotal)
    var refundableAmount = (int)Math.Round(subTotal - totalDiscounts);
    // Ensure refundable amount is not negative
    if (refundableAmount < 0) refundableAmount = 0;
}

<div class="container">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="display-6 mb-1">
                <i class="fas fa-undo-alt text-warning me-2"></i>Refund Action Center
            </h2>
            <p class="text-muted mb-0">Order #@(Model.OrderNumber ?? Model.Id.ToString())</p>
        </div>
        <div class="btn-group">
            <a asp-action="Returns" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Back to Returns
            </a>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                <i class="fas fa-receipt me-1"></i> Order Details
            </a>
        </div>
    </div>

    <!-- Status Banner -->
    <div class="alert alert-permanent @GetStatusAlertClass(Model.RefundStatus) mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h5 class="mb-1">
                    <i class="@GetStatusIconClass(Model.RefundStatus) me-2"></i>Refund Status: @GetRefundStatusDisplay(Model.RefundStatus)
                </h5>
                @if (Model.RefundStatusChangedAt.HasValue)
                {
                    <small>Last updated: @Model.RefundStatusChangedAt.Value.ToBangladeshString()</small>
                }
            </div>
            @if (Model.ReferredToAccounting)
            {
                <span class="badge bg-info fs-6">
                    <i class="fas fa-user-tie me-1"></i>Referred to: @Model.ReferredToAccountingName
                </span>
            }
        </div>
    </div>

    <div class="row">
        <!-- Left Column - Return Details -->
        <div class="col-lg-8">
            <!-- Return Information Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-warning bg-opacity-10 border-0">
                    <h5 class="mb-0 text-warning">
                        <i class="fas fa-exclamation-circle me-2"></i>Return Request Details
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="mb-0">
                                <dt class="text-muted small">Return Reason</dt>
                                <dd class="mb-3">
                                    <span class="badge bg-secondary fs-6">
                                        @FormatReturnReason(Model.ReturnReason)
                                    </span>
                                </dd>

                                <dt class="text-muted small">Customer Preference</dt>
                                <dd class="mb-3">
                                    @if (Model.PrefersReplacement)
                                    {
                                        <span class="badge bg-info fs-6">
                                            <i class="fas fa-exchange-alt me-1"></i> Replacement Preferred
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success fs-6">
                                            <i class="fas fa-money-bill-wave me-1"></i> Refund Requested
                                        </span>
                                    }
                                </dd>

                                <dt class="text-muted small">Requested On</dt>
                                <dd class="mb-3">
                                    @if (Model.ReturnedAt.HasValue)
                                    {
                                        @Model.ReturnedAt.Value.ToBangladeshString()
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not recorded</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl class="mb-0">
                                <dt class="text-muted small">Order Status</dt>
                                <dd class="mb-3">
                                    <span class="badge @GetOrderStatusBadgeClass(Model.Status) fs-6">
                                        @Model.Status.GetDisplayName()
                                    </span>
                                </dd>

                                <dt class="text-muted small">Refund Status</dt>
                                <dd class="mb-3">
                                    <span class="badge @GetRefundStatusBadgeClass(Model.RefundStatus) fs-6">
                                        @GetRefundStatusDisplay(Model.RefundStatus)
                                    </span>
                                </dd>

                                @if (Model.ApprovedRefundAmount.HasValue)
                                {
                                    <dt class="text-muted small">Approved Refund Amount</dt>
                                    <dd class="mb-3">
                                        <span class="badge bg-success fs-5">৳@((int)Math.Round(Model.ApprovedRefundAmount.Value))</span>
                                    </dd>
                                }
                            </dl>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Refund Method & Account Details -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary bg-opacity-10 border-0">
                    <h5 class="mb-0 text-primary">
                        <i class="fas fa-credit-card me-2"></i>Refund Method & Account Details
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="mb-0">
                                <dt class="text-muted small">Preferred Refund Method</dt>
                                <dd class="mb-3">
                                    @{
                                        var refundLogoPath = Model.PreferredRefundMethod switch
                                        {
                                            RefundMethod.Bkash => "/images/logos/bkash-logo.png",
                                            RefundMethod.Nagad => "/images/logos/nagad-logo.png",
                                            RefundMethod.Rocket => "/images/logos/rocket-logo.png",
                                            RefundMethod.Upay => "/images/logos/upay-logo.png",
                                            _ => ""
                                        };
                                    }
                                    <span class="badge bg-primary fs-6 d-inline-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(refundLogoPath))
                                        {
                                            <img src="@refundLogoPath" alt="@GetRefundMethodDisplay(Model.PreferredRefundMethod)" style="height: 18px; width: auto;" class="me-1" />
                                        }
                                        else
                                        {
                                            <i class="@GetRefundMethodIcon(Model.PreferredRefundMethod) me-1"></i>
                                        }
                                        @GetRefundMethodDisplay(Model.PreferredRefundMethod)
                                    </span>
                                </dd>

                                <dt class="text-muted small">Refundable Amount</dt>
                                <dd class="mb-2">
                                    <span class="fs-5 fw-bold text-success">৳@refundableAmount</span>
                                </dd>
                                @if (Model.DeliveryCharge > 0)
                                {
                                    <dt class="text-muted small">Delivery Charge (Non-refundable)</dt>
                                    <dd class="mb-3">
                                        <span class="text-muted"><s>৳@((int)Math.Round(Model.DeliveryCharge))</s></span>
                                    </dd>
                                }
                                @if (totalDiscounts > 0)
                                {
                                    <dt class="text-muted small">Discounts Applied (Non-refundable)</dt>
                                    <dd class="mb-3">
                                        <span class="text-muted"><s>৳@((int)Math.Round(totalDiscounts))</s></span>
                                    </dd>
                                }

                                <dt class="text-muted small">Original Payment Method</dt>
                                <dd class="mb-0">
                                    <span class="badge bg-secondary">@GetPaymentMethodDisplay(Model.PaymentMethod)</span>
                                </dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            @if (Model.PreferredRefundMethod == RefundMethod.WalletCredit)
                            {
                                <div class="alert alert-permanent alert-success py-2 mb-0">
                                    <i class="fas fa-wallet me-2"></i>
                                    <strong>Wallet Credit</strong>
                                    <p class="mb-0 small mt-1">Refund will be credited instantly to customer's wallet when approved.</p>
                                </div>
                            }
                            else if (Model.PreferredRefundMethod == RefundMethod.BankTransfer)
                            {
                                <div class="p-3 bg-light rounded">
                                    <h6 class="mb-2"><i class="fas fa-university me-2"></i>Bank Account Details</h6>
                                    @if (!string.IsNullOrEmpty(Model.RefundBankName))
                                    {
                                        <div><strong>Bank:</strong> @Model.RefundBankName</div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.RefundAccountHolderName))
                                    {
                                        <div><strong>Account Name:</strong> @Model.RefundAccountHolderName</div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.RefundAccountNumber))
                                    {
                                        <div><strong>Account Number:</strong> <code>@Model.RefundAccountNumber</code></div>
                                    }
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(Model.RefundAccountNumber))
                            {
                                <div class="p-3 bg-light rounded">
                                    @{
                                        var logoPath = Model.PreferredRefundMethod switch
                                        {
                                            RefundMethod.Bkash => "/images/logos/bkash-logo.png",
                                            RefundMethod.Nagad => "/images/logos/nagad-logo.png",
                                            RefundMethod.Rocket => "/images/logos/rocket-logo.png",
                                            RefundMethod.Upay => "/images/logos/upay-logo.png",
                                            _ => ""
                                        };
                                        var methodName = GetRefundMethodDisplay(Model.PreferredRefundMethod);
                                    }
                                    <h6 class="mb-2 d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(logoPath))
                                        {
                                            <img src="@logoPath" alt="@methodName" style="height: 24px; width: auto;" class="me-2" />
                                        }
                                        else
                                        {
                                            <i class="fas fa-mobile-alt me-2"></i>
                                        }
                                        @methodName Account
                                    </h6>
                                    <div><strong>Number:</strong> <code>@Model.RefundAccountNumber</code></div>
                                    @if (!string.IsNullOrEmpty(Model.RefundAccountHolderName))
                                    {
                                        <div><strong>Name:</strong> @Model.RefundAccountHolderName</div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-permanent alert-warning py-2 mb-0">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    <strong>No account details provided</strong>
                                    <p class="mb-0 small mt-1">Customer did not provide refund account details.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions Card (shown when order is returned and not yet refunded) -->
            @if (!isRefunded && !isRejected && Model.Status == OrderStatus.Returned)
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header border-0 bg-success bg-opacity-10">
                        <h5 class="mb-0 text-success">
                            <i class="fas fa-bolt me-2"></i>Quick Actions
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-success btn-lg" data-bs-toggle="modal" data-bs-target="#quickApproveModal">
                                <i class="fas fa-check-circle me-2"></i>Quick Approve & Process Refund
                            </button>
                            @if (Model.PrefersReplacement)
                            {
                                <button type="button" class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#replacementModal">
                                    <i class="fas fa-exchange-alt me-2"></i>Create Replacement Order
                                </button>
                            }
                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">
                                <i class="fas fa-times-circle me-2"></i>Reject Request
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- Admin Notes / Activity Log -->
            @if (!string.IsNullOrEmpty(Model.RefundAdminNotes) || !string.IsNullOrEmpty(Model.AdminNotes))
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header border-0">
                        <h5 class="mb-0">
                            <i class="fas fa-clipboard-list me-2"></i>Activity Log
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(Model.RefundAdminNotes))
                        {
                            <div class="mb-3">
                                <h6 class="text-muted">Refund Notes</h6>
                                <div class="p-3 bg-light rounded">
                                    <pre class="mb-0" style="white-space: pre-wrap; font-family: inherit;">@Model.RefundAdminNotes</pre>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.AdminNotes))
                        {
                            <div>
                                <h6 class="text-muted">Order Admin Notes</h6>
                                <div class="p-3 bg-light rounded">
                                    <pre class="mb-0" style="white-space: pre-wrap; font-family: inherit;">@Model.AdminNotes</pre>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Return Images -->
            @if (returnImages.Any())
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header border-0">
                        <h5 class="mb-0">
                            <i class="fas fa-images me-2"></i>Return Evidence Photos
                            <span class="badge bg-secondary ms-2">@returnImages.Count</span>
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            @foreach (var image in returnImages)
                            {
                                <div class="col-6 col-md-4 col-lg-3">
                                    <a href="@image" target="_blank" class="return-image-link">
                                        <div class="return-image-wrapper">
                                            <img src="@image" alt="Return evidence" class="img-fluid rounded">
                                            <div class="return-image-overlay">
                                                <i class="fas fa-search-plus"></i>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Order Items -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header border-0">
                    <h5 class="mb-0">
                        <i class="fas fa-shopping-cart me-2"></i>Order Items
                        <span class="badge bg-info ms-2">@Model.OrderItems.Count items</span>
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Product</th>
                                    <th class="text-center">Quantity</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end pe-4">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderItems)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                @if (item.Product != null && !string.IsNullOrEmpty(item.Product.ImageUrl))
                                                {
                                                    <img src="/@item.Product.ImageUrl" alt="@item.ProductName"
                                                         class="me-3 rounded" style="width: 50px; height: 50px; object-fit: cover;">
                                                }
                                                else
                                                {
                                                    <div class="me-3 bg-light d-flex align-items-center justify-content-center rounded"
                                                         style="width: 50px; height: 50px;">
                                                        <i class="fas fa-box text-muted"></i>
                                                    </div>
                                                }
                                                <div>
                                                    <strong>@item.ProductName</strong>
                                                    @if (!string.IsNullOrEmpty(item.VariantInfo))
                                                    {
                                                        <br><small class="text-info"><i class="fas fa-tag me-1"></i>@item.VariantInfo</small>
                                                    }
                                                    <br><small class="text-muted">ID: @item.ProductId</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-secondary">@item.Quantity</span>
                                        </td>
                                        <td class="text-end">৳@((int)Math.Round(item.UnitPrice))</td>
                                        <td class="text-end pe-4">
                                            <strong>৳@((int)Math.Round(item.TotalPrice))</strong>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <th colspan="3" class="text-end">Products Subtotal:</th>
                                    <th class="text-end pe-4">৳@((int)Math.Round(subTotal))</th>
                                </tr>
                                <tr>
                                    <th colspan="3" class="text-end">
                                        Delivery <span class="text-muted small">(Non-refundable)</span>:
                                    </th>
                                    <th class="text-end pe-4 text-muted"><s>৳@((int)Math.Round(Model.DeliveryCharge))</s></th>
                                </tr>
                                @if (totalDiscounts > 0)
                                {
                                    <tr>
                                        <th colspan="3" class="text-end">
                                            Discounts <span class="text-muted small">(Non-refundable)</span>:
                                        </th>
                                        <th class="text-end pe-4 text-muted"><s>-৳@((int)Math.Round(totalDiscounts))</s></th>
                                    </tr>
                                }
                                <tr class="table-secondary">
                                    <th colspan="3" class="text-end">Order Total:</th>
                                    <th class="text-end pe-4">৳@((int)Math.Round(Model.TotalAmount))</th>
                                </tr>
                                <tr class="table-success">
                                    <th colspan="3" class="text-end">Refundable Amount:</th>
                                    <th class="text-end pe-4 text-success fw-bold">৳@refundableAmount</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column - Customer Info & Actions -->
        <div class="col-lg-4">
            <!-- Customer Info -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header border-0">
                    <h5 class="mb-0">
                        <i class="fas fa-user me-2"></i>Customer Information
                    </h5>
                </div>
                <div class="card-body">
                    <dl class="mb-0">
                        <dt class="text-muted small">Name</dt>
                        <dd class="mb-3">@Model.CustomerName</dd>

                        <dt class="text-muted small">Phone</dt>
                        <dd class="mb-3">
                            <a href="tel:@Model.Phone" class="text-decoration-none">
                                <i class="fas fa-phone me-1"></i>@Model.Phone
                            </a>
                        </dd>

                        <dt class="text-muted small">Email</dt>
                        <dd class="mb-3">
                            <a href="mailto:@Model.Email" class="text-decoration-none">
                                <i class="fas fa-envelope me-1"></i>@Model.Email
                            </a>
                        </dd>

                        <dt class="text-muted small">Address</dt>
                        <dd class="mb-0">
                            <i class="fas fa-map-marker-alt me-1 text-muted"></i>@Model.Address
                            @if (!string.IsNullOrEmpty(Model.City))
                            {
                                <br><small class="text-muted">@Model.City</small>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            <!-- Update Order Status Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header border-0 bg-success bg-opacity-10">
                    <h5 class="mb-0 text-success">
                        <i class="fas fa-shopping-bag me-2"></i>Update Order Status
                    </h5>
                </div>
                <div class="card-body">
                    <form id="orderStatusUpdateForm">
                        <input type="hidden" name="id" value="@Model.Id" />
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">Current Order Status</label>
                            @if (Model.Status == OrderStatus.Refunded)
                            {
                                <div class="form-control bg-success bg-opacity-10 text-success fw-bold" style="pointer-events: none;">
                                    <i class="fas fa-check-circle me-1"></i>Refunded
                                </div>
                                <div class="form-text text-success">Order has been refunded. Status cannot be changed.</div>
                            }
                            else
                            {
                                <select class="form-select" name="status" id="orderStatusSelect" required>
                                    @{
                                        var orderStatuses = new[] {
                                            (OrderStatus.Pending, "Pending"),
                                            (OrderStatus.Confirmed, "Confirmed"),
                                            (OrderStatus.Paid, "Paid"),
                                            (OrderStatus.Processing, "Processing"),
                                            (OrderStatus.Shipped, "Shipped"),
                                            (OrderStatus.OutForDelivery, "Out For Delivery"),
                                            (OrderStatus.Delivered, "Delivered"),
                                            (OrderStatus.Cancelled, "Cancelled"),
                                            (OrderStatus.Returned, "Returned")
                                        };
                                    }
                                    @foreach (var (status, display) in orderStatuses)
                                    {
                                        if (Model.Status == status)
                                        {
                                            <option value="@status" selected>@display</option>
                                        }
                                        else
                                        {
                                            <option value="@status">@display</option>
                                        }
                                    }
                                </select>
                            }
                        </div>

                        @if (Model.Status != OrderStatus.Refunded)
                        {
                            <button type="button" class="btn btn-success w-100" id="updateOrderStatusBtn">
                                <i class="fas fa-save me-1"></i> Update Order Status
                            </button>
                        }
                    </form>
                </div>
            </div>

            <!-- Refund Status Change Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header border-0 bg-warning bg-opacity-10">
                    <h5 class="mb-0 text-warning">
                        <i class="fas fa-sync-alt me-2"></i>Update Refund Status
                    </h5>
                </div>
                <div class="card-body">
                    @if (isRefunded)
                    {
                        <div class="alert alert-permanent alert-success mb-0">
                            <i class="fas fa-check-circle me-2"></i>
                            <strong>Refund Completed</strong>
                            <p class="mb-0 mt-2 small">Payment status: @Model.PaymentStatus.GetDisplayName()</p>
                        </div>
                    }
                    else
                    {
                        <form id="statusUpdateForm">
                            <input type="hidden" name="id" value="@Model.Id" />
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label class="form-label">Change Status</label>
                                <select class="form-select" name="newStatus" id="newStatusSelect" required>
                                    @{
                                        // Completed status is only set via ProcessRefund, not manually
                                        var statuses = new[] {
                                            (RefundStatus.Pending, "Pending", "Pending"),
                                            (RefundStatus.Reviewing, "Reviewing", "Reviewing"),
                                            (RefundStatus.InProgress, "InProgress", "In Progress"),
                                            (RefundStatus.Approved, "Approved", "Approved"),
                                            (RefundStatus.Rejected, "Rejected", "Rejected")
                                        };
                                    }
                                    @foreach (var (status, value, display) in statuses)
                                    {
                                        if (Model.RefundStatus == status)
                                        {
                                            <option value="@value" selected>@display</option>
                                        }
                                        else
                                        {
                                            <option value="@value">@display</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="mb-3" id="approvedAmountGroup" style="display: none;">
                                <label class="form-label">Approved Refund Amount</label>
                                <div class="input-group">
                                    <span class="input-group-text">৳</span>
                                    <input type="number" class="form-control" name="approvedAmount"
                                           value="@refundableAmount" step="1" min="0" max="@refundableAmount" />
                                </div>
                                <div class="form-text">Max refundable: ৳@refundableAmount</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Notes (Optional)</label>
                                <textarea class="form-control" name="notes" rows="2"
                                          placeholder="Add notes about this status change..."></textarea>
                            </div>

                            <button type="button" class="btn btn-warning w-100" id="updateStatusBtn">
                                <i class="fas fa-save me-1"></i> Update Status
                            </button>
                        </form>
                    }
                </div>
            </div>

            <!-- Refund Payment Details Card (shown when refund is completed or payment is refunded) -->
            @if ((Model.RefundStatus == RefundStatus.Completed || Model.PaymentStatus == PaymentStatus.Refunded || Model.PaymentStatus == PaymentStatus.PartiallyRefunded) && Model.RefundPaymentDate.HasValue)
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header border-0 bg-success bg-opacity-10 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 text-success">
                            <i class="fas fa-check-double me-2"></i>Refund Payment Details
                        </h5>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editRefundDetailsModal">
                            <i class="fas fa-edit me-1"></i>Edit
                        </button>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0 align-items-center">
                            <dt class="col-5 col-sm-4 text-muted mb-2">Payment Method</dt>
                            <dd class="col-7 col-sm-8 mb-2">
                                @{
                                    var paymentMethodDisplay = Model.RefundPaymentMethod switch
                                    {
                                        RefundMethod.WalletCredit => "Wallet Credit",
                                        RefundMethod.Bkash => "bKash",
                                        RefundMethod.Nagad => "Nagad",
                                        RefundMethod.Upay => "Upay",
                                        RefundMethod.Rocket => "Rocket",
                                        RefundMethod.BankTransfer => "Bank Transfer",
                                        _ => Model.RefundPaymentMethod?.ToString() ?? "-"
                                    };
                                }
                                <span class="badge bg-success">@paymentMethodDisplay</span>
                            </dd>

                            <dt class="col-5 col-sm-4 text-muted mb-2">Amount Paid</dt>
                            <dd class="col-7 col-sm-8 mb-2">
                                <strong class="text-success">৳@((int)Math.Round(Model.RefundPaidAmount ?? 0))</strong>
                            </dd>

                            @if (!string.IsNullOrEmpty(Model.RefundPaidFromAccount))
                            {
                                <dt class="col-5 col-sm-4 text-muted mb-2">Paid From</dt>
                                <dd class="col-7 col-sm-8 mb-2">
                                    <span class="refund-code">@Model.RefundPaidFromAccount</span>
                                </dd>
                            }

                            @if (!string.IsNullOrEmpty(Model.RefundReceiverNumber))
                            {
                                <dt class="col-5 col-sm-4 text-muted mb-2">Receiver Number</dt>
                                <dd class="col-7 col-sm-8 mb-2">
                                    <span class="refund-code">@Model.RefundReceiverNumber</span>
                                </dd>
                            }

                            @if (!string.IsNullOrEmpty(Model.RefundTransactionId))
                            {
                                <dt class="col-5 col-sm-4 text-muted mb-2">Transaction ID</dt>
                                <dd class="col-7 col-sm-8 mb-2">
                                    <span class="badge bg-primary">@Model.RefundTransactionId</span>
                                </dd>
                            }

                            <dt class="col-5 col-sm-4 text-muted mb-2">Payment Date</dt>
                            <dd class="col-7 col-sm-8 mb-2">@Model.RefundPaymentDate?.ToBangladeshString()</dd>

                            @if (!string.IsNullOrEmpty(Model.RefundPaymentNotes))
                            {
                                <dt class="col-5 col-sm-4 text-muted mb-0">Notes</dt>
                                <dd class="col-7 col-sm-8 mb-0">@Model.RefundPaymentNotes</dd>
                            }
                        </dl>
                    </div>
                </div>
            }

            <!-- Refer to Accounting Card -->
            @if (!isRefunded)
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header border-0 bg-info bg-opacity-10">
                        <h5 class="mb-0 text-info">
                            <i class="fas fa-user-tie me-2"></i>Refer to Accounting
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (Model.ReferredToAccounting)
                        {
                            <div class="alert alert-permanent alert-info mb-3">
                                <i class="fas fa-check me-2"></i>
                                <strong>Currently Referred</strong>
                                <p class="mb-0 mt-2 small">
                                    Referred to: <strong>@Model.ReferredToAccountingName</strong><br>
                                    @if (Model.ReferredToAccountingAt.HasValue)
                                    {
                                        <text>On: @Model.ReferredToAccountingAt.Value.ToBangladeshShortString()</text>
                                    }
                                </p>
                            </div>
                        }
                        <form id="referAccountingForm">
                            <input type="hidden" name="id" value="@Model.Id" />
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label class="form-label">@(Model.ReferredToAccounting ? "Change Accounting Team Member" : "Accounting Team Member")</label>
                                <select class="form-select" name="accountingPersonName" required>
                                    <option value="">-- Select Person --</option>
                                    @if (ViewBag.AccountingUsers != null)
                                    {
                                        foreach (var user in ViewBag.AccountingUsers)
                                        {
                                            if (Model.ReferredToAccountingName == user.Name)
                                            {
                                                <option value="@user.Name" selected>@user.Name (@user.Email)</option>
                                            }
                                            else
                                            {
                                                <option value="@user.Name">@user.Name (@user.Email)</option>
                                            }
                                        }
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Notes (Optional)</label>
                                <textarea class="form-control" name="notes" rows="2"
                                          placeholder="Additional notes for accounting..."></textarea>
                            </div>

                            <button type="button" class="btn btn-info w-100" id="referAccountingBtn">
                                <i class="fas fa-paper-plane me-1"></i> @(Model.ReferredToAccounting ? "Update Referral" : "Refer to Accounting")
                            </button>
                        </form>
                    </div>
                </div>
            }

            <!-- Order Timeline -->
            <div class="card border-0 shadow-sm">
                <div class="card-header border-0">
                    <h5 class="mb-0">
                        <i class="fas fa-history me-2"></i>Order Timeline
                    </h5>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        <div class="timeline-item">
                            <div class="timeline-marker bg-success"></div>
                            <div class="timeline-content">
                                <span class="text-muted small">Order Placed</span>
                                <p class="mb-0">@Model.OrderDate.ToBangladeshShortDateString()</p>
                            </div>
                        </div>
                        @if (Model.DeliveredAt.HasValue)
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker bg-info"></div>
                                <div class="timeline-content">
                                    <span class="text-muted small">Delivered</span>
                                    <p class="mb-0">@Model.DeliveredAt.Value.ToBangladeshShortDateString()</p>
                                </div>
                            </div>
                        }
                        @if (Model.ReturnedAt.HasValue)
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker bg-warning"></div>
                                <div class="timeline-content">
                                    <span class="text-muted small">Return Requested</span>
                                    <p class="mb-0">@Model.ReturnedAt.Value.ToBangladeshShortDateString()</p>
                                </div>
                            </div>
                        }
                        @if (Model.RefundStatusChangedAt.HasValue && Model.RefundStatus != RefundStatus.Pending)
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker @GetRefundStatusTimelineColor(Model.RefundStatus)"></div>
                                <div class="timeline-content">
                                    <span class="text-muted small">Refund @Model.RefundStatus.GetDisplayName()</span>
                                    <p class="mb-0">@Model.RefundStatusChangedAt.Value.ToBangladeshShortDateString()</p>
                                </div>
                            </div>
                        }
                        @if (isRefunded)
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker bg-success"></div>
                                <div class="timeline-content">
                                    <span class="text-muted small">Refunded</span>
                                    <p class="mb-0">@Model.UpdatedAt.ToBangladeshShortDateString()</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Approve Modal -->
<div class="modal fade" id="quickApproveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
