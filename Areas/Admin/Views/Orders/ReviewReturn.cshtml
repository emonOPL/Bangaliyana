                    </div>

                    <div class="mb-3" id="quickReceiverGroup" style="display: none;">
                        <label class="form-label">Receiver Number <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="receiverNumber" id="receiverNumber"
                               value="@Model.RefundAccountNumber"
                               placeholder="Enter customer's account/number where refund was sent" />
