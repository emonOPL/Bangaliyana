                    </div>

                    <div class="mb-3" id="quickTransactionIdGroup" style="display: none;">
                        <label class="form-label">Transaction ID <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="transactionId" id="transactionId"
                               placeholder="Enter transaction ID after sending refund" />
