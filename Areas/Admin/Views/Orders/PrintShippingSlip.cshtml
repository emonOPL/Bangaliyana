@model Bangaliyana.Models.Order
@using Bangaliyana.Extensions
@{
    Layout = null;
    var siteSettings = ViewBag.SiteSettings as Bangaliyana.Models.SiteSettings;
    var siteName = siteSettings?.SiteName ?? "Bangaliyana";
    var sitePhone = siteSettings?.ContactPhone ?? "";
    var siteEmail = siteSettings?.ContactEmail ?? "";
    var siteAddress = siteSettings?.ContactAddress ?? "";
    var currencySymbol = siteSettings?.CurrencySymbol ?? "৳";
    var sellers = ViewBag.Sellers as List<Bangaliyana.Models.Seller> ?? new List<Bangaliyana.Models.Seller>();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shipping Slip - Order #@Model.Id</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
    <style>
        * {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 12pt;
            line-height: 1.4;
            color: #333;
            background: #fff;
        }

        .shipping-slip {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }

        .slip-header {
            border-bottom: 3px solid #198754;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }

        .company-name {
            font-size: 24pt;
            font-weight: bold;
            color: #198754;
        }

        .slip-title {
            font-size: 18pt;
            font-weight: bold;
            text-align: center;
            background: #198754;
            color: white;
            padding: 10px;
            margin: 20px 0;
            border-radius: 5px;
        }

        .info-section {
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 15px;
            background: #f8f9fa;
        }

        .info-section h5 {
            color: #198754;
            border-bottom: 2px solid #198754;
            padding-bottom: 8px;
            margin-bottom: 12px;
            font-size: 14pt;
        }

        .info-row {
            display: flex;
            margin-bottom: 5px;
        }

        .info-label {
            font-weight: 600;
            width: 140px;
            color: #555;
        }

        .info-value {
            flex: 1;
        }

        .address-box {
            background: #fff;
            border: 2px solid #198754;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 15px;
        }

        .address-box h5 {
            color: #198754;
            margin-bottom: 10px;
            font-size: 14pt;
        }

        .address-box .name {
            font-size: 14pt;
            font-weight: bold;
            color: #333;
        }

        .address-box .phone {
            font-size: 14pt;
            font-weight: bold;
            color: #198754;
        }

        .items-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
        }

        .items-table th {
            background: #198754;
            color: white;
            padding: 10px;
            text-align: left;
            font-size: 11pt;
        }

        .items-table td {
            padding: 10px;
            border-bottom: 1px solid #ddd;
            font-size: 11pt;
        }

        .items-table tbody tr:last-child td {
            border-bottom: none;
        }

        .items-table tr:nth-child(even) {
            background: #f8f9fa;
        }

        .variant-info {
            font-size: 10pt;
            color: #666;
        }

        .totals-section {
            background: #f8f9fa;
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 15px;
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            padding: 5px 0;
            border-bottom: 1px solid #eee;
        }

        .total-row:last-child {
            border-bottom: none;
        }

        .total-row.grand-total {
            font-size: 14pt;
            font-weight: bold;
            color: #198754;
            border-top: 2px solid #198754;
            margin-top: 10px;
            padding-top: 10px;
        }

        .cod-badge {
            background: #dc3545;
            color: white;
            padding: 8px 15px;
            border-radius: 5px;
            font-weight: bold;
            font-size: 12pt;
            display: inline-block;
        }

        .paid-badge {
            background: #198754;
            color: white;
            padding: 8px 15px;
            border-radius: 5px;
            font-weight: bold;
            font-size: 12pt;
            display: inline-block;
        }

        .barcode-section {
            text-align: center;
            margin: 20px 0;
            padding: 15px 20px;
            background: #fff;
            border: 1px solid #ddd;
            border-radius: 8px;
        }

        .barcode-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .barcode-wrapper {
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .barcode-wrapper svg {
            height: 100px;
        }

        .qr-wrapper {
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .qr-wrapper img {
            width: 100px;
            height: 100px;
        }

        .order-id-display {
            margin-top: 15px;
            padding: 10px 25px;
            background: #198754;
            color: white;
            font-size: 16pt;
            font-weight: bold;
            letter-spacing: 4px;
            border-radius: 25px;
            display: inline-block;
            box-shadow: 0 3px 10px rgba(25, 135, 84, 0.3);
        }

        .tracking-info {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 12px;
            font-size: 10pt;
            color: #666;
        }

        .tracking-info span {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .order-id-large {
            font-size: 24pt;
            font-weight: bold;
            letter-spacing: 3px;
            color: #333;
        }

        .print-btn {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1000;
        }

        .footer-note {
            text-align: center;
            font-size: 10pt;
            color: #666;
            margin-top: 20px;
            padding-top: 15px;
            border-top: 1px solid #ddd;
        }

        @@media print {
            .print-btn {
                display: none !important;
            }

            body {
                padding: 0;
                margin: 0;
            }

            .shipping-slip {
                padding: 10px;
                max-width: 100%;
            }

            .info-section,
            .address-box,
            .totals-section,
            .barcode-section {
                break-inside: avoid;
            }
        }
    </style>
</head>
<body>
    <button class="btn btn-success print-btn" onclick="window.print()">
        <i class="fas fa-print me-2"></i>Print Shipping Slip
    </button>

    <div class="shipping-slip">
        <!-- Header -->
        <div class="slip-header">
            <div class="row align-items-center">
                <div class="col-8">
                    <div class="company-name">@siteName</div>
                    @if (!string.IsNullOrEmpty(sitePhone))
                    {
                        <div><i class="fas fa-phone me-2"></i>@sitePhone</div>
                    }
                    @if (!string.IsNullOrEmpty(siteEmail))
                    {
                        <div><i class="fas fa-envelope me-2"></i>@siteEmail</div>
                    }
                </div>
                <div class="col-4 text-end">
                    <div class="order-id-large">#@Model.Id</div>
                    <div class="text-muted">@Model.OrderDate.ToBangladeshShortDateString()</div>
                    @if (Model.PaymentMethod == Bangaliyana.Models.PaymentMethod.CashOnDelivery)
                    {
                        <div class="cod-badge mt-2">
                            <i class="fas fa-money-bill-wave me-1"></i>COD: @currencySymbol@Model.TotalAmount.ToString("N0")
                        </div>
                    }
                    else
                    {
                        <div class="paid-badge mt-2">
                            <i class="fas fa-check-circle me-1"></i>PAID
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="slip-title">
            <i class="fas fa-truck me-2"></i>SHIPPING SLIP / DELIVERY DETAILS
        </div>

        <div class="row">
            <!-- Customer/Buyer Info -->
            <div class="col-6">
                <div class="address-box">
                    <h5><i class="fas fa-user me-2"></i>SHIP TO (Customer)</h5>
                    <div class="name">@Model.CustomerName</div>
                    <div class="phone"><i class="fas fa-phone me-1"></i>@Model.Phone</div>
                    @if (!string.IsNullOrEmpty(Model.Email))
                    {
                        <div><i class="fas fa-envelope me-1"></i>@Model.Email</div>
                    }
                    <hr />
                    <div><strong>Address:</strong></div>
                    <div>@Model.Address</div>
                    @if (Model.Upazila != null)
                    {
                        <div>@Model.Upazila.Name, @Model.District?.Name</div>
                    }
                    @if (Model.Division != null)
                    {
                        <div>@Model.Division.Name</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.PostalCode))
                    {
                        <div>Postal Code: @Model.PostalCode</div>
                    }
                </div>
            </div>

            <!-- Seller Info -->
            <div class="col-6">
                <div class="address-box">
                    <h5><i class="fas fa-store me-2"></i>SHIP FROM (Seller)</h5>
                    @if (sellers.Any())
                    {
                        @foreach (var seller in sellers)
                        {
                            <div class="mb-2">
                                <div class="name">@seller.ShopName</div>
                                @if (seller.User != null)
                                {
                                    <div><i class="fas fa-phone me-1"></i>@seller.User.PhoneNumber</div>
                                }
                                @if (!string.IsNullOrEmpty(seller.BusinessAddress))
                                {
                                    <div><small>@seller.BusinessAddress</small></div>
                                }
                            </div>
                            @if (sellers.Count > 1)
                            {
                                <hr class="my-2" />
                            }
                        }
                    }
                    else
                    {
                        <div class="name">@siteName</div>
                        @if (!string.IsNullOrEmpty(siteAddress))
                        {
                            <div>@siteAddress</div>
                        }
                        @if (!string.IsNullOrEmpty(sitePhone))
                        {
                            <div><i class="fas fa-phone me-1"></i>@sitePhone</div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Order Items -->
        <div class="info-section">
            <h5><i class="fas fa-box me-2"></i>ORDER ITEMS (@Model.OrderItems.Count items)</h5>
            <table class="items-table">
                <thead>
                    <tr>
                        <th style="width: 50%;">Product</th>
                        <th class="text-center">Qty</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderItems)
                    {
                        <tr>
                            <td>
                                <strong>@item.ProductName</strong>
                                @if (!string.IsNullOrEmpty(item.VariantInfo))
                                {
                                    <div class="variant-info"><i class="fas fa-tag me-1"></i>@item.VariantInfo</div>
                                }
                                @if (!string.IsNullOrEmpty(item.SKU))
                                {
                                    <div class="variant-info">SKU: @item.SKU</div>
                                }
                            </td>
                            <td class="text-center"><strong>@item.Quantity</strong></td>
                            <td class="text-end">@currencySymbol@item.UnitPrice.ToString("N0")</td>
                            <td class="text-end"><strong>@currencySymbol@item.TotalPrice.ToString("N0")</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="row">
            <!-- Order Info -->
            <div class="col-6">
                <div class="info-section">
                    <h5><i class="fas fa-info-circle me-2"></i>ORDER INFO</h5>
                    <div class="info-row">
                        <span class="info-label">Order ID:</span>
                        <span class="info-value"><strong>#@Model.Id</strong></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Order Date:</span>
                        <span class="info-value">@Model.OrderDate.ToBangladeshShortString()</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Status:</span>
                        <span class="info-value"><span class="badge bg-success">@Model.Status.GetDisplayName()</span></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Payment:</span>
                        <span class="info-value">@Model.PaymentMethod.GetDisplayName()</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.TransactionId))
                    {
                        <div class="info-row">
                            <span class="info-label">Transaction ID:</span>
                            <span class="info-value">@Model.TransactionId</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="info-row">
                            <span class="info-label">Instructions:</span>
                            <span class="info-value">@Model.Notes</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Payment Summary -->
            <div class="col-6">
                <div class="totals-section">
                    <h5 style="color: #198754; margin-bottom: 10px;"><i class="fas fa-receipt me-2"></i>PAYMENT SUMMARY</h5>
                    <div class="total-row">
                        <span>Subtotal:</span>
                        <span>@currencySymbol@Model.SubTotal.ToString("N0")</span>
                    </div>
                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="total-row text-success">
                            <span>Discount:</span>
                            <span>-@currencySymbol@Model.DiscountAmount.ToString("N0")</span>
                        </div>
                    }
                    @if (Model.RewardDiscountAmount > 0)
                    {
                        <div class="total-row text-success">
                            <span>Reward Discount:</span>
                            <span>-@currencySymbol@Model.RewardDiscountAmount.ToString("N0")</span>
                        </div>
                    }
                    @if (Model.PremiumDiscountAmount > 0)
                    {
                        <div class="total-row text-success">
                            <span>Premium Discount:</span>
                            <span>-@currencySymbol@Model.PremiumDiscountAmount.ToString("N0")</span>
                        </div>
                    }
                    <div class="total-row">
                        <span>Delivery Charge:</span>
                        <span>@(Model.FreeShippingApplied ? "FREE" : currencySymbol + Model.DeliveryCharge.ToString("N0"))</span>
                    </div>
                    <div class="total-row grand-total">
                        <span>TOTAL:</span>
                        <span>@currencySymbol@Model.TotalAmount.ToString("N0")</span>
                    </div>
                    @if (Model.PaymentMethod == Bangaliyana.Models.PaymentMethod.CashOnDelivery)
                    {
                        <div class="text-center mt-3">
                            <span class="cod-badge">
                                <i class="fas fa-hand-holding-usd me-1"></i>COLLECT: @currencySymbol@Model.TotalAmount.ToString("N0")
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Barcode/Order ID Section -->
        <div class="barcode-section">
            <div class="barcode-container">
                <!-- Barcode -->
                <div class="barcode-wrapper">
                    <svg id="barcode"></svg>
                </div>
                <!-- QR Code -->
                <div class="qr-wrapper">
                    @{
                        // Create detailed order info for QR code
                        var orderDetails = new System.Text.StringBuilder();
                        orderDetails.AppendLine($"ORDER #{Model.Id}");
                        orderDetails.AppendLine($"Date: {Model.OrderDate:dd MMM yyyy}");
                        orderDetails.AppendLine($"Customer: {Model.CustomerName}");
                        orderDetails.AppendLine($"Phone: {Model.Phone}");
                        orderDetails.AppendLine($"Address: {Model.Address}");
                        if (Model.Upazila != null)
                        {
                            orderDetails.AppendLine($"Area: {Model.Upazila.Name}, {Model.District?.Name}");
                        }
                        if (Model.Division != null)
                        {
                            orderDetails.AppendLine($"Division: {Model.Division.Name}");
                        }
                        orderDetails.AppendLine($"Items: {Model.OrderItems.Count}");
                        orderDetails.AppendLine($"Total: {currencySymbol}{Model.TotalAmount:N0}");
                        orderDetails.AppendLine($"Payment: {Model.PaymentMethod.GetDisplayName()}");
                        if (Model.PaymentMethod == Bangaliyana.Models.PaymentMethod.CashOnDelivery)
                        {
                            orderDetails.AppendLine($"COD Amount: {currencySymbol}{Model.TotalAmount:N0}");
                        }
                        orderDetails.AppendLine($"Status: {Model.Status.GetDisplayName()}");
                        var qrData = orderDetails.ToString();
                        var qrUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=100x100&data={Uri.EscapeDataString(qrData)}";
                    }
                    <img src="@qrUrl" alt="QR Code" />
                </div>
            </div>
            <div class="order-id-display">
                <i class="fas fa-box me-2"></i>ORDER #@Model.Id
            </div>
            <div class="tracking-info">
                <span><i class="fas fa-calendar-alt"></i> @Model.OrderDate.ToBangladeshShortDateString()</span>
                <span><i class="fas fa-truck"></i> @Model.Status.GetDisplayName()</span>
                <span><i class="fas fa-credit-card"></i> @Model.PaymentMethod.GetDisplayName()</span>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer-note">
            <p><strong>@siteName</strong> - Thank you for your order!</p>
            <p>For any queries, contact:
                @if (!string.IsNullOrEmpty(sitePhone) && !string.IsNullOrEmpty(siteEmail))
                {
                    @sitePhone @: | @siteEmail
                }
                else if (!string.IsNullOrEmpty(sitePhone))
                {
                    @sitePhone
                }
                else if (!string.IsNullOrEmpty(siteEmail))
                {
                    @siteEmail
                }
            </p>
            <p>Printed on: @DateTimeExtensions.GetBangladeshNowString()</p>
        </div>
    </div>

    <script>
        // Generate Barcode
        document.addEventListener('DOMContentLoaded', function() {
            var orderId = '@Model.Id.ToString().PadLeft(8, '0')';
            JsBarcode("#barcode", orderId, {
                format: "CODE128",
                width: 2,
                height: 70,
                displayValue: true,
                fontSize: 12,
                fontOptions: "bold",
                textMargin: 3,
                margin: 5,
                background: "#ffffff"
            });
        });
    </script>
</body>
</html>
