@using Bangaliyana.Models
@using Bangaliyana.Extensions
@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<Order>

@{
    ViewData["Title"] = "Return Requests";
}

<div class="container">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="display-6 mb-1">
                <i class="fas fa-undo-alt text-warning me-2"></i>Return Requests
            </h2>
            <p class="text-muted mb-0">Manage customer return and refund requests</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to Orders
        </a>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="stats-icon bg-primary bg-opacity-10 text-primary rounded-circle p-3">
                                <i class="fas fa-list fa-lg"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h3 class="mb-0">@ViewBag.TotalReturns</h3>
                            <small class="text-muted">Total Returns</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="stats-icon bg-warning bg-opacity-10 text-warning rounded-circle p-3">
                                <i class="fas fa-clock fa-lg"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h3 class="mb-0">@ViewBag.PendingReturns</h3>
                            <small class="text-muted">Pending Review</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="stats-icon bg-success bg-opacity-10 text-success rounded-circle p-3">
                                <i class="fas fa-check-circle fa-lg"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h3 class="mb-0">@ViewBag.ProcessedReturns</h3>
                            <small class="text-muted">Processed</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-3">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-auto">
                    <label class="form-label small text-muted mb-1">Filter by Status</label>
                    @{
                        var currentStatus = ViewBag.CurrentStatus as string;
                    }
                    <select name="status" class="form-select" style="min-width: 180px;" onchange="this.form.submit()">
                        <option value="">All Returns</option>
                        @if (currentStatus == "pending")
                        {
                            <option value="pending" selected>Pending Review</option>
                        }
                        else
                        {
                            <option value="pending">Pending Review</option>
                        }
                        @if (currentStatus == "approved")
                        {
                            <option value="approved" selected>Processed/Refunded</option>
                        }
                        else
                        {
                            <option value="approved">Processed/Refunded</option>
                        }
                        @if (currentStatus == "rejected")
                        {
                            <option value="rejected" selected>Rejected</option>
                        }
                        else
                        {
                            <option value="rejected">Rejected</option>
                        }
                    </select>
                </div>
                @if (!string.IsNullOrEmpty(ViewBag.CurrentStatus))
                {
                    <div class="col-auto">
                        <a asp-action="Returns" class="btn btn-outline-secondary">
                            <i class="fas fa-times me-1"></i> Clear Filter
                        </a>
                    </div>
                }
            </form>
        </div>
    </div>

    <!-- Returns List -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Order</th>
                                <th>Customer</th>
                                <th>Return Reason</th>
                                <th>Preferred Resolution</th>
                                <th class="text-end">Amount</th>
                                <th>Status</th>
                                <th>Requested</th>
                                <th class="text-center pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                var returnStatus = GetReturnStatus(order);
                                var returnStatusClass = GetReturnStatusClass(returnStatus);
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div>
                                                <strong class="d-block">#@(order.OrderNumber ?? order.Id.ToString())</strong>
                                                <small class="text-muted">@order.OrderItems.Count items</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div>
                                            <span class="d-block">@order.CustomerName</span>
                                            <small class="text-muted">@order.Phone</small>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-truncate d-inline-block" style="max-width: 200px;" title="@order.ReturnReason.FormatAsDisplayName()">
                                            @FormatReturnReason(order.ReturnReason)
                                        </span>
                                    </td>
                                    <td>
                                        @if (order.PrefersReplacement)
                                        {
                                            <span class="badge bg-info">
                                                <i class="fas fa-exchange-alt me-1"></i> Replacement
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="fas fa-money-bill-wave me-1"></i> Refund
                                            </span>
                                            @if (order.PreferredRefundMethod != null)
                                            {
                                                <br><small class="text-muted">@GetRefundMethodDisplay(order.PreferredRefundMethod)</small>
                                            }
                                        }
                                    </td>
                                    <td class="text-end">
                                        <strong class="text-success">৳@Math.Round(order.TotalAmount).ToString("N0")</strong>
                                    </td>
                                    <td>
                                        <span class="badge @returnStatusClass">@returnStatus</span>
                                    </td>
                                    <td>
                                        @if (order.ReturnedAt.HasValue)
                                        {
                                            <span title="@order.ReturnedAt.Value.ToString("yyyy-MM-dd HH:mm")">
                                                @GetTimeAgo(order.ReturnedAt.Value)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-center pe-4">
                                        <a asp-action="ReviewReturn" asp-route-id="@order.Id" class="btn btn-sm btn-primary">
                                            <i class="fas fa-eye me-1"></i> Review
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.PageCount > 1)
                {
                    <div class="card-footer bg-transparent border-0">
                        <nav aria-label="Page navigation">
                            @Html.PagedListPager(Model, page => Url.Action("Returns", new { page, status = ViewBag.CurrentStatus }),
                                new PagedListRenderOptions
                                {
                                    LiElementClasses = new[] { "page-item" },
                                    PageClasses = new[] { "page-link" },
                                    UlElementClasses = new[] { "pagination", "justify-content-center", "mb-0" }
                                })
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
                    <h5 class="text-muted">No return requests found</h5>
                    <p class="text-muted mb-0">
                        @if (!string.IsNullOrEmpty(ViewBag.CurrentStatus))
                        {
                            <text>No returns matching the selected filter.</text>
                        }
                        else
                        {
                            <text>There are no return requests at the moment.</text>
                        }
                    </p>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    string GetReturnStatus(Order order)
    {
        // Use RefundStatus for accurate status display
        return order.RefundStatus switch
        {
            RefundStatus.Pending => "Pending",
            RefundStatus.Reviewing => "Reviewing",
            RefundStatus.InProgress => "In Progress",
            RefundStatus.Approved => order.PaymentStatus == PaymentStatus.Refunded ? "Refunded"
                : order.PaymentStatus == PaymentStatus.PartiallyRefunded ? "Partially Refunded"
                : "Approved",
            RefundStatus.Rejected => "Rejected",
            RefundStatus.Completed => "Completed",
            _ => "Unknown"
        };
    }

    string GetReturnStatusClass(string status)
    {
        return status switch
        {
            "Refunded" => "bg-success",
            "Partially Refunded" => "bg-info",
            "Approved" => "bg-success",
            "Completed" => "bg-success",
            "Pending" => "bg-warning text-dark",
            "Reviewing" => "bg-info",
            "In Progress" => "bg-primary",
            "Rejected" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    string FormatReturnReason(string? reason)
    {
        if (string.IsNullOrEmpty(reason))
            return "No reason specified";

        var mappings = new Dictionary<string, string>
        {
            { "Damaged", "Damaged Product" },
            { "WrongItem", "Wrong Item Received" },
            { "NotAsDescribed", "Product Not as Described" },
            { "QualityIssue", "Quality Not Satisfactory" },
            { "SizeIssue", "Size/Fit Issue" },
            { "ChangedMind", "Changed Mind" },
            { "Other", "Other" }
        };

        foreach (var m in mappings)
        {
            if (reason.StartsWith(m.Key + ":"))
                return m.Value + reason.Substring(m.Key.Length);
            if (reason == m.Key)
                return m.Value;
        }
        return reason;
    }

    string GetRefundMethodDisplay(RefundMethod? method)
    {
        if (method == null) return "Not specified";
        return method switch
        {
            RefundMethod.WalletCredit => "Wallet Credit",
            RefundMethod.Bkash => "bKash",
            RefundMethod.Nagad => "Nagad",
            RefundMethod.Upay => "Upay",
            RefundMethod.Rocket => "Rocket",
            RefundMethod.BankTransfer => "Bank Transfer",
            _ => method.ToString() ?? "Unknown"
        };
    }

    string GetTimeAgo(DateTime dateTime)
    {
        var timeSpan = DateTime.UtcNow - dateTime;
        if (timeSpan.TotalMinutes < 1)
            return "Just now";
        if (timeSpan.TotalHours < 1)
            return $"{(int)timeSpan.TotalMinutes}m ago";
        if (timeSpan.TotalDays < 1)
            return $"{(int)timeSpan.TotalHours}h ago";
        if (timeSpan.TotalDays < 7)
            return $"{(int)timeSpan.TotalDays}d ago";
        return dateTime.ToString("MMM dd");
    }
}

@section Styles {
    <style>
        .stats-icon {
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .table > :not(caption) > * > * {
            padding: 1rem 0.75rem;
        }

        /* Dark mode */
        [data-theme="dark"] .table-light {
            background-color: #374151 !important;
            color: #e5e7eb !important;
        }
        [data-theme="dark"] .table-light th {
            background-color: #374151 !important;
            color: #e5e7eb !important;
            border-color: #4b5563 !important;
        }
        [data-theme="dark"] .card {
            background-color: #1f2937;
            border-color: #374151 !important;
        }
        [data-theme="dark"] .table {
            color: #e5e7eb;
        }
        [data-theme="dark"] .table tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.05);
        }
        [data-theme="dark"] .form-select {
            background-color: #374151;
            border-color: #4b5563;
            color: #e5e7eb;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            @if (TempData["success"] != null)
            {
                <text>alertify.success('@Html.Raw(TempData["success"])');</text>
            }
            @if (TempData["error"] != null)
            {
                <text>alertify.error('@Html.Raw(TempData["error"])');</text>
            }
        });
    </script>
}
