@using Bangaliyana.Models
@model Transaction
@{
    ViewData["Title"] = $"Transaction #{Model.Id}";
    var typeClass = Model.Type switch
    {
        TransactionType.Payment => "bg-primary",
        TransactionType.Refund => "bg-danger",
        TransactionType.SellerPayout => "bg-success",
        TransactionType.Commission => "bg-warning",
        _ => "bg-secondary"
    };
    var statusClass = Model.Status switch
    {
        TransactionStatus.Completed => "bg-success",
        TransactionStatus.Pending => "bg-warning text-dark",
        TransactionStatus.Processing => "bg-info",
        TransactionStatus.Failed => "bg-danger",
        TransactionStatus.Cancelled => "bg-secondary",
        _ => "bg-secondary"
    };
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Transactions</a></li>
            <li class="breadcrumb-item active">Transaction #@Model.Id</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-8">
            <!-- Transaction Details Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-exchange-alt text-primary me-2"></i>Transaction Details</h5>
                    <div>
                        <span class="badge @typeClass me-2">@Model.Type</span>
                        <span class="badge @statusClass">@Model.Status</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-borderless mb-0">
                                <tr>
                                    <td class="text-muted">Transaction ID</td>
                                    <td class="fw-bold">#@Model.Id</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Date & Time</td>
                                    <td>@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Amount</td>
                                    <td>
                                        <span class="@(Model.Type == TransactionType.Refund ? "text-danger" : "text-success") fw-bold fs-4">
                                            @(Model.Type == TransactionType.Refund ? "-" : "")৳@Model.Amount.ToString("N0")
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Payment Method</td>
                                    <td>@Model.PaymentMethod</td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-borderless mb-0">
                                <tr>
                                    <td class="text-muted">Gateway Transaction ID</td>
                                    <td class="font-monospace">@(Model.GatewayTransactionId ?? "-")</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Gateway Reference</td>
                                    <td class="font-monospace">@(Model.GatewayReference ?? "-")</td>
                                </tr>
                                @if (Model.CompletedAt.HasValue)
                                {
                                    <tr>
                                        <td class="text-muted">Completed At</td>
                                        <td>@Model.CompletedAt.Value.ToString("dd MMM yyyy, hh:mm tt")</td>
                                    </tr>
                                }
                                @if (!string.IsNullOrEmpty(Model.FailureReason))
                                {
                                    <tr>
                                        <td class="text-muted">Failure Reason</td>
                                        <td class="text-danger">@Model.FailureReason</td>
                                    </tr>
                                }
                            </table>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <hr>
                        <div>
                            <label class="text-muted small">Notes</label>
                            <p class="mb-0">@Model.Notes</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Order Details (if linked) -->
            @if (Model.Order != null)
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="fas fa-shopping-cart text-info me-2"></i>Order Details</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h6 class="mb-1">Order #@Model.Order.OrderNumber</h6>
                                <small class="text-muted">Placed on @Model.Order.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</small>
                            </div>
                            <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId" class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-eye me-1"></i>View Order
                            </a>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <table class="table table-sm table-borderless mb-0">
                                    <tr>
                                        <td class="text-muted">Order Status</td>
                                        <td><span class="badge bg-secondary">@Model.Order.Status</span></td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Payment Status</td>
                                        <td><span class="badge bg-secondary">@Model.Order.PaymentStatus</span></td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Order Total</td>
                                        <td class="fw-bold">৳@Model.Order.TotalAmount.ToString("N0")</td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-md-6">
                                @if (Model.Order.User != null)
                                {
                                    <table class="table table-sm table-borderless mb-0">
                                        <tr>
                                            <td class="text-muted">Customer</td>
                                            <td>@Model.Order.User.FirstName @Model.Order.User.LastName</td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Email</td>
                                            <td>@Model.Order.User.Email</td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Phone</td>
                                            <td>@(Model.Order.User.PhoneNumber ?? "-")</td>
                                        </tr>
                                    </table>
                                }
                            </div>
                        </div>

                        @if (Model.Order.OrderItems?.Any() == true)
                        {
                            <hr>
                            <h6 class="mb-3">Order Items</h6>
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Product</th>
                                            <th class="text-center">Qty</th>
                                            <th class="text-end">Price</th>
                                            <th class="text-end">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Order.OrderItems)
                                        {
                                            <tr>
                                                <td>@(item.Product?.Name ?? "Product")</td>
                                                <td class="text-center">@item.Quantity</td>
                                                <td class="text-end">৳@item.UnitPrice.ToString("N0")</td>
                                                <td class="text-end">৳@item.TotalPrice.ToString("N0")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Seller Details (if linked) -->
            @if (Model.Seller != null)
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="fas fa-store text-success me-2"></i>Seller Details</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                                <i class="fas fa-store text-success fa-lg"></i>
                            </div>
                            <div>
                                <h6 class="mb-1">@Model.Seller.ShopName</h6>
                                <small class="text-muted">@(Model.Seller.User?.Email ?? "")</small>
                            </div>
                            <a asp-area="Admin" asp-controller="SellerPayment" asp-action="SellerPaymentDetails" asp-route-id="@Model.SellerId" class="btn btn-sm btn-outline-primary ms-auto">
                                <i class="fas fa-eye me-1"></i>View Seller
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <!-- Quick Actions -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h6 class="mb-0"><i class="fas fa-bolt text-warning me-2"></i>Quick Actions</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        @if (Model.Order != null)
                        {
                            <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId" class="btn btn-outline-primary">
                                <i class="fas fa-shopping-cart me-2"></i>View Order
                            </a>
                        }
                        @if (Model.Type == TransactionType.Payment && Model.Order != null)
                        {
                            <a asp-action="CreateRefund" asp-route-orderId="@Model.OrderId" class="btn btn-outline-danger">
                                <i class="fas fa-undo me-2"></i>Create Refund
                            </a>
                        }
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-list me-2"></i>Back to Transactions
                        </a>
                    </div>
                </div>
            </div>

            <!-- Related Transactions -->
            @if (ViewBag.RelatedTransactions != null && ((List<Transaction>)ViewBag.RelatedTransactions).Any())
            {
                <div class="card shadow-sm">
                    <div class="card-header bg-white">
                        <h6 class="mb-0"><i class="fas fa-link text-info me-2"></i>Related Transactions</h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            @foreach (var related in (List<Transaction>)ViewBag.RelatedTransactions)
                            {
                                var relatedTypeClass = related.Type switch
                                {
                                    TransactionType.Payment => "bg-primary",
                                    TransactionType.Refund => "bg-danger",
                                    TransactionType.SellerPayout => "bg-success",
                                    TransactionType.Commission => "bg-warning",
                                    _ => "bg-secondary"
                                };
                                <a asp-action="Details" asp-route-id="@related.Id" class="list-group-item list-group-item-action">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="badge @relatedTypeClass me-2">@related.Type</span>
                                            <span class="@(related.Type == TransactionType.Refund ? "text-danger" : "text-success") fw-bold">
                                                @(related.Type == TransactionType.Refund ? "-" : "")৳@related.Amount.ToString("N0")
                                            </span>
                                        </div>
                                        <small class="text-muted">@related.CreatedAt.ToString("dd MMM")</small>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
