@model Microsoft.AspNetCore.Identity.IdentityRole

@{
    ViewData["Title"] = "Delete Role";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Delete Role</h1>
            <p class="text-muted mb-0">Confirm role deletion</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to List
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Confirm Deletion</h5>
                </div>
                <div class="card-body text-center">
                    <div class="confirm-icon-wrapper mb-3">
                        <div class="confirm-icon-circle confirm-icon-danger">
                            <i class="fas fa-trash-alt"></i>
                        </div>
                    </div>

                    <h4 class="mb-3">Are you sure you want to delete this role?</h4>

                    <div class="alert alert-secondary">
                        <strong>Role Name:</strong> @Model.Name
                    </div>

                    <div class="alert alert-warning text-start">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Warning:</strong>
                        <ul class="mb-0 mt-2">
                            <li>This action cannot be undone</li>
                            <li>Users with this role will lose associated permissions</li>
                            <li>System roles cannot be deleted</li>
                        </ul>
                    </div>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="d-flex justify-content-center gap-2">
                            <a asp-action="Index" class="btn btn-secondary px-4">
                                <i class="fas fa-times me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="fas fa-trash me-1"></i> Delete Role
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Dark mode support */
        [data-theme="dark"] .card {
            background-color: var(--bs-dark);
            border-color: var(--bs-gray-700);
        }
        [data-theme="dark"] .card-body {
            color: var(--bs-light);
        }
        [data-theme="dark"] h1,
        [data-theme="dark"] h4,
        [data-theme="dark"] h5,
        [data-theme="dark"] strong {
            color: var(--bs-light);
        }
        [data-theme="dark"] .text-muted {
            color: var(--bs-gray-400) !important;
        }
        [data-theme="dark"] .alert-secondary {
            background-color: var(--bs-gray-700);
            border-color: var(--bs-gray-600);
            color: var(--bs-light);
        }
    </style>
}
