@model List<Microsoft.AspNetCore.Identity.IdentityRole>

@{
    ViewData["Title"] = "Role Management";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Role Management</h1>
            <p class="text-muted mb-0">Manage system roles and permissions</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i> Add Role
            </a>
            <a asp-action="ManageUsers" class="btn btn-outline-primary">
                <i class="fas fa-users me-1"></i> Manage User Roles
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="fas fa-user-tag me-2"></i>
                System Roles
                <span class="badge bg-primary ms-2">@Model.Count</span>
            </h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Role Name</th>
                                <th>Role ID</th>
                                <th style="width: 100px;">Type</th>
                                <th style="width: 150px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var role in Model.OrderBy(r => r.Name))
                            {
                                var isSystemRole = role.Name == "Admin" || role.Name == "SuperAdmin" ||
                                                   role.Name == "User" || role.Name == "Seller" ||
                                                   role.Name == "Moderator";
                                var badgeClass = role.Name == "Admin" || role.Name == "SuperAdmin" ? "bg-danger" :
                                                role.Name == "Moderator" ? "bg-purple" :
                                                role.Name == "Seller" ? "bg-primary" :
                                                role.Name == "User" ? "bg-success" : "bg-secondary";
                                var iconClass = role.Name == "Admin" || role.Name == "SuperAdmin" ? "fas fa-user-shield" :
                                               role.Name == "Moderator" ? "fas fa-user-tie" :
                                               role.Name == "Seller" ? "fas fa-store" :
                                               role.Name == "User" ? "fas fa-user" : "fas fa-tag";
                                <tr>
                                    <td>
                                        <i class="@iconClass me-2" style="@(role.Name == "Moderator" ? "color: #6f42c1;" : "")"></i>
                                        <strong>@role.Name</strong>
                                        @if (isSystemRole)
                                        {
                                            <span class="badge bg-info ms-1">System</span>
                                        }
                                    </td>
                                    <td class="text-muted small">@role.Id</td>
                                    <td>
                                        <span class="badge @badgeClass" @(role.Name == "Moderator" ? "style=background-color:#6f42c1;" : "")>
                                            @role.Name
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex btn-group-gap">
                                            @if (!isSystemRole)
                                            {
                                                <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <form asp-action="Delete" asp-route-id="@role.Id" method="post" class="d-inline delete-role-form">
                                                    @Html.AntiForgeryToken()
                                                    <button type="button" class="btn btn-sm btn-outline-danger delete-role-btn" title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-sm btn-outline-secondary" title="View">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <button class="btn btn-sm btn-outline-secondary" disabled title="System roles cannot be deleted">
                                                    <i class="fas fa-lock"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="fas fa-folder-open fa-2x mb-2"></i>
                    <p class="mb-0">No roles found</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Role Confirmation Modal -->
<div class="modal fade" id="deleteRoleModal" tabindex="-1" aria-labelledby="deleteRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content confirm-modal-content">
            <button type="button" class="btn-close confirm-modal-close" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="modal-body text-center">
                <div class="confirm-icon-wrapper mb-3">
                    <div class="confirm-icon-circle confirm-icon-danger">
                        <i class="fas fa-trash-alt"></i>
                    </div>
                </div>
                <h4 class="modal-title fw-bold mb-2" id="deleteRoleModalLabel">Delete Role?</h4>
                <p class="text-muted mb-0">Are you sure you want to delete this role?</p>
                <p class="text-muted small">This action cannot be undone.</p>
            </div>
            <div class="modal-footer justify-content-center gap-2">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Cancel
                </button>
                <button type="button" class="btn btn-danger px-4" id="confirmDeleteRoleBtn">
                    <i class="fas fa-check me-1"></i> Yes, Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Dark mode support */
        [data-theme="dark"] .card {
            background-color: var(--bs-dark);
            border-color: var(--bs-gray-700);
        }
        [data-theme="dark"] .card-header.bg-light {
            background-color: var(--bs-gray-800) !important;
            border-color: var(--bs-gray-700);
            color: var(--bs-light);
        }
        [data-theme="dark"] .table {
            color: var(--bs-light);
        }
        [data-theme="dark"] .table-light {
            background-color: var(--bs-gray-800) !important;
            color: var(--bs-light);
        }
        [data-theme="dark"] .table-light th {
            background-color: var(--bs-gray-800) !important;
            color: var(--bs-light);
            border-color: var(--bs-gray-700);
        }
        [data-theme="dark"] .table-hover tbody tr:hover {
            background-color: var(--bs-gray-700) !important;
            color: var(--bs-light);
        }
        [data-theme="dark"] .table td,
        [data-theme="dark"] .table th {
            border-color: var(--bs-gray-700);
        }
        [data-theme="dark"] .text-muted {
            color: var(--bs-gray-400) !important;
        }
        [data-theme="dark"] h1,
        [data-theme="dark"] h5,
        [data-theme="dark"] strong {
            color: var(--bs-light);
        }
        /* Button gaps */
        .btn-group-gap {
            gap: 0.5rem;
        }
        .btn-group-gap .btn {
            border-radius: 0.375rem !important;
        }
        .bg-purple {
            background-color: #6f42c1 !important;
        }
    </style>
}

@section Scripts {
    <script>
        // Delete role modal handling
        let currentDeleteForm = null;
        const deleteRoleModal = new bootstrap.Modal(document.getElementById('deleteRoleModal'));

        document.querySelectorAll('.delete-role-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                currentDeleteForm = this.closest('.delete-role-form');
                deleteRoleModal.show();
            });
        });

        document.getElementById('confirmDeleteRoleBtn')?.addEventListener('click', function() {
            if (currentDeleteForm) {
                deleteRoleModal.hide();
                currentDeleteForm.submit();
            }
        });
    </script>
}
