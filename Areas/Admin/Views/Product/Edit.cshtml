                }
            });

            // Image enhancement functions
            function enhanceImage(imageData) {
                var data = imageData.data;
                var len = data.length;

                // Step 1: Calculate histogram for contrast stretching
                var minR = 255, maxR = 0, minG = 255, maxG = 0, minB = 255, maxB = 0;
                for (var i = 0; i < len; i += 4) {
                    if (data[i] < minR) minR = data[i];
                    if (data[i] > maxR) maxR = data[i];
                    if (data[i+1] < minG) minG = data[i+1];
                    if (data[i+1] > maxG) maxG = data[i+1];
                    if (data[i+2] < minB) minB = data[i+2];
                    if (data[i+2] > maxB) maxB = data[i+2];
                }

                // Step 2: Apply contrast stretching
                var rangeR = Math.max(1, maxR - minR);
                var rangeG = Math.max(1, maxG - minG);
                var rangeB = Math.max(1, maxB - minB);

                for (var i = 0; i < len; i += 4) {
                    data[i] = Math.min(255, Math.max(0, Math.round(((data[i] - minR) / rangeR) * 255)));
                    data[i+1] = Math.min(255, Math.max(0, Math.round(((data[i+1] - minG) / rangeG) * 255)));
                    data[i+2] = Math.min(255, Math.max(0, Math.round(((data[i+2] - minB) / rangeB) * 255)));
                }

                return imageData;
            }

            // Calculate gradient magnitude for edge detection
            function calculateGradient(data, width, height) {
                var gradient = new Float32Array(width * height);

                for (var y = 1; y < height - 1; y++) {
                    for (var x = 1; x < width - 1; x++) {
                        // Sobel operator for gradient
                        var gxR = -data[((y-1)*width+x-1)*4] + data[((y-1)*width+x+1)*4]
                                  - 2*data[(y*width+x-1)*4] + 2*data[(y*width+x+1)*4]
                                  - data[((y+1)*width+x-1)*4] + data[((y+1)*width+x+1)*4];
                        var gyR = -data[((y-1)*width+x-1)*4] - 2*data[((y-1)*width+x)*4] - data[((y-1)*width+x+1)*4]
                                  + data[((y+1)*width+x-1)*4] + 2*data[((y+1)*width+x)*4] + data[((y+1)*width+x+1)*4];

                        var gxG = -data[((y-1)*width+x-1)*4+1] + data[((y-1)*width+x+1)*4+1]
                                  - 2*data[(y*width+x-1)*4+1] + 2*data[(y*width+x+1)*4+1]
                                  - data[((y+1)*width+x-1)*4+1] + data[((y+1)*width+x+1)*4+1];
                        var gyG = -data[((y-1)*width+x-1)*4+1] - 2*data[((y-1)*width+x)*4+1] - data[((y-1)*width+x+1)*4+1]
                                  + data[((y+1)*width+x-1)*4+1] + 2*data[((y+1)*width+x)*4+1] + data[((y+1)*width+x+1)*4+1];

                        var gxB = -data[((y-1)*width+x-1)*4+2] + data[((y-1)*width+x+1)*4+2]
                                  - 2*data[(y*width+x-1)*4+2] + 2*data[(y*width+x+1)*4+2]
                                  - data[((y+1)*width+x-1)*4+2] + data[((y+1)*width+x+1)*4+2];
                        var gyB = -data[((y-1)*width+x-1)*4+2] - 2*data[((y-1)*width+x)*4+2] - data[((y-1)*width+x+1)*4+2]
                                  + data[((y+1)*width+x-1)*4+2] + 2*data[((y+1)*width+x)*4+2] + data[((y+1)*width+x+1)*4+2];

                        // Combined gradient magnitude
                        var magR = Math.sqrt(gxR*gxR + gyR*gyR);
                        var magG = Math.sqrt(gxG*gxG + gyG*gyG);
                        var magB = Math.sqrt(gxB*gxB + gyB*gyB);

                        gradient[y * width + x] = (magR + magG + magB) / 3;
                    }
                }

                return gradient;
            }

            // RGB to LAB color space conversion
            function rgbToLab(r, g, b) {
                r = r / 255; g = g / 255; b = b / 255;
                r = r > 0.04045 ? Math.pow((r + 0.055) / 1.055, 2.4) : r / 12.92;
                g = g > 0.04045 ? Math.pow((g + 0.055) / 1.055, 2.4) : g / 12.92;
                b = b > 0.04045 ? Math.pow((b + 0.055) / 1.055, 2.4) : b / 12.92;
                var x = (r * 0.4124 + g * 0.3576 + b * 0.1805) / 0.95047;
                var y = (r * 0.2126 + g * 0.7152 + b * 0.0722) / 1.00000;
                var z = (r * 0.0193 + g * 0.1192 + b * 0.9505) / 1.08883;
                x = x > 0.008856 ? Math.pow(x, 1/3) : (7.787 * x) + 16/116;
                y = y > 0.008856 ? Math.pow(y, 1/3) : (7.787 * y) + 16/116;
                z = z > 0.008856 ? Math.pow(z, 1/3) : (7.787 * z) + 16/116;
                return { L: (116 * y) - 16, a: 500 * (x - y), b: 200 * (y - z) };
            }

            function deltaE(lab1, lab2) {
                return Math.sqrt(Math.pow(lab1.L - lab2.L, 2) + Math.pow(lab1.a - lab2.a, 2) + Math.pow(lab1.b - lab2.b, 2));
            }

            $('#removeBackgroundBtn').click(function() {
                var btn = $(this);
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Processing...');
                var overlay = $('<div class="processing-overlay"><div class="spinner-border" role="status"></div><p class="processing-text">Removing background...</p></div>');
                $('.cropper-container-wrapper').append(overlay);

                setTimeout(function() {
                    removeBackgroundAdvanced();
                    overlay.remove();
                    btn.prop('disabled', false).html('<i class="fas fa-magic me-2"></i>Remove Background');
                    $('#bgColorOptions').show();
                    $('#undoBackgroundBtn').prop('disabled', false);
                }, 100);
            });

            function removeBackgroundAdvanced() {
                if (!cropper) return;
                imageBeforeBgRemoval = cropper.getCroppedCanvas().toDataURL('image/png');

                var canvas = cropper.getCroppedCanvas();
                var ctx = canvas.getContext('2d');
                var imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);

                // --- Step 0: Enhance image for better detection ---
                var enhancedData = enhanceImage(ctx.getImageData(0, 0, canvas.width, canvas.height));
                var data = imageData.data;  // Keep original for output
                var enhData = enhancedData.data;  // Use enhanced for analysis
                var width = canvas.width, height = canvas.height;

                // Calculate edge gradients for better boundary detection
                var gradient = calculateGradient(enhData, width, height);

                // Edge sampling with LAB clustering
                var edgeDepth = Math.max(8, Math.floor(Math.min(width, height) * 0.03));
                var edgeSamples = [];
                for (var d = 0; d < edgeDepth; d++) {
                    for (var x = d; x < width - d; x += 2) {
                        var idx1 = (d * width + x) * 4;
                        edgeSamples.push({ r: enhData[idx1], g: enhData[idx1+1], b: enhData[idx1+2] });
                        var idx2 = ((height - 1 - d) * width + x) * 4;
                        edgeSamples.push({ r: enhData[idx2], g: enhData[idx2+1], b: enhData[idx2+2] });
                    }
                    for (var y = d; y < height - d; y += 2) {
                        var idx3 = (y * width + d) * 4;
                        edgeSamples.push({ r: enhData[idx3], g: enhData[idx3+1], b: enhData[idx3+2] });
                        var idx4 = (y * width + (width - 1 - d)) * 4;
                        edgeSamples.push({ r: enhData[idx4], g: enhData[idx4+1], b: enhData[idx4+2] });
                    }
                }

                // Cluster with LAB
                var clusters = {};
                edgeSamples.forEach(function(c) {
                    var lab = rgbToLab(c.r, c.g, c.b);
                    var key = Math.floor(lab.L/10)*10 + ',' + Math.floor(lab.a/10)*10 + ',' + Math.floor(lab.b/10)*10;
                    if (!clusters[key]) clusters[key] = { count: 0, r: 0, g: 0, b: 0, L: 0, a: 0, bb: 0 };
                    clusters[key].count++;
                    clusters[key].r += c.r; clusters[key].g += c.g; clusters[key].b += c.b;
                    clusters[key].L += lab.L; clusters[key].a += lab.a; clusters[key].bb += lab.b;
                });

                var sortedClusters = Object.values(clusters).sort((a, b) => b.count - a.count).slice(0, 3);
                var bgColors = sortedClusters.map(function(c) {
                    return {
                        r: Math.round(c.r / c.count), g: Math.round(c.g / c.count), b: Math.round(c.b / c.count),
                        lab: { L: c.L / c.count, a: c.a / c.count, b: c.bb / c.count }
                    };
                });
                if (bgColors.length === 0) bgColors = [{ r: 255, g: 255, b: 255, lab: rgbToLab(255, 255, 255) }];

                // Gradient-aware flood fill with LAB distance
                var mask = new Float32Array(width * height);
                var visited = new Uint8Array(width * height);
                var baseTolerance = 25;
                var edgeThreshold = 100;

                function getMinLabDistance(idx) {
                    var lab = rgbToLab(enhData[idx], enhData[idx+1], enhData[idx+2]);
                    var minDist = Infinity;
                    bgColors.forEach(function(bg) { var dist = deltaE(lab, bg.lab); if (dist < minDist) minDist = dist; });
                    return minDist;
                }

                var queue = [];
                for (var x = 0; x < width; x++) { queue.push({ pos: x }); queue.push({ pos: (height-1) * width + x }); }
                for (var y = 1; y < height-1; y++) { queue.push({ pos: y * width }); queue.push({ pos: y * width + width - 1 }); }

                while (queue.length > 0) {
                    var item = queue.shift(), pos = item.pos;
                    if (visited[pos]) continue;
                    visited[pos] = 1;

                    var dist = getMinLabDistance(pos * 4);
                    var grad = gradient[pos] || 0;

                    // Reduce tolerance at strong edges (better object boundary detection)
                    var effectiveTolerance = baseTolerance;
                    if (grad > edgeThreshold) {
                        effectiveTolerance = baseTolerance * 0.5;
                    } else if (grad > edgeThreshold * 0.5) {
                        effectiveTolerance = baseTolerance * 0.75;
                    }

                    if (dist < effectiveTolerance) {
                        mask[pos] = 1.0;
                        var x = pos % width, y = Math.floor(pos / width);
                        if (x > 0) queue.push({ pos: pos - 1 });
                        if (x < width-1) queue.push({ pos: pos + 1 });
                        if (y > 0) queue.push({ pos: pos - width });
                        if (y < height-1) queue.push({ pos: pos + width });
                    }
                }

                // Morphological cleanup
                var tempMask = new Float32Array(mask);
                for (var y = 1; y < height-1; y++) {
                    for (var x = 1; x < width-1; x++) {
                        var pos = y * width + x;
                        if (mask[pos] === 1) {
                            var hasNonMask = false;
                            for (var dy = -1; dy <= 1 && !hasNonMask; dy++) {
                                for (var dx = -1; dx <= 1 && !hasNonMask; dx++) {
                                    if (mask[(y+dy) * width + (x+dx)] === 0) hasNonMask = true;
                                }
                            }
                            if (hasNonMask) tempMask[pos] = 0.5;
                        }
                    }
                }
                mask = tempMask;

                // Edge feathering
                var featherRadius = 4;
                var alphaMask = new Float32Array(width * height);
                for (var i = 0; i < mask.length; i++) {
                    if (mask[i] > 0) {
                        var x = i % width, y = Math.floor(i / width);
                        var minDistToForeground = Infinity;
                        for (var dy = -featherRadius; dy <= featherRadius; dy++) {
                            for (var dx = -featherRadius; dx <= featherRadius; dx++) {
                                var nx = x + dx, ny = y + dy;
                                if (nx >= 0 && nx < width && ny >= 0 && ny < height) {
                                    if (mask[ny * width + nx] === 0) {
                                        var d = Math.sqrt(dx*dx + dy*dy);
                                        if (d < minDistToForeground) minDistToForeground = d;
                                    }
                                }
                            }
                        }
                        alphaMask[i] = minDistToForeground <= featherRadius ? 0.5 * (1 + Math.cos(Math.PI * minDistToForeground / featherRadius)) : 0;
                    } else {
                        alphaMask[i] = 1;
                    }
                }

                // Apply alpha
                for (var i = 0; i < alphaMask.length; i++) {
                    data[i * 4 + 3] = Math.round(255 * alphaMask[i]);
                }

                ctx.putImageData(imageData, 0, 0);
                processedImageDataUrl = canvas.toDataURL('image/png');
                cropper.replace(processedImageDataUrl);
                alertify.success('Background removed successfully');
            }

            $('#applyBgColorBtn').click(function() {
                if (!cropper) return;
                var color = $('#bgColorPicker').val();
                var canvas = cropper.getCroppedCanvas();
                var newCanvas = document.createElement('canvas');
                newCanvas.width = canvas.width; newCanvas.height = canvas.height;
                var ctx = newCanvas.getContext('2d');
                ctx.fillStyle = color;
                ctx.fillRect(0, 0, newCanvas.width, newCanvas.height);
                ctx.drawImage(canvas, 0, 0);
                processedImageDataUrl = newCanvas.toDataURL('image/png');
                cropper.replace(processedImageDataUrl);
                $('#bgColorOptions').hide();
                alertify.success('Background color applied');
            });

            $('#transparentBgBtn').click(function() { $('#bgColorOptions').hide(); alertify.message('Keeping transparent background'); });

            $('#undoBackgroundBtn').click(function() {
                if (imageBeforeBgRemoval && cropper) {
                    cropper.replace(imageBeforeBgRemoval);
                    imageBeforeBgRemoval = null;
                    processedImageDataUrl = null;
                    $(this).prop('disabled', true);
