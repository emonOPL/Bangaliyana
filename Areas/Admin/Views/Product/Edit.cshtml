            function openImageEditor(imageDataUrl) {
                originalImageDataUrl = imageDataUrl;
                imageBeforeBgRemoval = null;
                scaleX = 1;
                scaleY = 1;

                $('#bgColorOptions').hide();
                $('#undoBackgroundBtn').prop('disabled', true);
                $('.btn-ratio').removeClass('active');
                $('.btn-ratio[data-ratio="NaN"]').addClass('active');
                $('#zoomSlider').val(1);
                $('#zoomValue').text('100');

                var cropperImage = document.getElementById('cropperImage');
                cropperImage.src = imageDataUrl;

                if (cropper) { cropper.destroy(); cropper = null; }

                imageEditorModal.show();
                $('#imageEditorModal').one('shown.bs.modal', function() { initCropper(); });
            }

            // Zoom is now relative to initial display: 100% = initial fit, 50% = half, 200% = double
            var initialZoomRatio = 1; // The absolute zoom when cropper first loads (this becomes our 100%)
            var displayZoomPercent = 100; // What we show to user (50-200)
            var minDisplayPercent = 50;
            var maxDisplayPercent = 200;
            var processedImageDataUrl = null;

            function initCropper() {
                var cropperImage = document.getElementById('cropperImage');
                cropper = new Cropper(cropperImage, {
                    viewMode: 1,
                    dragMode: 'move',
                    aspectRatio: NaN,
                    autoCropArea: 0.9,
                    restore: false,
                    guides: true,
                    center: true,
                    highlight: true,
                    cropBoxMovable: true,
                    cropBoxResizable: true,
                    toggleDragModeOnDblclick: true,
                    background: true,
                    responsive: true,
                    checkCrossOrigin: false,
                    ready: function() {
                        // Capture the initial zoom ratio as our 100% reference
                        var imageData = cropper.getImageData();
                        initialZoomRatio = imageData.width / imageData.naturalWidth;
                        displayZoomPercent = 100;
                        $('#zoomValue').text('100');
                        $('#zoomSlider').val(100);
                    },
                    zoom: function(e) {
                        // Enforce zoom limits
                        if (initialZoomRatio > 0) {
                            var imageData = cropper.getImageData();
                            var absoluteZoom = imageData.width / imageData.naturalWidth;
                            var percent = (absoluteZoom / initialZoomRatio) * 100;
                            if (percent < minDisplayPercent || percent > maxDisplayPercent) {
                                e.preventDefault();
                                return;
                            }
                        }
                        updateZoomValue();
                    }
                });
            }

            function updateZoomValue() {
                if (cropper && initialZoomRatio > 0) {
                    var imageData = cropper.getImageData();
                    var naturalWidth = imageData.naturalWidth;
                    var currentWidth = imageData.width;
                    var absoluteZoom = currentWidth / naturalWidth;

                    // Calculate display percentage relative to initial zoom
                    displayZoomPercent = Math.round((absoluteZoom / initialZoomRatio) * 100);
                    displayZoomPercent = Math.max(minDisplayPercent, Math.min(maxDisplayPercent, displayZoomPercent));

                    $('#zoomValue').text(displayZoomPercent);
                    $('#zoomSlider').val(displayZoomPercent);
                }
            }

            // Zoom controls - slider value is now 50-200 representing percentage
            $('#zoomSlider').on('input', function() {
                if (cropper && initialZoomRatio > 0) {
                    var percent = parseInt($(this).val());
                    percent = Math.max(minDisplayPercent, Math.min(maxDisplayPercent, percent));
                    var absoluteZoom = (percent / 100) * initialZoomRatio;
                    cropper.zoomTo(absoluteZoom);
                    displayZoomPercent = percent;
                    $('#zoomValue').text(percent);
                }
            });

            $('#zoomInBtn').click(function() {
                if (cropper && initialZoomRatio > 0) {
                    var newPercent = Math.min(maxDisplayPercent, displayZoomPercent + 10);
                    var absoluteZoom = (newPercent / 100) * initialZoomRatio;
                    cropper.zoomTo(absoluteZoom);
                    displayZoomPercent = newPercent;
                    $('#zoomSlider').val(newPercent);
                    $('#zoomValue').text(newPercent);
                }
            });

            $('#zoomOutBtn').click(function() {
                if (cropper && initialZoomRatio > 0) {
                    var newPercent = Math.max(minDisplayPercent, displayZoomPercent - 10);
                    var absoluteZoom = (newPercent / 100) * initialZoomRatio;
                    cropper.zoomTo(absoluteZoom);
                    displayZoomPercent = newPercent;
                    $('#zoomSlider').val(newPercent);
                    $('#zoomValue').text(newPercent);
                }
            });

            $('#rotateLeftBtn').click(function() { if (cropper) cropper.rotate(-90); });
            $('#rotateRightBtn').click(function() { if (cropper) cropper.rotate(90); });
            $('#flipHorizontalBtn').click(function() { if (cropper) { scaleX *= -1; cropper.scaleX(scaleX); } });
            $('#flipVerticalBtn').click(function() { if (cropper) { scaleY *= -1; cropper.scaleY(scaleY); } });

