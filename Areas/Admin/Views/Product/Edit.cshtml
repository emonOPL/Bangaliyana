            $('#confirmImageBtn').click(function() {
                if (!cropper) return;
                var canvas = cropper.getCroppedCanvas({ maxWidth: 2000, maxHeight: 2000, imageSmoothingEnabled: true, imageSmoothingQuality: 'high' });

                // Save as PNG if background was removed (to preserve transparency)
                var hasTransparency = processedImageDataUrl !== null;
                var mimeType = hasTransparency ? 'image/png' : 'image/jpeg';
                var extension = hasTransparency ? 'png' : 'jpg';
                var quality = hasTransparency ? undefined : 0.92;

                canvas.toBlob(function(blob) {
                    var timestamp = new Date().getTime();
                    var file = new File([blob], 'edited_image_' + timestamp + '.' + extension, { type: mimeType });

                    var reader = new FileReader();
                    reader.onload = function(e) {
                        if (editingImageIndex >= 0) {
                            // Update existing image
                            uploadedNewImages[editingImageIndex] = {
                                file: file,
                                dataUrl: e.target.result,
                                name: file.name
                            };
                            alertify.success('Image updated successfully');
                            editingImageIndex = -1;
                        } else {
                            // Add new image
                            capturedFiles.push(file);
                            uploadedNewImages.push({
                                file: file,
                                dataUrl: e.target.result,
                                name: file.name
                            });
                            alertify.success('Image added successfully');
                        }
                        renderNewImageGrid();
                        processedImageDataUrl = null;
                    };
                    reader.readAsDataURL(file);

                    if (cropper) { cropper.destroy(); cropper = null; }
                    imageEditorModal.hide();
                }, mimeType, quality);
            });

            $('#imageEditorModal').on('hidden.bs.modal', function() {
                if (cropper) { cropper.destroy(); cropper = null; }
                editingImageIndex = -1;
                processedImageDataUrl = null;
                imageBeforeBgRemoval = null;
            });
            $('#discardImageBtn, #closeEditorModal').click(function() {
                if (cropper) { cropper.destroy(); cropper = null; }
                editingImageIndex = -1;
                processedImageDataUrl = null;
                imageBeforeBgRemoval = null;
            });

            // =============================================
            // PRODUCT VARIANTS MANAGEMENT
            // =============================================

            // Show/hide custom size input
            $('#variantSize').on('change', function() {
                if ($(this).val() === 'Custom') {
                    $('#customSize').show().focus();
                } else {
                    $('#customSize').hide().val('');
                }
            });

            // Sync color picker with text input
            $('#variantColorPicker').on('input', function() {
                $('#variantColorCode').val($(this).val());
            });
            $('#variantColorCode').on('input', function() {
                var val = $(this).val();
                if (/^#[0-9A-Fa-f]{6}$/.test(val)) {
                    $('#variantColorPicker').val(val);
                }
            });

            // Reset variant form
            function resetVariantForm() {
                $('#variantId').val('0');
                $('#variantSize').val('');
                $('#customSize').hide().val('');
                $('#variantColor').val('');
                $('#variantColorCode').val('');
                $('#variantColorPicker').val('#6f42c1');
                $('#variantSKU').val('');
                $('#variantStock').val('0');
                $('#variantAdditionalPrice').val('0');
                $('#variantIsAvailable').prop('checked', true);
                $('#variantModalTitle').text('Add New Variant');
            }

            // Track if we're in edit mode
            var isVariantEditMode = false;

            // Open modal for adding new variant
            $('#addVariantModal').on('show.bs.modal', function(e) {
                if (!isVariantEditMode) {
                    resetVariantForm();
                }
                isVariantEditMode = false; // Reset flag after modal shows
            });

            // Edit variant button click
            $(document).on('click', '.edit-variant-btn', function() {
                var btn = $(this);
                isVariantEditMode = true; // Set flag to prevent form reset

                $('#variantId').val(btn.data('variantId'));

                var size = btn.data('size') || '';
                var sizeOptions = ['XS', 'S', 'M', 'L', 'XL', 'XXL', 'XXXL', 'Free Size'];
                if (size && sizeOptions.indexOf(size) === -1) {
                    $('#variantSize').val('Custom');
                    $('#customSize').show().val(size);
                } else {
                    $('#variantSize').val(size);
                    $('#customSize').hide().val('');
                }

                $('#variantColor').val(btn.data('color') || '');
                var colorCode = btn.data('colorCode') || '';
                $('#variantColorCode').val(colorCode);
                if (colorCode && /^#[0-9A-Fa-f]{6}$/.test(colorCode)) {
                    $('#variantColorPicker').val(colorCode);
                }
                $('#variantSKU').val(btn.data('sku') || '');
                $('#variantStock').val(btn.data('stock') || 0);
                $('#variantAdditionalPrice').val(btn.data('additionalPrice') || 0);
                $('#variantIsAvailable').prop('checked', btn.data('isAvailable') === true || btn.data('isAvailable') === 'true');
                $('#variantModalTitle').text('Edit Variant');

                var modal = new bootstrap.Modal(document.getElementById('addVariantModal'));
                modal.show();
            });

            // Save variant
            $('#saveVariantBtn').on('click', function() {
                var variantId = parseInt($('#variantId').val()) || 0;
                var size = $('#variantSize').val() === 'Custom' ? $('#customSize').val() : $('#variantSize').val();
                var color = $('#variantColor').val();

                if (!size && !color) {
                    alertify.error('Please enter at least a size or color');
                    return;
                }

                var data = {
                    Id: variantId,
                    ProductId: parseInt($('#variantProductId').val()),
                    Size: size,
                    Color: color,
                    ColorCode: $('#variantColorCode').val(),
                    SKU: $('#variantSKU').val(),
                    Stock: parseInt($('#variantStock').val()) || 0,
                    AdditionalPrice: parseFloat($('#variantAdditionalPrice').val()) || 0,
                    IsAvailable: $('#variantIsAvailable').is(':checked')
                };

                var url = variantId > 0 ? '@Url.Action("UpdateVariant", "Product")' : '@Url.Action("AddVariant", "Product")';

                $.ajax({
                    url: url,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    success: function(response) {
                        if (response.success) {
                            alertify.success(variantId > 0 ? 'Variant updated successfully' : 'Variant added successfully');
                            bootstrap.Modal.getInstance(document.getElementById('addVariantModal')).hide();
                            location.reload();
                        } else {
                            alertify.error(response.message || 'Failed to save variant');
                        }
                    },
                    error: function() {
                        alertify.error('An error occurred while saving the variant');
                    }
                });
            });

            // Delete variant button click
            $(document).on('click', '.delete-variant-btn', function() {
                $('#deleteVariantId').val($(this).data('variant-id'));
                var modal = new bootstrap.Modal(document.getElementById('deleteVariantModal'));
                modal.show();
            });

            // Confirm delete variant
            $('#confirmDeleteVariantBtn').on('click', function() {
                var variantId = $('#deleteVariantId').val();

                $.ajax({
                    url: '@Url.Action("DeleteVariant", "Product")',
                    type: 'POST',
                    data: { id: variantId },
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    success: function(response) {
                        if (response.success) {
                            alertify.success('Variant deleted successfully');
                            bootstrap.Modal.getInstance(document.getElementById('deleteVariantModal')).hide();
                            $('tr[data-variant-id="' + variantId + '"]').fadeOut(300, function() { $(this).remove(); });
                            if ($('#variantsTableBody tr').length === 0) {
                                location.reload();
                            }
                        } else {
                            alertify.error(response.message || 'Failed to delete variant');
                        }
                    },
                    error: function() {
                        alertify.error('An error occurred while deleting the variant');
                    }
                });
            });
        });
    </script>
}
