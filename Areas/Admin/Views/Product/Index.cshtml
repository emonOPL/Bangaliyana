@using Bangaliyana.Models
@using Bangaliyana.Extensions
@model IEnumerable<Products>
@{
    ViewData["Title"] = Localizer["Products"];
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var totalProducts = ViewBag.TotalProducts as int? ?? 0;
    var search = ViewBag.Search as string;
    var categoryId = ViewBag.CategoryId as int?;
    var status = ViewBag.Status as string;
    var sellerId = ViewBag.SellerId as int?;
    var filteredSeller = ViewBag.FilteredSeller as Seller;
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var sellers = ViewBag.Sellers as List<Seller> ?? new List<Seller>();
    var canFilterBySeller = ViewBag.CanFilterBySeller as bool? ?? false;
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            @if (filteredSeller != null)
            {
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-2">
                        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="SellerManagement" asp-action="Index">@Localizer["Sellers"]</a></li>
                        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="SellerManagement" asp-action="Details" asp-route-id="@filteredSeller.Id">@filteredSeller.ShopName</a></li>
                        <li class="breadcrumb-item active">@Localizer["Products"]</li>
                    </ol>
                </nav>
                <h1 class="h3 mb-1">
                    <i class="fas fa-store text-primary me-2"></i>@filteredSeller.ShopName - @Localizer["Products"]
                </h1>
                <p class="text-muted mb-0">
                    <span class="me-3"><i class="fas fa-user me-1"></i>@filteredSeller.FullName</span>
                    <span class="badge bg-primary">@totalProducts @Localizer["Products"].Value.ToLower()</span>
                </p>
            }
            else
            {
                <h1 class="h3 mb-1"><i class="fas fa-box text-primary me-2"></i>@Localizer["ProductManagement"]</h1>
                <p class="text-muted mb-0">@Localizer["ManageAllProductsInMarketplace"]</p>
            }
        </div>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <span class="badge bg-primary fs-6 d-flex align-items-center" style="height: 38px;">
                <i class="fas fa-box me-1"></i>@totalProducts @Localizer["Products"]
            </span>
            @if (filteredSeller != null)
            {
                <a asp-action="BulkUpload" class="btn btn-outline-success">
                    <i class="fas fa-file-excel me-1"></i>@Localizer["BulkUpload"]
                </a>
                <a asp-action="Create" asp-route-sellerId="@sellerId" class="btn btn-success">
                    <i class="fas fa-plus me-1"></i>@Localizer["AddProduct"]
                </a>
                <a asp-area="Admin" asp-controller="SellerManagement" asp-action="Details" asp-route-id="@filteredSeller.Id" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i>@Localizer["BackToSeller"]
                </a>
            }
            else
            {
                <a asp-action="BulkUpload" class="btn btn-outline-success">
                    <i class="fas fa-file-excel me-1"></i>@Localizer["BulkUpload"]
                </a>
                <a asp-action="Create" class="btn btn-success">
                    <i class="fas fa-plus me-1"></i>@Localizer["AddProduct"]
                </a>
            }
        </div>
    </div>

    @if (TempData["onSave"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["onSave"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["onEdit"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show">
            <i class="fas fa-info-circle me-2"></i>@TempData["onEdit"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["onDelete"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["onDelete"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filters Card -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="@(canFilterBySeller ? "col-md-3" : "col-md-4")">
                    <label class="form-label small text-muted mb-1">@Localizer["Search"]</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" name="search" value="@search" class="form-control" placeholder="@Localizer["ProductNameOrSKU"]" />
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">@Localizer["Category"]</label>
                    <select name="categoryId" class="form-select">
                        <option value="">@Localizer["AllCategories"]</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id" selected="@(categoryId == cat.Id)">@cat.Name</option>
                        }
                    </select>
                </div>
                @if (canFilterBySeller)
                {
                    <div class="col-md-3">
                        <label class="form-label small text-muted mb-1"><i class="fas fa-store me-1"></i>@Localizer["ShopSeller"]</label>
                        <select name="sellerId" class="form-select">
                            <option value="">@Localizer["AllShops"]</option>
                            @foreach (var seller in sellers)
                            {
                                <option value="@seller.Id" selected="@(sellerId == seller.Id)">@seller.ShopName</option>
                            }
                        </select>
                    </div>
                }
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">@Localizer["Status"]</label>
                    <select name="status" class="form-select">
                        <option value="">@Localizer["AllStatus"]</option>
                        @foreach (var s in Enum.GetValues<ProductStatus>())
                        {
                            <option value="@s" selected="@(status == s.ToString())">@s.GetDisplayName()</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-filter me-1"></i>@Localizer["Filter"]
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Products Table Card -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 60px;">@Localizer["Image"]</th>
                                <th>@Localizer["Product"]</th>
                                @if (filteredSeller == null && isAdmin)
                                {
                                    <th>@Localizer["Seller"]</th>
                                }
                                <th>@Localizer["Category"]</th>
                                <th>@Localizer["Price"]</th>
                                <th class="text-center">@Localizer["Stock"]</th>
                                <th class="text-center">@Localizer["Views"]</th>
                                <th class="text-center">@Localizer["Sold"]</th>
                                <th class="text-center">@Localizer["Status"]</th>
                                <th style="width: 140px;" class="text-center">@Localizer["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model)
                            {
                                var stockClass = product.Stock <= 0 ? "bg-danger" : (product.Stock <= 5 ? "bg-warning text-dark" : "bg-success");
                                var statusClass = product.Status switch
                                {
                                    ProductStatus.Active => "bg-success",
                                    ProductStatus.Draft => "bg-secondary",
                                    ProductStatus.Inactive => "bg-warning text-dark",
                                    ProductStatus.OutOfStock => "bg-danger",
                                    _ => "bg-secondary"
                                };
                                <tr>
                                    <td>
                                        <img src="~/@(product.ImageUrl ?? "images/products/noimage.jpg")" alt="@product.Name"
                                             class="rounded shadow-sm" style="width: 50px; height: 50px; object-fit: cover;" />
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@product.Id" class="fw-semibold text-decoration-none product-name">
                                            @(product.Name.Length > 40 ? product.Name.Substring(0, 40) + "..." : product.Name)
                                        </a>
                                        @if (!string.IsNullOrEmpty(product.SKU))
                                        {
                                            <br /><small class="text-muted"><i class="fas fa-barcode me-1"></i>@product.SKU</small>
                                        }
                                    </td>
                                    @if (filteredSeller == null && isAdmin)
                                    {
                                        <td>
                                            @if (product.Seller != null)
                                            {
                                                <a asp-area="Admin" asp-controller="SellerManagement" asp-action="Details" asp-route-id="@product.SellerId" class="text-decoration-none">
                                                    <small><i class="fas fa-store me-1"></i>@product.Seller.ShopName</small>
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info">@Localizer["Platform"]</span>
                                            }
                                        </td>
                                    }
                                    <td>
                                        <span class="badge category-badge">@(product.Category?.Name ?? "-")</span>
                                    </td>
                                    <td>
                                        @if (product.DiscountPrice.HasValue && product.DiscountPrice < product.Price)
                                        {
                                            <span class="fw-semibold text-success">৳@product.DiscountPrice.Value.ToString("N0")</span>
                                            <br /><small class="text-muted text-decoration-line-through">৳@product.Price.ToString("N0")</small>
                                        }
                                        else
                                        {
                                            <span class="fw-semibold">৳@product.Price.ToString("N0")</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @stockClass">@product.Stock</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="text-primary"><i class="fas fa-eye me-1"></i>@product.ViewCount</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="text-success"><i class="fas fa-shopping-cart me-1"></i>@product.SoldCount</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @statusClass">@product.Status.GetDisplayName()</span>
                                        @if (!product.IsAvailable)
                                        {
                                            <br /><small class="badge bg-secondary mt-1">@Localizer["Hidden"]</small>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-outline-primary" title="@Localizer["Edit"]">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-info" title="@Localizer["ViewDetails"]">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-danger" title="@Localizer["Delete"]"
                                                    data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                    data-product-id="@product.Id" data-product-name="@product.Name">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <nav class="p-3 border-top">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)"
                                   asp-route-sellerId="@sellerId" asp-route-search="@search" asp-route-categoryId="@categoryId" asp-route-status="@status">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                            @{
                                var startPage = Math.Max(1, currentPage - 2);
                                var endPage = Math.Min(totalPages, startPage + 4);
                                if (endPage - startPage < 4)
                                {
                                    startPage = Math.Max(1, endPage - 4);
                                }
                            }
                            @if (startPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" asp-route-page="1"
                                       asp-route-sellerId="@sellerId" asp-route-search="@search" asp-route-categoryId="@categoryId" asp-route-status="@status">1</a>
                                </li>
                                @if (startPage > 2)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                            }
                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i"
                                       asp-route-sellerId="@sellerId" asp-route-search="@search" asp-route-categoryId="@categoryId" asp-route-status="@status">@i</a>
                                </li>
                            }
                            @if (endPage < totalPages)
                            {
                                @if (endPage < totalPages - 1)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" asp-route-page="@totalPages"
                                       asp-route-sellerId="@sellerId" asp-route-search="@search" asp-route-categoryId="@categoryId" asp-route-status="@status">@totalPages</a>
                                </li>
                            }
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)"
                                   asp-route-sellerId="@sellerId" asp-route-search="@search" asp-route-categoryId="@categoryId" asp-route-status="@status">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                        <div class="text-center text-muted small mt-2">
                            @Localizer["ShowingXOfYProducts", $"{(currentPage - 1) * 15 + 1} - {Math.Min(currentPage * 15, totalProducts)}", totalProducts]
                        </div>
                    </nav>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
                    <h5 class="text-muted">@Localizer["NoProductsFound"]</h5>
                    <p class="text-muted">
                        @if (!string.IsNullOrEmpty(search) || categoryId.HasValue || !string.IsNullOrEmpty(status))
                        {
                            <text>@Localizer["TryAdjustingFilters"]</text>
                        }
                        else if (filteredSeller != null)
                        {
                            <text>@Localizer["SellerNoProducts"]</text>
                        }
                        else
                        {
                            <text>@Localizer["NoProductsInMarketplace"]</text>
                        }
                    </p>
                    @if (!string.IsNullOrEmpty(search) || categoryId.HasValue || !string.IsNullOrEmpty(status))
                    {
                        <a asp-action="Index" asp-route-sellerId="@sellerId" class="btn btn-outline-primary me-2">
                            <i class="fas fa-times me-1"></i>@Localizer["ClearFilters"]
                        </a>
                    }
                    <a asp-action="Create" class="btn btn-success">
                        <i class="fas fa-plus me-1"></i>@Localizer["AddProduct"]
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-body text-center p-4">
                <div class="mb-3">
                    <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="fas fa-trash-alt text-danger" style="font-size: 2rem;"></i>
                    </div>
                </div>
                <h4 class="fw-bold mb-2">@Localizer["DeleteProductQuestion"]</h4>
                <p class="text-muted mb-1">@Localizer["ConfirmDeleteProduct"] "<span id="deleteProductName" class="fw-semibold"></span>"?</p>
                <p class="text-muted small mb-0">@Localizer["ActionCannotBeUndone"]</p>
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2 py-4">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>@Localizer["Cancel"]
                </button>
                <form id="deleteForm" method="post" class="m-0 d-inline-flex">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="fas fa-trash me-1"></i>@Localizer["Delete"]
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .product-name {
            color: var(--bs-body-color);
            transition: color 0.2s;
        }
        .product-name:hover {
            color: var(--bs-primary);
        }

        .category-badge {
            background-color: #e9ecef;
            color: #495057;
            border: 1px solid #dee2e6;
            font-weight: 500;
        }

        .table > tbody > tr:hover {
            background-color: rgba(var(--bs-primary-rgb), 0.05);
        }

        /* Dark mode styles */
        [data-theme="dark"] .card {
            background-color: var(--bs-dark);
            border-color: var(--bs-gray-700);
        }

        [data-theme="dark"] .table {
            color: var(--bs-light);
        }

        [data-theme="dark"] .table-light {
            background-color: #374151 !important;
            color: #f3f4f6 !important;
        }

        [data-theme="dark"] .table-light th {
            background-color: #374151 !important;
            color: #f3f4f6 !important;
        }

        [data-theme="dark"] .form-control,
        [data-theme="dark"] .form-select {
            background-color: var(--bs-gray-800);
            border-color: var(--bs-gray-600);
            color: var(--bs-light);
        }

        [data-theme="dark"] .input-group-text {
            background-color: var(--bs-gray-700);
            border-color: var(--bs-gray-600);
            color: var(--bs-light);
        }

        [data-theme="dark"] .category-badge {
            background-color: #374151;
            color: #e5e7eb;
            border-color: #4b5563;
        }

        [data-theme="dark"] .page-link {
            background-color: var(--bs-gray-800);
            border-color: var(--bs-gray-600);
            color: var(--bs-light);
        }

        [data-theme="dark"] .page-item.active .page-link {
            background-color: var(--bs-primary);
            border-color: var(--bs-primary);
        }

        [data-theme="dark"] .page-item.disabled .page-link {
            background-color: var(--bs-gray-900);
            color: var(--bs-gray-500);
        }

        [data-theme="dark"] .border-top {
            border-color: var(--bs-gray-700) !important;
        }

        [data-theme="dark"] .modal-content {
            background-color: var(--bs-dark);
            color: var(--bs-light);
        }

        [data-theme="dark"] .breadcrumb-item a {
            color: var(--bs-primary);
        }

        [data-theme="dark"] .breadcrumb-item.active {
            color: var(--bs-gray-400);
        }

        [data-theme="dark"] .breadcrumb-item + .breadcrumb-item::before {
            color: var(--bs-gray-500);
        }
    </style>
}

@section Scripts {
    <script>
        // Delete modal handler
        document.getElementById('deleteModal').addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var productId = button.getAttribute('data-product-id');
            var productName = button.getAttribute('data-product-name');

            document.getElementById('deleteProductName').textContent = productName;
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + productId;
        });
    </script>
}
