@model Bangaliyana.Models.FlashSale
@{
    ViewData["Title"] = "Flash Sale Details";
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Flash Sales</a></li>
            <li class="breadcrumb-item active">@Model.Name</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-8">
            <!-- Main Info -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-bolt me-2"></i>@Model.Name</h5>
                    @if (Model.IsCurrentlyActive)
                    {
                        <span class="badge bg-success">Active Now</span>
                    }
                    else if (Model.IsUpcoming)
                    {
                        <span class="badge bg-info">Upcoming</span>
                    }
                    else if (Model.IsExpired)
                    {
                        <span class="badge bg-danger">Expired</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
                    {
                        <div class="mb-4">
                            <img src="@Model.BannerImageUrl" alt="Banner" class="img-fluid rounded" style="max-height: 200px; width: 100%; object-fit: cover;">
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <p class="text-muted">@Model.Description</p>
                    }

                    <div class="row">
                        <div class="col-md-6">
                            <p><strong><i class="fas fa-calendar text-primary me-2"></i>Start Date:</strong><br />@Model.StartDate.ToString("MMMM dd, yyyy HH:mm")</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong><i class="fas fa-calendar-check text-danger me-2"></i>End Date:</strong><br />@Model.EndDate.ToString("MMMM dd, yyyy HH:mm")</p>
                        </div>
                    </div>

                    @if (Model.IsCurrentlyActive)
                    {
                        <div class="alert alert-success mb-0">
                            <i class="fas fa-clock me-2"></i>
                            <strong>Time Remaining:</strong> @Model.TimeRemaining.Days days, @Model.TimeRemaining.Hours hours, @Model.TimeRemaining.Minutes minutes
                        </div>
                    }
                </div>
            </div>

            <!-- Products -->
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-boxes me-2"></i>Products (@Model.Products.Count)</h5>
                    <a asp-action="ManageProducts" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">
                        <i class="fas fa-edit me-1"></i>Manage
                    </a>
                </div>
                <div class="card-body p-0">
                    @if (Model.Products.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Product</th>
                                        <th>Original Price</th>
                                        <th>Flash Sale Price</th>
                                        <th>Discount</th>
                                        <th>Stock / Sold</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Products.OrderBy(p => p.DisplayOrder))
                                    {
                                        var product = item.Product;
                                        var firstImage = product?.Images?.FirstOrDefault()?.ImageUrl;
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(firstImage))
                                                    {
                                                        <img src="@firstImage" alt="Product" class="rounded me-2" style="width: 40px; height: 40px; object-fit: cover;">
                                                    }
                                                    <span>@product?.Name</span>
                                                </div>
                                            </td>
                                            <td><span class="text-decoration-line-through text-muted">৳@product?.Price.ToString("N0")</span></td>
                                            <td><span class="fw-bold text-danger">৳@item.FlashSalePrice.ToString("N0")</span></td>
                                            <td><span class="badge bg-danger">@item.DiscountPercentage% OFF</span></td>
                                            <td>
                                                @if (item.FlashSaleStock.HasValue)
                                                {
                                                    <span>@item.RemainingStock / @item.FlashSaleStock (Sold: @item.SoldCount)</span>
                                                    @if (item.IsSoldOut)
                                                    {
                                                        <span class="badge bg-dark ms-1">Sold Out</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Unlimited (Sold: @item.SoldCount)</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No products in this flash sale</h5>
                            <a asp-action="ManageProducts" asp-route-id="@Model.Id" class="btn btn-primary">
                                <i class="fas fa-plus me-1"></i>Add Products
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Settings -->
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <i class="fas fa-cog me-2"></i>Settings
                </div>
                <div class="card-body">
                    <p class="d-flex justify-content-between">
                        <span>Active:</span>
                        <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">@(Model.IsActive ? "Yes" : "No")</span>
                    </p>
                    <p class="d-flex justify-content-between">
                        <span>Show Countdown:</span>
                        <span class="badge @(Model.ShowCountdown ? "bg-success" : "bg-secondary")">@(Model.ShowCountdown ? "Yes" : "No")</span>
                    </p>
                    <p class="d-flex justify-content-between mb-0">
                        <span>Display Order:</span>
                        <span>@Model.DisplayOrder</span>
                    </p>
                </div>
            </div>

            <!-- Theme Colors -->
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <i class="fas fa-palette me-2"></i>Theme Colors
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <div class="rounded me-2" style="width: 30px; height: 30px; background-color: @(Model.PrimaryColor ?? "#ef4444");"></div>
                        <span>Primary: @(Model.PrimaryColor ?? "#ef4444")</span>
                    </div>
                    <div class="d-flex align-items-center mb-2">
                        <div class="rounded me-2" style="width: 30px; height: 30px; background-color: @(Model.SecondaryColor ?? "#fef2f2");"></div>
                        <span>Secondary: @(Model.SecondaryColor ?? "#fef2f2")</span>
                    </div>
                    <div class="d-flex align-items-center">
                        <div class="rounded me-2 border" style="width: 30px; height: 30px; background-color: @(Model.TextColor ?? "#ffffff");"></div>
                        <span>Text: @(Model.TextColor ?? "#ffffff")</span>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="card shadow-sm">
                <div class="card-header">
                    <i class="fas fa-tools me-2"></i>Actions
                </div>
                <div class="card-body">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary w-100 mb-2">
                        <i class="fas fa-edit me-1"></i>Edit Flash Sale
                    </a>
                    <a asp-action="ManageProducts" asp-route-id="@Model.Id" class="btn btn-outline-primary w-100 mb-2">
                        <i class="fas fa-boxes me-1"></i>Manage Products
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">
                        <i class="fas fa-arrow-left me-1"></i>Back to List
                    </a>
                </div>
            </div>

            <!-- Timestamps -->
            <div class="card shadow-sm mt-4">
                <div class="card-body small text-muted">
                    <p class="mb-1"><i class="fas fa-clock me-1"></i>Created: @Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                    <p class="mb-0"><i class="fas fa-sync me-1"></i>Updated: @Model.UpdatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                </div>
            </div>
        </div>
    </div>
</div>
