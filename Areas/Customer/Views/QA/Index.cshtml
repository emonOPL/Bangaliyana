@model List<Bangaliyana.Models.ProductQuestion>
@using Bangaliyana.Extensions
@{
    ViewData["Title"] = Localizer["MyQuestions"].Value;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="mb-1"><i class="fas fa-question-circle me-2"></i>@Localizer["MyQuestions"]</h2>
            <p class="text-muted mb-0">@Localizer["QuestionsAboutProducts"]</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="fas fa-inbox text-muted fs-1 mb-3"></i>
                <h5 class="text-muted">@Localizer["NoQuestionsYet"]</h5>
                <p class="text-muted mb-3">@Localizer["YouHaventAskedQuestions"]</p>
                <a href="@Url.Action("Index", "Home", new { area = "Customer" })" class="btn btn-primary">
                    <i class="fas fa-shopping-bag me-1"></i>@Localizer["BrowseProducts"]
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var question in Model)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex align-items-start gap-3">
                                @if (question.Product != null)
                                {
                                    var imgUrl = !string.IsNullOrEmpty(question.Product.ImageUrl)
                                        ? (question.Product.ImageUrl.StartsWith("/") ? question.Product.ImageUrl : "/" + question.Product.ImageUrl)
                                        : "/images/products/noimage.jpg";
                                    <a href="@Url.Action("Details", "Home", new { area = "Customer", id = question.ProductId })">
                                        <img src="@imgUrl"
                                             alt="@question.Product.Name"
                                             class="rounded"
                                             style="width: 80px; height: 80px; object-fit: cover;"
                                             onerror="this.src='/images/products/noimage.jpg'">
                                    </a>
                                }
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                        <div>
                                            @if (question.Product != null)
                                            {
                                                <a href="@Url.Action("Details", "Home", new { area = "Customer", id = question.ProductId })"
                                                   class="text-decoration-none">
                                                    <h6 class="fw-semibold mb-1">@question.Product.Name</h6>
                                                </a>
                                            }
                                            <small class="text-muted">
                                                <i class="fas fa-calendar me-1"></i>@Localizer["AskedOn"] @question.CreatedAt.ToBangladeshString()
                                            </small>
                                        </div>
                                        <div>
                                            @if (question.IsAnswered)
                                            {
                                                <span class="badge bg-success"><i class="fas fa-check me-1"></i>@Localizer["Answered"]</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>@Localizer["Pending"]</span>
                                            }
                                        </div>
                                    </div>

                                    <!-- Question -->
                                    <div class="mt-3 p-3 bg-light rounded">
                                        <div class="d-flex align-items-start gap-2">
                                            <span class="badge bg-primary">Q</span>
                                            <p class="mb-0">@question.Question</p>
                                        </div>
                                    </div>

                                    <!-- Answer (if any) -->
                                    @if (question.IsAnswered && !string.IsNullOrEmpty(question.Answer))
                                    {
                                        <div class="mt-2 p-3 bg-success bg-opacity-10 rounded">
                                            <div class="d-flex align-items-start gap-2">
                                                <span class="badge bg-success">A</span>
                                                <div>
                                                    <p class="mb-1">@question.Answer</p>
                                                    <small class="text-muted">
                                                        @Localizer["AnsweredBy"] @(question.AnsweredBy?.FirstName ?? Localizer["Seller"].Value)
                                                        @Localizer["On"].Value.ToLower() @question.AnsweredAt?.ToBangladeshShortDateString()
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <!-- Actions -->
                                    <div class="mt-3 d-flex gap-2">
                                        @if (!question.IsAnswered)
                                        {
                                            <a asp-action="Edit" asp-route-id="@question.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-pen me-1"></i>@Localizer["EditQuestion"]
                                            </a>
                                        }
                                        <a href="@Url.Action("Details", "Home", new { area = "Customer", id = question.ProductId })"
                                           class="btn btn-sm btn-outline-secondary">
                                            <i class="fas fa-external-link-alt me-1"></i>@Localizer["ViewProduct"]
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                onclick="confirmDelete(@question.Id)">
                                            <i class="fas fa-trash me-1"></i>@Localizer["Delete"]
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0">
                <h5 class="modal-title"><i class="fas fa-trash text-danger me-2"></i>@Localizer["DeleteQuestion"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <p class="mb-1">@Localizer["DeleteQuestionConfirm"]</p>
                <p class="text-muted small mb-0">@Localizer["ActionCannotBeUndone"]</p>
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <form id="deleteForm" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-1"></i>@Localizer["Delete"]
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id) {
            document.getElementById('deleteForm').action = '@Url.Action("Delete", "QA", new { area = "Customer" })/' + id;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }

        @if (TempData["success"] != null)
        {
            <text>alertify.success('@TempData["success"]');</text>
        }
        @if (TempData["error"] != null)
        {
            <text>alertify.error('@TempData["error"]');</text>
        }
    </script>
}
