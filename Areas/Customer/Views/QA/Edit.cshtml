@model Bangaliyana.Models.ProductQuestion
@{
    ViewData["Title"] = Localizer["EditQuestion"].Value;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-outline-secondary me-3">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <h2 class="mb-0"><i class="fas fa-edit me-2"></i>@Localizer["EditQuestion"]</h2>
                    <p class="text-muted mb-0">@Localizer["UpdateYourQuestion"]</p>
                </div>
            </div>

            <!-- Product Info Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        @if (Model.Product != null)
                        {
                            <img src="@(Model.Product.ImageUrl ?? "/images/products/noimage.jpg")"
                                 alt="@Model.Product.Name"
                                 class="rounded me-3"
                                 style="width: 80px; height: 80px; object-fit: cover;">
                            <div>
                                <h5 class="mb-1">@Model.Product.Name</h5>
                                <a asp-area="Customer" asp-controller="Home" asp-action="Details" asp-route-id="@Model.ProductId"
                                   class="btn btn-sm btn-outline-primary" target="_blank">
                                    <i class="fas fa-external-link-alt me-1"></i>@Localizer["ViewProduct"]
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Edit Question Form -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0"><i class="fas fa-question-circle me-2"></i>@Localizer["YourQuestion"]</h6>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label">@Localizer["Question"] <span class="text-danger">*</span></label>
                            <textarea name="questionText" class="form-control" rows="4" required
                                      placeholder="@Localizer["TypeYourQuestionHere"]">@Model.Question</textarea>
                            <small class="text-muted">@Localizer["QuestionClearSpecific"]</small>
                        </div>

                        <div class="alert alert-info mb-4">
                            <i class="fas fa-info-circle me-2"></i>
                            <small>@Localizer["QuestionEditWarning"]</small>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i>@Localizer["UpdateQuestion"]
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        @if (TempData["error"] != null)
        {
            <text>alertify.error('@TempData["error"]');</text>
        }
    </script>
}
