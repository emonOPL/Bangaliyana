@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        // AI Chat JavaScript
        (function() {
            let connection = null;
            let currentSessionId = @(existingSession?.Id ?? 0);
            let aiSessionId = 0;
            let selectedRating = 0;
            let soundEnabled = true;

            // Initialize SignalR connection
            async function initConnection() {
                try {
                    connection = new signalR.HubConnectionBuilder()
                        .withUrl("/supportChatHub")
                        .withAutomaticReconnect()
                        .configureLogging(signalR.LogLevel.Information)
                        .build();

                    // Event handlers
                    connection.on("ChatStarted", onChatStarted);
                    connection.on("SessionResumed", onSessionResumed);
                    connection.on("SessionJoined", onSessionJoined);
                    connection.on("AgentJoined", onAgentJoined);
                    connection.on("ReceiveMessage", onReceiveMessage);
                    connection.on("ChatClosed", onChatClosed);
                    connection.on("UserTyping", onUserTyping);
                    connection.on("Error", onError);
                    connection.on("RatingSubmitted", onRatingSubmitted);
                    connection.on("HandoffRequested", onHandoffRequested);
                    connection.on("SuggestHumanAgent", onSuggestHumanAgent);
                    connection.on("FeedbackSubmitted", onFeedbackSubmitted);
                    connection.on("NewWaitingChat", onNewWaitingChat);
                    connection.on("SessionClosed", onSessionClosed);

                    // Connection state change handlers
                    connection.onclose((error) => {
                        console.log("Connection closed", error);
                        updateConnectionStatus(false);
                    });

                    connection.onreconnecting((error) => {
                        console.log("Reconnecting...", error);
                        updateConnectionStatus(false, "Reconnecting...");
                    });

                    connection.onreconnected((connectionId) => {
                        console.log("Reconnected", connectionId);
                        updateConnectionStatus(true);
                    });

                    await connection.start();
                    console.log("Connected to chat hub");
                    updateConnectionStatus(true);

                    // If there's an existing session, join it
                    if (currentSessionId > 0) {
                        await connection.invoke("JoinSession", "@existingSession?.SessionCode");
                    }
                } catch (err) {
                    console.error("Failed to connect:", err);
                    updateConnectionStatus(false, "Connection failed");
                }
            }

            // Update connection status indicator
            function updateConnectionStatus(isConnected, message = null) {
                const statusEl = document.getElementById('chatAvailability');
                if (statusEl) {
                    if (isConnected) {
                        statusEl.innerHTML = `
                            <div class="availability-status online">
                                <span class="status-dot"></span>
                                <span>AI Assistant Online 24/7</span>
                            </div>`;
                    } else {
                        statusEl.innerHTML = `
                            <div class="availability-status" style="background: #fef2f2; color: #dc2626;">
                                <span class="status-dot" style="background: #dc2626;"></span>
                                <span>${message || 'Connecting...'}</span>
                            </div>`;
                    }
                }
            }

            // Custom form validation function
            function validateChatForm() {
                let isValid = true;
                const form = document.getElementById('initChatForm');

                // Clear previous errors
                form.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
                form.querySelectorAll('.invalid-feedback').forEach(el => {
                    el.textContent = '';
                    el.classList.remove('show');
                });

                // Validate required fields
                const requiredFields = form.querySelectorAll('[data-required="true"]');
                requiredFields.forEach(field => {
                    const value = field.value.trim();
                    const errorDiv = document.getElementById(field.id + '-error');

                    if (!value) {
                        field.classList.add('is-invalid');
                        if (errorDiv) {
                            errorDiv.textContent = field.dataset.errorMsg || 'This field is required';
                            errorDiv.classList.add('show');
                        }
                        isValid = false;
                    }

                    // Email validation
                    if (value && field.dataset.type === 'email') {
                        const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                        if (!emailRegex.test(value)) {
                            field.classList.add('is-invalid');
                            if (errorDiv) {
                                errorDiv.textContent = field.dataset.emailError || 'Please enter a valid email';
                                errorDiv.classList.add('show');
                            }
                            isValid = false;
                        }
                    }
                });

                return isValid;
            }

            // Clear error on input
            document.querySelectorAll('#initChatForm [data-required="true"]').forEach(field => {
                field.addEventListener('input', function() {
                    this.classList.remove('is-invalid');
                    const errorDiv = document.getElementById(this.id + '-error');
                    if (errorDiv) {
                        errorDiv.textContent = '';
                        errorDiv.classList.remove('show');
                    }
                });

                field.addEventListener('change', function() {
                    this.classList.remove('is-invalid');
                    const errorDiv = document.getElementById(this.id + '-error');
                    if (errorDiv) {
                        errorDiv.textContent = '';
                        errorDiv.classList.remove('show');
                    }
                });
            });

            // Start chat form submission
            document.getElementById('initChatForm')?.addEventListener('submit', async function(e) {
                e.preventDefault();

                // Validate form first
                if (!validateChatForm()) {
                    // Focus first invalid field
                    const firstInvalid = document.querySelector('#initChatForm .is-invalid');
                    if (firstInvalid) {
                        firstInvalid.focus();
                    }
                    return;
                }

                const name = document.getElementById('visitorName').value;
                const email = document.getElementById('visitorEmail').value;
                const department = document.getElementById('chatDepartment').value;
                const query = document.getElementById('initialQuery').value;

                // Check connection state
                if (!connection || connection.state !== signalR.HubConnectionState.Connected) {
                    alertify.error('Connection not ready. Please wait...');
                    // Try to reconnect
                    try {
                        await initConnection();
                    } catch (err) {
                        alertify.error('Failed to connect. Please refresh the page.');
                        return;
                    }
                }

                document.getElementById('startChatBtn').disabled = true;
                document.getElementById('startChatBtn').innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Connecting...';

                try {
                    await connection.invoke("StartChat", name, email, query, department);
                } catch (err) {
                    console.error("Error starting chat:", err);
                    alertify.error('Failed to start chat: ' + (err.message || 'Unknown error'));
                    document.getElementById('startChatBtn').disabled = false;
                    document.getElementById('startChatBtn').innerHTML = '<i class="fas fa-robot me-2"></i>Start AI Chat';
                }
            });

            // Message form submission
            document.getElementById('messageForm')?.addEventListener('submit', async function(e) {
                e.preventDefault();

                const input = document.getElementById('messageInput');
                const message = input.value.trim();

                if (!message || !currentSessionId) return;

                input.value = '';
                hideQuickReplies();

                try {
                    await connection.invoke("SendMessage", currentSessionId, message, aiSessionId > 0 ? aiSessionId : null);
                } catch (err) {
                    console.error("Error sending message:", err);
                    addSystemMessage('⚠️ মেসেজ পাঠাতে সমস্যা হয়েছে। আবার চেষ্টা করুন।');
                }
            });

            // End chat button - show modal
            document.getElementById('endChatBtn')?.addEventListener('click', function() {
                const endChatModal = new bootstrap.Modal(document.getElementById('endChatModal'));
                endChatModal.show();
            });

            // Confirm end chat from modal
            document.getElementById('confirmEndChatBtn')?.addEventListener('click', async function() {
                try {
                    // First hide the modal and wait for it to be fully hidden
                    const endChatModalEl = document.getElementById('endChatModal');
                    const endChatModal = bootstrap.Modal.getInstance(endChatModalEl);

                    // Wait for modal to be fully hidden before proceeding
                    endChatModalEl.addEventListener('hidden.bs.modal', async function onHidden() {
                        endChatModalEl.removeEventListener('hidden.bs.modal', onHidden);
                        // Remove any residual backdrops
                        document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
                        document.body.classList.remove('modal-open');
                        document.body.style.removeProperty('overflow');
                        document.body.style.removeProperty('padding-right');
                        // Now invoke CloseChat which will trigger onChatClosed
                        await connection.invoke("CloseChat", currentSessionId, aiSessionId > 0 ? aiSessionId : null);
                    }, { once: true });

                    endChatModal.hide();
                } catch (err) {
                    console.error("Error ending chat:", err);
                }
            });

            // Request human agent
            document.getElementById('requestHumanBtn')?.addEventListener('click', function() {
                const modal = new bootstrap.Modal(document.getElementById('requestHumanModal'));
                modal.show();
            });

            document.getElementById('confirmHandoffBtn')?.addEventListener('click', async function() {
                const reason = document.getElementById('handoffReason').value;
                try {
                    await connection.invoke("RequestHumanAgent", currentSessionId, aiSessionId > 0 ? aiSessionId : null, reason);
                    const modal = bootstrap.Modal.getInstance(document.getElementById('requestHumanModal'));
                    modal.hide();
                } catch (err) {
                    console.error("Error requesting handoff:", err);
                }
            });

            // Typing indicator
            let typingTimeout;
            document.getElementById('messageInput')?.addEventListener('input', async function() {
                clearTimeout(typingTimeout);

                try {
                    await connection.invoke("Typing", currentSessionId, true);

                    typingTimeout = setTimeout(async () => {
                        await connection.invoke("Typing", currentSessionId, false);
                    }, 2000);
                } catch (err) {
                    console.error("Error sending typing status:", err);
                }
            });

            // Rating functions are defined globally below the IIFE

            // Topic buttons
            document.querySelectorAll('.topic-btn').forEach(btn => {
                btn.addEventListener('click', async function() {
                    const message = this.dataset.message;
                    if (message && currentSessionId > 0) {
                        try {
                            await connection.invoke("SendMessage", currentSessionId, message, aiSessionId > 0 ? aiSessionId : null);
                        } catch (err) {
                            console.error("Error sending topic message:", err);
                        }
                    } else if (message) {
                        // Start chat first if no session
                        document.getElementById('initialQuery').value = message;
                        document.getElementById('initChatForm').dispatchEvent(new Event('submit'));
                    }
                });
            });

            // Event handlers
            function onChatStarted(sessionCode, sessionId, aiSessId) {
                currentSessionId = sessionId;
                aiSessionId = aiSessId || 0;
                document.getElementById('startChatForm').classList.add('d-none');
                document.getElementById('chatInterface').classList.remove('d-none');
                document.getElementById('chatMessages').innerHTML = '';
            }

            function onSessionResumed(sessionCode, sessionId) {
                currentSessionId = sessionId;
                document.getElementById('startChatForm').classList.add('d-none');
                document.getElementById('chatInterface').classList.remove('d-none');
            }

            function onSessionJoined(data) {
                currentSessionId = data.sessionId;
                document.getElementById('chatStatus').innerHTML = '<span class="status-dot-small online"></span> Connected';

                const messagesContainer = document.getElementById('chatMessages');
                messagesContainer.innerHTML = '';

                data.messages.forEach(msg => addMessageToChat(msg));
                scrollToBottom();
            }

            function onAgentJoined(data) {
                aiSessionId = data.aiSessionId || aiSessionId;
                document.getElementById('agentName').textContent = data.agentName;
                const icon = data.isAI ? 'fas fa-robot' : 'fas fa-user-tie';
                document.getElementById('agentAvatar').innerHTML = `<i class="${icon}"></i>`;
                document.getElementById('chatStatus').innerHTML = '<span class="status-dot-small online"></span> Connected';
            }

            function onReceiveMessage(message) {
                addMessageToChat(message);
                scrollToBottom();

                // Show quick replies if available
                if (message.quickReplies && message.quickReplies.length > 0) {
                    showQuickReplies(message.quickReplies);
                }

                // Play notification sound for agent messages
                if (message.isAgentMessage && soundEnabled) {
                    playNotificationSound();
                }
            }

            function onChatClosed(sessionId) {
                // Ensure any modals and backdrops are cleaned up
                document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
                document.body.classList.remove('modal-open');
                document.body.style.removeProperty('overflow');
                document.body.style.removeProperty('padding-right');

                document.getElementById('chatInterface').classList.add('d-none');
                document.getElementById('chatRating').classList.remove('d-none');
            }

            function onUserTyping(data) {
                const indicator = document.getElementById('typingIndicator');
                if (data.isTyping && data.isAgent) {
                    indicator.classList.remove('d-none');
                } else {
                    indicator.classList.add('d-none');
                }
            }

            function onError(message) {
                console.error('Chat error:', message);
            }

            function onRatingSubmitted(success) {
                if (success) {
                    alertify.success('ধন্যবাদ আপনার মতামতের জন্য!');
                    resetChat();
                } else {
                    alertify.error('রেটিং সাবমিট করতে সমস্যা হয়েছে');
                    // Reset submit button
                    const submitBtn = document.getElementById('submitRatingBtn');
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<i class="fas fa-check me-2"></i>Submit Rating';
                    }
                }
            }

            function onHandoffRequested(data) {
                if (data.success) {
                    // Show a system message about waiting
                    addSystemMessage(data.message || 'আপনার request পাঠানো হয়েছে। অনুগ্রহ করে অপেক্ষা করুন...');
                }
            }

            function onSuggestHumanAgent(data) {
                // Show button to request human agent
                addSystemMessage(data.reason || 'AI recommends connecting with a human agent for better assistance.');
            }

            function onFeedbackSubmitted(data) {
                // Feedback is already handled in submitFeedback function
                // This callback just confirms server-side success
                if (!data.success) {
                    console.error("Feedback submission failed for message:", data.messageId);
                }
            }

            function onNewWaitingChat(data) {
                // For support agents - notification about new waiting chat
                console.log('New waiting chat:', data);
            }

            function onSessionClosed(sessionId) {
                // Session was closed by agent or system
                console.log('Session closed:', sessionId);
                if (currentSessionId === sessionId) {
                    // Ensure any modals and backdrops are cleaned up
                    document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
                    document.body.classList.remove('modal-open');
                    document.body.style.removeProperty('overflow');
                    document.body.style.removeProperty('padding-right');

                    // Show rating section
                    document.getElementById('chatInterface')?.classList.add('d-none');
                    document.getElementById('chatRating')?.classList.remove('d-none');
                }
            }

            function addMessageToChat(message) {
                const messagesContainer = document.getElementById('chatMessages');

                if (message.isSystemMessage) {
                    addSystemMessage(message.content);
                    return;
                }

                const msgDiv = document.createElement('div');
                msgDiv.className = `message ${message.isAgentMessage ? 'agent' : 'customer'}`;

                const time = new Date(message.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

                // Parse markdown for AI responses (trusted content from our backend), escape for user messages
                let contentHtml = message.isAgentMessage
                    ? parseMarkdown(message.content)
                    : escapeHtml(message.content);

                // Handle product carousel
                if (message.products && message.products.length > 0) {
                    contentHtml += renderProductCarousel(message.products);
                }

                let feedbackHtml = '';
                if (message.isAgentMessage && message.id) {
                    // Check if feedback was already given (wasHelpful can be true, false, or null)
                    if (message.wasHelpful === true) {
                        // Show positive response message
                        feedbackHtml = `
                            <div class="message-feedback">
                                <span class="feedback-response positive"><i class="fas fa-check-circle"></i> ধন্যবাদ! আপনার মতামত আমাদের উন্নত হতে সাহায্য করবে।</span>
                            </div>
                        `;
                    } else if (message.wasHelpful === false) {
                        // Show negative response message
                        feedbackHtml = `
                            <div class="message-feedback">
                                <span class="feedback-response negative"><i class="fas fa-heart"></i> দুঃখিত! আমরা আরও ভালো করার চেষ্টা করব।</span>
                            </div>
                        `;
                    } else {
                        // Show feedback buttons
                        feedbackHtml = `
                            <div class="message-feedback">
                                <button class="feedback-btn" data-message-id="${message.id}" data-feedback-type="helpful" onclick="submitFeedback(this, ${message.id}, true)">
                                    <i class="fas fa-thumbs-up"></i> Helpful
                                </button>
                                <button class="feedback-btn" data-message-id="${message.id}" data-feedback-type="not-helpful" onclick="submitFeedback(this, ${message.id}, false)">
                                    <i class="fas fa-thumbs-down"></i> Not Helpful
                                </button>
                            </div>
                        `;
                    }
                }

                msgDiv.innerHTML = `
                    <div class="message-bubble">${contentHtml}</div>
                    <span class="message-time">${message.senderName} - ${time}</span>
                    ${feedbackHtml}
                `;

                messagesContainer.appendChild(msgDiv);
            }

            function addSystemMessage(content) {
                const messagesContainer = document.getElementById('chatMessages');
                const systemDiv = document.createElement('div');
                systemDiv.className = 'system-message';
                systemDiv.innerHTML = `<p>${escapeHtml(content)}</p>`;
                messagesContainer.appendChild(systemDiv);
                scrollToBottom();
            }

            function getProductImageUrl(product) {
                // Get image URL from various possible property names
                let imgUrl = product.imageUrl || product.ImageUrl || product.image || product.Image || '';

                // If empty or null, use default
                if (!imgUrl || imgUrl.trim() === '') {
                    return '/images/noimage.jpg';
                }

                // Ensure URL starts with / for relative paths
                if (!imgUrl.startsWith('http') && !imgUrl.startsWith('/')) {
                    imgUrl = '/' + imgUrl;
                }

                return imgUrl;
            }

            function renderProductCarousel(products) {
                if (!Array.isArray(products)) {
                    try { products = JSON.parse(products); } catch { return ''; }
                }

                let html = '<div class="product-carousel">';
                products.forEach(product => {
                    // Get product ID (handle both camelCase and PascalCase from JSON)
                    const productId = product.id || product.Id;
                    const url = productId ? `/Customer/Home/Details/${productId}` : '#';
                    const imgUrl = getProductImageUrl(product);
                    const productName = product.name || product.Name || 'Product';
                    const productPrice = product.discountPrice || product.DiscountPrice || product.price || product.Price || 0;

                    html += `
                        <a href="${url}" class="product-card-mini" target="_blank">
                            <img src="${imgUrl}" alt="${escapeHtml(productName)}" onerror="this.src='/images/noimage.jpg'">
                            <div class="card-body">
                                <div class="product-name">${escapeHtml(productName)}</div>
                                <div class="product-price">৳${productPrice.toLocaleString()}</div>
                            </div>
                        </a>
                    `;
                });
                html += '</div>';
                return html;
            }

            function showQuickReplies(replies) {
                if (!replies || !Array.isArray(replies) || replies.length === 0) return;

                const container = document.getElementById('quickReplies');
                container.innerHTML = '';

                replies.forEach(reply => {
                    const btn = document.createElement('button');
                    btn.className = 'quick-reply-btn';
                    const text = reply.Text || reply.text || reply.label || '';
                    const icon = reply.Icon || reply.icon || '';
                    btn.innerHTML = `${icon ? `<i class="${icon}"></i>` : ''}${text}`;
                    btn.onclick = () => handleQuickReply(reply);
                    container.appendChild(btn);
                });

                container.classList.remove('d-none');
            }

            function hideQuickReplies() {
                document.getElementById('quickReplies').classList.add('d-none');
            }

            async function handleQuickReply(reply) {
                hideQuickReplies();
                const action = reply.Action || reply.action || 'send_message';
                const payload = reply.Payload || reply.payload || reply.Text || reply.text || '';

                if (action === 'send_message') {
                    // Check if SignalR connection is established
                    if (!connection || connection.state !== signalR.HubConnectionState.Connected) {
                        addSystemMessage('⚠️ চ্যাট সংযোগ ভেঙে গেছে। পেজ রিফ্রেশ করুন।');
                        return;
                    }
                    try {
                        await connection.invoke("SendMessage", currentSessionId, payload, aiSessionId > 0 ? aiSessionId : null);
                    } catch (err) {
                        console.error("Error sending quick reply:", err);
                        addSystemMessage('⚠️ রিকুয়েস্ট পাঠাতে সমস্যা হয়েছে। আবার চেষ্টা করুন।');
                    }
                } else if (action === 'open_url') {
                    window.open(payload, '_blank');
                } else if (action === 'navigate') {
                    // Navigate in the same tab
                    window.location.href = payload;
                } else if (action === 'request_human') {
                    document.getElementById('requestHumanBtn').click();
                }
            }

            function scrollToBottom() {
                const container = document.getElementById('chatMessages');
                container.scrollTop = container.scrollHeight;
            }

            function resetChat() {
                currentSessionId = 0;
                aiSessionId = 0;
                selectedRating = 0;
                document.getElementById('chatRating').classList.add('d-none');
                document.getElementById('chatInterface').classList.add('d-none');
                document.getElementById('startChatForm').classList.remove('d-none');
                document.getElementById('chatMessages').innerHTML = '';
                document.getElementById('startChatBtn').disabled = false;
                document.getElementById('startChatBtn').innerHTML = '<i class="fas fa-robot me-2"></i>Start AI Chat';
                hideQuickReplies();

                // Reset star rating display using global function
                if (typeof resetRatingStarsDisplay === 'function') {
                    resetRatingStarsDisplay();
                }

                // Reset feedback textarea
                const feedbackEl = document.getElementById('chatFeedback');
                if (feedbackEl) feedbackEl.value = '';

                // Reset submit button
                const submitBtn = document.getElementById('submitRatingBtn');
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="fas fa-check me-2"></i>Submit Rating';
                }
            }

            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            function parseMarkdown(text) {
                if (!text) return '';
                return text
                    // Links: [text](url) - internal links navigate same tab, external open new tab
                    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, function(match, linkText, url) {
                        const isExternal = url.startsWith('http://') || url.startsWith('https://');
                        if (isExternal) {
                            return `<a href="${url}" class="chat-link" target="_blank" rel="noopener noreferrer">${linkText}</a>`;
                        } else {
                            return `<a href="${url}" class="chat-link" onclick="event.stopPropagation(); window.location.href='${url}'; return false;">${linkText}</a>`;
                        }
                    })
                    // Bold: **text** or __text__
                    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
                    .replace(/__(.+?)__/g, '<strong>$1</strong>')
                    // Italic: *text* or _text_
                    .replace(/\*(.+?)\*/g, '<em>$1</em>')
                    .replace(/_(.+?)_/g, '<em>$1</em>')
                    // Strikethrough: ~~text~~
                    .replace(/~~(.+?)~~/g, '<del>$1</del>')
                    // Line breaks
                    .replace(/\n/g, '<br>')
                    // Bullet points: • or -
                    .replace(/^[•\-]\s+/gm, '<span class="bullet-point">•</span> ');
            }

            function playNotificationSound() {
                try {
                    const audioContext = new (window.AudioContext || window.webkitAudioContext)();
                    const oscillator = audioContext.createOscillator();
                    const gainNode = audioContext.createGain();
                    oscillator.connect(gainNode);
                    gainNode.connect(audioContext.destination);
                    oscillator.frequency.value = 800;
                    oscillator.type = 'sine';
                    gainNode.gain.value = 0.1;
                    oscillator.start();
                    oscillator.stop(audioContext.currentTime + 0.1);
                } catch (e) { }
            }

            // Global function for feedback
            window.submitFeedback = async function(btnElement, messageId, wasHelpful) {
                try {
                    const feedbackContainer = btnElement.closest('.message-feedback');
                    const allBtns = feedbackContainer.querySelectorAll('.feedback-btn');
                    allBtns.forEach(btn => btn.disabled = true);

                    await connection.invoke("SubmitMessageFeedback", messageId, aiSessionId > 0 ? aiSessionId : null, wasHelpful, null);

                    // Replace buttons with feedback response message
                    const responseMessage = wasHelpful
                        ? '<span class="feedback-response positive"><i class="fas fa-check-circle"></i> ধন্যবাদ! আপনার মতামত আমাদের উন্নত হতে সাহায্য করবে।</span>'
                        : '<span class="feedback-response negative"><i class="fas fa-heart"></i> দুঃখিত! আমরা আরও ভালো করার চেষ্টা করব।</span>';
                    feedbackContainer.innerHTML = responseMessage;
                } catch (err) {
                    console.error("Error submitting feedback:", err);
                    const feedbackContainer = btnElement.closest('.message-feedback');
                    if (feedbackContainer) {
                        const allBtns = feedbackContainer.querySelectorAll('.feedback-btn');
                        allBtns.forEach(btn => btn.disabled = false);
                    }
                }
            };

            // Load seller stats if user is a seller
            @if (isSeller)
            {
                <text>loadSellerQuickStats();</text>
            }

            // Initialize when page loads
            initConnection();

            // Seller stats loading function
            async function loadSellerQuickStats() {
                try {
                    const response = await fetch('/Customer/HelpCenter/GetSellerOrderSummary');
                    const result = await response.json();

                    const statsBody = document.getElementById('quickStatsBody');
                    if (result.success && result.data) {
                        const data = result.data;
                        statsBody.innerHTML = `
                            <div class="stat-item">
                                <span class="stat-label">আজকের অর্ডার</span>
                                <span class="stat-value text-primary">${data.todayOrders || 0}</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">পেন্ডিং</span>
                                <span class="stat-value text-warning">${data.pendingOrders || 0}</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">প্রসেসিং</span>
                                <span class="stat-value text-info">${data.processingOrders || 0}</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">আজকের সেলস</span>
                                <span class="stat-value text-success">৳${(data.todayRevenue || 0).toLocaleString()}</span>
                            </div>
                        `;
                    } else {
                        statsBody.innerHTML = `
                            <div class="text-center text-muted py-2">
                                <i class="fas fa-info-circle me-1"></i>ডাটা লোড হয়নি
                            </div>
                        `;
                    }
                } catch (err) {
                    console.error('Error loading seller stats:', err);
                    document.getElementById('quickStatsBody').innerHTML = `
                        <div class="text-center text-muted py-2">
                            <i class="fas fa-exclamation-circle me-1"></i>এরর
                        </div>
                    `;
                }
            }

            // Refresh seller stats every 5 minutes
            @if (isSeller)
            {
                <text>setInterval(loadSellerQuickStats, 5 * 60 * 1000);</text>
            }
        })();

        // Global function for minimize button
        function toggleMinimizeChat() {
            const chatInterface = document.getElementById('chatInterface');
            const minimizeBtn = document.getElementById('minimizeChat');

            if (chatInterface.classList.contains('chat-minimized')) {
                chatInterface.classList.remove('chat-minimized');
                minimizeBtn.innerHTML = '<i class="fas fa-minus" id="minimizeIcon"></i>';
                minimizeBtn.title = 'Minimize';
            } else {
                chatInterface.classList.add('chat-minimized');
                minimizeBtn.innerHTML = '<i class="fas fa-plus" id="minimizeIcon"></i>';
                minimizeBtn.title = 'Expand';
            }
        }

        // jQuery Star Rating - helper functions
        function getSelectedRating() {
            return parseInt($('#selectedRating').val()) || 0;
        }

        function resetRatingStarsDisplay() {
            $('#selectedRating').val('0');
            $('#starRating .star').removeClass('selected hovered');
        }

        function updateStarDisplay(rating) {
            $('#starRating .star').each(function() {
                var starValue = parseInt($(this).data('value'));
                if (starValue <= rating) {
                    $(this).addClass('selected');
                } else {
                    $(this).removeClass('selected');
                }
            });
        }

        // Initialize star rating event handlers
        $(function() {
            // Click event - select rating
            $('#starRating .star').on('click', function() {
                var rating = parseInt($(this).data('value'));
                $('#selectedRating').val(rating);
                $('#starRating .star').removeClass('selected hovered');
                updateStarDisplay(rating);
                console.log('Star selected:', rating);
            });

            // Hover event - highlight stars
            $('#starRating .star').on('mouseenter', function() {
                var hoverValue = parseInt($(this).data('value'));
                $('#starRating .star').each(function() {
                    var starValue = parseInt($(this).data('value'));
                    if (starValue <= hoverValue) {
                        $(this).addClass('hovered');
                    } else {
                        $(this).removeClass('hovered');
                    }
                });
            });

            // Mouse leave - restore selected state
            $('#starRating').on('mouseleave', function() {
                $('#starRating .star').removeClass('hovered');
                var currentRating = getSelectedRating();
                updateStarDisplay(currentRating);
            });
        });

        function submitChatRating() {
            var rating = getSelectedRating();
            if (rating === 0) {
                alertify.warning('অনুগ্রহ করে একটি রেটিং সিলেক্ট করুন');
                return;
            }

            var feedback = document.getElementById('chatFeedback').value;
            var submitBtn = document.getElementById('submitRatingBtn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Submitting...';

            console.log('Rating submitted:', rating);

            // Show success message and reset
            alertify.success('ধন্যবাদ আপনার মতামতের জন্য!');

            // Reset after a short delay
            setTimeout(function() {
                // Reset the rating form
                resetRatingStarsDisplay();
                document.getElementById('chatFeedback').value = '';
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-check me-2"></i>Submit Rating';

                // Hide rating section and show start form
                document.getElementById('chatRating').classList.add('d-none');
                document.getElementById('chatInterface').classList.add('d-none');
                document.getElementById('startChatForm').classList.remove('d-none');
            }, 1000);
        }

        function skipChatRating() {
            // Reset and go back to start form
            resetRatingStarsDisplay();
            document.getElementById('chatFeedback').value = '';

            document.getElementById('chatRating').classList.add('d-none');
            document.getElementById('chatInterface').classList.add('d-none');
            document.getElementById('startChatForm').classList.remove('d-none');
        }
    </script>
}
