@using Bangaliyana.Models
@{
    ViewData["Title"] = Localizer["LiveChatSupport"].Value;
    var siteSettings = ViewBag.SiteSettings as SiteSettings;
    var userName = ViewBag.UserName as string;
    var userEmail = ViewBag.UserEmail as string;
    var existingSession = ViewBag.ExistingSession as SupportChatSession;

    // Role detection
    var userRole = ViewBag.UserRole as string ?? "Customer";
    var isSeller = ViewBag.IsSeller as bool? ?? false;
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
    var isModerator = ViewBag.IsModerator as bool? ?? false;
    var shopName = ViewBag.ShopName as string;
    var sellerGreeting = ViewBag.SellerGreeting as string;
    var sellerId = ViewBag.SellerId;
}

<div class="live-chat-page">
    <!-- Header -->
    <section class="chat-header py-4 bg-gradient-primary text-white">
        <div class="container">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb breadcrumb-light">
                    <li class="breadcrumb-item"><a asp-area="Customer" asp-controller="Home" asp-action="Index">@Localizer["Home"]</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">@Localizer["HelpCenter"]</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Localizer["LiveChat"]</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold mb-2">
                <i class="fas fa-robot me-2"></i>@Localizer["AIChatAssistant"]
                @if (isSeller)
                {
                    <span class="badge bg-success ms-2">@Localizer["Seller"]</span>
                }
                else if (isAdmin)
                {
                    <span class="badge bg-danger ms-2">@Localizer["Admin"]</span>
                }
                else if (isModerator)
                {
                    <span class="badge bg-warning ms-2">@Localizer["Moderator"]</span>
                }
            </h1>
            <p class="mb-0 header-subtitle">
                @if (isSeller && !string.IsNullOrEmpty(shopName))
                {
                    <text><i class="fas fa-store me-1"></i>@shopName - আপনার ব্যবসার সহকারী</text>
                }
                else
                {
                    <text>আমি আপনার বাংলালিয়ানা সহকারী - আমাকে যেকোনো প্রশ্ন করুন!</text>
                }
            </p>
        </div>
    </section>

    <div class="container py-4">
        <div class="row">
            <div class="col-lg-8">
                <!-- Chat Container -->
                <div class="chat-container" id="chatContainer">
                    <!-- Start Chat Form -->
                    <div id="startChatForm" class="start-chat-section @(existingSession != null ? "d-none" : "")">
                        <div class="start-chat-header text-center mb-4">
                            <div class="chat-avatar mb-3">
                                <i class="fas fa-robot"></i>
                            </div>
                            <h4>@Localizer["StartAIChat"]</h4>
                            <p class="text-muted">@Localizer["AIAssistantAvailable247"]</p>
                        </div>

                        <form id="initChatForm" class="chat-form" novalidate>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="visitorName" class="form-label">@Localizer["YourName"] *</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="fas fa-user"></i></span>
                                            <input type="text" class="form-control" id="visitorName"
                                                   placeholder="@Localizer["EnterYourName"]" value="@userName"
                                                   data-required="true" data-error-msg="@Localizer["PleaseEnterYourName"]">
                                        </div>
                                        <div class="invalid-feedback" id="visitorName-error"></div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="visitorEmail" class="form-label">@Localizer["EmailAddress"] *</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                            <input type="email" class="form-control" id="visitorEmail"
                                                   placeholder="@Localizer["EnterYourEmail"]" value="@userEmail"
                                                   data-required="true" data-type="email" data-error-msg="@Localizer["PleaseEnterYourEmail"]" data-email-error="@Localizer["EnterValidEmail"]">
                                        </div>
                                        <div class="invalid-feedback" id="visitorEmail-error"></div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-group">
                                        <label for="chatDepartment" class="form-label">@Localizer["Department"] *</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="fas fa-building"></i></span>
                                            <select class="form-select" id="chatDepartment"
                                                    data-required="true" data-error-msg="@Localizer["PleaseSelectDepartment"]">
                                                <option value="">@Localizer["SelectDepartment"]</option>
                                                <option value="General">@Localizer["GeneralInquiry"]</option>
                                                <option value="Sales">@Localizer["Sales"]</option>
                                                <option value="Support" selected>@Localizer["TechnicalSupport"]</option>
                                                <option value="Complaint">@Localizer["Complaint"]</option>
                                                <option value="Other">@Localizer["Other"]</option>
                                            </select>
                                        </div>
                                        <div class="invalid-feedback" id="chatDepartment-error"></div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-group">
                                        <label for="initialQuery" class="form-label">@Localizer["HowCanWeHelpOptional"]</label>
                                        <textarea class="form-control" id="initialQuery" placeholder="@Localizer["DescribeYourIssue"]"
                                                  rows="4"></textarea>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="btn btn-primary btn-lg w-100" id="startChatBtn">
                                        <i class="fas fa-robot me-2"></i>@Localizer["StartAIChat"]
                                    </button>
                                </div>
                            </div>
                        </form>

                        <div class="chat-availability mt-4 text-center" id="chatAvailability">
                            <div class="availability-status online">
                                <span class="status-dot"></span>
                                <span>@Localizer["AIAssistantOnline247"]</span>
                            </div>
                        </div>
                    </div>

                    <!-- Active Chat Interface -->
                    <div id="chatInterface" class="chat-interface @(existingSession == null ? "d-none" : "")">
                        <!-- Chat Header -->
                        <div class="chat-header-bar">
                            <div class="chat-header-info">
                                <div class="agent-avatar" id="agentAvatar">
                                    <img src="/images/Emon.jpg" alt="Bot" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">
                                </div>
                                <div class="agent-details">
                                    <h6 class="mb-0" id="agentName">বাংলালিয়ানা সহকারী</h6>
                                    <span class="status-text" id="chatStatus">
                                        <span class="status-dot-small online"></span>
                                        Online
                                    </span>
                                </div>
                            </div>
                            <div class="chat-actions">
                                <button class="btn btn-sm btn-outline-light" id="requestHumanBtn" title="@Localizer["RequestHumanAgent"]">
                                    <i class="fas fa-user-tie"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-light" id="minimizeChat" title="@Localizer["Minimize"]" onclick="toggleMinimizeChat()">
                                    <i class="fas fa-minus" id="minimizeIcon"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" id="endChatBtn" title="@Localizer["EndChat"]">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Messages Area -->
                        <div class="chat-messages" id="chatMessages">
                            <!-- Messages will be loaded here -->
                            <div class="system-message">
                                <p>@Localizer["WelcomeToLiveChat"]</p>
                            </div>
                        </div>

                        <!-- Typing Indicator -->
                        <div class="typing-indicator d-none" id="typingIndicator">
                            <span class="typing-dots">
                                <span></span>
                                <span></span>
                                <span></span>
                            </span>
                            <span class="typing-text">@Localizer["AIIsThinking"]</span>
                        </div>

                        <!-- Quick Replies -->
                        <div class="quick-replies-container d-none" id="quickReplies">
                            <!-- Quick replies will be loaded here -->
                        </div>

                        <!-- Message Input -->
                        <div class="chat-input-area">
                            <form id="messageForm">
                                <div class="input-group">
                                    <input type="text" class="form-control" id="messageInput"
                                           placeholder="@Localizer["TypeYourMessagePlaceholder"]" autocomplete="off">
                                    <button type="submit" class="btn btn-primary" id="sendMessageBtn">
                                        <i class="fas fa-paper-plane"></i>
                                    </button>
                                </div>
                            </form>
                            <div class="input-hints mt-2">
                                <small class="text-muted">
                                    <i class="fas fa-lightbulb me-1"></i>
                                    @Localizer["ChatLanguageTip"]
                                </small>
                            </div>
                        </div>
                    </div>

                    <!-- Chat Rating (shown after chat ends) -->
                    <div id="chatRating" class="chat-rating d-none">
                        <div class="text-center py-4">
                            <div class="rating-icon mb-3">
                                <i class="fas fa-star"></i>
                            </div>
                            <h4>@Localizer["RateYourExperience"]</h4>
                            <p class="text-muted mb-4">@Localizer["HowWasYourExperience"]</p>
                            <div class="star-rating mb-4" id="starRating">
                                <span class="star" data-value="1">★</span>
                                <span class="star" data-value="2">★</span>
                                <span class="star" data-value="3">★</span>
                                <span class="star" data-value="4">★</span>
                                <span class="star" data-value="5">★</span>
                            </div>
                            <input type="hidden" id="selectedRating" value="0" />
                            <div class="mb-4">
                                <textarea class="form-control" id="chatFeedback" placeholder="@Localizer["AdditionalFeedbackOptional"]"
                                          rows="3"></textarea>
                            </div>
                            <button class="btn btn-primary" id="submitRatingBtn" onclick="submitChatRating()">
                                <i class="fas fa-check me-2"></i>@Localizer["SubmitRating"]
                            </button>
                            <button class="btn btn-outline-secondary ms-2" id="skipRatingBtn" onclick="skipChatRating()">@Localizer["Skip"]</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                @if (isSeller)
                {
                    <!-- Seller Quick Stats -->
                    <div class="sidebar-card mb-4" id="sellerQuickStats">
                        <div class="sidebar-header">
                            <i class="fas fa-chart-pie text-primary me-2"></i>
                            আজকের সামারি
                        </div>
                        <div class="sidebar-body" id="quickStatsBody">
                            <div class="d-flex justify-content-center py-3">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Seller Topics -->
                    <div class="sidebar-card mb-4">
                        <div class="sidebar-header">
                            <i class="fas fa-fire text-danger me-2"></i>
                            সেলার সাপোর্ট
                        </div>
                        <div class="sidebar-body">
                            <div class="popular-topics">
                                <button class="topic-btn" data-message="আজকের অর্ডার দেখাও">
                                    <i class="fas fa-shopping-cart"></i>
                                    <span>আজকের অর্ডার</span>
                                </button>
                                <button class="topic-btn" data-message="পেন্ডিং অর্ডার দেখাও">
                                    <i class="fas fa-clock"></i>
                                    <span>পেন্ডিং</span>
                                </button>
                                <button class="topic-btn" data-message="এই মাসের সেলস">
                                    <i class="fas fa-chart-line"></i>
                                    <span>সেলস রিপোর্ট</span>
                                </button>
                                <button class="topic-btn" data-message="পেমেন্ট কবে পাবো">
                                    <i class="fas fa-wallet"></i>
                                    <span>পেমেন্ট</span>
                                </button>
                                <button class="topic-btn" data-message="কম স্টক পণ্য দেখাও">
                                    <i class="fas fa-exclamation-triangle"></i>
                                    <span>স্টক এলার্ট</span>
                                </button>
                                <button class="topic-btn" data-message="কিভাবে সেলস বাড়াবো">
                                    <i class="fas fa-lightbulb"></i>
                                    <span>টিপস</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Seller Quick Links -->
                    <div class="other-options">
                        <a asp-area="Seller" asp-controller="Order" asp-action="Index" class="alt-option">
                            <i class="fas fa-shopping-bag text-primary"></i>
                            <div>
                                <h6>অর্ডার ম্যানেজ</h6>
                                <small class="text-muted">সব অর্ডার দেখুন</small>
                            </div>
                        </a>
                        <a asp-area="Seller" asp-controller="Product" asp-action="Index" class="alt-option">
                            <i class="fas fa-boxes text-success"></i>
                            <div>
                                <h6>প্রোডাক্ট</h6>
                                <small class="text-muted">স্টক ম্যানেজ</small>
                            </div>
                        </a>
                        <a asp-area="Seller" asp-controller="Dashboard" asp-action="Index" class="alt-option">
                            <i class="fas fa-tachometer-alt text-info"></i>
                            <div>
                                <h6>ড্যাশবোর্ড</h6>
                                <small class="text-muted">পূর্ণ ড্যাশবোর্ড</small>
                            </div>
                        </a>
                    </div>
                }
                else
                {
                    <!-- Customer Popular Topics -->
                    <div class="sidebar-card mb-4">
                        <div class="sidebar-header">
                            <i class="fas fa-fire text-danger me-2"></i>
                            @Localizer["PopularTopics"]
                        </div>
                        <div class="sidebar-body">
                            <div class="popular-topics">
                                <button class="topic-btn" data-message="আমার অর্ডার ট্র্যাক করুন">
                                    <i class="fas fa-truck"></i>
                                    <span>@Localizer["TrackOrder"]</span>
                                </button>
                                <button class="topic-btn" data-message="পণ্য দেখাও">
                                    <i class="fas fa-search"></i>
                                    <span>@Localizer["FindProducts"]</span>
                                </button>
                                <button class="topic-btn" data-message="কোন কুপন আছে?">
                                    <i class="fas fa-tags"></i>
                                    <span>@Localizer["FindCoupons"]</span>
                                </button>
                                <button class="topic-btn" data-message="রিটার্ন পলিসি কি?">
                                    <i class="fas fa-undo"></i>
                                    <span>@Localizer["ReturnPolicy"]</span>
                                </button>
                                <button class="topic-btn" data-message="পেমেন্ট মেথড কি কি?">
                                    <i class="fas fa-credit-card"></i>
                                    <span>@Localizer["PaymentMethods"]</span>
                                </button>
                                <button class="topic-btn" data-message="ডেলিভারি কত দিনে হয়">
                                    <i class="fas fa-shipping-fast"></i>
                                    <span>@Localizer["DeliveryTime"]</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Alternative Options -->
                    <div class="other-options">
                        <a asp-action="FAQ" class="alt-option">
                            <i class="fas fa-question-circle text-primary"></i>
                            <div>
                                <h6>@Localizer["FAQs"]</h6>
                                <small class="text-muted">@Localizer["FindQuickAnswers"]</small>
                            </div>
                        </a>
                        <a asp-action="Contact" class="alt-option">
                            <i class="fas fa-envelope text-success"></i>
                            <div>
                                <h6>@Localizer["EmailUs"]</h6>
                                <small class="text-muted">@Localizer["ResponseWithin24Hours"]</small>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- End Chat Confirmation Modal -->
<div class="modal fade" id="endChatModal" tabindex="-1" aria-labelledby="endChatModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content confirm-modal-content">
            <button type="button" class="btn-close confirm-modal-close" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="modal-body text-center">
                <div class="confirm-icon-wrapper">
                    <div class="confirm-icon-circle confirm-icon-warning">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                </div>
                <h5 class="mt-3 mb-2">@Localizer["EndChatQuestion"]</h5>
                <p class="text-muted mb-0">@Localizer["EndChatConfirmMessage"]</p>
            </div>
            <div class="modal-footer justify-content-center border-0 pt-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>@Localizer["Cancel"]
                </button>
                <button type="button" class="btn btn-danger" id="confirmEndChatBtn">
                    <i class="fas fa-sign-out-alt me-1"></i>@Localizer["YesEndChat"]
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Request Human Agent Modal -->
<div class="modal fade" id="requestHumanModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-user-tie me-2"></i>@Localizer["ConnectToHumanAgent"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>@Localizer["WhyConnectToHumanAgent"]</p>
                <div class="mb-3">
                    <textarea class="form-control" id="handoffReason" rows="3" placeholder="@Localizer["DescribeYourProblemOptional"]"></textarea>
                </div>
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    @Localizer["ChatHistoryWillBeShared"]
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <button type="button" class="btn btn-primary" id="confirmHandoffBtn">
                    <i class="fas fa-user-tie me-2"></i>@Localizer["ConnectNow"]
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .breadcrumb-light .breadcrumb-item a {
        color: rgba(255, 255, 255, 0.8);
    }

    .breadcrumb-light .breadcrumb-item.active {
        color: #fff;
    }

    .breadcrumb-light .breadcrumb-item + .breadcrumb-item::before {
        color: rgba(255, 255, 255, 0.6);
    }

    /* Header Subtitle - Better visibility on gradient */
    .header-subtitle {
        color: #fff;
        font-size: 1.05rem;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
        letter-spacing: 0.3px;
    }

    .chat-container {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        border: 1px solid #e5e7eb;
    }

    .start-chat-section {
        padding: 2.5rem;
    }

    .chat-form .form-group {
        margin-bottom: 0;
    }

    .chat-form .invalid-feedback {
        display: none;
        font-size: 0.875rem;
        color: #dc3545;
        margin-top: 0.25rem;
        padding-left: 0.25rem;
    }

    .chat-form .invalid-feedback.show {
        display: block;
    }

    .chat-form .form-control.is-invalid,
    .chat-form .form-select.is-invalid {
        border-color: #dc3545;
    }

    .chat-form .input-group .form-control.is-invalid,
    .chat-form .input-group .form-select.is-invalid {
        border-color: #dc3545;
        box-shadow: none;
    }

    .chat-form .input-group .form-control.is-invalid:focus,
    .chat-form .input-group .form-select.is-invalid:focus {
        box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.15);
    }

    .chat-form .form-label {
        font-weight: 500;
        color: #374151;
        margin-bottom: 0.5rem;
    }

    .chat-form .input-group-text {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: #fff;
    }

    .chat-form .form-control,
    .chat-form .form-select {
        border-radius: 0 10px 10px 0;
        border: 1px solid #e5e7eb;
    }

    .chat-form .input-group .form-control,
    .chat-form .input-group .form-select {
        border-left: none;
    }

    .chat-form .form-control:focus,
    .chat-form .form-select:focus {
        border-color: var(--bs-primary);
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
    }

    .chat-form textarea.form-control {
        border-radius: 10px;
        border: 1px solid #e5e7eb;
    }

    .chat-avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        animation: pulse-glow 2s infinite;
    }

    @@keyframes pulse-glow {
        0%, 100% { box-shadow: 0 0 0 0 rgba(102, 126, 234, 0.4); }
        50% { box-shadow: 0 0 20px 5px rgba(102, 126, 234, 0.2); }
    }

    .chat-avatar i {
        font-size: 2rem;
        color: #fff;
    }

    .availability-status {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border-radius: 50px;
        font-size: 0.9rem;
    }

    .availability-status.online {
        background: #ecfdf5;
        color: #059669;
    }

    .status-dot, .status-dot-small {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #10b981;
        animation: pulse 2s infinite;
    }

    .status-dot-small {
        width: 8px;
        height: 8px;
        display: inline-block;
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
    }

    .chat-interface {
        display: flex;
        flex-direction: column;
        height: 650px;
        transition: height 0.3s ease;
    }

    .chat-interface.chat-minimized {
        height: auto;
    }

    .chat-interface.chat-minimized .chat-messages,
    .chat-interface.chat-minimized .chat-input-area,
    .chat-interface.chat-minimized .typing-indicator,
    .chat-interface.chat-minimized .quick-replies-container {
        display: none !important;
    }

    .chat-header-bar {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        padding: 1rem 1.5rem;
