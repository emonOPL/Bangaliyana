@model List<Bangaliyana.Models.SellerConversation>
@using Bangaliyana.Extensions

@{
    ViewData["Title"] = Localizer["Messages"];
    var unreadCount = ViewBag.UnreadCount ?? 0;
    var currentFilter = ViewBag.CurrentFilter as string ?? "all";
    var searchQuery = ViewBag.SearchQuery as string;
    var totalCount = ViewBag.TotalCount ?? 0;
    var archivedCount = ViewBag.ArchivedCount ?? 0;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <!-- Header with Title and Stats -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
                <div>
                    <h2 class="text-primary mb-1">
                        <i class="fas fa-comments me-2"></i>@Localizer["Messages"]
                    </h2>
                    <p class="text-muted mb-0 small">
                        @Localizer["ConversationsCount", totalCount]
                        @if (unreadCount > 0)
                        {
                            <span class="badge bg-danger ms-1">@Localizer["UnreadCount", unreadCount]</span>
                        }
                    </p>
                </div>

                <!-- Search Box -->
                <form method="get" class="d-flex gap-2" style="min-width: 300px;">
                    <input type="hidden" name="filter" value="@currentFilter" />
                    <div class="input-group">
                        <span class="input-group-text bg-transparent">
                            <i class="fas fa-search text-muted"></i>
                        </span>
                        <input type="text" name="search" class="form-control"
                               placeholder="@Localizer["SearchConversations"]"
                               value="@searchQuery" />
                        @if (!string.IsNullOrEmpty(searchQuery))
                        {
                            <a href="@Url.Action("Index", new { filter = currentFilter })" class="btn btn-outline-secondary">
                                <i class="fas fa-times"></i>
                            </a>
                        }
                        <button type="submit" class="btn btn-primary">@Localizer["Search"]</button>
                    </div>
                </form>
            </div>

            @if (TempData["success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Filter Tabs -->
            <ul class="nav nav-pills mb-4 flex-nowrap overflow-auto">
                <li class="nav-item">
                    <a class="nav-link @(currentFilter == "all" ? "active" : "")"
                       href="@Url.Action("Index", new { filter = "all", search = searchQuery })">
                        <i class="fas fa-inbox me-1"></i>@Localizer["All"]
                        <span class="badge bg-light text-dark ms-1">@totalCount</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentFilter == "unread" ? "active" : "")"
                       href="@Url.Action("Index", new { filter = "unread", search = searchQuery })">
                        <i class="fas fa-envelope me-1"></i>@Localizer["Unread"]
                        @if (unreadCount > 0)
                        {
                            <span class="badge bg-danger ms-1">@unreadCount</span>
                        }
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentFilter == "archived" ? "active" : "")"
                       href="@Url.Action("Index", new { filter = "archived", search = searchQuery })">
                        <i class="fas fa-archive me-1"></i>@Localizer["Archived"]
                        @if (archivedCount > 0)
                        {
                            <span class="badge bg-secondary ms-1">@archivedCount</span>
                        }
                    </a>
                </li>
            </ul>

            <!-- Search Results Info -->
            @if (!string.IsNullOrEmpty(searchQuery))
            {
                <div class="alert alert-info d-flex align-items-center mb-4">
                    <i class="fas fa-search me-2"></i>
                    <span>
                        @Localizer["ShowingResultsFor"] "<strong>@searchQuery</strong>"
                        - @Localizer["ConversationsFound", Model.Count]
                    </span>
                    <a href="@Url.Action("Index", new { filter = currentFilter })" class="btn btn-sm btn-outline-info ms-auto">
                        @Localizer["ClearSearch"]
                    </a>
                </div>
            }

            @if (Model.Any())
            {
                <div class="row">
                    @foreach (var conversation in Model)
                    {
                        var lastMessage = conversation.Messages?.FirstOrDefault();
                        var hasUnread = conversation.UnreadCountBuyer > 0;
                        var isArchived = conversation.IsArchived;

                        <div class="col-lg-6 col-xl-4 mb-4">
                            <div class="card conversation-card border-0 shadow-sm h-100 @(hasUnread ? "has-unread" : "") @(isArchived ? "archived" : "")">
                                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-start">
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(conversation.Seller?.ShopLogoUrl))
                                        {
                                            <img src="@conversation.Seller.ShopLogoUrl" alt="@conversation.Seller.ShopName" class="avatar-circle me-2" style="object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="avatar-circle bg-primary text-white me-2">
                                                @(conversation.Seller?.ShopName?.Substring(0, 1).ToUpper() ?? "S")
                                            </div>
                                        }
                                        <div>
                                            <h6 class="mb-0 fw-bold">@(conversation.Seller?.ShopName ?? Localizer["Seller"])</h6>
                                            <small class="text-muted">
                                                @if (lastMessage != null)
                                                {
                                                    @GetTimeAgo(lastMessage.CreatedAt)
                                                }
                                                else
                                                {
                                                    @conversation.CreatedAt.ToBangladeshShortDateString()
                                                }
                                            </small>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (hasUnread)
                                        {
                                            <span class="badge bg-primary rounded-pill">@conversation.UnreadCountBuyer</span>
                                        }
                                        @if (isArchived)
                                        {
                                            <span class="badge bg-secondary"><i class="fas fa-archive"></i></span>
                                        }
                                        <!-- Dropdown menu -->
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-link text-muted p-0" type="button" data-bs-toggle="dropdown">
                                                <i class="fas fa-ellipsis-v"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li>
                                                    <a class="dropdown-item" asp-action="Conversation" asp-route-id="@conversation.Id">
                                                        <i class="fas fa-envelope-open me-2"></i>@Localizer["View"]
                                                    </a>
                                                </li>
                                                @if (!isArchived)
                                                {
                                                    <li>
                                                        <form asp-action="ArchiveConversation" asp-route-id="@conversation.Id" method="post" class="archive-form">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="dropdown-item">
                                                                <i class="fas fa-archive me-2"></i>@Localizer["Archive"]
                                                            </button>
                                                        </form>
                                                    </li>
                                                }
                                                else
                                                {
                                                    <li>
                                                        <form asp-action="UnarchiveConversation" asp-route-id="@conversation.Id" method="post" class="unarchive-form">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="dropdown-item">
                                                                <i class="fas fa-inbox me-2"></i>@Localizer["Unarchive"]
                                                            </button>
                                                        </form>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body pt-0">
                                    @if (!string.IsNullOrEmpty(conversation.Subject))
                                    {
                                        <h6 class="text-primary mb-2 subject-line">
                                            <i class="fas fa-tag me-1"></i>@conversation.Subject
                                        </h6>
                                    }

                                    <div class="d-flex flex-wrap gap-1 mb-2">
                                        @if (conversation.Order != null)
                                        {
                                            <span class="badge bg-info-subtle text-info">
                                                <i class="fas fa-shopping-bag me-1"></i>@Localizer["OrderNumber", conversation.Order.OrderNumber]
                                            </span>
                                        }
                                        @if (conversation.Product != null)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">
                                                <i class="fas fa-box me-1"></i>@(conversation.Product.Name.Length > 20 ? conversation.Product.Name.Substring(0, 17) + "..." : conversation.Product.Name)
                                            </span>
                                        }
                                    </div>

                                    @if (lastMessage != null)
                                    {
                                        <p class="text-muted small mb-0 last-message">
                                            @if (lastMessage.IsSentBySeller)
                                            {
                                                <i class="fas fa-store text-primary me-1"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-user text-success me-1"></i>
                                                <span class="text-success">@Localizer["You"]:</span>
                                            }
                                            @if (lastMessage.MessageType == "shared_order")
                                            {
                                                <em><i class="fas fa-share me-1"></i>@Localizer["SharedAnOrder"]</em>
                                            }
                                            else if (lastMessage.MessageType == "shared_product")
                                            {
                                                <em><i class="fas fa-share me-1"></i>@Localizer["SharedAProduct"]</em>
                                            }
                                            else if (lastMessage.AttachmentUrl != null)
                                            {
                                                <em><i class="fas fa-paperclip me-1"></i>@Localizer["SentAnAttachment"]</em>
                                            }
                                            else
                                            {
                                                @(lastMessage.Message.Length > 80 ? lastMessage.Message.Substring(0, 77) + "..." : lastMessage.Message)
                                            }
                                        </p>
                                    }
                                </div>
                                <div class="card-footer bg-transparent border-0 pt-0">
                                    <a asp-action="Conversation" asp-route-id="@conversation.Id"
                                       class="btn @(hasUnread ? "btn-primary" : "btn-outline-primary") btn-sm w-100">
                                        <i class="fas fa-envelope-open me-1"></i>
                                        @(hasUnread ? Localizer["ViewNewMessages"] : Localizer["ViewConversation"])
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="display-1 text-muted mb-4">
                        @if (currentFilter == "unread")
                        {
                            <i class="fas fa-check-circle"></i>
                        }
                        else if (currentFilter == "archived")
                        {
                            <i class="fas fa-archive"></i>
                        }
                        else if (!string.IsNullOrEmpty(searchQuery))
                        {
                            <i class="fas fa-search"></i>
                        }
                        else
                        {
                            <i class="fas fa-comments"></i>
                        }
                    </div>
                    <h4 class="text-muted mb-3">
                        @if (currentFilter == "unread")
                        {
                            <span>@Localizer["NoUnreadMessages"]</span>
                        }
                        else if (currentFilter == "archived")
                        {
                            <span>@Localizer["NoArchivedConversations"]</span>
                        }
                        else if (!string.IsNullOrEmpty(searchQuery))
                        {
                            <span>@Localizer["NoResultsFoundForQuery", searchQuery]</span>
                        }
                        else
                        {
                            <span>@Localizer["NoMessagesYet"]</span>
                        }
                    </h4>
                    <p class="text-muted mb-4">
                        @if (currentFilter == "unread")
                        {
                            <span>@Localizer["AllCaughtUp"]</span>
                        }
                        else if (currentFilter == "archived")
                        {
                            <span>@Localizer["ArchivedConversationsAppearHere"]</span>
                        }
                        else if (!string.IsNullOrEmpty(searchQuery))
                        {
                            <span>@Localizer["TryDifferentKeywords"]</span>
                        }
                        else
                        {
                            <span>@Localizer["NoConversationsWithSellers"]</span>
                        }
                    </p>
                    @if (currentFilter != "all" || !string.IsNullOrEmpty(searchQuery))
                    {
                        <a asp-action="Index" class="btn btn-outline-primary me-2">
                            <i class="fas fa-inbox me-1"></i>@Localizer["ViewAllMessages"]
                        </a>
                    }
                    <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-primary">
                        <i class="fas fa-shopping-cart me-2"></i>@Localizer["ContinueShopping"]
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    private string GetTimeAgo(DateTime dateTime)
    {
        var timeSpan = DateTime.UtcNow - dateTime;

        if (timeSpan.TotalMinutes < 1)
            return Localizer["JustNow"];
        if (timeSpan.TotalMinutes < 60)
            return Localizer["MinutesAgo", (int)timeSpan.TotalMinutes];
        if (timeSpan.TotalHours < 24)
            return Localizer["HoursAgo", (int)timeSpan.TotalHours];
        if (timeSpan.TotalDays < 7)
            return Localizer["DaysAgo", (int)timeSpan.TotalDays];
        if (timeSpan.TotalDays < 30)
            return Localizer["WeeksAgo", (int)(timeSpan.TotalDays / 7)];

        return dateTime.ToBangladeshShortDateString();
    }
}

<style>
    .avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .conversation-card {
        transition: all 0.3s ease;
        border-left: 3px solid transparent !important;
    }

    .conversation-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }

    .conversation-card.has-unread {
        border-left: 3px solid var(--bs-primary) !important;
        background: linear-gradient(to right, rgba(99, 102, 241, 0.03), transparent);
    }

    .conversation-card.archived {
        opacity: 0.7;
    }

    .subject-line {
        font-size: 0.9rem;
    }

    .last-message {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 2.4em;
    }

    .nav-pills .nav-link {
        color: var(--text-color);
        border-radius: 20px;
        padding: 0.5rem 1rem;
        white-space: nowrap;
    }

    .nav-pills .nav-link.active {
        background-color: var(--primary-color);
        color: #ffffff !important;
    }

    .nav-pills .nav-link.active .badge {
        background-color: rgba(255, 255, 255, 0.25) !important;
        color: #ffffff !important;
    }

    .nav-pills .nav-link:not(.active):hover {
        background-color: var(--bg-secondary);
    }

    /* Dark mode */
    [data-theme="dark"] .nav-pills .nav-link:not(.active) .badge {
        background-color: #3d3d5c !important;
        color: #e0e0e0 !important;
    }

    [data-theme="dark"] .card {
        background-color: #252538;
    }

    [data-theme="dark"] .conversation-card.has-unread {
        background: linear-gradient(to right, rgba(99, 102, 241, 0.08), transparent);
    }

    [data-theme="dark"] .avatar-circle.bg-primary {
        background-color: #3699ff !important;
    }

    [data-theme="dark"] .input-group-text {
        background-color: #1e1e2d;
        border-color: #3d3d5c;
    }

    [data-theme="dark"] .form-control {
        background-color: #1e1e2d;
        border-color: #3d3d5c;
        color: #e0e0e0;
    }

    [data-theme="dark"] .dropdown-menu {
        background-color: #252538;
        border-color: #3d3d5c;
    }

    [data-theme="dark"] .dropdown-item {
        color: #e0e0e0;
    }

    [data-theme="dark"] .dropdown-item:hover {
        background-color: #1e1e2d;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .nav-pills {
            padding-bottom: 0.5rem;
            margin-bottom: 1rem !important;
        }
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Ensure form submission works inside Bootstrap dropdowns
            $('.archive-form button, .unarchive-form button').on('click', function(e) {
                e.stopPropagation();
                $(this).closest('form').submit();
            });
        });
    </script>
}
