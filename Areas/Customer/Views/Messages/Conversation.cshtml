@model List<Bangaliyana.Models.SellerMessage>
@using Bangaliyana.Extensions

@{
    var conversation = ViewBag.Conversation as Bangaliyana.Models.SellerConversation;
    var currentUserId = ViewBag.CurrentUserId as string;
    var userOrders = ViewBag.UserOrders as dynamic;
    ViewData["Title"] = Localizer["ConversationWith", conversation?.Seller?.ShopName ?? Localizer["Seller"]];
}

<div class="container mt-4">
    <div class="row">
        <!-- Main Chat Area -->
        <div class="col-lg-8">
            <!-- Back Button and Header -->
            <div class="chat-header d-flex align-items-center mb-3 p-3 rounded shadow-sm" style="background-color: var(--bg-color);">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div class="d-flex align-items-center flex-grow-1">
                    @if (!string.IsNullOrEmpty(conversation?.Seller?.ShopLogoUrl))
                    {
                        <img src="@conversation.Seller.ShopLogoUrl" alt="@conversation.Seller.ShopName" class="avatar-circle me-3">
                    }
                    else
                    {
                        <div class="avatar-circle bg-primary text-white me-3">
                            @(conversation?.Seller?.ShopName?.Substring(0, 1).ToUpper() ?? "S")
                        </div>
                    }
                    <div>
                        <h6 class="mb-0 fw-bold">@(conversation?.Seller?.ShopName ?? Localizer["Seller"])</h6>
                        @if (conversation?.Seller?.IsVerified == true)
                        {
                            <small class="text-success"><i class="fas fa-check-circle me-1"></i>@Localizer["VerifiedSeller"]</small>
                        }
                        else
                        {
                            <small class="text-muted">@Localizer["Seller"]</small>
                        }
                    </div>
                </div>
                <div class="btn-group btn-group-sm">
                    @if (conversation != null && !conversation.IsClosedByBuyer)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#closeConversationModal">
                            <i class="fas fa-times me-1"></i>@Localizer["Close"]
                        </button>
                    }
                </div>
            </div>

            @if (TempData["success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Context Info -->
            @if (!string.IsNullOrEmpty(conversation?.Subject) || conversation?.Order != null || conversation?.Product != null)
            {
                <div class="context-card p-3 mb-3 rounded shadow-sm">
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        @if (!string.IsNullOrEmpty(conversation?.Subject))
                        {
                            <span class="badge bg-primary-subtle text-primary">
                                <i class="fas fa-tag me-1"></i>@conversation.Subject
                            </span>
                        }
                        @if (conversation?.Order != null)
                        {
                            <a asp-area="Customer" asp-controller="Home" asp-action="OrderDetails" asp-route-id="@conversation.Order.Id"
                               class="badge bg-info-subtle text-info text-decoration-none">
                                <i class="fas fa-shopping-bag me-1"></i>@Localizer["OrderNumber", conversation.Order.Id]
                            </a>
                        }
                        @if (conversation?.Product != null)
                        {
                            <a asp-area="Customer" asp-controller="Home" asp-action="Details" asp-route-id="@conversation.Product.Id"
                               class="badge bg-secondary text-decoration-none">
                                <i class="fas fa-box me-1"></i>@conversation.Product.Name
                            </a>
                        }
                    </div>
                </div>
            }

            <!-- Unified Chatbox Container -->
            <div class="card border-0 shadow-sm chatbox-unified">
                <!-- Search Within Conversation - Integrated in chatbox header -->
                <div class="chatbox-search-bar">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-transparent border-0">
                            <i class="fas fa-search text-muted"></i>
                        </span>
                        <input type="text" id="messageSearch" class="form-control border-0"
                               placeholder="@Localizer["SearchInConversation"]" />
                        <span id="searchResults" class="input-group-text bg-transparent text-muted d-none border-0">
                            <span id="currentMatch">0</span>/<span id="totalMatches">0</span>
                        </span>
                        <button type="button" id="prevMatch" class="btn btn-sm btn-link text-muted d-none" title="@Localizer["PreviousMatch"]">
                            <i class="fas fa-chevron-up"></i>
                        </button>
                        <button type="button" id="nextMatch" class="btn btn-sm btn-link text-muted d-none" title="@Localizer["NextMatch"]">
                            <i class="fas fa-chevron-down"></i>
                        </button>
                        <button type="button" id="clearSearch" class="btn btn-sm btn-link text-muted d-none" title="@Localizer["ClearSearch"]">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>

                <!-- Messages Container -->
                <div class="chat-container" id="chatContainer">
                    @if (Model.Any())
                    {
                        var lastDate = DateTime.MinValue;
                        @foreach (var message in Model)
                        {
                            var bdMessageTime = message.CreatedAt.ToBangladeshTime();
                            // Date separator
                            if (bdMessageTime.Date != lastDate.Date)
                            {
                                lastDate = bdMessageTime;
                                <div class="date-separator my-3">
                                    <span>@message.CreatedAt.ToBangladeshDateString()</span>
                                </div>
                            }

                            var isMe = !message.IsSentBySeller; // Customer's messages are NOT from seller
                            var canEditDelete = isMe && !message.IsRead && !message.IsDeleted && (DateTime.UtcNow - message.CreatedAt).TotalMinutes <= 15;
                            <div class="d-flex @(isMe ? "justify-content-end" : "justify-content-start") mb-3 message-row" data-message-id="@message.Id">
                                @if (!isMe)
                                {
                                    <div class="message-avatar me-2">
                                        @if (!string.IsNullOrEmpty(conversation?.Seller?.ShopLogoUrl))
                                        {
                                            <img src="@conversation.Seller.ShopLogoUrl" alt="@conversation.Seller.ShopName" class="avatar-sm rounded-circle" style="object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="avatar-sm bg-primary text-white">
                                                @(conversation?.Seller?.ShopName?.Substring(0, 1).ToUpper() ?? "S")
                                            </div>
                                        }
                                    </div>
                                }
                                @if (isMe && canEditDelete)
                                {
                                    <div class="message-actions me-2 d-flex align-items-start dropdown">
                                        <button type="button" class="btn btn-sm btn-link text-muted p-1 message-menu-btn"
                                                data-bs-toggle="dropdown" aria-expanded="false" title="@Localizer["MessageOptions"]">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end message-dropdown shadow-sm">
                                            <li>
                                                <button type="button" class="dropdown-item"
                                                        onclick="openEditModal(@message.Id, '@Html.Raw(message.Message.Replace("'", "\\'").Replace("\n", "\\n").Replace("\r", ""))')">
                                                    <i class="fas fa-pencil-alt me-2 text-primary"></i>@Localizer["Edit"]
                                                </button>
                                            </li>
                                            <li>
                                                <button type="button" class="dropdown-item text-danger"
                                                        onclick="openDeleteModal(@message.Id)">
                                                    <i class="fas fa-trash-alt me-2"></i>@Localizer["Delete"]
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                }
                                <div class="chat-bubble @(isMe ? "chat-bubble-me" : "chat-bubble-other") @(message.IsDeleted ? "deleted-message" : "")">
                                    @if (message.IsDeleted)
                                    {
                                        <div class="message-content deleted-text">
                                            <i class="fas fa-ban me-1"></i>@Localizer["MessageWasDeleted"]
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- Shared Content -->
                                        @if (message.SharedOrderId.HasValue)
                                        {
                                            <div class="shared-content shared-order mb-2">
                                                <i class="fas fa-shopping-bag me-1"></i>
                                                <span>@Localizer["SharedOrderNumber", message.SharedOrderId]</span>
                                                <a asp-area="Customer" asp-controller="Home" asp-action="OrderDetails" asp-route-id="@message.SharedOrderId"
                                                   class="btn btn-sm btn-outline-light ms-2">@Localizer["View"]</a>
                                            </div>
                                        }
                                        @if (message.SharedProductId.HasValue)
                                        {
                                            <div class="shared-content shared-product mb-2">
                                                <i class="fas fa-box me-1"></i>
                                                <span>@Localizer["SharedProduct"]</span>
                                                <a asp-area="Customer" asp-controller="Home" asp-action="Details" asp-route-id="@message.SharedProductId"
                                                   class="btn btn-sm btn-outline-light ms-2">@Localizer["View"]</a>
                                            </div>
                                        }

                                        <div class="message-content">@message.Message</div>
                                        @if (message.IsEdited)
                                        {
                                            <small class="edited-indicator"><i class="fas fa-pencil-alt me-1"></i>@Localizer["Edited"]</small>
                                        }
                                    }

                                    @if (!string.IsNullOrEmpty(message.AttachmentUrl))
                                    {
                                        <div class="attachment-preview mt-2">
                                            @if (message.AttachmentUrl.EndsWith(".jpg") || message.AttachmentUrl.EndsWith(".jpeg") ||
                                                 message.AttachmentUrl.EndsWith(".png") || message.AttachmentUrl.EndsWith(".gif") ||
                                                 message.AttachmentUrl.EndsWith(".webp"))
                                            {
                                                <a href="@message.AttachmentUrl" target="_blank" data-lightbox="messages">
                                                    <img src="@message.AttachmentUrl" alt="@Localizer["Attachment"]" class="attachment-image">
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="@message.AttachmentUrl" target="_blank" class="attachment-file">
                                                    <i class="fas fa-file me-1"></i>@(message.AttachmentName ?? Localizer["DownloadFile"])
                                                </a>
                                            }
                                        </div>
                                    }

                                    <div class="message-time">
                                        @message.CreatedAt.ToBangladeshString("hh:mm tt")
                                        @if (isMe)
                                        {
                                            @if (message.IsRead)
                                            {
                                                <i class="fas fa-check-double text-info ms-1" title="@Localizer["Read"]"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-check ms-1" title="@Localizer["Sent"]"></i>
                                            }
                                        }
                                    </div>
                                </div>
                                @if (isMe)
                                {
                                    <div class="message-avatar ms-2">
                                        @if (!string.IsNullOrEmpty(ViewBag.UserAvatarUrl as string))
                                        {
                                            <img src="@ViewBag.UserAvatarUrl" alt="@ViewBag.UserFullName" class="avatar-sm rounded-circle" style="object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="avatar-sm bg-secondary text-white">
                                                <i class="fas fa-user"></i>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <i class="fas fa-comments fa-3x mb-3"></i>
                            <p>@Localizer["NoMessagesStartConversation"]</p>
                        </div>
                    }
                </div>

                <!-- Reply Form - Integrated in chatbox footer -->
                @if (conversation != null && !conversation.IsClosedByBuyer && !conversation.IsClosedBySeller)
                {
                    <div class="chatbox-input-area">
                        <form asp-action="SendMessage" method="post" enctype="multipart/form-data" id="messageForm">
                            <input type="hidden" name="conversationId" value="@conversation.Id" />
                            <input type="hidden" name="sharedOrderId" id="sharedOrderId" />
                            <input type="hidden" name="sharedProductId" id="sharedProductId" />

                            <!-- Attachment Preview -->
                            <div id="attachmentPreview" class="attachment-preview-container d-none mb-2">
                                <div class="d-flex align-items-center p-2 bg-light rounded">
                                    <i class="fas fa-paperclip me-2"></i>
                                    <span id="attachmentName" class="flex-grow-1"></span>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeAttachment()">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Shared Content Preview -->
                            <div id="sharedContentPreview" class="shared-preview-container d-none mb-2">
                                <div class="d-flex align-items-center p-2 bg-light rounded">
                                    <i id="sharedContentIcon" class="fas fa-share me-2"></i>
                                    <span id="sharedContentText" class="flex-grow-1"></span>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeSharedContent()">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="input-group">
                                <!-- Quick Actions Button -->
                                <div class="btn-group dropup">
                                    <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" title="@Localizer["QuickActions"]">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <button type="button" class="dropdown-item" onclick="openModalFromDropdown('shareOrderModal')">
                                                <i class="fas fa-shopping-bag me-2 text-info"></i>@Localizer["ShareOrder"]
                                            </button>
                                        </li>
                                        <li>
                                            <button type="button" class="dropdown-item" onclick="openModalFromDropdown('shareProductModal')">
                                                <i class="fas fa-box me-2 text-primary"></i>@Localizer["ShareProduct"]
                                            </button>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/SupportTickets">
                                                <i class="fas fa-ticket-alt me-2 text-warning"></i>@Localizer["CreateSupportTicket"]
                                            </a>
                                        </li>
                                        <li>
                                            <button type="button" class="dropdown-item text-danger" onclick="openModalFromDropdown('escalateModal')">
                                                <i class="fas fa-exclamation-triangle me-2"></i>@Localizer["EscalateToAdmin"]
                                            </button>
                                        </li>
                                    </ul>
                                </div>

                                <!-- Attachment Button -->
                                <label class="btn btn-outline-secondary" for="attachmentInput" title="@Localizer["AttachFile"]">
                                    <i class="fas fa-paperclip"></i>
                                </label>
                                <input type="file" name="attachment" id="attachmentInput" class="d-none"
                                       accept="image/*,.pdf,.doc,.docx" onchange="previewAttachment(this)">

                                <textarea name="message" class="form-control" rows="1" id="messageInput"
                                          placeholder="@Localizer["TypeYourMessage"]" required
                                          style="min-height: 44px; max-height: 120px; resize: none;"></textarea>
                                <button type="submit" class="btn btn-primary" title="@Localizer["SendMessage"]">
                                    <i class="fas fa-paper-plane"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                }
                else if (conversation?.IsClosedByBuyer == true)
                {
                    <div class="chatbox-closed-notice">
                        <i class="fas fa-lock me-2"></i>@Localizer["YouClosedConversation"]
                        <form asp-action="ReopenConversation" asp-route-id="@conversation.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-link p-0">@Localizer["Reopen"]</button>
                        </form>
                    </div>
                }
                else if (conversation?.IsClosedBySeller == true)
                {
                    <div class="chatbox-closed-notice">
                        <i class="fas fa-lock me-2"></i>@Localizer["SellerClosedConversation"]
                    </div>
                }
            </div>
        </div>

        <!-- Sidebar - Quick Info -->
        <div class="col-lg-4 d-none d-lg-block">
            <!-- Seller Info Card -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-transparent">
                    <h6 class="mb-0"><i class="fas fa-store me-2"></i>@Localizer["SellerInfo"]</h6>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        @if (!string.IsNullOrEmpty(conversation?.Seller?.ShopLogoUrl))
                        {
                            <img src="@conversation.Seller.ShopLogoUrl" alt="@conversation.Seller.ShopName" class="rounded me-3" style="width: 50px; height: 50px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="avatar-circle bg-primary text-white me-3" style="width: 50px; height: 50px;">
                                @(conversation?.Seller?.ShopName?.Substring(0, 1).ToUpper() ?? "S")
                            </div>
                        }
                        <div>
                            <h6 class="mb-0">@conversation?.Seller?.ShopName</h6>
                            @if (conversation?.Seller?.Rating > 0)
                            {
                                <small class="text-warning">
                                    <i class="fas fa-star"></i> @conversation.Seller.Rating.ToString("F1")
                                </small>
                            }
                        </div>
                    </div>
                    @if (conversation?.Product != null)
                    {
                        <hr>
                        <h6 class="small text-muted mb-2">@Localizer["RelatedProduct"].ToString().ToUpper()</h6>
                        <div class="d-flex align-items-center">
                            <img src="~/@(conversation.Product.ImageUrl ?? "images/products/noimage.jpg")"
                                 alt="@conversation.Product.Name" class="rounded me-2"
                                 style="width: 40px; height: 40px; object-fit: cover;">
                            <div class="small">
                                <div class="text-truncate" style="max-width: 150px;">@conversation.Product.Name</div>
                                <span class="text-primary fw-bold">৳@((conversation.Product.DiscountPrice ?? conversation.Product.Price).ToString("N0"))</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Quick Actions Card -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent">
                    <h6 class="mb-0"><i class="fas fa-bolt me-2"></i>@Localizer["QuickActions"]</h6>
                </div>
                <div class="card-body p-2">
                    <div class="list-group list-group-flush">
                        <button type="button" class="list-group-item list-group-item-action" data-bs-toggle="modal" data-bs-target="#shareOrderModal">
                            <i class="fas fa-shopping-bag me-2 text-info"></i>@Localizer["ShareAnOrder"]
                        </button>
                        <button type="button" class="list-group-item list-group-item-action" data-bs-toggle="modal" data-bs-target="#shareProductModal">
                            <i class="fas fa-box me-2 text-primary"></i>@Localizer["ShareAProduct"]
                        </button>
                        <a class="list-group-item list-group-item-action" asp-area="Identity" asp-page="/Account/Manage/SupportTickets">
                            <i class="fas fa-ticket-alt me-2 text-warning"></i>@Localizer["CreateSupportTicket"]
                        </a>
                        <button type="button" class="list-group-item list-group-item-action text-danger" data-bs-toggle="modal" data-bs-target="#escalateModal">
                            <i class="fas fa-exclamation-triangle me-2"></i>@Localizer["EscalateIssue"]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Share Order Modal -->
<div class="modal fade" id="shareOrderModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-shopping-bag me-2"></i>@Localizer["ShareOrder"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">@Localizer["SelectOrderToShare"]</p>
                <div class="list-group" id="orderList">
                    @if (userOrders != null && ((IEnumerable<dynamic>)userOrders).Any())
                    {
                        @foreach (var order in (IEnumerable<dynamic>)userOrders)
                        {
                            <button type="button" class="list-group-item list-group-item-action"
                                    onclick="selectOrder(@order.Id, '@Localizer["OrderNumber", order.OrderNumber] - ৳@((decimal)order.TotalAmount).ToString("N0")')">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@Localizer["OrderNumber", order.OrderNumber]</strong>
                                        <br><small class="text-muted">@((DateTime)order.OrderDate).ToBangladeshShortDateString()</small>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-secondary">@order.Status.GetDisplayName()</span>
                                        <br><small class="fw-bold">৳@((decimal)order.TotalAmount).ToString("N0")</small>
                                    </div>
                                </div>
                            </button>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-3">
                            <i class="fas fa-shopping-bag fa-2x mb-2"></i>
                            <p>@Localizer["NoOrdersFound"]</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Share Product Modal -->
<div class="modal fade" id="shareProductModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-box me-2"></i>@Localizer["ShareProduct"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <input type="text" class="form-control" id="productSearch" placeholder="@Localizer["SearchSellerProducts"]">
                </div>
                <div id="productSearchResults" class="list-group" style="max-height: 300px; overflow-y: auto;">
                    <div class="text-center text-muted py-3">
                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                            <span class="visually-hidden">@Localizer["Loading"]</span>
                        </div>
                        <p class="mt-2 mb-0">@Localizer["LoadingSellerProducts"]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="currentSellerId" value="@conversation?.SellerId" />

<!-- Escalate to Admin Modal -->
<div class="modal fade" id="escalateModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle me-2"></i>@Localizer["EscalateToAdmin"]</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="EscalateToAdmin" method="post">
                <input type="hidden" name="conversationId" value="@conversation?.Id" />
                <div class="modal-body">
                    <div class="alert alert-warning">
                        <i class="fas fa-info-circle me-2"></i>
                        @Localizer["EscalateWarningMessage"]
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Localizer["ReasonForEscalation"] <span class="text-danger">*</span></label>
                        <select name="reason" class="form-select" required>
                            <option value="">@Localizer["SelectAReason"]</option>
                            <option value="Non-responsive seller">@Localizer["SellerNotResponding"]</option>
                            <option value="Product quality issue">@Localizer["ProductQualityIssue"]</option>
                            <option value="Refund dispute">@Localizer["RefundDispute"]</option>
                            <option value="Fraudulent activity">@Localizer["SuspectedFraudulentActivity"]</option>
                            <option value="Other">@Localizer["Other"]</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Localizer["AdditionalDetails"]</label>
                        <textarea name="description" class="form-control" rows="3" placeholder="@Localizer["ProvideMoreDetails"]"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-paper-plane me-1"></i>@Localizer["SubmitEscalation"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Close Conversation Confirmation Modal -->
<div class="modal fade" id="closeConversationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content confirm-modal-content border-0 shadow-lg">
            <button type="button" class="btn-close confirm-modal-close" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button>
            <div class="modal-body text-center p-4">
                <div class="confirm-icon-wrapper mb-3">
                    <div class="confirm-icon-circle confirm-icon-warning">
                        <i class="fas fa-times-circle" style="font-size: 2.5rem;"></i>
                    </div>
                </div>
                <h4 class="modal-title fw-bold mb-2">@Localizer["CloseConversationQuestion"]</h4>
                <p class="text-muted mb-1">@Localizer["CloseConversationConfirm"]</p>
                <p class="text-muted small mb-0">@Localizer["CanReopenLater"]</p>
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2 pt-0 pb-4">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> @Localizer["Cancel"]
                </button>
                <form asp-action="CloseConversation" asp-route-id="@conversation?.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-warning px-4">
                        <i class="fas fa-check me-1"></i> @Localizer["YesClose"]
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Message Modal -->
<div class="modal fade" id="editMessageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-pencil-alt me-2"></i>@Localizer["EditMessage"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editMessageId" />
                <div class="mb-3">
                    <label class="form-label">@Localizer["Message"]</label>
                    <textarea id="editMessageText" class="form-control" rows="3" maxlength="2000"></textarea>
                    <small class="text-muted">@Localizer["EditMessageTimeLimit"]</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <button type="button" class="btn btn-primary" onclick="submitEditMessage()">
                    <i class="fas fa-save me-1"></i>@Localizer["SaveChanges"]
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Message Confirmation Modal -->
<div class="modal fade" id="deleteMessageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content confirm-modal-content border-0 shadow-lg">
            <button type="button" class="btn-close confirm-modal-close" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button>
            <div class="modal-body text-center p-4">
                <div class="confirm-icon-wrapper mb-3">
                    <div class="confirm-icon-circle confirm-icon-danger">
                        <i class="fas fa-trash-alt" style="font-size: 2.5rem;"></i>
                    </div>
                </div>
                <h4 class="modal-title fw-bold mb-2">@Localizer["DeleteMessageQuestion"]</h4>
                <p class="text-muted mb-1">@Localizer["DeleteMessageConfirm"]</p>
                <p class="text-muted small mb-0">@Localizer["ActionCannotBeUndone"]</p>
                <input type="hidden" id="deleteMessageId" />
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2 pt-0 pb-4">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> @Localizer["Cancel"]
                </button>
                <button type="button" class="btn btn-danger px-4" onclick="submitDeleteMessage()">
                    <i class="fas fa-trash-alt me-1"></i> @Localizer["Delete"]
