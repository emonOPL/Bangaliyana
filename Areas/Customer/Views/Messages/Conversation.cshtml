@section Scripts {
    <script>
        // Function to open modal from dropdown - fixes Bootstrap conflict
        function openModalFromDropdown(modalId) {
            // Close any open dropdowns first
            document.querySelectorAll('.dropdown-menu.show').forEach(menu => {
                menu.classList.remove('show');
                menu.previousElementSibling?.classList.remove('show');
                menu.previousElementSibling?.setAttribute('aria-expanded', 'false');
            });

            // Small delay to allow dropdown to close, then show modal
            setTimeout(() => {
                const modalElement = document.getElementById(modalId);
                if (modalElement) {
                    const modal = new bootstrap.Modal(modalElement);
                    modal.show();
                }
            }, 100);
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Scroll to bottom of chat
            var chatContainer = document.getElementById('chatContainer');
            if (chatContainer) {
                chatContainer.scrollTop = chatContainer.scrollHeight;
            }

            // Auto-resize textarea
            var textarea = document.getElementById('messageInput');
            if (textarea) {
                textarea.addEventListener('input', function () {
                    this.style.height = 'auto';
                    this.style.height = Math.min(this.scrollHeight, 120) + 'px';
                });

                // Keyboard shortcut: Ctrl+Enter or Cmd+Enter to send
                textarea.addEventListener('keydown', function (e) {
                    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                        e.preventDefault();
                        var form = document.getElementById('messageForm');
                        if (form && this.value.trim()) {
                            form.submit();
                        }
                    }
                });
            }

            // Also add Escape to clear attachment/shared content and clear search
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    removeAttachment();
                    removeSharedContent();
                    clearMessageSearch();
                }
                // Ctrl+F to focus search
                if ((e.ctrlKey || e.metaKey) && e.key === 'f') {
                    e.preventDefault();
                    document.getElementById('messageSearch').focus();
                }
            });

            // Message search within conversation
            initMessageSearch();

            // Product search
            var productSearch = document.getElementById('productSearch');
            var sellerId = document.getElementById('currentSellerId')?.value;

            if (productSearch) {
                let searchTimeout;
                productSearch.addEventListener('input', function () {
                    clearTimeout(searchTimeout);
                    const query = this.value.trim();
                    searchTimeout = setTimeout(() => searchProducts(query), 300);
                });
            }

            // Load seller products when Share Product modal opens
            var shareProductModal = document.getElementById('shareProductModal');
            if (shareProductModal) {
                shareProductModal.addEventListener('shown.bs.modal', function () {
                    // Clear search input
                    if (productSearch) productSearch.value = '';
                    // Load all seller's products initially
                    searchProducts('');
                });
            }
        });

        function searchProducts(query) {
            var sellerId = document.getElementById('currentSellerId')?.value;
            if (!sellerId) {
                document.getElementById('productSearchResults').innerHTML = '<div class="text-center text-muted py-3"><p>@Localizer["UnableToLoadProducts"]</p></div>';
                return;
            }

            let url = `/Customer/Messages/SearchProducts?sellerId=${encodeURIComponent(sellerId)}`;
            if (query && query.length >= 2) {
                url += `&query=${encodeURIComponent(query)}`;
            }

            fetch(url)
                .then(response => response.json())
                .then(data => {
                    const container = document.getElementById('productSearchResults');
                    if (data.length === 0) {
                        container.innerHTML = '<div class="text-center text-muted py-3"><i class="fas fa-box-open fa-2x mb-2"></i><p class="mb-0">@Localizer["NoProductsFound"]</p></div>';
                        return;
                    }
                    container.innerHTML = data.map(p => `
                        <button type="button" class="list-group-item list-group-item-action" onclick="selectProduct(${p.id}, '${p.name.replace(/'/g, "\\'")}')">
                            <div class="d-flex align-items-center">
                                <img src="${p.imageUrl}" class="rounded me-2" style="width: 40px; height: 40px; object-fit: cover;" onerror="this.src='/images/products/noimage.jpg'">
                                <div class="flex-grow-1">
                                    <div class="text-truncate" style="max-width: 200px;">${p.name}</div>
                                    <small class="text-primary fw-bold">৳${(p.discountPrice || p.price).toLocaleString()}</small>
                                    ${p.discountPrice && p.discountPrice < p.price ? `<small class="text-muted text-decoration-line-through ms-1">৳${p.price.toLocaleString()}</small>` : ''}
                                </div>
                            </div>
                        </button>
                    `).join('');
                })
                .catch(err => {
                    console.error('Search error:', err);
                    document.getElementById('productSearchResults').innerHTML = '<div class="text-center text-muted py-3"><p>@Localizer["ErrorLoadingProducts"]</p></div>';
                });
        }

        function selectOrder(orderId, orderText) {
            document.getElementById('sharedOrderId').value = orderId;
            document.getElementById('sharedProductId').value = '';
            document.getElementById('sharedContentIcon').className = 'fas fa-shopping-bag me-2 text-info';
            document.getElementById('sharedContentText').textContent = orderText;
            document.getElementById('sharedContentPreview').classList.remove('d-none');
            bootstrap.Modal.getInstance(document.getElementById('shareOrderModal')).hide();
        }

        function selectProduct(productId, productName) {
            document.getElementById('sharedProductId').value = productId;
            document.getElementById('sharedOrderId').value = '';
            document.getElementById('sharedContentIcon').className = 'fas fa-box me-2 text-primary';
            document.getElementById('sharedContentText').textContent = productName;
            document.getElementById('sharedContentPreview').classList.remove('d-none');
            bootstrap.Modal.getInstance(document.getElementById('shareProductModal')).hide();
        }

        function removeSharedContent() {
            document.getElementById('sharedOrderId').value = '';
            document.getElementById('sharedProductId').value = '';
            document.getElementById('sharedContentPreview').classList.add('d-none');
        }

        function previewAttachment(input) {
            if (input.files && input.files[0]) {
                document.getElementById('attachmentName').textContent = input.files[0].name;
                document.getElementById('attachmentPreview').classList.remove('d-none');
            }
        }

        function removeAttachment() {
            document.getElementById('attachmentInput').value = '';
            document.getElementById('attachmentPreview').classList.add('d-none');
        }

        // Message Search Functions
        let searchMatches = [];
        let currentMatchIndex = -1;

        function initMessageSearch() {
            const searchInput = document.getElementById('messageSearch');
            const prevBtn = document.getElementById('prevMatch');
            const nextBtn = document.getElementById('nextMatch');
            const clearBtn = document.getElementById('clearSearch');

            if (!searchInput) return;

            let searchTimeout;
            searchInput.addEventListener('input', function() {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => performMessageSearch(this.value), 200);
            });

            searchInput.addEventListener('keydown', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    if (e.shiftKey) {
                        navigateMatch(-1);
                    } else {
                        navigateMatch(1);
                    }
                }
            });

            prevBtn.addEventListener('click', () => navigateMatch(-1));
            nextBtn.addEventListener('click', () => navigateMatch(1));
            clearBtn.addEventListener('click', clearMessageSearch);
        }

        function performMessageSearch(query) {
            // Clear previous highlights
            document.querySelectorAll('.message-content').forEach(el => {
                el.innerHTML = el.textContent;
                el.closest('.message-row')?.classList.remove('search-match', 'search-current');
            });

            searchMatches = [];
            currentMatchIndex = -1;

            if (!query || query.length < 2) {
                updateSearchUI(false);
                return;
            }

            const regex = new RegExp(`(${escapeRegExp(query)})`, 'gi');
            document.querySelectorAll('.message-content').forEach((el, index) => {
                const text = el.textContent;
                if (text.toLowerCase().includes(query.toLowerCase())) {
                    searchMatches.push(el);
                    el.innerHTML = text.replace(regex, '<mark class="search-highlight">$1</mark>');
                    el.closest('.message-row')?.classList.add('search-match');
                }
            });

            updateSearchUI(true);

            if (searchMatches.length > 0) {
                currentMatchIndex = 0;
                highlightCurrentMatch();
            }
        }

        function navigateMatch(direction) {
            if (searchMatches.length === 0) return;

            currentMatchIndex += direction;
            if (currentMatchIndex >= searchMatches.length) currentMatchIndex = 0;
            if (currentMatchIndex < 0) currentMatchIndex = searchMatches.length - 1;

            highlightCurrentMatch();
        }

        function highlightCurrentMatch() {
            document.querySelectorAll('.search-current').forEach(el => el.classList.remove('search-current'));

            if (currentMatchIndex >= 0 && searchMatches[currentMatchIndex]) {
                const match = searchMatches[currentMatchIndex];
                match.closest('.message-row')?.classList.add('search-current');
                match.scrollIntoView({ behavior: 'smooth', block: 'center' });
                document.getElementById('currentMatch').textContent = currentMatchIndex + 1;
            }
        }

        function updateSearchUI(showControls) {
            const elements = ['searchResults', 'prevMatch', 'nextMatch', 'clearSearch'];
            elements.forEach(id => {
                document.getElementById(id)?.classList.toggle('d-none', !showControls);
            });

            if (showControls) {
                document.getElementById('totalMatches').textContent = searchMatches.length;
                document.getElementById('currentMatch').textContent = searchMatches.length > 0 ? '1' : '0';
            }
        }

        function clearMessageSearch() {
            const searchInput = document.getElementById('messageSearch');
            if (searchInput) searchInput.value = '';

            document.querySelectorAll('.message-content').forEach(el => {
                el.innerHTML = el.textContent;
                el.closest('.message-row')?.classList.remove('search-match', 'search-current');
            });

            searchMatches = [];
            currentMatchIndex = -1;
            updateSearchUI(false);
        }

        function escapeRegExp(string) {
            return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        }

        // Edit/Delete Message Functions
        function openEditModal(messageId, messageText) {
            document.getElementById('editMessageId').value = messageId;
            document.getElementById('editMessageText').value = messageText;
            const modal = new bootstrap.Modal(document.getElementById('editMessageModal'));
            modal.show();
        }

        function openDeleteModal(messageId) {
            document.getElementById('deleteMessageId').value = messageId;
            const modal = new bootstrap.Modal(document.getElementById('deleteMessageModal'));
            modal.show();
        }

        function submitEditMessage() {
            const messageId = document.getElementById('editMessageId').value;
            const newMessage = document.getElementById('editMessageText').value.trim();

            if (!newMessage) {
                alert('@Localizer["MessageCannotBeEmpty"]');
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch('/Customer/Messages/EditMessage', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `messageId=${messageId}&newMessage=${encodeURIComponent(newMessage)}&__RequestVerificationToken=${encodeURIComponent(token)}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Update the message in the DOM
                    const messageRow = document.querySelector(`[data-message-id="${messageId}"]`);
                    if (messageRow) {
                        const messageContent = messageRow.querySelector('.message-content');
                        if (messageContent) {
                            messageContent.textContent = newMessage;
                        }
                        // Add edited indicator if not present
                        const bubble = messageRow.querySelector('.chat-bubble');
                        if (bubble && !bubble.querySelector('.edited-indicator')) {
                            const indicator = document.createElement('small');
                            indicator.className = 'edited-indicator';
                            indicator.innerHTML = '<i class="fas fa-pencil-alt me-1"></i>@Localizer["Edited"]';
                            bubble.querySelector('.message-content').after(indicator);
                        }
                    }
                    bootstrap.Modal.getInstance(document.getElementById('editMessageModal')).hide();
                } else {
                    alert(data.error || '@Localizer["FailedToEditMessage"]');
                }
            })
            .catch(err => {
                console.error('Edit error:', err);
                alert('@Localizer["ErrorEditingMessage"]');
            });
        }

        function submitDeleteMessage() {
            const messageId = document.getElementById('deleteMessageId').value;
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch('/Customer/Messages/DeleteMessage', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `messageId=${messageId}&__RequestVerificationToken=${encodeURIComponent(token)}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Update the message in the DOM
                    const messageRow = document.querySelector(`[data-message-id="${messageId}"]`);
                    if (messageRow) {
                        const bubble = messageRow.querySelector('.chat-bubble');
                        if (bubble) {
                            bubble.classList.add('deleted-message');
                            bubble.innerHTML = '<div class="message-content deleted-text"><i class="fas fa-ban me-1"></i>@Localizer["MessageWasDeleted"]</div>' +
                                '<div class="message-time">' + bubble.querySelector('.message-time')?.innerHTML + '</div>';
                        }
                        // Remove action buttons
                        const actions = messageRow.querySelector('.message-actions');
                        if (actions) actions.remove();
                    }
                    bootstrap.Modal.getInstance(document.getElementById('deleteMessageModal')).hide();
                } else {
                    alert(data.error || '@Localizer["FailedToDeleteMessage"]');
                }
            })
            .catch(err => {
                console.error('Delete error:', err);
                alert('@Localizer["ErrorDeletingMessage"]');
            });
        }
    </script>
}
