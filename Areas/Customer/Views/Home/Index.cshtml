                                }
                                else
                                {
                                    <div class="rounded-circle bg-success bg-opacity-25 d-flex align-items-center justify-content-center me-3 text-success" style="width: 50px; height: 50px;">
                                        <i class="fas fa-user"></i>
                                    </div>
                                }
                                <div>
                                    <h6 class="mb-0 fw-semibold">@testimonial.CustomerName</h6>
                                    @if (!string.IsNullOrEmpty(testimonial.CustomerLocation))
                                    {
