@using System.Globalization
@using Bangaliyana.Models
@using Bangaliyana.Models.ViewModels
@using X.PagedList.Mvc.Core
@using X.PagedList
@model HomePageViewModel

@{
    ViewData["Title"] = "Home";
    var currentPage = Model.AllProducts.PageNumber;
    var totalPages = Model.AllProducts.PageCount;
    var hasProducts = Model.AllProducts.Any();
    var siteSettings = Model.SiteSettings;
    var currencySymbol = siteSettings.CurrencySymbol ?? "৳";
}

<!-- Hero Slider Section - Full Width Background -->
<section class="hero-section mb-5" style="margin-top: -76px; width: 100%; position: relative; left: 50%; right: 50%; margin-left: -50%; margin-right: -50%;">
    @if (Model.HeroBanners.Any())
    {
        <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="5000">
            <div class="carousel-indicators" style="bottom: 15px; margin-bottom: 0;">
                @for (int i = 0; i < Model.HeroBanners.Count(); i++)
                {
                    <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" style="width: 10px !important; height: 10px !important; border-radius: 50% !important; border: none !important; padding: 0 !important; margin: 0 5px !important; background-color: @(i == 0 ? "#fff" : "rgba(255,255,255,0.5)"); opacity: 1 !important;" aria-current="@(i == 0 ? "true" : "false")"></button>
                }
            </div>
            <div class="carousel-inner">
                @{ var bannerIndex = 0; }
                @foreach (var banner in Model.HeroBanners)
                {
                    <div class="carousel-item @(bannerIndex == 0 ? "active" : "")">
                        <div class="position-relative d-flex align-items-center" style="min-height: 70vh; background: @(!string.IsNullOrEmpty(banner.ImageUrl) ? $"url('/{banner.ImageUrl}') center/cover" : banner.BackgroundColor ?? "linear-gradient(135deg, #198754, #0d6efd)");">
                            <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark bg-opacity-50"></div>
                            <div class="container position-relative">
                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="text-white">
                                            @if (!string.IsNullOrEmpty(banner.Subtitle))
                                            {
                                                <span class="badge bg-success rounded-pill px-3 py-2 mb-3 d-inline-block">@banner.Subtitle</span>
                                            }
                                            <h1 class="display-4 fw-bold mb-3" style="color: @(banner.TextColor ?? "white"); text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">@Html.Raw(banner.Title ?? "Welcome to " + siteSettings.SiteName)</h1>
                                            @if (!string.IsNullOrEmpty(banner.Description))
                                            {
                                                <p class="lead mb-4 text-white" style="opacity: 0.9; text-shadow: 1px 1px 2px rgba(0,0,0,0.5);">@banner.Description</p>
                                            }
                                            @if (!string.IsNullOrEmpty(banner.ButtonText))
                                            {
                                                <a href="#products-section" class="btn btn-lg px-5 py-3 fw-bold shadow-lg scroll-to shop-now-btn shop-now-btn-gradient" style="font-size: 1.25rem; letter-spacing: 0.5px; color: white !important; border: 2px solid rgba(255,255,255,0.3); border-radius: 50px;">
                                                    <i class="fas fa-shopping-bag me-2" style="color: white;"></i><span style="color: white;">@banner.ButtonText</span>
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    bannerIndex++;
                }
            </div>
            <button class="carousel-control-prev d-none d-lg-flex" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev" style="width: 5%;">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">@Localizer["Previous"]</span>
            </button>
            <button class="carousel-control-next d-none d-lg-flex" type="button" data-bs-target="#heroCarousel" data-bs-slide="next" style="width: 5%;">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">@Localizer["Next"]</span>
            </button>
        </div>
    }
    else
    {
        <!-- Default Hero -->
        <div class="position-relative d-flex align-items-center bg-gradient hero-gradient" style="min-height: 70vh;">
            <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark bg-opacity-25"></div>
            <div class="container position-relative">
                <div class="row">
                    <div class="col-lg-6">
                        <h1 class="display-4 fw-bold mb-4 text-white">@Localizer["WelcomeTo"] <span class="text-warning">@siteSettings.SiteName</span></h1>
                        <p class="lead mb-4 text-white-50">@(siteSettings.SiteTagline ?? "Discover authentic Bangladeshi fashion")</p>
                        <a href="#products-section" class="btn btn-lg px-5 py-3 fw-bold shadow-lg scroll-to shop-now-btn shop-now-btn-gradient" style="font-size: 1.25rem; letter-spacing: 0.5px; color: white; border: 2px solid rgba(255,255,255,0.3); border-radius: 50px;">
                            <i class="fas fa-shopping-bag me-2"></i>@Localizer["ShopNow"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</section>

<!-- Features Bar -->
@if (Model.HomeFeatures.Any())
{
    <section class="py-4 bg-light border-bottom">
        <div class="container">
            <div class="row g-3">
                @foreach (var feature in Model.HomeFeatures.Take(4))
                {
                    <div class="col-6 col-md-3">
                        <div class="d-flex align-items-center p-2">
                            <div class="fs-4 me-3" style="color: @(feature.IconColor ?? "#198754")">
                                <i class="@feature.IconClass"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold">@feature.Title</h6>
                                <small class="text-muted">@feature.Description</small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Categories Section -->
@if (Model.Categories.Any())
{
    <section class="py-5">
        <div class="container">
            <div class="text-center mb-4">
                <h2 class="fw-bold">@Localizer["ShopByCategory"]</h2>
                <p class="text-muted">@Localizer["BrowseCategoriesDescription"]</p>
            </div>
            <div class="row g-4">
                @{ var categoriesToShow = Model.Categories.Take(5); }
                @foreach (var category in categoriesToShow)
                {
                    var hasSubcategories = category.Children?.Any(c => c.IsActive) == true;
                    <div class="col-6 col-md-4 col-lg-2">
                        <a href="@Url.Action("Category", "Home", new { area = "Customer", id = category.Id })" class="card h-100 text-decoration-none border text-center p-3 category-card">
                            <div class="d-flex align-items-center justify-content-center position-relative" style="height: 80px;">
                                @if (!string.IsNullOrEmpty(category.ImageUrl))
                                {
                                    <img src="~/@category.ImageUrl" alt="@category.Name" class="img-fluid" style="max-height: 100%; object-fit: contain;" />
                                }
                                else
                                {
                                    <i class="@(category.IconClass ?? "fas fa-folder") fs-1 text-success"></i>
                                }
                                @if (hasSubcategories)
                                {
                                    <span class="position-absolute top-0 end-0 badge bg-success rounded-pill" style="font-size: 0.65rem;">
                                        @category.Children!.Count(c => c.IsActive) <i class="fas fa-sitemap ms-1"></i>
                                    </span>
                                }
                            </div>
                            <h6 class="mt-2 mb-0 fw-semibold category-name">@category.Name</h6>
                        </a>
                    </div>
                }
                <!-- See All Categories Card -->
                <div class="col-6 col-md-4 col-lg-2">
                    <a href="@Url.Action("Categories", "Home", new { area = "Customer" })" class="card h-100 text-decoration-none border text-center p-3 category-card see-all-card">
                        <div class="d-flex align-items-center justify-content-center" style="height: 80px;">
                            <i class="fas fa-th-large fs-1 text-success"></i>
                        </div>
                        <h6 class="mt-2 mb-0 fw-semibold category-name">@Localizer["SeeAll"]</h6>
                    </a>
                </div>
            </div>
        </div>
    </section>
}

<!-- Flash Sale Section -->
@if (Model.FlashSaleProducts.Any() && Model.HasActiveFlashSale)
{
    <section class="py-5 bg-danger bg-opacity-10">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                <div>
                    <h2 class="fw-bold mb-0">
                        <i class="fas fa-bolt text-warning me-2"></i>@Localizer["FlashSale"]
                    </h2>
                    <p class="text-muted mb-0">@Localizer["FlashSaleDescription"]</p>
                </div>
                <div class="d-flex gap-2 align-items-center countdown-timer" data-end-time="@Model.FlashSaleEndTime?.ToString("o")">
                    <div class="bg-danger text-white text-center rounded px-3 py-2" style="min-width: 60px;">
                        <span class="fs-4 fw-bold d-block" id="hours">00</span>
                        <small class="text-uppercase" style="font-size: 0.65rem;">@Localizer["Hours"]</small>
                    </div>
                    <span class="fs-4 fw-bold text-danger">:</span>
                    <div class="bg-danger text-white text-center rounded px-3 py-2" style="min-width: 60px;">
                        <span class="fs-4 fw-bold d-block" id="minutes">00</span>
                        <small class="text-uppercase" style="font-size: 0.65rem;">@Localizer["Minutes"]</small>
                    </div>
                    <span class="fs-4 fw-bold text-danger">:</span>
                    <div class="bg-danger text-white text-center rounded px-3 py-2" style="min-width: 60px;">
                        <span class="fs-4 fw-bold d-block" id="seconds">00</span>
                        <small class="text-uppercase" style="font-size: 0.65rem;">@Localizer["Seconds"]</small>
                    </div>
                </div>
            </div>
            <div class="row g-3">
                @foreach (var product in Model.FlashSaleProducts.Take(4))
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        @await Html.PartialAsync("_ProductCard", product, new ViewDataDictionary(ViewData) { { "IsFlashSale", true }, { "CurrencySymbol", currencySymbol } })
                    </div>
                }
            </div>
        </div>
    </section>
}

