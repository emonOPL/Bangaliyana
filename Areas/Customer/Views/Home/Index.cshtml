<!-- Scroll to Top Button -->
@* <button id="scrollToTop" class="btn btn-success rounded-circle shadow-lg position-fixed" style="bottom: 30px; right: 30px; width: 50px; height: 50px; display: none; z-index: 1050;">
    <i class="fas fa-arrow-up"></i>
</button> *@

@section Scripts {
    <script>
        // Localized strings for JavaScript
        var localizedStrings = {
            saleEnded: '@Localizer["SaleEnded"].Value',
            errorOccurred: '@Localizer["ErrorOccurred"].Value'
        };

        $(document).ready(function() {
            // Scroll to top functionality
            $(window).scroll(function() {
                if ($(this).scrollTop() > 300) {
                    $('#scrollToTop').fadeIn();
                } else {
                    $('#scrollToTop').fadeOut();
                }
            });

            $('#scrollToTop').click(function() {
                $('html, body').animate({ scrollTop: 0 }, 500);
                return false;
            });

            // Newsletter subscription
            $('#newsletterForm').on('submit', function(e) {
                e.preventDefault();
                var btn = $('#subscribeBtn');
                var btnText = btn.find('.btn-text');
                var btnLoading = btn.find('.btn-loading');
                var messageDiv = $('#newsletterMessage');

                btn.prop('disabled', true);
                btnText.addClass('d-none');
                btnLoading.removeClass('d-none');

                $.ajax({
                    url: '@Url.Action("SubscribeNewsletter", "Home")',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function(response) {
                        if (response.success) {
                            messageDiv.html('<div class="alert alert-success py-2 mb-0 small"><i class="fas fa-check-circle me-2"></i>' + response.message + '</div>');
                            $('#newsletterEmail').val('');
                        } else {
                            messageDiv.html('<div class="alert alert-warning py-2 mb-0 small"><i class="fas fa-exclamation-circle me-2"></i>' + response.message + '</div>');
                        }
                    },
                    error: function() {
                        messageDiv.html('<div class="alert alert-danger py-2 mb-0 small"><i class="fas fa-times-circle me-2"></i>' + localizedStrings.errorOccurred + '</div>');
                    },
                    complete: function() {
                        btn.prop('disabled', false);
                        btnText.removeClass('d-none');
                        btnLoading.addClass('d-none');
                    }
                });
            });

            // Flash sale countdown
            var endTime = $('.countdown-timer').data('end-time');
            if (endTime) {
                updateCountdown();
                setInterval(updateCountdown, 1000);
            }

            function updateCountdown() {
                var now = new Date().getTime();
                var end = new Date(endTime).getTime();
                var distance = end - now;

                if (distance < 0) {
                    $('.countdown-timer').html('<span class="text-danger fw-bold">' + localizedStrings.saleEnded + '</span>');
                    return;
                }

                var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                var seconds = Math.floor((distance % (1000 * 60)) / 1000);

                $('#hours').text(hours.toString().padStart(2, '0'));
                $('#minutes').text(minutes.toString().padStart(2, '0'));
                $('#seconds').text(seconds.toString().padStart(2, '0'));
            }

            // Smooth scroll
            $('.scroll-to').click(function(e) {
                e.preventDefault();
                var target = $($(this).attr('href'));
                if (target.length) {
                    $('html, body').animate({ scrollTop: target.offset().top - 100 }, 800);
                }
            });
        });
    </script>
}

