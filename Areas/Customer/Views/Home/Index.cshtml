<!-- All Products Section -->
<section id="products-section" class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div class="text-center text-md-start">
                <h2 class="fw-bold mb-0">
                    <i class="fas fa-tshirt text-primary me-2"></i>@Localizer["AllProducts"]
                </h2>
                <p class="text-muted mb-0">@Localizer["AllProductsDescription"]</p>
            </div>
            <a href="@Url.Action("Index", "Home", new { area = "Customer" })#products-section" class="btn btn-outline-success">@Localizer["ViewAllProducts"]</a>
        </div>

        @if (hasProducts)
        {
            <div class="row g-4">
                @foreach (var product in Model.AllProducts)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        @await Html.PartialAsync("_ProductCard", product, new ViewDataDictionary(ViewData) { { "CurrencySymbol", currencySymbol } })
                    </div>
                }
            </div>

            <!-- Pagination -->
            <div class="mt-5">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <p class="text-muted mb-0">
                        @Localizer["ShowingProducts"] <strong>@Model.AllProducts.FirstItemOnPage - @Model.AllProducts.LastItemOnPage</strong> @Localizer["Of"] <strong>@Model.AllProducts.TotalItemCount</strong> @Localizer["Products"]
                    </p>
                    <nav>
                        @Html.PagedListPager(Model.AllProducts, page => Url.Action("Index", new { page }),
                            new PagedListRenderOptions
                            {
                                UlElementClasses = new[] { "pagination", "mb-0" },
                                LiElementClasses = new[] { "page-item" },
                                PageClasses = new[] { "page-link" },
                                LinkToPreviousPageFormat = "<i class=\"fas fa-chevron-left\"></i>",
                                LinkToNextPageFormat = "<i class=\"fas fa-chevron-right\"></i>",
                                DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                                DisplayLinkToNextPage = PagedListDisplayMode.Always,
                                MaximumPageNumbersToDisplay = 5
                            })
                    </nav>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-box-open fa-4x text-muted mb-4"></i>
                <h3 class="text-muted mb-3">@Localizer["NoProductsFound"]</h3>
                <p class="text-muted mb-4">@Localizer["NoProductsFoundDescription"]</p>
            </div>
        }
    </div>
</section>

<!-- Newsletter Section -->
<section class="py-5">
    <div class="container">
        <div class="rounded-4 p-4 p-lg-5 text-white newsletter-gradient">
            <div class="row align-items-center">
                <div class="col-lg-6 mb-4 mb-lg-0">
                    <h3 class="fw-bold mb-2">
                        <i class="fas fa-envelope-open-text me-2"></i>@Localizer["SubscribeNewsletter"]
                    </h3>
                    <p class="mb-0 text-white" style="opacity: 0.9;">@Localizer["NewsletterDescription"]</p>
                </div>
                <div class="col-lg-6">
                    <form id="newsletterForm">
                        @Html.AntiForgeryToken()
                        <div class="input-group input-group-lg">
                            <input type="email" class="form-control border-0 rounded-start-pill py-3" id="newsletterEmail" name="email" placeholder="@Localizer["EnterEmail"]" required />
                            <button type="submit" class="btn btn-warning rounded-end-pill px-4" id="subscribeBtn">
                                <span class="btn-text fw-semibold">@Localizer["Subscribe"]</span>
                                <span class="btn-loading d-none"><i class="fas fa-spinner fa-spin"></i></span>
                            </button>
                        </div>
                        <div id="newsletterMessage" class="mt-2"></div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

