@model IEnumerable<Bangaliyana.Models.Category>
@{
    ViewData["Title"] = "All Categories";
    var allCategories = ViewBag.AllCategories as List<Bangaliyana.Models.Category>;
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-success">@Localizer["Home"]</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Localizer["Categories"]</li>
        </ol>
    </nav>

    <!-- Page Header -->
    <div class="text-center mb-5">
        <h1 class="fw-bold mb-2">
            <i class="fas fa-th-large text-success me-2"></i>@Localizer["ShopByCategory"]
        </h1>
        <p class="text-muted">@Localizer["BrowseCategoriesDescription"]</p>
    </div>

    @if (Model.Any())
    {
        <div class="row">
            <!-- Category Tree Sidebar -->
            <div class="col-lg-4 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="fas fa-folder-tree me-2"></i>@Localizer["CategoryHierarchy"]</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="category-tree">
                            @foreach (var category in Model.OrderBy(c => c.DisplayOrder).ThenBy(c => c.Name))
                            {
                                @await Html.PartialAsync("_CustomerCategoryTree", category)
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Category Cards Grid -->
            <div class="col-lg-8">
                <h5 class="mb-4 text-muted"><i class="fas fa-layer-group me-2"></i>@Localizer["RootCategories"]</h5>
                <div class="row g-4">
                    @foreach (var category in Model.OrderBy(c => c.DisplayOrder).ThenBy(c => c.Name))
                    {
                        <div class="col-6 col-md-4">
                            <a asp-action="Category" asp-route-id="@category.Id" class="text-decoration-none">
                                <div class="card h-100 border-0 shadow-sm category-card">
                                    <div class="card-body text-center p-4">
                                        @if (!string.IsNullOrEmpty(category.ImageUrl))
                                        {
                                            <div class="mb-3" style="height: 80px;">
                                                <img src="@category.ImageUrl" alt="@category.Name" class="img-fluid h-100" style="object-fit: contain;" />
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="mb-3 d-flex align-items-center justify-content-center" style="height: 80px;">
                                                <i class="@(category.IconClass ?? "fas fa-folder") text-success" style="font-size: 3rem;"></i>
                                            </div>
                                        }
                                        <h6 class="card-title fw-bold mb-2">@category.Name</h6>
                                        @if (category.Children?.Any(c => c.IsActive) == true)
                                        {
                                            <span class="badge bg-success-subtle text-success">
                                                <i class="fas fa-sitemap me-1"></i>@Localizer["SubcategoriesCount", category.Children.Count(c => c.IsActive)]
                                            </span>
                                        }
                                        @{
                                            var productCount = category.Products?.Count ?? 0;
                                        }
                                        @if (productCount > 0)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary ms-1">
                                                <i class="fas fa-box me-1"></i>@Localizer["ProductsCount", productCount]
                                            </span>
                                        }
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-folder-open fa-4x text-muted mb-4"></i>
            <h3 class="text-muted mb-3">@Localizer["NoCategoriesFound"]</h3>
            <p class="text-muted mb-4">@Localizer["CategoriesWillAppear"]</p>
            <a asp-action="Index" class="btn btn-success">
                <i class="fas fa-home me-2"></i>@Localizer["BackToHome"]
            </a>
        </div>
    }
</div>

<style>
    .category-card {
        border-radius: 1rem !important;
        background-color: var(--bg-color, #fff);
        border: 1px solid var(--border-color, rgba(0,0,0,0.1)) !important;
        transition: all 0.2s ease;
    }

    .category-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15) !important;
    }

    .category-card .card-title {
        color: var(--text-color, #212529);
    }

    /* Category Tree Styles */
    .category-tree {
        padding: 0;
    }

    .category-tree-item {
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }

    .category-tree-item:last-child {
        border-bottom: none;
    }

    .category-tree-link {
        display: flex;
        align-items: center;
        padding: 12px 15px;
        color: var(--text-color, #212529);
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .category-tree-link:hover {
        background-color: rgba(25, 135, 84, 0.1);
        color: #198754;
    }

    .category-tree-toggle {
        cursor: pointer;
        padding: 5px 10px;
        margin-right: 5px;
        border-radius: 4px;
    }

    .category-tree-toggle:hover {
        background-color: rgba(25, 135, 84, 0.2);
    }

    .category-tree-children {
        padding-left: 20px;
        border-left: 2px solid rgba(25, 135, 84, 0.2);
        margin-left: 15px;
        display: none;
    }

    .category-tree-children.show {
        display: block;
    }

    .category-icon {
        width: 24px;
        margin-right: 10px;
        color: #198754;
    }

    .category-count {
        margin-left: auto;
        font-size: 0.8rem;
        color: #6c757d;
    }

    /* Dark mode */
    [data-theme="dark"] .category-card {
        background-color: #1e1e2d;
        border-color: rgba(255,255,255,0.1) !important;
    }

    [data-theme="dark"] .category-card:hover {
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.3) !important;
    }

    [data-theme="dark"] .category-card .card-title {
        color: #e0e0e0;
    }

    [data-theme="dark"] .category-tree-link {
        color: #e0e0e0;
    }

    [data-theme="dark"] .category-tree-item {
        border-color: rgba(255,255,255,0.05);
    }

    [data-theme="dark"] .category-tree-children {
        border-color: rgba(25, 135, 84, 0.3);
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Toggle category tree children
            $('.category-tree-toggle').on('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                var $this = $(this);
                var $children = $this.closest('.category-tree-item').find('> .category-tree-children');

                $children.toggleClass('show');

                // Toggle icon between right and down arrow
                $this.find('.icon-right').toggle();
                $this.find('.icon-down').toggle();
            });
        });
    </script>
}
