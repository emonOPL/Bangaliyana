@using Bangaliyana.Services
@{
    ViewData["Title"] = string.IsNullOrEmpty(ViewBag.Query) ? Localizer["SearchProducts"].Value : $"{Localizer["Search"].Value}: {ViewBag.Query}";

    var searchResult = ViewBag.SearchResult as SearchResult;
    var filters = ViewBag.Filters as SearchFilters;
    var trendingSearches = ViewBag.TrendingSearches as IEnumerable<TrendingSearchItem>;
    var recommendations = ViewBag.Recommendations as List<ProductRecommendation>;
    var pageNumber = (int)ViewBag.PageNumber;
    var totalPages = (int)ViewBag.TotalPages;
}

<div class="container py-4">
    <!-- Search Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-area="Customer" asp-controller="Home" asp-action="Index">@Localizer["Home"]</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Localizer["Search"]</li>
                </ol>
            </nav>

            @if (!string.IsNullOrEmpty(ViewBag.Query))
            {
                <h2 class="mb-2">
                    <i class="fas fa-search text-primary me-2"></i>
                    @Localizer["SearchResultsFor"] "<strong>@ViewBag.Query</strong>"
                </h2>
                <p class="text-muted">
                    @if (searchResult != null)
                    {
                        @searchResult.TotalCount
                        <text> @Localizer["ProductsFound"]</text>
                    }
                </p>
            }
            else
            {
                <h2 class="mb-2">
                    <i class="fas fa-search text-primary me-2"></i>
                    @Localizer["SearchProducts"]
                </h2>
            }
        </div>
    </div>

    <div class="row">
        <!-- Filters Sidebar -->
        <div class="col-lg-3 col-md-4 mb-4">
            <div class="filters-card card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-filter me-2"></i>@Localizer["Filters"]</h5>
                </div>
                <div class="card-body">
                    <form id="filterForm" method="get">
                        <input type="hidden" name="q" value="@ViewBag.Query" />

                        <!-- Categories -->
                        @if (filters?.Categories?.Any() == true)
                        {
                            <div class="filter-section mb-4">
                                <h6 class="fw-bold mb-3">@Localizer["Category"]</h6>
                                @foreach (var cat in filters.Categories)
                                {
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="radio" name="category"
                                               value="@cat.Id" id="cat_@cat.Id"
                                               @(ViewBag.Category?.ToString() == cat.Id.ToString() ? "checked" : "")
                                               onchange="this.form.submit()">
                                        <label class="form-check-label" for="cat_@cat.Id">
                                            @cat.Name <span class="badge bg-secondary">@cat.Count</span>
                                        </label>
                                    </div>
                                }
                                @if (ViewBag.Category != null)
                                {
                                    <a href="@Url.Action("Search", new { q = ViewBag.Query, sortBy = ViewBag.SortBy })"
                                       class="btn btn-sm btn-outline-secondary mt-2">@Localizer["ClearCategory"]</a>
                                }
                            </div>
                        }

                        <!-- Price Range -->
                        <div class="filter-section mb-4">
                            <h6 class="fw-bold mb-3">@Localizer["PriceRange"]</h6>
                            <div class="row g-2">
                                <div class="col-6">
                                    <input type="number" class="form-control form-control-sm" name="minPrice"
                                           placeholder="Min" value="@ViewBag.MinPrice" min="0">
                                </div>
                                <div class="col-6">
                                    <input type="number" class="form-control form-control-sm" name="maxPrice"
                                           placeholder="Max" value="@ViewBag.MaxPrice" min="0">
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm w-100 mt-2">@Localizer["ApplyPrice"]</button>
                        </div>

                        <!-- Sort By -->
                        <div class="filter-section">
                            <h6 class="fw-bold mb-3">@Localizer["SortBy"]</h6>
                            <select name="sortBy" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="relevance" selected="@(ViewBag.SortBy == "relevance")">@Localizer["Relevance"]</option>
                                <option value="newest" selected="@(ViewBag.SortBy == "newest")">@Localizer["NewestFirst"]</option>
                                <option value="price_asc" selected="@(ViewBag.SortBy == "price_asc")">@Localizer["PriceLowToHigh"]</option>
                                <option value="price_desc" selected="@(ViewBag.SortBy == "price_desc")">@Localizer["PriceHighToLow"]</option>
                                <option value="popular" selected="@(ViewBag.SortBy == "popular")">@Localizer["MostPopular"]</option>
                            </select>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Trending Searches -->
            @if (trendingSearches?.Any() == true)
            {
                <div class="card shadow-sm mt-4 trending-card">
                    <div class="card-header bg-danger text-white">
                        <h6 class="mb-0"><i class="fas fa-fire me-2"></i>@Localizer["TrendingSearches"]</h6>
                    </div>
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var trend in trendingSearches)
                            {
                                <a href="@Url.Action("Search", new { q = trend.SearchTerm })"
                                   class="badge bg-light text-dark text-decoration-none trending-badge">
                                    @trend.SearchTerm
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Search Results -->
        <div class="col-lg-9 col-md-8">
            @if (searchResult?.Products?.Any() == true)
            {
                <!-- Results Grid -->
                <div class="row row-cols-2 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
                    @foreach (var product in searchResult.Products)
                    {
                        <div class="col">
                            <div class="card product-card h-100 shadow-sm">
                                <a asp-area="Customer" asp-controller="Home" asp-action="Detail" asp-route-id="@product.Id"
                                   class="text-decoration-none">
                                    <div class="position-relative">
                                        <img src="~/@(product.ImageUrl ?? "images/products/noimage.jpg")" class="card-img-top product-image"
                                             alt="@product.Name" loading="lazy">
                                        @if (product.HasDiscount)
                                        {
                                            <span class="badge bg-danger position-absolute top-0 end-0 m-2">
                                                -@(Math.Round((1 - product.DiscountedPrice / product.Price) * 100))%
                                            </span>
                                        }
                                    </div>
                                </a>
                                <div class="card-body d-flex flex-column">
                                    <span class="badge bg-secondary mb-2 align-self-start">@product.ProductTypeName</span>
                                    <a asp-area="Customer" asp-controller="Home" asp-action="Detail" asp-route-id="@product.Id"
                                       class="text-decoration-none">
                                        <h6 class="card-title product-name mb-2">@product.Name</h6>
                                    </a>
                                    <div class="mt-auto">
                                        @if (product.HasDiscount)
                                        {
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="text-muted text-decoration-line-through small">
                                                    &#2547;@product.Price.ToString("N0")
                                                </span>
                                                <span class="text-danger fw-bold">
                                                    &#2547;@product.DiscountedPrice.ToString("N0")
                                                </span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-primary">&#2547;@product.Price.ToString("N0")</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <nav class="mt-4" aria-label="Search results pagination">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(pageNumber == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Search", new { q = ViewBag.Query, productType = ViewBag.ProductType, specialTag = ViewBag.SpecialTag, minPrice = ViewBag.MinPrice, maxPrice = ViewBag.MaxPrice, sortBy = ViewBag.SortBy, page = pageNumber - 1 })">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = Math.Max(1, pageNumber - 2); i <= Math.Min(totalPages, pageNumber + 2); i++)
                            {
                                <li class="page-item @(i == pageNumber ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Search", new { q = ViewBag.Query, productType = ViewBag.ProductType, specialTag = ViewBag.SpecialTag, minPrice = ViewBag.MinPrice, maxPrice = ViewBag.MaxPrice, sortBy = ViewBag.SortBy, page = i })">@i</a>
                                </li>
                            }
                            <li class="page-item @(pageNumber == totalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Search", new { q = ViewBag.Query, productType = ViewBag.ProductType, specialTag = ViewBag.SpecialTag, minPrice = ViewBag.MinPrice, maxPrice = ViewBag.MaxPrice, sortBy = ViewBag.SortBy, page = pageNumber + 1 })">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <!-- No Results -->
                <div class="text-center py-5">
                    <i class="fas fa-search fa-4x text-muted mb-4"></i>
                    <h4>@Localizer["NoProductsFound"]</h4>
                    @if (!string.IsNullOrEmpty(ViewBag.Query))
                    {
                        <p class="text-muted">@Localizer["NoProductsMatchingQuery"] "<strong>@ViewBag.Query</strong>"</p>
                        <p class="text-muted">@Localizer["TryDifferentKeywords"]</p>
                    }
                    else
                    {
                        <p class="text-muted">@Localizer["StartByTypingSearch"]</p>
                    }

                    <!-- Recommendations -->
                    @if (recommendations?.Any() == true)
                    {
                        <div class="mt-5">
                            <h5 class="mb-4">@Localizer["YouMightLikeTheseProducts"]</h5>
                            <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 g-3 justify-content-center">
                                @foreach (var rec in recommendations.Take(4))
                                {
                                    <div class="col">
                                        <div class="card product-card h-100 shadow-sm">
                                            <a asp-area="Customer" asp-controller="Home" asp-action="Detail" asp-route-id="@rec.ProductId"
                                               class="text-decoration-none">
                                                <img src="~/@(rec.ImageUrl ?? "images/products/noimage.jpg")" class="card-img-top product-image"
                                                     alt="@rec.Name" loading="lazy">
                                            </a>
                                            <div class="card-body">
                                                <h6 class="card-title product-name">@rec.Name</h6>
                                                <span class="fw-bold text-primary">&#2547;@rec.Price.ToString("N0")</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    .filters-card .card-header {
        border-radius: 10px 10px 0 0;
    }

    .filter-section {
        border-bottom: 1px solid #eee;
        padding-bottom: 1rem;
    }

    .filter-section:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .product-card {
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15) !important;
    }

    .product-image {
        height: 180px;
        object-fit: cover;
    }

    .product-name {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        color: var(--text-color, #333);
        font-size: 0.9rem;
    }

    .trending-badge {
        padding: 8px 12px;
        font-size: 0.85rem;
        transition: all 0.2s ease;
    }

    .trending-badge:hover {
        background-color: #ff6b6b !important;
        color: white !important;
        transform: scale(1.05);
    }

    /* Dark mode */
    [data-theme="dark"] .filters-card,
    [data-theme="dark"] .trending-card {
        background-color: #1e1e2d;
        border-color: #3d3d5c;
    }

    [data-theme="dark"] .filters-card .card-body,
    [data-theme="dark"] .trending-card .card-body {
        background-color: #1e1e2d;
    }

    [data-theme="dark"] .filter-section {
        border-bottom-color: #3d3d5c;
    }

    [data-theme="dark"] .product-card {
        background-color: #1e1e2d;
        border-color: #3d3d5c;
    }

    [data-theme="dark"] .trending-badge {
        background-color: #2a2a40 !important;
        color: #e0e0e0 !important;
    }

    [data-theme="dark"] .form-control,
    [data-theme="dark"] .form-select {
        background-color: #2a2a40;
        border-color: #3d3d5c;
        color: #e0e0e0;
    }

    [data-theme="dark"] .breadcrumb-item a {
        color: #4a6cf7;
    }

    [data-theme="dark"] .breadcrumb-item.active {
        color: #a0a0a0;
    }

    [data-theme="dark"] .page-link {
        background-color: #2a2a40;
        border-color: #3d3d5c;
        color: #e0e0e0;
    }

    [data-theme="dark"] .page-item.active .page-link {
        background-color: #4a6cf7;
        border-color: #4a6cf7;
    }

    @@media (max-width: 768px) {
        .product-image {
            height: 150px;
        }

        .product-name {
            font-size: 0.85rem;
        }
    }
</style>
