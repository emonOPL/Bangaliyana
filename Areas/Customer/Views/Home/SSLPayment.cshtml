@{
    ViewData["Title"] = Localizer["ProcessingPayment"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container text-center mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">@Localizer["ProcessingPayment"]</h4>
                    <p class="card-text">@Localizer["RedirectToPaymentGateway"]</p>
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Auto-submit form to SSL ECOMMERCE -->
<form id="sslPaymentForm" method="POST" action="@ViewBag.SSLUrl" style="display: none;">
    @foreach (var item in (Dictionary<string, string>)ViewBag.FormData)
    {
        <input type="hidden" name="@item.Key" value="@item.Value" />
    }
</form>

<script>
    // Auto-submit the form after a brief delay
    setTimeout(function() {
        document.getElementById('sslPaymentForm').submit();
    }, 2000);
    
    // Fallback: Show manual submit button if auto-submit fails
    setTimeout(function() {
        if (document.getElementById('sslPaymentForm').style.display === 'none') {
            document.getElementById('sslPaymentForm').style.display = 'block';
            document.querySelector('.card-body').innerHTML = `
                <h4 class="card-title">Redirect to Payment Gateway</h4>
                <p class="card-text">Click the button below to proceed to payment:</p>
                <button type="submit" form="sslPaymentForm" class="btn btn-primary">
                    Proceed to Payment
                </button>
            `;
        }
    }, 10000);
</script>