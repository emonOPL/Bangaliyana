        document.getElementById('modal-district')?.addEventListener('change', function() {
            const districtId = this.value;
            const upazilaSelect = document.getElementById('modal-upazila');
            upazilaSelect.innerHTML = '<option value="">Select Upazila</option>';

            if (districtId) {
                $.get('/api/address/upazilas/' + districtId, function(data) {
                    data.forEach(u => {
                        upazilaSelect.innerHTML += `<option value="${u.id}">${u.name}</option>`;
                    });
                });
            }
        });

        function loadAddressForEdit(addressId) {
            $.get('@Url.Action("GetAddress", "Home")/' + addressId, function(response) {
                if (response.success) {
                    const addr = response.address;
                    document.getElementById('address-id').value = addr.id;
                    document.getElementById('address-label').value = addr.label;
                    document.getElementById('address-type').value = addr.addressType;
                    document.getElementById('modal-recipient-name').value = addr.recipientName;
                    document.getElementById('modal-phone').value = addr.phone;
                    document.getElementById('modal-full-address').value = addr.fullAddress;
                    document.getElementById('modal-postal-code').value = addr.postalCode || '';
                    document.getElementById('modal-is-default').checked = addr.isDefault;

                    // Load divisions first, then cascade
                    $.get('/api/address/divisions', function(divisions) {
                        const divSelect = document.getElementById('modal-division');
                        divSelect.innerHTML = '<option value="">Select Division</option>';
                        divisions.forEach(d => {
                            divSelect.innerHTML += `<option value="${d.id}" ${d.id == addr.divisionId ? 'selected' : ''}>${d.name}</option>`;
                        });

                        if (addr.divisionId) {
                            $.get('/api/address/districts/' + addr.divisionId, function(districts) {
                                const distSelect = document.getElementById('modal-district');
                                distSelect.innerHTML = '<option value="">Select District</option>';
                                districts.forEach(d => {
                                    distSelect.innerHTML += `<option value="${d.id}" ${d.id == addr.districtId ? 'selected' : ''}>${d.name}</option>`;
                                });

                                if (addr.districtId) {
                                    $.get('/api/address/upazilas/' + addr.districtId, function(upazilas) {
                                        const upzSelect = document.getElementById('modal-upazila');
                                        upzSelect.innerHTML = '<option value="">Select Upazila</option>';
                                        upazilas.forEach(u => {
                                            upzSelect.innerHTML += `<option value="${u.id}" ${u.id == addr.upazilaId ? 'selected' : ''}>${u.name}</option>`;
                                        });
                                    });
                                }
                            });
                        }
                    });

                    document.getElementById('addressModalLabel').innerHTML = '<i class="fas fa-edit me-2"></i>Edit Address';
                    const modal = new bootstrap.Modal(document.getElementById('addressModal'));
                    modal.show();
                }
            });
        }

        document.getElementById('save-address-btn')?.addEventListener('click', function() {
            const addressData = {
                id: parseInt(document.getElementById('address-id').value) || 0,
                label: document.getElementById('address-label').value,
                addressType: parseInt(document.getElementById('address-type').value),
                recipientName: document.getElementById('modal-recipient-name').value,
                phone: document.getElementById('modal-phone').value,
                divisionId: parseInt(document.getElementById('modal-division').value) || null,
                districtId: parseInt(document.getElementById('modal-district').value) || null,
                upazilaId: parseInt(document.getElementById('modal-upazila').value) || null,
                fullAddress: document.getElementById('modal-full-address').value,
                postalCode: document.getElementById('modal-postal-code').value,
                isDefault: document.getElementById('modal-is-default').checked
            };

            $.ajax({
                url: '@Url.Action("SaveAddress", "Home")',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(addressData),
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert(response.message);
                    }
                },
                error: function() {
                    alert('Failed to save address. Please try again.');
                }
            });
        });

        function deleteAddress(addressId) {
            $.ajax({
                url: '@Url.Action("DeleteAddress", "Home")?id=' + addressId,
                method: 'POST',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert(response.message);
                    }
                }
            });
        }
    });
    </script>
