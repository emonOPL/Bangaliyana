@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
    // Disable jQuery validation on MFS section to prevent it from hiding elements
    $(document).ready(function() {
        var form = $('#checkout-form');
        if (form.length && form.data('validator')) {
            // Tell jQuery validation to ignore the MFS fields - they'll be validated manually
            form.data('validator').settings.ignore = ':hidden:not(#MobileBankingNumber):not(#TransactionId)';
        }
    });

    document.addEventListener('DOMContentLoaded', function() {
        const cartTotal = @Model.CartTotal;
        const originalDeliveryCharge = @(Model.IsPremiumMember ? 0 : 100);
        let deliveryCharge = @Model.DeliveryCharge;
        let freeDeliveryThreshold = @(ViewBag.FreeDeliveryThreshold ?? 0);
        const currencySymbol = '@Html.Raw(currencySymbol)';
        const hasSavedAddresses = @(hasSavedAddresses ? "true" : "false");

        // Coupon discount from cart
        const couponDiscountAmount = @(couponDiscountAmount);

        // Rewards and wallet state
        const isPremiumMember = @(Model.IsPremiumMember ? "true" : "false");
        const hasPremiumDiscount = @(Model.HasActivePremiumDiscount ? "true" : "false");
        const availableWalletBalance = Math.floor(@Model.AvailableWalletBalance); // Always use integer

        let selectedFreeShippingVoucherId = 0;
        let selectedDiscountVoucherId = 0;
        let selectedDiscountAmount = 0;
        let useWallet = false;
        let walletAmountToUse = 0;
        let premiumDiscountAmount = 0;

        // MFS Numbers from SiteSettings
        const mfsNumbers = {
            'bKash': '@ViewBag.BkashNumber',
            'Nagad': '@ViewBag.NagadNumber',
            'Rocket': '@ViewBag.RocketNumber',
            'Upay': '@ViewBag.UpayNumber'
        };

        // Address card selection
        document.querySelectorAll('.address-card').forEach(card => {
            card.addEventListener('click', function(e) {
                if (e.target.closest('.address-actions')) return;

                document.querySelectorAll('.address-card').forEach(c => c.classList.remove('selected'));
                this.classList.add('selected');

                const addressId = this.dataset.addressId;
                const districtId = this.dataset.districtId;

                document.getElementById('selected-address-id').value = addressId;
                document.getElementById('use-saved-address').value = 'true';

                // Fetch delivery charge based on district from server
                if (districtId) {
                    fetch('/api/address/delivery-charge-by-district/' + districtId)
                        .then(response => response.json())
                        .then(data => {
                            deliveryCharge = data.deliveryCharge || 100;
                            freeDeliveryThreshold = data.freeDeliveryThreshold || 0;
                            updateTotals();
                        })
                        .catch(err => {
                            console.error('Error fetching delivery charge:', err);
                            deliveryCharge = 100;
                            updateTotals();
                        });
                } else {
                    deliveryCharge = 100;
                    updateTotals();
                }
            });
        });

        // Add new address button
        document.getElementById('add-new-address-btn')?.addEventListener('click', function() {
            const modal = new bootstrap.Modal(document.getElementById('addressModal'));
            resetAddressModal();
            document.getElementById('addressModalLabel').innerHTML = '<i class="fas fa-map-marker-alt me-2"></i>Add New Address';
            modal.show();
        });

        // Cancel new address
        document.getElementById('cancel-new-address-btn')?.addEventListener('click', function() {
            document.getElementById('saved-addresses-section').style.display = '';
            document.getElementById('new-address-section').style.display = 'none';
            document.getElementById('use-saved-address').value = 'true';
        });

        // Sync save address checkbox with hidden field
        document.getElementById('save-address-checkbox')?.addEventListener('change', function() {
            document.getElementById('save-address-hidden').value = this.checked ? 'true' : 'false';
        });

        // Edit address
        document.querySelectorAll('.edit-address-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                const addressId = this.dataset.addressId;
                loadAddressForEdit(addressId);
            });
        });

        // Delete address - modal handling
        let addressIdToDelete = null;
        const deleteAddressModal = new bootstrap.Modal(document.getElementById('deleteAddressModal'));

        document.querySelectorAll('.delete-address-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                addressIdToDelete = this.dataset.addressId;
                deleteAddressModal.show();
            });
        });

        document.getElementById('confirmDeleteAddressBtn')?.addEventListener('click', function() {
            if (addressIdToDelete) {
                deleteAddressModal.hide();
                deleteAddress(addressIdToDelete);
                addressIdToDelete = null;
            }
        });

        // Payment method selection
        // Track the currently selected MFS method
        let currentMfsMethod = null;

        // Helper function to check if a method is MFS
        function isMfsMethod(method) {
            return method === 'bKash' || method === 'Nagad' || method === 'Rocket' || method === 'Upay';
        }

        // Helper function to update MFS display
        function updateMfsDisplay(method) {
            const mfsBankingSection = document.getElementById('mobile-banking-details');
            const cardPaymentSection = document.getElementById('card-payment-info');
            const mfsProviderSpan = document.getElementById('mfs-provider');
            const mfsNumberSpan = document.getElementById('mfs-number');

            // Remove active classes and hide all payment info sections first
            if (mfsBankingSection) {
                mfsBankingSection.classList.remove('mfs-active');
                mfsBankingSection.style.display = 'none';
            }
            if (cardPaymentSection) {
                cardPaymentSection.classList.remove('card-active');
                cardPaymentSection.style.display = 'none';
            }

            if (isMfsMethod(method)) {
                if (mfsBankingSection) {
                    // Use CSS class with !important to force visibility
                    mfsBankingSection.classList.add('mfs-active');
                    mfsBankingSection.style.display = 'block';
                }
                if (mfsProviderSpan) {
                    mfsProviderSpan.textContent = method;
                }
                if (mfsNumberSpan) {
                    mfsNumberSpan.textContent = mfsNumbers[method] || '';
                }
                currentMfsMethod = method;
            } else if (method === 'CreditDebitCard') {
                if (cardPaymentSection) {
                    cardPaymentSection.classList.add('card-active');
                    cardPaymentSection.style.display = 'block';
                }
                currentMfsMethod = null;
            } else {
                currentMfsMethod = null;
            }
        }

        // Payment option click handlers
        const paymentOptions = document.querySelectorAll('.payment-option');
        paymentOptions.forEach(function(option) {
            option.addEventListener('click', function(e) {
                // Remove selected from all
                paymentOptions.forEach(function(o) {
                    o.classList.remove('selected');
                });
                // Add selected to clicked
                this.classList.add('selected');

                // Check the radio button
                const radio = this.querySelector('input[type="radio"]');
                if (radio) {
                    radio.checked = true;
                }

                // Update MFS display
                const method = this.getAttribute('data-method');
                updateMfsDisplay(method);
            });
        });

        // Initialize payment method display on page load
        function initPaymentDisplay() {
            const selectedPayment = document.querySelector('.payment-option.selected');
            if (selectedPayment) {
                const method = selectedPayment.getAttribute('data-method');
                updateMfsDisplay(method);
            }
        }

        // Run immediately
        initPaymentDisplay();

        // Also run after delays to counter any jQuery validation interference
        setTimeout(initPaymentDisplay, 100);
        setTimeout(initPaymentDisplay, 500);
        setTimeout(initPaymentDisplay, 1000);
        setTimeout(initPaymentDisplay, 2000);
        setTimeout(initPaymentDisplay, 3000);

        // Continuously protect MFS display for the first 10 seconds
        let protectionCount = 0;
        const protectionInterval = setInterval(function() {
            protectionCount++;
            const mfsBankingSection = document.getElementById('mobile-banking-details');
            const cardPaymentSection = document.getElementById('card-payment-info');

            if (mfsBankingSection && currentMfsMethod && isMfsMethod(currentMfsMethod)) {
                // Ensure the mfs-active class is present AND inline style is set
                if (!mfsBankingSection.classList.contains('mfs-active')) {
                    mfsBankingSection.classList.add('mfs-active');
                }
                // Force inline style to block
                if (mfsBankingSection.style.display !== 'block') {
                    mfsBankingSection.style.display = 'block';
                }
            }

            // Also protect card payment section if Credit/Debit Card is selected
            if (cardPaymentSection && currentMfsMethod === null) {
                const selectedPayment = document.querySelector('.payment-option.selected');
                if (selectedPayment && selectedPayment.getAttribute('data-method') === 'CreditDebitCard') {
                    if (!cardPaymentSection.classList.contains('card-active')) {
                        cardPaymentSection.classList.add('card-active');
                    }
                    if (cardPaymentSection.style.display !== 'block') {
                        cardPaymentSection.style.display = 'block';
                    }
                }
            }

            // Stop after 10 seconds (100 iterations at 100ms)
            if (protectionCount >= 100) {
                clearInterval(protectionInterval);
            }
        }, 100);

        function updateTotals() {
            // Calculate effective delivery charge
            let effectiveDeliveryCharge = deliveryCharge;

            // Premium members get free shipping automatically
            if (isPremiumMember) {
                effectiveDeliveryCharge = 0;
            }
            // Or if order qualifies for free delivery based on threshold
            else if (freeDeliveryThreshold > 0 && cartTotal >= freeDeliveryThreshold) {
                effectiveDeliveryCharge = 0;
            }
            // Or if a free shipping voucher is selected (and not premium)
            else if (selectedFreeShippingVoucherId > 0) {
                effectiveDeliveryCharge = 0;
            }

            // Calculate premium discount (5% if active)
            premiumDiscountAmount = 0;
            if (hasPremiumDiscount) {
                premiumDiscountAmount = Math.round(cartTotal * 0.05);
            }

            // Calculate wallet amount (can't exceed remaining total) - always integer
            let maxWalletUsable = Math.floor(cartTotal + effectiveDeliveryCharge - selectedDiscountAmount - premiumDiscountAmount - couponDiscountAmount);
            if (maxWalletUsable < 0) maxWalletUsable = 0;
            if (useWallet && walletAmountToUse > 0) {
                walletAmountToUse = Math.floor(Math.min(walletAmountToUse, maxWalletUsable, availableWalletBalance));
            } else {
                walletAmountToUse = 0;
            }

            // Calculate grand total (including coupon discount) - always integer
            let grandTotal = Math.floor(cartTotal + effectiveDeliveryCharge - premiumDiscountAmount - selectedDiscountAmount - walletAmountToUse - couponDiscountAmount);
            if (grandTotal < 0) grandTotal = 0;

            // Calculate total savings (including coupon discount) - always integer
            let totalSavings = Math.floor((deliveryCharge - effectiveDeliveryCharge) + premiumDiscountAmount + selectedDiscountAmount + walletAmountToUse + couponDiscountAmount);

            // Update delivery charge display
            const deliveryRow = document.getElementById('delivery-charge-row');
            const deliveryDisplay = document.getElementById('delivery-charge-display');
            if (effectiveDeliveryCharge === 0 && deliveryCharge > 0) {
                deliveryDisplay.innerHTML = '<span class="text-decoration-line-through text-muted me-2">' + currencySymbol + deliveryCharge.toLocaleString() + '</span><span class="text-success">FREE</span>';
            } else {
                deliveryDisplay.textContent = currencySymbol + effectiveDeliveryCharge.toLocaleString();
            }

            // Update premium discount row
            const premiumRow = document.getElementById('premium-discount-row');
            const premiumDisplay = document.getElementById('premium-discount-display');
            if (premiumDiscountAmount > 0) {
                premiumRow.style.display = 'flex';
                premiumRow.style.cssText = 'display: flex !important;';
                premiumDisplay.textContent = '-' + currencySymbol + premiumDiscountAmount.toLocaleString();
            } else {
                premiumRow.style.display = 'none';
                premiumRow.style.cssText = 'display: none !important;';
            }

            // Update voucher discount row
            const voucherRow = document.getElementById('voucher-discount-row');
            const voucherDisplay = document.getElementById('voucher-discount-display');
            if (selectedDiscountAmount > 0) {
                voucherRow.style.display = 'flex';
                voucherRow.style.cssText = 'display: flex !important;';
                voucherDisplay.textContent = '-' + currencySymbol + selectedDiscountAmount.toLocaleString();
            } else {
                voucherRow.style.display = 'none';
                voucherRow.style.cssText = 'display: none !important;';
            }

            // Update wallet discount row
            const walletRow = document.getElementById('wallet-discount-row');
            const walletDisplay = document.getElementById('wallet-discount-display');
            if (walletAmountToUse > 0) {
                walletRow.style.display = 'flex';
                walletRow.style.cssText = 'display: flex !important;';
                walletDisplay.textContent = '-' + currencySymbol + walletAmountToUse.toLocaleString();
            } else {
                walletRow.style.display = 'none';
                walletRow.style.cssText = 'display: none !important;';
            }

            // Update grand total
            document.getElementById('grand-total').textContent = currencySymbol + grandTotal.toLocaleString();

            // Update savings message
            const savingsMessage = document.getElementById('savings-message');
            const totalSavingsDisplay = document.getElementById('total-savings');
            if (savingsMessage && totalSavings > 0) {
                savingsMessage.style.display = 'inline';
                totalSavingsDisplay.textContent = currencySymbol + totalSavings.toLocaleString();
            } else if (savingsMessage) {
                savingsMessage.style.display = 'none';
            }

            // Update hidden form fields
            document.getElementById('delivery-charge-hidden').value = effectiveDeliveryCharge;
            document.getElementById('selected-discount-reward-id').value = selectedDiscountVoucherId || '';
            document.getElementById('selected-free-shipping-reward-id').value = selectedFreeShippingVoucherId || '';
            document.getElementById('use-wallet-balance').value = useWallet ? 'true' : 'false';
            document.getElementById('wallet-amount-to-use').value = walletAmountToUse;
        }

        // Listen for delivery charge updates from address fields
        document.addEventListener('deliveryChargeUpdated', function(event) {
            deliveryCharge = event.detail.deliveryCharge;
            updateTotals();
        });

        // Voucher option selection handlers
        document.querySelectorAll('.voucher-option[data-type="shipping"]').forEach(option => {
            option.addEventListener('click', function() {
                // Remove selection from all shipping vouchers
                document.querySelectorAll('.voucher-option[data-type="shipping"]').forEach(opt => {
                    opt.classList.remove('selected');
                    opt.querySelector('input[type="radio"]').checked = false;
                });

                // Select this one
                this.classList.add('selected');
                const radio = this.querySelector('input[type="radio"]');
                radio.checked = true;

                // Update state
                selectedFreeShippingVoucherId = parseInt(this.dataset.voucherId) || 0;
                updateTotals();
            });
        });

        document.querySelectorAll('.voucher-option[data-type="discount"]').forEach(option => {
            option.addEventListener('click', function() {
                const minOrder = parseFloat(this.dataset.min) || 0;
                const discountAmount = parseFloat(this.dataset.amount) || 0;
                const voucherId = parseInt(this.dataset.voucherId) || 0;

                // Check minimum order requirement
                if (voucherId > 0 && cartTotal < minOrder) {
                    alert('Your cart total (' + currencySymbol + cartTotal.toLocaleString() + ') is below the minimum order requirement (' + currencySymbol + minOrder.toLocaleString() + ') for this voucher.');
                    return;
                }

                // Remove selection from all discount vouchers
                document.querySelectorAll('.voucher-option[data-type="discount"]').forEach(opt => {
                    opt.classList.remove('selected');
                    opt.querySelector('input[type="radio"]').checked = false;
                });

                // Select this one
                this.classList.add('selected');
                const radio = this.querySelector('input[type="radio"]');
                radio.checked = true;

                // Update state
                selectedDiscountVoucherId = voucherId;
                selectedDiscountAmount = discountAmount;
                updateTotals();
            });
        });

        // Wallet checkbox handler
        const walletCheckbox = document.getElementById('use-wallet-checkbox');
        const walletAmountSection = document.getElementById('wallet-amount-section');
        const walletAmountInput = document.getElementById('wallet-amount-input');
        const useFullWalletBtn = document.getElementById('use-full-wallet-btn');

        if (walletCheckbox) {
            walletCheckbox.addEventListener('change', function() {
                useWallet = this.checked;
                if (walletAmountSection) {
                    walletAmountSection.style.display = this.checked ? 'block' : 'none';
                }
                if (this.checked && walletAmountInput) {
                    walletAmountToUse = parseFloat(walletAmountInput.value) || 0;
                } else {
                    walletAmountToUse = 0;
                }
                updateTotals();
            });
        }

        if (walletAmountInput) {
            walletAmountInput.addEventListener('input', function() {
                // Only allow integer values
                let value = Math.floor(parseFloat(this.value) || 0);
                if (value < 0) value = 0;
                if (value > availableWalletBalance) value = availableWalletBalance;
                this.value = value; // Update input to show integer
                walletAmountToUse = value;
                updateTotals();
            });
        }

        if (useFullWalletBtn) {
            useFullWalletBtn.addEventListener('click', function() {
                if (walletAmountInput) {
                    walletAmountInput.value = availableWalletBalance; // Already integer from Math.floor
                    walletAmountToUse = availableWalletBalance;
                    updateTotals();
                }
            });
        }

        // Initialize totals on page load
        updateTotals();

        // Form submission handler
        function submitCheckoutForm(e) {
            if (e) e.preventDefault();
            console.log('Form submission triggered');

            clearValidationMessages();

            if (!validateForm()) {
                console.log('Form validation failed');
                return false;
            }

            console.log('Form validation passed, submitting...');
            showLoadingState();

            const form = document.getElementById('checkout-form');
            const formData = new FormData(form);

            // Ensure MFS fields are included in FormData even if parent is hidden
            const selectedPaymentMethod = document.querySelector('input[name="PaymentMethod"]:checked')?.value;
            if (selectedPaymentMethod === 'bKash' || selectedPaymentMethod === 'Nagad' || selectedPaymentMethod === 'Rocket' || selectedPaymentMethod === 'Upay') {
                const mobileNumber = document.getElementById('MobileBankingNumber')?.value?.trim();
                const transactionId = document.getElementById('TransactionId')?.value?.trim();

                // Strip +88 prefix if present to match server validation (01XXXXXXXXX format)
                let cleanedMobileNumber = mobileNumber;
                if (mobileNumber && mobileNumber.startsWith('+88')) {
                    cleanedMobileNumber = mobileNumber.substring(3);
                } else if (mobileNumber && mobileNumber.startsWith('88')) {
                    cleanedMobileNumber = mobileNumber.substring(2);
                }

                // Explicitly set/override the values in FormData
                if (cleanedMobileNumber) {
                    formData.set('MobileBankingNumber', cleanedMobileNumber);
                }
                if (transactionId) {
                    formData.set('TransactionId', transactionId);
                }
            }

            // Log form data for debugging
            console.log('Form action:', '@Url.Action("Checkout", "Home")');
            for (let [key, value] of formData.entries()) {
                console.log('Form data:', key, '=', value);
            }

            $.ajax({
                url: '@Url.Action("Checkout", "Home")',
                method: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: handleCheckoutSuccess,
                error: handleCheckoutError
            });

            return false;
        }

        // Form submit event listener
        document.getElementById('checkout-form').addEventListener('submit', submitCheckoutForm);

        // Also add click handler to the button directly (fallback)
        document.getElementById('place-order-btn').addEventListener('click', function(e) {
            console.log('Place Order button clicked');
            e.preventDefault();
            submitCheckoutForm(e);
        });

        function validateForm() {
            let isValid = true;
            let firstErrorField = null;

            // Clear previous validation messages
            clearValidationMessages();

            const useSavedAddress = document.getElementById('use-saved-address').value === 'true';
            const selectedAddressId = document.getElementById('selected-address-id').value;

            if (useSavedAddress && hasSavedAddresses) {
                if (!selectedAddressId) {
                    showFieldError('address-cards', 'Please select a delivery address');
                    isValid = false;
                    if (!firstErrorField) firstErrorField = document.getElementById('address-cards');
                }
            } else {
                // Validate new address fields
                const customerName = document.getElementById('CustomerName')?.value?.trim();
                const phone = document.getElementById('Phone')?.value?.trim();
                const divisionId = document.getElementById('DivisionId')?.value;
                const districtId = document.getElementById('DistrictId')?.value;
                const upazilaId = document.getElementById('UpazilaId')?.value;
                const address = document.getElementById('Address')?.value?.trim();

                if (!customerName) {
                    showFieldError('CustomerName', 'Full name is required');
                    isValid = false;
                    if (!firstErrorField) firstErrorField = document.getElementById('CustomerName');
                }
                if (!phone) {
                    showFieldError('Phone', 'Phone number is required');
                    isValid = false;
                    if (!firstErrorField) firstErrorField = document.getElementById('Phone');
                } else {
                    // Validate Bangladesh phone number format
                    const phoneRegex = /^(?:\+?88)?01[3-9]\d{8}$/;
                    if (!phoneRegex.test(phone)) {
                        showFieldError('Phone', 'Please enter a valid Bangladeshi phone number');
                        isValid = false;
                        if (!firstErrorField) firstErrorField = document.getElementById('Phone');
                    }
                }
                if (!divisionId) {
                    showFieldError('DivisionId', 'Division is required');
                    isValid = false;
                    if (!firstErrorField) firstErrorField = document.getElementById('DivisionId');
                }
                if (!districtId) {
                    showFieldError('DistrictId', 'District is required');
                    isValid = false;
                    if (!firstErrorField) firstErrorField = document.getElementById('DistrictId');
                }
                if (!upazilaId) {
                    showFieldError('UpazilaId', 'Upazila is required');
                    isValid = false;
                    if (!firstErrorField) firstErrorField = document.getElementById('UpazilaId');
                }
                if (!address) {
                    showFieldError('Address', 'Address is required');
                    isValid = false;
                    if (!firstErrorField) firstErrorField = document.getElementById('Address');
                }
            }

            // Validate payment method
            const paymentMethod = document.querySelector('input[name="PaymentMethod"]:checked');
            if (!paymentMethod) {
                showFieldError('payment-method-section', 'Please select a payment method');
                isValid = false;
                if (!firstErrorField) firstErrorField = document.querySelector('.payment-option');
            } else {
                // If bKash, Nagad, Rocket, or Upay is selected, validate mobile banking fields
                const selectedMethod = paymentMethod.value;
                if (selectedMethod === 'bKash' || selectedMethod === 'Nagad' || selectedMethod === 'Rocket' || selectedMethod === 'Upay') {
                    const mobileNumber = document.getElementById('MobileBankingNumber')?.value?.trim();
                    const transactionId = document.getElementById('TransactionId')?.value?.trim();

                    if (!mobileNumber) {
                        showFieldError('MobileBankingNumber', 'Mobile number is required');
                        isValid = false;
                        if (!firstErrorField) firstErrorField = document.getElementById('MobileBankingNumber');
                    } else {
                        // Validate Bangladesh phone number format
                        const phoneRegex = /^(?:\+?88)?01[3-9]\d{8}$/;
                        if (!phoneRegex.test(mobileNumber)) {
                            showFieldError('MobileBankingNumber', 'Please enter a valid mobile number');
                            isValid = false;
                            if (!firstErrorField) firstErrorField = document.getElementById('MobileBankingNumber');
                        }
                    }
                    if (!transactionId) {
                        showFieldError('TransactionId', 'Transaction ID is required');
                        isValid = false;
                        if (!firstErrorField) firstErrorField = document.getElementById('TransactionId');
                    }
                }
            }

            // Scroll to first error field
            if (!isValid && firstErrorField) {
                firstErrorField.scrollIntoView({ behavior: 'smooth', block: 'center' });
                if (firstErrorField.focus) firstErrorField.focus();
            }

            return isValid;
        }

        function showFieldError(fieldId, message) {
            const field = document.getElementById(fieldId);
            if (field) {
                // Add is-invalid class to the field
                field.classList.add('is-invalid');

                // Check if error span already exists
                let errorSpan = field.parentElement.querySelector('.field-validation-error');
                if (!errorSpan) {
                    errorSpan = document.createElement('span');
                    errorSpan.className = 'field-validation-error text-danger small d-block mt-1';
                    field.parentElement.appendChild(errorSpan);
                }
                errorSpan.textContent = message;
            }
        }

        function clearValidationMessages() {
            // Remove is-invalid class from all fields
            document.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
            // Remove all field validation error messages
            document.querySelectorAll('.field-validation-error').forEach(el => el.remove());
            // Hide validation summary if visible
            const validationSummary = document.getElementById('validation-summary');
            const validationErrors = document.getElementById('validation-errors');
            if (validationSummary) validationSummary.style.display = 'none';
            if (validationErrors) validationErrors.innerHTML = '';
        }

        function showLoadingState() {
            document.getElementById('place-order-btn').disabled = true;
            document.getElementById('btn-text').classList.add('d-none');
            document.getElementById('btn-spinner').classList.remove('d-none');
        }

        function hideLoadingState() {
            document.getElementById('place-order-btn').disabled = false;
            document.getElementById('btn-text').classList.remove('d-none');
            document.getElementById('btn-spinner').classList.add('d-none');
        }

        function showErrors(errors) {
            const validationSummary = document.getElementById('validation-summary');
            const validationErrors = document.getElementById('validation-errors');

            if (validationSummary && validationErrors) {
                validationErrors.innerHTML = '';
                errors.forEach(error => {
                    const li = document.createElement('li');
                    li.textContent = error;
                    validationErrors.appendChild(li);
                });
                validationSummary.style.display = 'block';
                validationSummary.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }

        function handleCheckoutSuccess(response) {
            console.log('Checkout response:', response);
            hideLoadingState();

            if (response.success) {
                console.log('Order successful, redirecting...');
                if (response.paymentUrl) {
                    console.log('Redirecting to payment URL:', response.paymentUrl);
                    window.location.href = response.paymentUrl;
                } else if (response.redirectUrl) {
                    console.log('Redirecting to:', response.redirectUrl);
                    window.location.href = response.redirectUrl;
                } else {
                    const url = '@Url.Action("OrderConfirmation", "Home")/' + response.orderId;
                    console.log('Redirecting to OrderConfirmation:', url);
                    window.location.href = url;
                }
            } else {
                console.log('Order failed:', response);
                if (response.errors) {
                    const errorMessages = [];
                    Object.values(response.errors).forEach(errs => {
                        errs.forEach(err => errorMessages.push(err));
                    });
                    showErrors(errorMessages);
                } else {
                    showErrors([response.message || 'An error occurred. Please try again.']);
                }
            }
        }

        function handleCheckoutError(xhr, status, error) {
            console.error('Checkout AJAX error:', status, error);
            console.error('XHR response:', xhr.responseText);
            hideLoadingState();
            showErrors(['An error occurred while processing your order. Please try again.']);
        }

        // Address Modal Functions
        function resetAddressModal() {
            document.getElementById('address-id').value = '0';
            document.getElementById('address-label').value = '';
            document.getElementById('address-type').value = '0';
            document.getElementById('modal-recipient-name').value = '';
            document.getElementById('modal-phone').value = '';
            document.getElementById('modal-division').innerHTML = '<option value="">Select Division</option>';
            document.getElementById('modal-district').innerHTML = '<option value="">Select District</option>';
            document.getElementById('modal-upazila').innerHTML = '<option value="">Select Upazila</option>';
