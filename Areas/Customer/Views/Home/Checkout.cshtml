@model Bangaliyana.Models.CheckoutViewModel
@using System.Globalization
@using Bangaliyana.Extensions
@using Bangaliyana.Models

@{
    ViewData["Title"] = Localizer["Checkout"].Value;
    var currencySymbol = "৳";
    var hasSavedAddresses = Model.SavedAddresses?.Any() == true;
    var isCODAllowed = ViewBag.IsCODAllowed ?? true;
    var codRestrictionReason = ViewBag.CODRestrictionReason as string;
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home", new { area = "Customer" })" class="text-decoration-none">@Localizer["Home"]</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Cart", "Home", new { area = "Customer" })" class="text-decoration-none">@Localizer["Cart"]</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Localizer["Checkout"]</li>
        </ol>
    </nav>

    <h2 class="mb-4"><i class="fas fa-shopping-bag me-2"></i>@Localizer["Checkout"]</h2>

    <div class="row g-4">
        <!-- Left Column - Checkout Form -->
        <div class="col-lg-7">
            <form id="checkout-form" asp-action="Checkout" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="DeliveryCharge" id="delivery-charge-hidden" />
                <input type="hidden" asp-for="UseSavedAddress" id="use-saved-address" />
                <input type="hidden" asp-for="SelectedAddressId" id="selected-address-id" />
                <input type="hidden" asp-for="SaveAddress" id="save-address-hidden" value="true" />
                <input type="hidden" asp-for="SelectedDiscountRewardId" id="selected-discount-reward-id" />
                <input type="hidden" asp-for="SelectedFreeShippingRewardId" id="selected-free-shipping-reward-id" />
                <input type="hidden" asp-for="UseWalletBalance" id="use-wallet-balance" value="false" />
                <input type="hidden" asp-for="WalletAmountToUse" id="wallet-amount-to-use" value="0" />

                <!-- Validation Summary -->
                <div id="validation-summary" class="alert alert-danger" style="display: none;">
                    <h6><i class="fas fa-exclamation-triangle me-2"></i>@Localizer["PleaseFixErrors"]</h6>
                    <ul id="validation-errors" class="mb-0"></ul>
                </div>

                <!-- Delivery Address Section -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="fas fa-map-marker-alt me-2"></i>@Localizer["DeliveryAddress"]</h5>
                    </div>
                    <div class="card-body">
                        @if (hasSavedAddresses)
                        {
                            <!-- Saved Addresses -->
                            <div id="saved-addresses-section">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="mb-0">@Localizer["SelectDeliveryAddress"]</h6>
                                    <button type="button" class="btn btn-outline-success btn-sm" id="add-new-address-btn">
                                        <i class="fas fa-plus me-1"></i>@Localizer["AddNewAddress"]
                                    </button>
                                </div>

                                <div class="row g-3" id="address-cards">
                                    @foreach (var address in Model.SavedAddresses)
                                    {
                                        <div class="col-md-6">
                                            <div class="card address-card @(address.Id == Model.SelectedAddressId ? "selected" : "")"
                                                 data-address-id="@address.Id"
                                                 data-division-id="@address.DivisionId"
                                                 data-district-id="@address.DistrictId"
                                                 data-division-name="@address.Division?.Name">
                                                <div class="card-body p-3">
                                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                                        <div>
                                                            <span class="badge @(address.AddressType == AddressType.Home ? "bg-primary" : address.AddressType == AddressType.Office ? "bg-info" : "bg-secondary") me-1">
                                                                <i class="fas @(address.AddressType == AddressType.Home ? "fa-home" : address.AddressType == AddressType.Office ? "fa-building" : "fa-map-pin") me-1"></i>
                                                                @address.AddressType
                                                            </span>
                                                            @if (address.IsDefault)
                                                            {
                                                                <span class="badge bg-success">@Localizer["Default"]</span>
                                                            }
                                                        </div>
                                                        <div class="address-actions">
                                                            <button type="button" class="btn btn-sm btn-link text-muted p-0 edit-address-btn" data-address-id="@address.Id" title="Edit">
                                                                <i class="fas fa-edit"></i>
                                                            </button>
                                                            <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-2 delete-address-btn" data-address-id="@address.Id" title="Delete">
                                                                <i class="fas fa-trash"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                    <h6 class="mb-1">@address.RecipientName</h6>
                                                    <p class="text-muted small mb-1">@address.Phone</p>
                                                    <p class="small mb-0 address-text">
                                                        @address.FullAddress@(address.Upazila != null ? $", {address.Upazila.Name}" : "")@(address.District != null ? $", {address.District.Name}" : "")@(address.Division != null ? $", {address.Division.Name}" : "")
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- New Address Form (hidden if saved addresses exist) -->
                        <div id="new-address-section" style="@(hasSavedAddresses ? "display: none;" : "")">
                            @if (hasSavedAddresses)
                            {
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="mb-0">@Localizer["AddNewAddress"]</h6>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" id="cancel-new-address-btn">
                                        <i class="fas fa-times me-1"></i>@Localizer["Cancel"]
                                    </button>
                                </div>
                            }

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="CustomerName" class="form-label">@Localizer["FullName"] <span class="text-danger">*</span></label>
                                    <input asp-for="CustomerName" class="form-control" placeholder="@Localizer["EnterRecipientName"]" />
                                    <span asp-validation-for="CustomerName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Phone" class="form-label">@Localizer["Phone"] <span class="text-danger">*</span></label>
                                    <input asp-for="Phone" class="form-control" placeholder="01XXXXXXXXX" />
                                    <span asp-validation-for="Phone" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Email" class="form-label">@Localizer["Email"] <span class="text-danger">*</span></label>
                                    <input asp-for="Email" class="form-control" type="email" placeholder="your@email.com" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                            </div>

                            <!-- Address Fields -->
                            <div class="mt-3">
                                @{
                                    ViewData["DivisionField"] = "DivisionId";
                                    ViewData["DistrictField"] = "DistrictId";
                                    ViewData["UpazilaField"] = "UpazilaId";
                                    ViewData["AddressField"] = "Address";
                                    ViewData["PostalCodeField"] = "PostalCode";

                                    ViewData["SelectedDivision"] = Model.DivisionId?.ToString() ?? "";
                                    ViewData["SelectedDistrict"] = Model.DistrictId?.ToString() ?? "";
                                    ViewData["SelectedUpazila"] = Model.UpazilaId?.ToString() ?? "";
                                    ViewData["AddressValue"] = Model.Address ?? "";
                                    ViewData["PostalCodeValue"] = Model.PostalCode ?? "";
                                    ViewData["IsCheckout"] = "true";
                                }
                                @await Html.PartialAsync("_AddressFields")
                            </div>

                            <!-- Save Address Checkbox -->
                            <div class="form-check mt-3">
                                <input class="form-check-input" type="checkbox" id="save-address-checkbox" checked>
                                <label class="form-check-label" for="save-address-checkbox">
                                    @Localizer["SaveAddressForFuture"]
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Delivery Instructions -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="fas fa-sticky-note me-2"></i>@Localizer["DeliveryInstructions"]</h5>
                    </div>
                    <div class="card-body">
                        <textarea asp-for="DeliveryInstructions" class="form-control" rows="2"
                                  placeholder="@Localizer["DeliveryInstructionsPlaceholder"]"></textarea>
                        <small class="text-muted">@Localizer["Max500Characters"]</small>
                    </div>
                </div>

                <!-- Payment Method Section -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="fas fa-credit-card me-2"></i>@Localizer["PaymentMethod"]</h5>
                    </div>
                    <div class="card-body">
                        @if (!isCODAllowed)
                        {
                            <div class="alert alert-warning mb-3">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                <strong>@Localizer["CODRestricted"]:</strong> @Localizer["CODNotAvailable"]
                                @if (!string.IsNullOrEmpty(codRestrictionReason))
                                {
                                    <br /><small class="text-muted">Reason: @codRestrictionReason</small>
                                }
                            </div>
                        }
                        <div class="row g-3" id="payment-method-section">
                            <!-- Cash on Delivery -->
                            <div class="col-md-6 col-lg-4">
                                @if (isCODAllowed)
                                {
                                    <div class="payment-option @(Model.PaymentMethod == PaymentMethod.CashOnDelivery ? "selected" : "")" data-method="CashOnDelivery">
                                        <input class="form-check-input d-none" type="radio" name="PaymentMethod" value="CashOnDelivery"
                                               id="pm_CashOnDelivery" @(Model.PaymentMethod == PaymentMethod.CashOnDelivery ? "checked" : "") />
                                        <label class="payment-label" for="pm_CashOnDelivery">
                                            <div class="payment-logo">
                                                <img src="~/images/logos/cod-logo.png" alt="Cash on Delivery" />
                                            </div>
                                            <span>Cash on Delivery</span>
                                        </label>
                                    </div>
                                }
                                else
                                {
                                    <div class="payment-option disabled" data-method="CashOnDelivery" data-bs-toggle="tooltip" data-bs-placement="top" title="COD is not available for your account">
                                        <label class="payment-label">
                                            <div class="payment-logo disabled-logo">
                                                <img src="~/images/logos/cod-logo.png" alt="Cash on Delivery" />
                                            </div>
                                            <span>Cash on Delivery</span>
                                            <small class="text-danger d-block mt-1"><i class="fas fa-ban"></i> Restricted</small>
                                        </label>
                                    </div>
                                }
                            </div>

                            <!-- bKash -->
                            <div class="col-md-6 col-lg-4">
                                <div class="payment-option @(Model.PaymentMethod == PaymentMethod.bKash ? "selected" : "")" data-method="bKash">
                                    <input class="form-check-input d-none" type="radio" name="PaymentMethod" value="bKash"
                                           id="pm_bKash" @(Model.PaymentMethod == PaymentMethod.bKash ? "checked" : "") />
                                    <label class="payment-label" for="pm_bKash">
                                        <div class="payment-logo">
                                            <img src="~/images/logos/bkash-logo.png" alt="bKash" />
                                        </div>
                                        <span>bKash</span>
                                    </label>
                                </div>
                            </div>

                            <!-- Nagad -->
                            <div class="col-md-6 col-lg-4">
                                <div class="payment-option @(Model.PaymentMethod == PaymentMethod.Nagad ? "selected" : "")" data-method="Nagad">
                                    <input class="form-check-input d-none" type="radio" name="PaymentMethod" value="Nagad"
                                           id="pm_Nagad" @(Model.PaymentMethod == PaymentMethod.Nagad ? "checked" : "") />
                                    <label class="payment-label" for="pm_Nagad">
                                        <div class="payment-logo">
                                            <img src="~/images/logos/nagad-logo.png" alt="Nagad" />
                                        </div>
                                        <span>Nagad</span>
                                    </label>
                                </div>
                            </div>

                            <!-- Rocket -->
                            <div class="col-md-6 col-lg-4">
                                <div class="payment-option @(Model.PaymentMethod == PaymentMethod.Rocket ? "selected" : "")" data-method="Rocket">
                                    <input class="form-check-input d-none" type="radio" name="PaymentMethod" value="Rocket"
                                           id="pm_Rocket" @(Model.PaymentMethod == PaymentMethod.Rocket ? "checked" : "") />
                                    <label class="payment-label" for="pm_Rocket">
                                        <div class="payment-logo">
                                            <img src="~/images/logos/rocket-logo.png" alt="Rocket" />
                                        </div>
                                        <span>Rocket</span>
                                    </label>
                                </div>
                            </div>

                            <!-- Upay -->
                            <div class="col-md-6 col-lg-4">
                                <div class="payment-option @(Model.PaymentMethod == PaymentMethod.Upay ? "selected" : "")" data-method="Upay">
                                    <input class="form-check-input d-none" type="radio" name="PaymentMethod" value="Upay"
                                           id="pm_Upay" @(Model.PaymentMethod == PaymentMethod.Upay ? "checked" : "") />
                                    <label class="payment-label" for="pm_Upay">
                                        <div class="payment-logo">
                                            <img src="~/images/logos/upay-logo.png" alt="Upay" />
                                        </div>
                                        <span>Upay</span>
                                    </label>
                                </div>
                            </div>

                            <!-- Credit/Debit Card -->
                            <div class="col-md-6 col-lg-4">
                                <div class="payment-option @(Model.PaymentMethod == PaymentMethod.CreditDebitCard ? "selected" : "")" data-method="CreditDebitCard">
                                    <input class="form-check-input d-none" type="radio" name="PaymentMethod" value="CreditDebitCard"
                                           id="pm_CreditDebitCard" @(Model.PaymentMethod == PaymentMethod.CreditDebitCard ? "checked" : "") />
                                    <label class="payment-label" for="pm_CreditDebitCard">
                                        <div class="payment-icon card-payment">
                                            <i class="fas fa-credit-card"></i>
                                        </div>
                                        <span>Card Payment</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Mobile Banking Details (shown for bKash, Nagad, Rocket) -->
                        <div id="mobile-banking-details" class="mt-4" style="display: none;">
                            <div class="alert alert-info alert-permanent" id="mfs-instructions">
                                <h6 class="alert-heading"><i class="fas fa-info-circle me-2"></i>@Localizer["MobileBankingInstructions"]</h6>
                                <ol class="mb-2 small">
                                    <li>Send the total amount to our <span id="mfs-provider">bKash</span> number: <strong id="mfs-number">@ViewBag.BkashNumber</strong></li>
                                    <li>Enter your mobile number and transaction ID below</li>
                                    <li>We will verify your payment and confirm your order</li>
                                </ol>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="MobileBankingNumber" class="form-label">@Localizer["YourMobileNumber"] <span class="text-danger">*</span></label>
                                    <input asp-for="MobileBankingNumber" class="form-control" id="MobileBankingNumber" placeholder="01XXXXXXXXX" />
                                    <span asp-validation-for="MobileBankingNumber" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="TransactionId" class="form-label">@Localizer["TransactionIDTrxID"] <span class="text-danger">*</span></label>
                                    <input asp-for="TransactionId" class="form-control" id="TransactionId" placeholder="@Localizer["EnterTransactionID"]" />
                                    <span asp-validation-for="TransactionId" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Card Payment Info (shown for Credit/Debit Card) -->
                        <div id="card-payment-info" class="mt-4" style="display: none;">
                            <div class="alert alert-info alert-permanent">
                                <h6 class="alert-heading"><i class="fas fa-credit-card me-2"></i>@Localizer["CardPaymentInfo"]</h6>
                                <p class="mb-2 small">You will be redirected to our secure payment gateway (SSLCommerz) to complete your payment.</p>
                                <div class="d-flex flex-wrap gap-2 align-items-center">
                                    <span class="small text-muted me-2">Accepted Cards:</span>
                                    <i class="fab fa-cc-visa fa-2x text-primary"></i>
                                    <i class="fab fa-cc-mastercard fa-2x text-warning"></i>
                                    <i class="fab fa-cc-amex fa-2x text-info"></i>
                                    <img src="https://www.sslcommerz.com/wp-content/uploads/2021/11/logo.png" alt="SSLCommerz" style="height: 24px;" onerror="this.style.display='none'" />
                                </div>
                            </div>
                        </div>

                        <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                    </div>
                </div>

                <!-- Rewards & Wallet Section (only show if user has any rewards/wallet) -->
                @if (Model.AvailableFreeShippingVouchers.Any() || Model.AvailableDiscountVouchers.Any() || Model.AvailableWalletBalance > 0 || Model.IsPremiumMember)
                {
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0"><i class="fas fa-gift me-2"></i>@Localizer["RewardsAndWallet"]</h5>
                        </div>
                        <div class="card-body">
                            <!-- Premium Member Badge -->
                            @if (Model.IsPremiumMember)
                            {
                                <div class="alert alert-success mb-3">
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-crown fa-2x text-warning me-3"></i>
                                        <div>
                                            <strong>@Localizer["PremiumMember"]</strong>
                                            <p class="mb-0 small">
                                                <i class="fas fa-truck me-1"></i>@Localizer["FreeShippingOnAllOrders"]
                                                @if (Model.HasActivePremiumDiscount)
                                                {
                                                    <span class="ms-2"><i class="fas fa-percent me-1"></i>5% discount active</span>
                                                }
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Free Shipping Vouchers -->
                            @if (Model.AvailableFreeShippingVouchers.Any() && !Model.IsPremiumMember)
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold"><i class="fas fa-truck me-2"></i>@Localizer["FreeShippingVouchers"]</label>
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <div class="voucher-option" data-voucher-id="0" data-type="shipping">
                                                <input type="radio" name="free-shipping-voucher" value="0" id="no-shipping-voucher" checked class="d-none" />
                                                <label for="no-shipping-voucher" class="voucher-label">
                                                    <i class="fas fa-times-circle text-muted me-2"></i>
                                                    <span>@Localizer["NoFreeShipping"]</span>
                                                </label>
                                            </div>
                                        </div>
                                        @foreach (var voucher in Model.AvailableFreeShippingVouchers)
                                        {
                                            <div class="col-md-6">
                                                <div class="voucher-option" data-voucher-id="@voucher.Id" data-type="shipping">
                                                    <input type="radio" name="free-shipping-voucher" value="@voucher.Id" id="shipping-voucher-@voucher.Id" class="d-none" />
                                                    <label for="shipping-voucher-@voucher.Id" class="voucher-label">
                                                        <i class="fas fa-truck text-success me-2"></i>
                                                        <div>
                                                            <span>@voucher.RewardName</span>
                                                            <small class="text-muted d-block">Expires: @voucher.ExpiresAt.ToString("MMM dd, yyyy")</small>
                                                        </div>
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Discount Vouchers -->
                            @if (Model.AvailableDiscountVouchers.Any())
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold"><i class="fas fa-tag me-2"></i>@Localizer["DiscountVouchers"]</label>
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <div class="voucher-option selected" data-voucher-id="0" data-type="discount" data-amount="0" data-min="0">
                                                <input type="radio" name="discount-voucher" value="0" id="no-discount-voucher" checked class="d-none" />
                                                <label for="no-discount-voucher" class="voucher-label">
                                                    <i class="fas fa-times-circle text-muted me-2"></i>
                                                    <span>@Localizer["NoDiscountVoucher"]</span>
                                                </label>
                                            </div>
                                        </div>
                                        @foreach (var voucher in Model.AvailableDiscountVouchers)
                                        {
                                            <div class="col-md-6">
                                                <div class="voucher-option" data-voucher-id="@voucher.Id" data-type="discount" data-amount="@(voucher.DiscountAmount ?? 0)" data-min="@(voucher.MinimumOrderAmount ?? 0)">
                                                    <input type="radio" name="discount-voucher" value="@voucher.Id" id="discount-voucher-@voucher.Id" class="d-none" />
                                                    <label for="discount-voucher-@voucher.Id" class="voucher-label">
                                                        <i class="fas fa-tag text-danger me-2"></i>
                                                        <div>
                                                            <span>@voucher.RewardName</span>
                                                            @if (voucher.MinimumOrderAmount.HasValue && voucher.MinimumOrderAmount > 0)
                                                            {
                                                                <small class="text-muted d-block">Min order: @currencySymbol@voucher.MinimumOrderAmount.Value.ToString("N0")</small>
                                                            }
                                                            <small class="text-muted d-block">Expires: @voucher.ExpiresAt.ToString("MMM dd, yyyy")</small>
                                                        </div>
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Wallet Balance -->
                            @if (Model.AvailableWalletBalance > 0)
                            {
                                <div class="mb-0">
                                    <label class="form-label fw-bold"><i class="fas fa-wallet me-2"></i>@Localizer["WalletBalance"]</label>
                                    <div class="d-flex align-items-center">
                                        <div class="form-check me-3">
                                            <input class="form-check-input" type="checkbox" id="use-wallet-checkbox">
                                            <label class="form-check-label" for="use-wallet-checkbox">
                                                @Localizer["UseWalletBalance"]
                                            </label>
                                        </div>
                                        <span class="badge bg-success fs-6">@currencySymbol@Math.Round(Model.AvailableWalletBalance).ToString("N0") available</span>
                                    </div>
                                    <div id="wallet-amount-section" class="mt-2" style="display: none;">
                                        <div class="input-group" style="max-width: 250px;">
                                            <span class="input-group-text">@currencySymbol</span>
                                            <input type="number" class="form-control" id="wallet-amount-input"
                                                   min="0" max="@Math.Round(Model.AvailableWalletBalance)" step="1"
                                                   value="@Math.Round(Model.AvailableWalletBalance)" placeholder="Amount to use" />
                                            <button type="button" class="btn btn-outline-success" id="use-full-wallet-btn">Max</button>
                                        </div>
                                        <small class="text-muted">Enter amount to use (max: @currencySymbol@Math.Round(Model.AvailableWalletBalance).ToString("N0"))</small>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </form>
        </div>

        <!-- Right Column - Order Summary -->
        <div class="col-lg-5">
            <div class="card shadow-sm sticky-top" style="top: 20px; overflow: visible;">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-receipt me-2"></i>@Localizer["OrderSummary"]</h5>
                </div>
                <div class="card-body" style="overflow: visible;">
                    <!-- Cart Items -->
                    <div class="order-items mb-3">
                        @foreach (var item in Model.CartItems)
                        {
                            var itemPrice = item.EffectivePrice;
                            var hasDiscount = item.Product.HasDiscount;
                            <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
                                <div class="position-relative me-3 product-img-wrapper">
                                    @if (!string.IsNullOrEmpty(item.Product.ImageUrl))
                                    {
                                        <img src="~/@item.Product.ImageUrl" alt="@item.Product.Name"
                                             class="rounded" style="width: 60px; height: 60px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <img src="~/images/no-image.png" alt="@item.Product.Name"
                                             class="rounded" style="width: 60px; height: 60px; object-fit: cover;" />
                                    }
                                    <span class="position-absolute badge rounded-pill bg-success qty-badge">
                                        @item.Quantity
                                    </span>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-0 small">@item.Product.Name</h6>
                                    @if (!string.IsNullOrEmpty(item.VariantInfo))
                                    {
                                        <small class="text-muted d-block"><i class="fas fa-tag me-1"></i>@item.VariantInfo</small>
                                    }
                                    <div>
                                        <small class="text-success">@(currencySymbol)@itemPrice.ToString("N0")</small>
                                        @if (hasDiscount)
                                        {
                                            <small class="text-muted text-decoration-line-through ms-1">@(currencySymbol)@item.Product.Price.ToString("N0")</small>
                                        }
                                    </div>
                                </div>
                                <div class="text-end">
                                    <strong>@(currencySymbol)@((itemPrice * item.Quantity).ToString("N0"))</strong>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Order Totals -->
                    <div class="order-totals">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal (@Model.CartItems.Sum(i => i.Quantity) items)</span>
                            <span id="cart-subtotal">@(currencySymbol)@Model.CartTotal.ToString("N0")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2" id="delivery-charge-row">
                            <span class="text-muted">@Localizer["DeliveryCharge"]</span>
                            <span id="delivery-charge-display">@(currencySymbol)@Model.DeliveryCharge.ToString("N0")</span>
                        </div>
                        @{
                            var appliedCoupon = ViewBag.AppliedCoupon as Bangaliyana.Models.Coupon;
                            var couponDiscountAmount = ViewBag.CouponDiscountAmount as decimal? ?? 0m;
                        }
                        <!-- Coupon Discount (from cart) -->
                        @if (appliedCoupon != null && couponDiscountAmount > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 text-success" id="coupon-discount-row">
                                <span><i class="fas fa-ticket-alt me-1"></i>Coupon (@appliedCoupon.Code)</span>
                                <span id="coupon-discount-display">-@(currencySymbol)@couponDiscountAmount.ToString("N0")</span>
                            </div>
                        }
                        <!-- Premium Discount (5% - shows only if premium and within first week) -->
                        <div class="d-flex justify-content-between mb-2 text-success" id="premium-discount-row" style="display: none !important;">
                            <span><i class="fas fa-crown me-1"></i>Premium Discount (5%)</span>
                            <span id="premium-discount-display">-@(currencySymbol)0</span>
                        </div>
                        <!-- Discount Voucher -->
                        <div class="d-flex justify-content-between mb-2 text-danger" id="voucher-discount-row" style="display: none !important;">
                            <span><i class="fas fa-tag me-1"></i>Voucher Discount</span>
                            <span id="voucher-discount-display">-@(currencySymbol)0</span>
                        </div>
                        <!-- Wallet Applied -->
                        <div class="d-flex justify-content-between mb-2 text-info" id="wallet-discount-row" style="display: none !important;">
                            <span><i class="fas fa-wallet me-1"></i>Wallet Applied</span>
                            <span id="wallet-discount-display">-@(currencySymbol)0</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between mb-3">
                            <strong class="fs-5">@Localizer["Total"]</strong>
                            <strong class="fs-5 text-success" id="grand-total">@(currencySymbol)@Model.GrandTotal.ToString("N0")</strong>
                        </div>
                        @if (Model.IsPremiumMember || Model.AvailableFreeShippingVouchers.Any() || Model.AvailableDiscountVouchers.Any() || Model.AvailableWalletBalance > 0)
                        {
                            <div class="text-center">
                                <small class="text-success" id="savings-message" style="display: none;">
                                    <i class="fas fa-piggy-bank me-1"></i>You're saving <span id="total-savings">@(currencySymbol)0</span>!
                                </small>
                            </div>
                        }
                    </div>

                    <!-- Place Order Button -->
                    <button type="submit" form="checkout-form" id="place-order-btn" class="btn btn-success btn-lg w-100">
                        <span id="btn-text"><i class="fas fa-lock me-2"></i>@Localizer["PlaceOrder"]</span>
                        <span id="btn-spinner" class="d-none">
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            @Localizer["Processing"]
                        </span>
                    </button>

                    <p class="text-muted small text-center mt-3 mb-0">
                        <i class="fas fa-shield-alt me-1"></i>
                        @Localizer["PaymentSecure"]
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Address Modal -->
<div class="modal fade" id="addressModal" tabindex="-1" aria-labelledby="addressModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="addressModalLabel"><i class="fas fa-map-marker-alt me-2"></i>Add New Address</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="address-form">
                    <input type="hidden" id="address-id" value="0" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Address Label <span class="text-danger">*</span></label>
                            <input type="text" id="address-label" class="form-control" placeholder="e.g., Home, Office" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Address Type</label>
                            <select id="address-type" class="form-select">
                                <option value="0">Home</option>
                                <option value="1">Office</option>
                                <option value="2">Other</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Recipient Name <span class="text-danger">*</span></label>
                            <input type="text" id="modal-recipient-name" class="form-control" placeholder="Full name" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone <span class="text-danger">*</span></label>
                            <input type="tel" id="modal-phone" class="form-control" placeholder="01XXXXXXXXX" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Division <span class="text-danger">*</span></label>
                            <select id="modal-division" class="form-select" required>
                                <option value="">Select Division</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">District <span class="text-danger">*</span></label>
                            <select id="modal-district" class="form-select" required>
                                <option value="">Select District</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Upazila <span class="text-danger">*</span></label>
                            <select id="modal-upazila" class="form-select" required>
                                <option value="">Select Upazila</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Postal Code</label>
                            <input type="text" id="modal-postal-code" class="form-control" placeholder="Postal code" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Full Address <span class="text-danger">*</span></label>
                            <textarea id="modal-full-address" class="form-control" rows="2" placeholder="House/Road/Village details" required></textarea>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" id="modal-is-default">
                                <label class="form-check-label" for="modal-is-default">
                                    Set as default address
                                </label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="save-address-btn">
                    <i class="fas fa-save me-1"></i>Save Address
                </button>
            </div>
        </div>
    </div>
</div>

